#!/bin/sh
set -e

case "$1" in
	remove)
		if [ -d /run/systemd/system ]; then
			systemctl --system daemon-reload >/dev/null 2>&1 || true
		fi
		# The start-up menu without Kulan's entries and notes (its /etc/grub.d
		# files stay until purged, and do nothing without this package).
		if command -v grub-editenv >/dev/null 2>&1 && [ -e /boot/grub/grubenv ]; then
			grub-editenv /boot/grub/grubenv unset kulan_boot_pending kulan_undo >/dev/null 2>&1 || true
		fi
		if [ -e /boot/grub/grub.cfg ] && command -v update-grub >/dev/null 2>&1; then
			update-grub >/dev/null 2>&1 || true
		fi
		# Encrypted DNS chosen in Kulan Settings goes with it: no setting
		# should stay that can no longer be changed from Kulan Settings.
		if [ -e /etc/systemd/resolved.conf.d/60-kulan-dns.conf ]; then
			rm -f /etc/systemd/resolved.conf.d/60-kulan-dns.conf
			if [ -d /run/systemd/system ]; then
				deb-systemd-invoke try-restart systemd-resolved.service >/dev/null 2>&1 || true
				nmcli general reload dns-rc >/dev/null 2>&1 || true
			fi
		fi
		;;
	purge)
		deb-systemd-helper purge kulan-restore-points.timer >/dev/null 2>&1 || true
		deb-systemd-helper purge kulan-update-status.service >/dev/null 2>&1 || true
		deb-systemd-helper purge kulan-update-status.timer >/dev/null 2>&1 || true
		deb-systemd-helper purge kulan-app-updates.timer >/dev/null 2>&1 || true
		deb-systemd-helper purge kulan-countme.timer >/dev/null 2>&1 || true
		deb-systemd-helper purge kulan-update-repair.service >/dev/null 2>&1 || true
		deb-systemd-helper purge kulan-boot-ok.service >/dev/null 2>&1 || true
		deb-systemd-helper purge kulan-undo-at-start.service >/dev/null 2>&1 || true
		rm -f /var/lib/kulan/auto-update-restore-point
		rm -rf /var/lib/kulan-countme
		rm -f /etc/kulan/no-countme
		rm -f /var/lib/kulan/app-updates.tsv /var/lib/kulan/restore-points.json
		rm -f /var/lib/kulan/updates.json /var/lib/kulan/security-checkup.json \
			/etc/apt/apt.conf.d/53kulan-auto-upgrades-user /etc/systemd/resolved.conf.d/60-kulan-dns.conf
		;;
esac

exit 0
