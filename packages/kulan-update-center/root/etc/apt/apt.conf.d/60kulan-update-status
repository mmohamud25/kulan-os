// Kulan OS: keep the Update Center and its top-bar indicator current.
// The helper never makes apt fail, and gives up after 60 seconds.
APT::Update::Post-Invoke-Success { "if [ -x /usr/lib/kulan/update-status ]; then timeout 60 /usr/lib/kulan/update-status refresh || true; fi"; };
DPkg::Pre-Invoke { "if [ -x /usr/lib/kulan/update-status ]; then timeout 10 /usr/lib/kulan/update-status running || true; fi"; };
// After each dpkg run, except during automatic updates and Kulan's own
// installs, which install in many small steps and refresh once at the end.
DPkg::Post-Invoke { "if [ -x /usr/lib/kulan/update-status ]; then timeout 60 /usr/lib/kulan/update-status after-dpkg || true; fi"; };
// The restore point before automatic updates is taken before they start,
// not here while they hold apt's lock: see apt-daily-upgrade.service.d.
