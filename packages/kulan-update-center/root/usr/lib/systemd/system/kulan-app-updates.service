[Unit]
Description=Kulan OS app (Flatpak) updates
Documentation=https://github.com/mmohamud25/kulan-os
ConditionKernelCommandLine=!boot=live
After=network-online.target
Wants=network-online.target

# Installs app updates only when "Install updates automatically" is on in
# Kulan Settings > Software Update; otherwise it just looks them up so they
# show there.
[Service]
Type=oneshot
ExecStart=/usr/lib/kulan/app-updates auto
Nice=10
IOSchedulingClass=idle
# Sandboxed: Flatpak updates for everyone (system-wide apps in
# /var/lib/flatpak). /usr, /boot and /etc stay read-only, home folders
# out of reach.
ProtectSystem=full
ProtectHome=yes
PrivateTmp=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
# Hardening that can't get in the way of what it does.
LockPersonality=yes
RestrictRealtime=yes
SystemCallArchitectures=native
ProtectKernelLogs=yes
ProtectClock=yes
