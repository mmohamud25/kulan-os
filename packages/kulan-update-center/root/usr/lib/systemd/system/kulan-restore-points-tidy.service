[Unit]
Description=Kulan OS restore points: keep within limits and measure their size
Documentation=man:timeshift(1)
ConditionKernelCommandLine=!boot=live

[Service]
Type=oneshot
ExecStart=/usr/lib/kulan/restore-points tidy
Nice=19
IOSchedulingClass=idle
# Measuring large restore points takes a while; never longer than this.
TimeoutStartSec=1h
# Hardening that can't get in the way of what it does.
LockPersonality=yes
RestrictRealtime=yes
SystemCallArchitectures=native
ProtectKernelLogs=yes
ProtectClock=yes
ProtectHome=read-only
