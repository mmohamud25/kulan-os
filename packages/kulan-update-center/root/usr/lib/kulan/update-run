#!/bin/bash
# Privileged actions for Kulan Update Center. Runs as root through pkexec
# (policy: org.kulan.updates.manage), so it accepts only these fixed actions:
#
#   update-run check                      download the latest package lists
#   update-run install [--restore-point]  install available updates
#   update-run auto-on | auto-off         automatic updates on or off
#   update-run restore-point              create a restore point now
#   update-run install-devkit             install the Kulan developer kit
#   update-run install-apps               install LibreOffice, VLC and GIMP
#
# Install progress goes to stdout as apt status lines (pmstatus/dlstatus);
# apt's own messages go to stderr.
set -euo pipefail

export PATH=/usr/sbin:/usr/bin:/sbin:/bin
export LC_ALL=C.UTF-8 DEBIAN_FRONTEND=noninteractive

AUTO_OVERRIDE=/etc/apt/apt.conf.d/53kulan-auto-upgrades-user
APT_OPTS=(-q -y
	-o Dpkg::Options::=--force-confdef
	-o Dpkg::Options::=--force-confold
	-o APT::Status-Fd=3)

die() {
	echo "$*" >&2
	exit 1
}

[[ ${EUID} -eq 0 ]] || die "update-run must run as root (through pkexec)."

# Status lines on fd 3 -> stdout; everything apt prints -> stderr.
run_apt() {
	apt-get "${APT_OPTS[@]}" "$@" 3>&1 1>&2
}

case "${1:-}" in
	check)
		[[ $# -eq 1 ]] || die "usage: update-run check"
		apt-get -q update 1>&2
		;;
	install)
		RESTORE=0
		if [[ $# -eq 2 && "$2" == --restore-point ]]; then
			RESTORE=1
		elif [[ $# -ne 1 ]]; then
			die "usage: update-run install [--restore-point]"
		fi
		if [[ ${RESTORE} -eq 1 && -x /usr/lib/kulan/restore-points ]]; then
			echo "pmstatus:restore-point:0:Creating a restore point"
			/usr/lib/kulan/restore-points create "Before installing updates" 1>&2 ||
				echo "Restore point skipped; installing updates anyway." >&2
		fi
		run_apt --with-new-pkgs upgrade
		;;
	auto-on)
		[[ $# -eq 1 ]] || die "usage: update-run auto-on"
		rm -f "${AUTO_OVERRIDE}"
		;;
	auto-off)
		[[ $# -eq 1 ]] || die "usage: update-run auto-off"
		printf '// Set by Kulan Update Center: automatic updates are off.\nAPT::Periodic::Unattended-Upgrade "0";\n' > "${AUTO_OVERRIDE}"
		chmod 0644 "${AUTO_OVERRIDE}"
		;;
	restore-point)
		[[ $# -eq 1 ]] || die "usage: update-run restore-point"
		[[ -x /usr/lib/kulan/restore-points ]] || die "Restore points aren't installed."
		/usr/lib/kulan/restore-points create "Created in Update Center"
		;;
	install-devkit)
		[[ $# -eq 1 ]] || die "usage: update-run install-devkit"
		apt-get -q update 1>&2
		run_apt install kulan-devkit
		;;
	install-apps)
		[[ $# -eq 1 ]] || die "usage: update-run install-apps"
		apt-get -q update 1>&2
		run_apt install kulan-apps
		;;
	*)
		die "usage: update-run check|install [--restore-point]|auto-on|auto-off|restore-point|install-devkit|install-apps"
		;;
esac
