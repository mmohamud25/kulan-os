#!/bin/bash
# Privileged actions for Kulan Update Center. Runs as root through pkexec
# (policy: org.kulan.updates.manage), so it accepts only these fixed actions:
#
#   update-run check                      download the latest package lists
#   update-run install [--restore-point]  install available updates
#   update-run auto-on | auto-off         automatic updates on or off
#   update-run restore-point              create a restore point now
#   update-run install-devkit             install the Kulan developer kit
#   update-run install-apps               install LibreOffice, VLC and GIMP
#   update-run addon-install <id>         install an add-on listed in addons.json
#   update-run addon-remove <id>          remove an add-on listed in addons.json
#   update-run security-checkup           run Lynis; summary in /var/lib/kulan/security-checkup.json
#   update-run firewall-on                turn the firewall on (block incoming)
#   update-run dns off|quad9|adblock  encrypted DNS for the whole computer
#   update-run set-hostname <name>        change the computer's name
#
# Install progress goes to stdout as apt status lines (pmstatus/dlstatus);
# apt's own messages go to stderr.
set -euo pipefail

export PATH=/usr/sbin:/usr/bin:/sbin:/bin
export LC_ALL=C.UTF-8 DEBIAN_FRONTEND=noninteractive

AUTO_OVERRIDE=/etc/apt/apt.conf.d/53kulan-auto-upgrades-user
ADDONS=/usr/share/kulan/addons.json
CHECKUP=/var/lib/kulan/security-checkup.json
DNS_CONF=/etc/systemd/resolved.conf.d/60-kulan-dns.conf
APT_OPTS=(-q -y
	-o Dpkg::Options::=--force-confdef
	-o Dpkg::Options::=--force-confold
	-o APT::Status-Fd=3)

die() {
	echo "$*" >&2
	exit 1
}

[[ ${EUID} -eq 0 ]] || die "update-run must run as root (through pkexec)."

# Status lines on fd 3 -> stdout; everything apt prints -> stderr.
run_apt() {
	apt-get "${APT_OPTS[@]}" "$@" 3>&1 1>&2
}

# Packages apt would remove as no longer needed, sorted, one per line.
autoremovable() {
	apt-get -s autoremove 2>/dev/null | awk '/^Remv /{print $2}' | sort -u
}

# The installed packages that Kulan metapackages (kulan-*) among $@ depend on.
metapackage_depends() {
	local pkg dep
	for pkg in "$@"; do
		[[ "${pkg}" == kulan-* ]] || continue
		dpkg-query -W -f '${Depends}\n' "${pkg}" 2>/dev/null | tr ',' '\n' |
			sed -E 's/\|.*//; s/\(.*\)//; s/:.*//; s/[[:space:]]//g'
	done | sort -u | while read -r dep; do
		[[ "${dep}" =~ ^[a-z0-9][a-z0-9+.-]+$ ]] || continue
		if dpkg-query -W -f '${db:Status-Status}' "${dep}" 2>/dev/null | grep -qx installed; then
			echo "${dep}"
		fi
	done
}

# The packages of add-on <id>, one per line, from the root-owned registry.
# Only add-ons listed there can be installed or removed through this helper.
addon_packages() {
	[[ "$1" =~ ^[a-z0-9][a-z0-9-]{0,40}$ ]] || die "Unknown add-on."
	python3 -I -c '
import json, re, sys
addon_id, registry = sys.argv[1], sys.argv[2]
for addon in json.load(open(registry, encoding="utf-8")):
    if addon.get("id") == addon_id:
        packages = addon.get("packages") or []
        if not packages or not all(isinstance(p, str) and re.fullmatch(r"[a-z0-9][a-z0-9+.-]+", p) for p in packages):
            sys.exit(1)
        print("\n".join(packages))
        sys.exit(0)
sys.exit(1)
' "$1" "${ADDONS}" || die "Unknown add-on."
}

case "${1:-}" in
	check)
		[[ $# -eq 1 ]] || die "usage: update-run check"
		apt-get -q update 1>&2
		;;
	install)
		RESTORE=0
		if [[ $# -eq 2 && "$2" == --restore-point ]]; then
			RESTORE=1
		elif [[ $# -ne 1 ]]; then
			die "usage: update-run install [--restore-point]"
		fi
		if [[ ${RESTORE} -eq 1 && -x /usr/lib/kulan/restore-points ]]; then
			echo "pmstatus:restore-point:0:Creating a restore point"
			/usr/lib/kulan/restore-points create "Before installing updates" 1>&2 ||
				echo "Restore point skipped; installing updates anyway." >&2
		fi
		run_apt --with-new-pkgs upgrade
		;;
	auto-on)
		[[ $# -eq 1 ]] || die "usage: update-run auto-on"
		rm -f "${AUTO_OVERRIDE}"
		;;
	auto-off)
		[[ $# -eq 1 ]] || die "usage: update-run auto-off"
		printf '// Set by Kulan Update Center: automatic updates are off.\nAPT::Periodic::Unattended-Upgrade "0";\n' > "${AUTO_OVERRIDE}"
		chmod 0644 "${AUTO_OVERRIDE}"
		;;
	restore-point)
		[[ $# -eq 1 ]] || die "usage: update-run restore-point"
		[[ -x /usr/lib/kulan/restore-points ]] || die "Restore points aren't installed."
		/usr/lib/kulan/restore-points create "Created in Update Center"
		;;
	install-devkit)
		[[ $# -eq 1 ]] || die "usage: update-run install-devkit"
		apt-get -q update 1>&2
		run_apt install kulan-devkit
		;;
	install-apps)
		[[ $# -eq 1 ]] || die "usage: update-run install-apps"
		apt-get -q update 1>&2
		run_apt install kulan-apps
		;;
	addon-install | addon-remove)
		[[ $# -eq 2 ]] || die "usage: update-run $1 <add-on>"
		mapfile -t PACKAGES < <(addon_packages "$2")
		[[ ${#PACKAGES[@]} -gt 0 ]] || die "Unknown add-on."
		if [[ "$1" == addon-install ]]; then
			apt-get -q update 1>&2
			run_apt install "${PACKAGES[@]}"
		else
			# Leave alone anything apt could already clean up before this.
			mapfile -t BEFORE < <(autoremovable)
			# On an ISO install the apps of a Kulan metapackage (kulan-apps)
			# were installed directly too, so mark what it depends on as
			# automatic: then they go with it unless something else needs them.
			mapfile -t DEPS < <(metapackage_depends "${PACKAGES[@]}")
			if [[ ${#DEPS[@]} -gt 0 ]]; then
				apt-mark auto "${DEPS[@]}" 1>&2
			fi
			# remove, not purge: settings files stay, as with any app removal.
			run_apt remove "${PACKAGES[@]}"
			mapfile -t FREED < <(comm -13 <(printf '%s\n' "${BEFORE[@]}") <(autoremovable))
			if [[ ${#FREED[@]} -gt 0 ]]; then
				run_apt remove "${FREED[@]}"
			fi
		fi
		;;
	security-checkup)
		[[ $# -eq 1 ]] || die "usage: update-run security-checkup"
		command -v lynis >/dev/null 2>&1 || die "The security checkup tool (lynis) isn't installed."
		REPORT="$(mktemp)"
		trap 'rm -f "${REPORT}"' EXIT
		# --quick: no pauses; results go to our own report file.
		lynis audit system --quick --no-colors --report-file "${REPORT}" --logfile /dev/null 1>&2 || true
		install -d -m 0755 /var/lib/kulan
		python3 -I - "${REPORT}" "${CHECKUP}" <<'PY'
import json, os, sys, tempfile, time
report, out = sys.argv[1], sys.argv[2]
result = {"time": time.time(), "score": None, "warnings": [], "suggestions": []}
with open(report, encoding="utf-8", errors="replace") as f:
    for line in f:
        key, sep, value = line.rstrip("\n").partition("=")
        if not sep:
            continue
        if key == "hardening_index":
            result["score"] = int(value) if value.isdigit() else None
        elif key in ("warning[]", "suggestion[]"):
            parts = value.split("|")
            item = {"id": parts[0], "text": parts[1] if len(parts) > 1 else "",
                    "details": parts[2] if len(parts) > 2 and parts[2] != "-" else ""}
            result["warnings" if key == "warning[]" else "suggestions"].append(item)
fd, tmp = tempfile.mkstemp(dir=os.path.dirname(out))
with os.fdopen(fd, "w") as f:
    json.dump(result, f)
os.chmod(tmp, 0o644)
os.replace(tmp, out)
PY
		;;
	firewall-on)
		[[ $# -eq 1 ]] || die "usage: update-run firewall-on"
		ufw default deny incoming 1>&2
		ufw default allow outgoing 1>&2
		ufw --force enable 1>&2
		;;
	dns)
		[[ $# -eq 2 ]] || die "usage: update-run dns off|quad9|adblock"
		case "$2" in
			off)
				rm -f "${DNS_CONF}"
				;;
			quad9 | adblock)
				if ! command -v resolvectl >/dev/null 2>&1; then
					apt-get -q update 1>&2
					run_apt install systemd-resolved
				fi
				if [[ "$2" == quad9 ]]; then
					SERVERS="9.9.9.9#dns.quad9.net 149.112.112.112#dns.quad9.net 2620:fe::fe#dns.quad9.net"
				else
					# Mullvad's ad- and tracker-blocking resolver, encrypted.
					SERVERS="194.242.2.3#adblock.dns.mullvad.net 2a07:e340::3#adblock.dns.mullvad.net"
				fi
				install -d -m 0755 "$(dirname "${DNS_CONF}")"
				printf '# Set by Kulan Settings > Privacy (encrypted DNS: %s).\n[Resolve]\nDNS=%s\nDNSOverTLS=yes\nDomains=~.\n' \
					"$2" "${SERVERS}" > "${DNS_CONF}"
				chmod 0644 "${DNS_CONF}"
				;;
			*) die "usage: update-run dns off|quad9|adblock" ;;
		esac
		if command -v resolvectl >/dev/null 2>&1; then
			systemctl restart systemd-resolved 1>&2 || true
		fi
		;;
	set-hostname)
		[[ $# -eq 2 ]] || die "usage: update-run set-hostname <name>"
		[[ "$2" =~ ^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$ ]] || die "Use letters, numbers and dashes only (up to 63)."
		OLD="$(hostname)"
		hostnamectl set-hostname "$2" 1>&2
		# Keep the name resolving locally (Debian's 127.0.1.1 line).
		if grep -qE "^127\.0\.1\.1[[:space:]]" /etc/hosts; then
			sed -i -E "s/^127\.0\.1\.1[[:space:]].*/127.0.1.1\t$2/" /etc/hosts
		else
			printf '127.0.1.1\t%s\n' "$2" >> /etc/hosts
		fi
		echo "Renamed ${OLD} to $2" >&2
		;;
	*)
		die "usage: update-run check|install [--restore-point]|auto-on|auto-off|restore-point|install-devkit|install-apps|addon-install <id>|addon-remove <id>|security-checkup|firewall-on|dns <mode>|set-hostname <name>"
		;;
esac
