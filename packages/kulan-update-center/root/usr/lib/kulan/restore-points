#!/bin/bash
# Kulan OS restore points (Timeshift, rsync mode).
#
#   restore-points setup             first-boot setup, if not set up yet
#   restore-points scheduled         daily timer: take scheduled snapshots
#   restore-points create "<note>"   take a snapshot now
#   restore-points status            print whether restore points are on
#   restore-points tidy              apply the limits below, then record usage
#   restore-points usage             record how many there are and the space
#                                    they use (for Kulan Settings > Storage)
#   restore-points delete-all        delete every restore point
#   restore-points before-auto-update  a restore point before automatic updates
#                                    (apt-daily-upgrade.service), once a day;
#                                    exits 75 when it left too little room for them
#   restore-points undo-update       put the system back to before the last
#                                    update (a restore point of how it is now
#                                    is taken first), then restart. Needs the
#                                    charger or a charged battery; the computer
#                                    stays on until it's done.
#   restore-points undo-at-start     the same, chosen in the start-up menu
#                                    ("Undo the last update", kulan-undo-at-start.service)
#   restore-points drop-update-point remove the point just taken before updates
#                                    (they need the room: updates come first)
#   restore-points forget-update-point  updates installed without a point: no undo
#
# Snapshots made here are Timeshift's on-demand kind (its default for
# --create; passing "--tags O" is refused by Timeshift 24/25).
# Snapshots are skipped when the disk is low on space, so restore points can
# never fill the disk. Schedule: daily (keep 2) and weekly (keep 1); of the
# ones taken before installing updates, the newest 2 are kept (Timeshift keeps
# on-demand snapshots forever, so before 2.3 they piled up). Ones you make
# yourself are never deleted automatically. If all of them together use more
# than a quarter of the disk, the oldest automatic ones go first. Home
# folders are not included (Timeshift's default): restore points roll back
# the system, not personal files - Deja Dup backs those up. Nor are apps from
# Flathub, the assistant's models or Docker's data (see EXCLUDES).
set -euo pipefail

export PATH=/usr/sbin:/usr/bin:/sbin:/bin LC_ALL=C.UTF-8

CONFIG=/etc/timeshift/timeshift.json
DEFAULTS=/etc/timeshift/default.json
MIN_FREE_PERCENT=15
MIN_FREE_GIB=6
SNAPSHOTS="${KULAN_RESTORE_SNAPSHOTS:-/timeshift/snapshots}" # Timeshift, rsync mode on /
USAGE_FILE="${KULAN_RESTORE_USAGE:-/var/lib/kulan/restore-points.json}"
UPDATE_NOTE="Before installing updates" # update-run's note
UNDO_NOTE="Before undoing an update"
PAUSE_FILE="${KULAN_PAUSE_FILE:-/etc/apt/apt.conf.d/54kulan-paused-after-undo}"
KEEP_UPDATE_POINTS=2
MAX_PERCENT=25 # of the disk, for all restore points together

log() { echo "kulan restore-points: $*" >&2; }

is_live_or_build() {
	[[ "${KULAN_RESTORE_FORCE:-0}" == 1 ]] && return 1 # tests only
	grep -qw 'boot=live' /proc/cmdline 2>/dev/null && return 0
	# Started by systemd: never an ISO build (its sandbox looks like a chroot
	# to ischroot).
	[ -n "${INVOCATION_ID:-}" ] && return 1
	ischroot 2>/dev/null && return 0
	return 1
}

have_space() {
	local size avail
	read -r size avail < <(df --output=size,avail -B1 / | tail -n 1)
	if (( avail * 100 < size * MIN_FREE_PERCENT )) || (( avail < MIN_FREE_GIB * 1024 * 1024 * 1024 )); then
		log "skipped: less than ${MIN_FREE_PERCENT}% or ${MIN_FREE_GIB} GiB free on /"
		return 1
	fi
}

# Left out of restore points: things that are big, come back from where they
# were downloaded, and don't break the system if they're newer or older than
# the rest (apps from Flathub, the assistant's models, Docker's images and
# containers, downloaded update files). A restore leaves them as they are.
# Without this, the first restore point of a computer with a few Flathub apps
# and a model was over 20 GB.
EXCLUDES=(/var/lib/flatpak /var/lib/kulan-assistant/models /var/lib/docker /var/lib/containerd
	/var/cache/apt/archives /swapfile)

exclude_big() {
	python3 -I - "${CONFIG}" "${EXCLUDES[@]}" <<'PY'
import json, os, sys
config, wanted = sys.argv[1], sys.argv[2:]
with open(config, encoding="utf-8") as fh:
    data = json.load(fh)
have = data.get("exclude")
have = [x for x in have if isinstance(x, str)] if isinstance(have, list) else []
missing = [x for x in wanted if x not in have]
if not missing:
    sys.exit(0)
data["exclude"] = have + missing
tmp = config + ".kulan-tmp"
with open(tmp, "w", encoding="utf-8") as fh:
    json.dump(data, fh, indent=2)
os.chmod(tmp, 0o644)
os.replace(tmp, config)
PY
}

setup() {
	command -v timeshift >/dev/null 2>&1 || { log "Timeshift isn't installed"; return 1; }
	if [[ -f "${CONFIG}" ]]; then
		# Computers set up before 2.6.1 get the exclusions too.
		exclude_big || log "couldn't update what restore points leave out"
		return 0
	fi
	is_live_or_build && return 0

	local uuid
	uuid="$(findmnt -no UUID / || true)"
	[[ -n "${uuid}" ]] || { log "could not find the system disk's UUID"; return 1; }

	python3 - "${DEFAULTS}" "${CONFIG}" "${uuid}" <<'PY'
import json, os, sys
defaults, config, uuid = sys.argv[1:4]
try:
    with open(defaults, encoding="utf-8") as fh:
        data = json.load(fh)
except (OSError, ValueError):
    data = {}
data.update({
    "backup_device_uuid": uuid,
    "do_first_run": "false",
    "btrfs_mode": "false",
    "schedule_monthly": "false",
    "schedule_weekly": "true",
    "schedule_daily": "true",
    "schedule_hourly": "false",
    "schedule_boot": "false",
    "count_weekly": "1",
    "count_daily": "2",
})
os.makedirs(os.path.dirname(config), exist_ok=True)
tmp = config + ".kulan-tmp"
with open(tmp, "w", encoding="utf-8") as fh:
    json.dump(data, fh, indent=2)
os.chmod(tmp, 0o644)
os.replace(tmp, config)
PY
	exclude_big
	log "set up: daily and weekly restore points on the system disk"
}

# Snapshots as "<name> <kind>" lines, oldest first (names are dates). kind is
# "update" (taken before installing updates), "own" (made by hand) or "auto"
# (the daily and weekly schedule).
list_snapshots() {
	python3 -I - "${SNAPSHOTS}" "${UPDATE_NOTE}" "${UNDO_NOTE}" <<'PY'
import json, os, sys
root, update_note, undo_note = sys.argv[1:4]
rows = []
try:
    names = os.listdir(root)
except OSError:
    names = []
for name in names:
    try:
        with open(os.path.join(root, name, "info.json"), encoding="utf-8") as fh:
            info = json.load(fh)
    except (OSError, ValueError):
        continue
    tags = str(info.get("tags", ""))
    comment = str(info.get("comments", ""))
    if comment == update_note:
        kind = "update"
    elif comment == undo_note:
        kind = "undo"
    elif "O" in tags.split():
        kind = "own"
    else:
        kind = "auto"
    rows.append((name, kind))
for name, kind in sorted(rows):
    if name and not any(c.isspace() for c in name):
        print(name, kind)
PY
}

delete_snapshot() {
	log "deleting restore point $1"
	timeshift --delete --snapshot "$1" --scripted >&2 || log "couldn't delete $1"
}

# Bytes used by all restore points (files shared between them counted once).
used_bytes() {
	if [[ -d "${SNAPSHOTS}" ]]; then
		du -sx -B1 "${SNAPSHOTS}" 2>/dev/null | cut -f1
	else
		echo 0
	fi
}

# Keep only the newest update-time restore points (quick).
prune_updates() {
	local name kind
	local -a updates=() undos=()
	while read -r name kind; do
		[[ "${kind}" == update ]] && updates+=("${name}")
		[[ "${kind}" == undo ]] && undos+=("${name}")
	done < <(list_snapshots)
	local extra=$(( ${#updates[@]} - KEEP_UPDATE_POINTS )) protected
	protected="$(recorded_point 2>/dev/null || true)"
	local i
	for (( i = 0; i < extra; i++ )); do
		[[ "${updates[i]}" == "${protected}" ]] && continue
		delete_snapshot "${updates[i]}"
	done
	# One "before undoing" point is enough to redo an update.
	extra=$(( ${#undos[@]} - 1 ))
	for (( i = 0; i < extra; i++ )); do
		delete_snapshot "${undos[i]}"
	done
}

# Over the cap (measuring takes a while, so it runs in the background service).
enforce_cap() {
	local name kind
	# Over the cap: the oldest automatic ones go, never the newest one, and
	# never one made by hand.
	local size total
	total="$(df --output=size -B1 / | tail -n 1)"
	while true; do
		size="$(used_bytes)"
		(( size * 100 > total * MAX_PERCENT )) || break
		local -a auto=()
		local protected
		protected="$(recorded_point 2>/dev/null || true)"
		while read -r name kind; do
			[[ "${kind}" != own && "${name}" != "${protected}" ]] && auto+=("${name}")
		done < <(list_snapshots)
		(( ${#auto[@]} > 1 )) || break
		delete_snapshot "${auto[0]}"
	done
}

# The start-up menu offers "Undo the last update" only while there's a restore
# point from before an update (a flag in GRUB's environment block, which GRUB
# reads at start-up). Not with signed start-up (no GRUB) or in tests.
GRUBENV="${KULAN_GRUBENV:-/boot/grub/grubenv}"
record_undo_entry() {
	command -v grub-editenv >/dev/null 2>&1 || return 0
	[[ -e "$(dirname "${GRUBENV}")/grub.cfg" ]] || return 0
	if [[ -n "$1" ]]; then
		grub-editenv "${GRUBENV}" set kulan_undo=1 2>/dev/null || log "couldn't offer the undo in the start-up menu"
	else
		grub-editenv "${GRUBENV}" unset kulan_undo 2>/dev/null || true
	fi
}

# Enough power to finish: the charger, no battery (a desktop), or a battery
# at least 30% full. An undo cut short by a flat battery leaves the system
# half old, half new. KULAN_POWER_SUPPLIES: tests only.
enough_power() {
	local dir="${KULAN_POWER_SUPPLIES:-/sys/class/power_supply}" supply type batteries=0 charged=0
	for supply in "${dir}"/*; do
		[[ -r "${supply}/type" ]] || continue
		type="$(cat "${supply}/type" 2>/dev/null || true)"
		case "${type}" in
			Mains | USB | USB_C | USB_PD)
				[[ "$(cat "${supply}/online" 2>/dev/null || echo 0)" == 1 ]] && return 0
				;;
			Battery)
				# Not a mouse's or a keyboard's battery: the computer's own.
				[[ "$(cat "${supply}/scope" 2>/dev/null || echo System)" == Device ]] && continue
				batteries=$((batteries + 1))
				(( $(cat "${supply}/capacity" 2>/dev/null || echo 0) >= 30 )) && charged=1
				;;
		esac
	done
	(( batteries == 0 || charged == 1 ))
}

# Which restore point protects the last update: written when the point
# before installing updates is taken (here, for Kulan Settings and automatic
# updates), so an undo goes back to that one and no further. When the point
# was skipped (low space, Timeshift busy), no point: the undo isn't offered,
# rather than quietly going back weeks. After an undo, none either (the
# update it protected is gone).
LAST_UPDATE="${KULAN_LAST_UPDATE:-/var/lib/kulan/last-update.json}"
record_last_update() { # record_last_update <point or ""> [undone point]
	mkdir -p "$(dirname "${LAST_UPDATE}")"
	local tmp="${LAST_UPDATE}.tmp"
	# The kernel running when the point was taken: the start-up menu's undo starts
	# that one (12_kulan-undo), in case the update's own kernel is what broke.
	local kernel
	kernel="$(uname -r | tr -dc 'A-Za-z0-9._+~-')"
	printf '{"point": "%s", "undone": "%s", "time": %d, "kernel": "%s"}\n' "$1" "${2:-}" "$(date +%s)" "${kernel}" >"${tmp}"
	chmod 0644 "${tmp}"
	mv -f "${tmp}" "${LAST_UPDATE}"
}
recorded_point() { # prints the recorded point; fails when nothing was ever recorded
	[[ -f "${LAST_UPDATE}" ]] || return 1
	sed -n 's/.*"point": *"\([0-9_-]*\)".*/\1/p' "${LAST_UPDATE}" | head -n 1
}

# Takes the restore point before installing updates and records it.
take_update_point() {
	local before newest name kind
	before="$(list_snapshots)"
	if have_space && timeshift --create --scripted --comments "${UPDATE_NOTE}" >&2; then
		newest=""
		while read -r name kind; do
			[[ "${kind}" == update ]] && ! grep -qx "${name} update" <<<"${before}" && newest="${name}"
		done < <(list_snapshots)
		record_last_update "${newest}"
		[[ -n "${newest}" ]] && return 0
		return 1
	fi
	record_last_update ""
	return 1
}

# The point just taken for an update, removed again (updates need the room):
# this update can't be undone, and Kulan Settings doesn't offer it.
drop_update_point() {
	local point
	point="$(recorded_point 2>/dev/null || true)"
	[[ -n "${point}" ]] && delete_snapshot "${point}"
	record_last_update ""
	log "the restore point before these updates was removed to make room for them"
}

# The restore point an undo goes back to: the one taken for the last update,
# if it's still there. Computers updated from before 2.13 have no record yet:
# the newest one from before an update, if it's less than a week old.
undo_target() {
	local name kind newest="" recorded
	while read -r name kind; do
		[[ "${kind}" == update ]] && newest="${name}"
	done < <(list_snapshots)
	if recorded="$(recorded_point)"; then
		[[ -n "${recorded}" ]] && list_snapshots | grep -qx "${recorded} update" && echo "${recorded}"
		return 0
	fi
	[[ -n "${newest}" ]] || return 0
	local made
	made="$(date -d "$(sed -E 's/^([0-9-]+)_([0-9]+)-([0-9]+)-([0-9]+)$/\1 \2:\3:\4/' <<<"${newest}")" +%s 2>/dev/null || echo 0)"
	(( $(date +%s) - made < 7 * 86400 )) && echo "${newest}"
	return 0
}

# What an undo never puts back: who can sign in and with what password, and
# the computer's security and organisation settings (Fleet, lost mode, a
# waiting erase, two-step sign-in, disk unlock, signed start-up and its key,
# the firewall, USB rules, compliance mode, Wi-Fi networks, fingerprints).
# They're kept as they are now: an undo puts back the software, not an older
# set of passwords or a lifted lost mode. Each is kept exactly: a file that
# isn't there now is removed from the restored system too. Only files Kulan
# or the person wrote: never a package's own files (dpkg's records go back
# with the restore point, and must match). /etc/gdm3/daemon.conf and
# /etc/ufw/ufw.conf are configuration files of their packages that compliance
# mode and the firewall change: kept as changed, as dpkg expects of an edited one.
KEEP_ROOT="${KULAN_KEEP_ROOT:-}" # tests only
KEEP=(/etc/passwd /etc/shadow /etc/group /etc/gshadow /etc/subuid /etc/subgid
	/etc/kulan /var/lib/kulan /var/lib/AccountsService /var/lib/fprint
	/etc/nologin /etc/crypttab /etc/kernel/cmdline /etc/default/grub
	/etc/dracut.conf.d/50-kulan-tpm.conf /etc/dracut.conf.d/40-kulan-signed-start.conf
	/etc/ufw/ufw.conf /etc/ufw/user.rules /etc/ufw/user6.rules
	/etc/udev/rules.d/60-kulan-fleet-usb.rules /etc/NetworkManager/system-connections
	/etc/dconf/db/local.d/40-kulan-fleet /etc/dconf/db/local.d/60-kulan-fleet /etc/dconf/db/local.d/50-kulan-compliance
	/etc/dconf/db/local.d/locks/40-kulan-fleet /etc/dconf/db/local.d/locks/60-kulan-fleet
	/etc/dconf/db/local.d/locks/50-kulan-compliance /etc/dconf/db/gdm.d/90-kulan-fleet-lost /etc/gdm3/daemon.conf
	/etc/apt/preferences.d/60-kulan-fleet-blocked /etc/apt/apt.conf.d/20kulan-compliance-updates
	/etc/ssh/sshd_config.d/50-kulan-compliance.conf /etc/security/pwquality.conf.d/50-kulan-compliance.conf
)
# Kept on the system disk, next to the restore points (never part of one, and
# never restored over): it survives a restart if something stops half-way.
KEPT="${KULAN_KEPT:-$(dirname "${SNAPSHOTS}")/kulan-undo-kept}"
keep_state() {
	rm -rf "${KEPT}"
	mkdir -p "${KEPT}"
	chmod 0700 "${KEPT}"
	local path
	: >"${KEPT}/absent"
	local -a present=()
	for path in "${KEEP[@]}"; do
		if [[ -e "${KEEP_ROOT}${path}" || -L "${KEEP_ROOT}${path}" ]]; then
			present+=("${path#/}")
		else
			echo "${path}" >>"${KEPT}/absent"
		fi
	done
	(( ${#present[@]} )) || return 0
	# tar says 1 when a file changed while it was read (the Fleet agent writing
	# its state, say): what it read is still a whole copy of each file.
	local rc=0
	tar --create --file "${KEPT}/state.tar" --acls --xattrs --numeric-owner --one-file-system \
		-C "${KEEP_ROOT:-/}" "${present[@]}" || rc=$?
	(( rc <= 1 ))
}
put_state_back() {
	[[ -d "${KEPT}" ]] || return 0
	# Unpacked next to where they go first, then each moved into place in one
	# step: if unpacking fails, nothing of the restored system was touched, and
	# there's never a moment without /etc/passwd or /etc/shadow.
	local stage="${KEEP_ROOT}/.kulan-undo-stage" path target ok=0
	rm -rf "${stage}"
	mkdir -p "${stage}"
	chmod 0700 "${stage}"
	if [[ -f "${KEPT}/state.tar" ]] && ! tar --extract --file "${KEPT}/state.tar" --acls --xattrs --numeric-owner \
		--same-permissions -C "${stage}"; then
		rm -rf "${stage}"
		log "couldn't unpack the kept accounts and settings; they're in ${KEPT}"
		return 1
	fi
	for path in "${KEEP[@]}"; do
		target="${KEEP_ROOT}${path}"
		if [[ -e "${stage}${path}" || -L "${stage}${path}" ]]; then
			mkdir -p "$(dirname "${target}")"
			if [[ -d "${stage}${path}" && ! -L "${stage}${path}" ]]; then
				rm -rf "${target}.kulan-old"
				if [[ -e "${target}" || -L "${target}" ]]; then mv "${target}" "${target}.kulan-old" || { ok=1; continue; }; fi
				if mv "${stage}${path}" "${target}"; then
					rm -rf "${target}.kulan-old"
				else
					[[ -e "${target}.kulan-old" ]] && mv "${target}.kulan-old" "${target}"
					ok=1
				fi
			else
				mv -f "${stage}${path}" "${target}" || ok=1
			fi
		elif grep -qxF "${path}" "${KEPT}/absent" 2>/dev/null; then
			rm -rf "${target}" || ok=1
		fi
	done
	rm -rf "${stage}"
	[[ ${ok} -eq 0 ]] || { log "couldn't put everything kept back; it's in ${KEPT}"; return 1; }
	rm -rf "${KEPT}"
	[[ -z "${KEEP_ROOT}" ]] && command -v dconf >/dev/null 2>&1 && { dconf update 2>/dev/null || true; }
	# The start-up files on the EFI partition (not part of restore points) are
	# signed again for the kernels the restored system has: otherwise the
	# newest one would still start the update's kernel, whose modules are gone.
	if [[ -f "${KEEP_ROOT}/var/lib/kulan/signed-start.json" ]] && command -v kulan-signed-start >/dev/null 2>&1; then
		echo "pmstatus:undo:90:Signing the start-up files"
		# The restored system's kulan-signed-start may be from before 2.13, without
		# --after-undo: then a plain rebuild.
		kulan-signed-start rebuild --after-undo >&2 || kulan-signed-start rebuild >&2 ||
			log "couldn't sign the start-up files again"
	fi
	return 0
}

# Lost mode or an erase waiting: an undo isn't the way out of either.
locked_by_organisation() {
	[[ -e "${KEEP_ROOT}/var/lib/kulan/fleet-lost" || -e "${KEEP_ROOT}/var/lib/kulan/fleet-erase-pending" ]]
}

undo_update() {
	is_live_or_build && { log "not available in the live session"; exit 1; }
	if locked_by_organisation; then
		log "lost mode or an erase is waiting: not undoing"
		echo "say:Your organisation has locked this computer, so updates can't be undone."
		exit 1
	fi
	TARGET="$(undo_target)"
	[[ -n "${TARGET}" ]] || { log "there is no restore point from the last update"; echo "say:There's no restore point from the last update to go back to."; exit 1; }
	[[ "${TARGET}" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}_[0-9]{2}-[0-9]{2}-[0-9]{2}$ ]] || { log "unexpected restore point name"; exit 1; }
	if ! enough_power; then
		log "not enough battery to undo the update"
		echo "say:Plug in the charger first. Undoing an update takes a few minutes and mustn't stop half-way."
		exit 1
	fi
	# How things are now, first: if the restore stops half-way (a full disk,
	# an error), the computer goes back to this. No point, no undo.
	echo "pmstatus:undo:10:Saving how things are now"
	local before safety="" name kind
	before="$(list_snapshots)"
	if ! have_space; then
		echo "say:There isn't enough free space to undo the update safely. Free up some space (Kulan Settings › Storage), then try again."
		exit 1
	fi
	if ! timeshift --create --scripted --comments "${UNDO_NOTE}" >&2; then
		echo "say:Kulan OS couldn't save how things are now, so the update wasn't undone. Restart the computer and try again."
		exit 1
	fi
	while read -r name kind; do
		[[ "${kind}" == undo ]] && ! grep -qx "${name} undo" <<<"${before}" && safety="${name}"
	done < <(list_snapshots)
	echo "pmstatus:undo:40:Putting the system back to before the update"
	keep_state || { log "couldn't keep accounts and security settings aside"; echo "say:The update couldn't be undone. Restart the computer and try again."; exit 1; }
	# Only the system is restored (Timeshift leaves home folders alone); the
	# boot loader stays as it is.
	if ! timeshift --restore --snapshot "${TARGET}" --scripted --yes --skip-grub >&2; then
		log "the restore stopped; going back to ${safety:-how things were}"
		if [[ -n "${safety}" ]]; then
			timeshift --restore --snapshot "${safety}" --scripted --yes --skip-grub >&2 || log "going back failed too"
		fi
		put_state_back || true
		echo "say:The update couldn't be undone, so nothing was changed. Restart the computer to finish."
		exit 1
	fi
	put_state_back || log "some kept settings are waiting in ${KEPT}"
	# Done: never again for this update (and a start-up that comes back with
	# the menu's option still set does nothing).
	record_last_update "" "${TARGET}"
	# The same updates would install themselves again tonight: pause
	# automatic updates for 3 days (update-status lifts the pause after
	# that; turning automatic updates on in Kulan Settings lifts it now).
	printf '// Set by Kulan OS after undoing an update. Until: %s\nAPT::Periodic::Unattended-Upgrade "0";\n' \
		"$(( $(date +%s) + 3 * 86400 ))" > "${PAUSE_FILE}"
	chmod 0644 "${PAUSE_FILE}"
	echo "pmstatus:undo:100:Restarting"
	sync
	# Past this command's own hold on shutdown (and anyone else's: the undo is done).
	systemctl reboot --check-inhibitors=no
}

# Writes the usage file Kulan Settings reads (it can't read /timeshift itself).
record_usage() {
	local count=0 own=0 last_update="" name kind size total
	while read -r name kind; do
		count=$((count + 1))
		[[ "${kind}" == own ]] && own=$((own + 1))
	done < <(list_snapshots)
	last_update="$(undo_target)"
	size="$(used_bytes)"
	total="$(df --output=size -B1 / | tail -n 1)"
	mkdir -p "$(dirname "${USAGE_FILE}")"
	local tmp="${USAGE_FILE}.tmp"
	# Snapshot names are dates (YYYY-MM-DD_HH-MM-SS): safe in JSON as they are.
	printf '{"count": %d, "own": %d, "bytes": %d, "disk_bytes": %d, "updated": %d, "last_update": "%s"}\n' \
		"${count}" "${own}" "${size:-0}" "${total:-0}" "$(date +%s)" "${last_update}" > "${tmp}"
	chmod 0644 "${tmp}"
	mv -f "${tmp}" "${USAGE_FILE}"
	record_undo_entry "${last_update}"
}

# Room for the automatic updates after the restore point: what apt would
# download and unpack for every waiting update, and 500 MB to work with, on
# the disks apt uses. Succeeds when there's room (or apt can't say).
room_for_updates() {
	local plan need dir avail margin=$((500 * 1000 * 1000))
	plan="$(apt-get -o Debug::NoLocking=1 --assume-no --with-new-pkgs upgrade 2>/dev/null || true)"
	need="$(python3 -I -c '
import re, sys
units = {"B": 1, "kB": 1e3, "MB": 1e6, "GB": 1e9}
need = 0
for line in sys.stdin:
    m = re.match(r"(?:Need to get|After this operation,) ([\d.,]+) (\w+)", line)
    if m and "freed" not in line:
        need += float(m.group(1).replace(",", "")) * units.get(m.group(2), 1)
print(int(need))
' <<<"${plan}" 2>/dev/null || echo 0)"
	[[ "${need}" =~ ^[0-9]+$ ]] || need=0
	for dir in /var/cache/apt/archives /usr; do
		avail="$(df --output=avail -B1 "${dir}" 2>/dev/null | tail -n 1 | tr -dc 0-9)"
		[[ -n "${avail}" ]] || continue
		if (( avail < need + margin )); then
			log "only $(( avail / 1000000 )) MB free on ${dir}; automatic updates need about $(( (need + margin) / 1000000 )) MB"
			return 1
		fi
	done
}

# Automatic updates will install something now: they're on, due (the same
# rule as apt.systemd.daily's) and there are updates waiting.
auto_update_due() {
	local days stamp=/var/lib/apt/periodic/unattended-upgrades-stamp
	days="$(apt-config shell D APT::Periodic::Unattended-Upgrade 2>/dev/null | sed -n "s/^D='\{0,1\}\([0-9]*\).*/\1/p")"
	[[ "${days}" =~ ^[0-9]+$ ]] && (( days > 0 )) || return 1
	if [[ -f "${stamp}" ]] && (( $(date +%s) - $(stat -c %Y "${stamp}") < days * 86400 )); then
		return 1
	fi
	apt-get -s -q -o Debug::NoLocking=1 --with-new-pkgs upgrade 2>/dev/null | grep -q '^Inst '
}

case "${1:-}" in
	setup)
		setup
		;;
	scheduled)
		is_live_or_build && exit 0
		setup
		if have_space; then
			timeshift --check --scripted || log "Timeshift's scheduled restore point failed; tidying up anyway"
		fi
		prune_updates
		enforce_cap
		record_usage
		;;
	tidy)
		is_live_or_build && exit 0
		prune_updates
		enforce_cap
		record_usage
		;;
	usage)
		is_live_or_build && exit 0
		record_usage
		;;
	undo-update)
		[[ $# -eq 1 ]] || { echo 'usage: restore-points undo-update' >&2; exit 2; }
		# The computer stays on (no sleep, no shutdown, lid closed or not) until it's
		# done; kulan-update.service already holds that.
		if [[ -z "${KULAN_INHIBITED:-}" && -d /run/systemd/system ]] && command -v systemd-inhibit >/dev/null 2>&1; then
			KULAN_INHIBITED=1 exec systemd-inhibit --what=shutdown:sleep:handle-lid-switch --mode=block \
				--who="Kulan OS" --why="Undoing the last update" "$0" "$@"
		fi
		undo_update
		;;
	undo-at-start)
		# Chosen in the start-up menu: the desktop may not even start. Said on the
		# start-up screen (Plymouth) and in the log; start-up carries on if it can't.
		[[ $# -eq 1 ]] || { echo 'usage: restore-points undo-at-start' >&2; exit 2; }
		show() {
			log "$1"
			plymouth display-message --text="$1" 2>/dev/null || true
		}
		if locked_by_organisation; then
			show "Your organisation has locked this computer, so updates can't be undone. Starting Kulan OS as it is."
			sleep 5
			exit 0
		fi
		if [[ -z "$(undo_target)" ]]; then
			show "There's no restore point from the last update. Starting Kulan OS as it is."
			sleep 5
			exit 0
		fi
		if ! enough_power; then
			show "Plug in the charger, then restart and choose Undo the last update again."
			sleep 10
			exit 0
		fi
		show "Undoing the last update. This takes a few minutes. Don't switch off the computer."
		# Its own process, so a failed step stops it (and nothing after it runs).
		KULAN_INHIBITED=1 "${BASH}" "$0" undo-update >/dev/null || { show "The update couldn't be undone. Starting Kulan OS as it is."; sleep 10; exit 0; }
		;;
	delete-all)
		[[ $# -eq 1 ]] || { echo 'usage: restore-points delete-all' >&2; exit 2; }
		is_live_or_build && exit 0
		if [[ -n "$(list_snapshots)" ]]; then
			timeshift --delete-all --scripted >&2
		fi
		record_usage
		;;
	before-auto-update)
		# apt-daily-upgrade.service's ExecCondition (50-kulan-restore-point.conf),
		# before automatic updates take apt's lock: a restore point like the one
		# Kulan Settings takes before installing updates, so "Undo the last update"
		# also covers updates that installed themselves. At most once in 20 hours,
		# only when updates will really install, never in the way of them: only
		# exit status 75 (the restore point left too little room for them) skips
		# this run of automatic updates.
		is_live_or_build && exit 0
		[[ -f "${CONFIG}" ]] || exit 0 # restore points not set up
		STAMP=/var/lib/kulan/auto-update-restore-point
		if [[ -f "${STAMP}" ]] && (( $(date +%s) - $(stat -c %Y "${STAMP}") < 20 * 3600 )); then
			exit 0
		fi
		auto_update_due || exit 0
		# Low on space: no point (and no undo offered for these updates), and
		# the updates still install.
		if take_update_point; then
			mkdir -p /var/lib/kulan
			touch "${STAMP}" # once a day: only once it's really made
		else
			log "couldn't take a restore point before automatic updates"
		fi
		prune_updates || true
		# Updates come first: a restore point that left too little room for them
		# goes (on a small disk, the first one can be most of the free space).
		if ! room_for_updates; then
			drop_update_point
			room_for_updates || exit 75
		fi
		systemctl start --no-block kulan-restore-points-tidy.service 2>/dev/null || true
		;;
	forget-update-point)
		# update-run, for updates installed without a restore point: an undo now
		# would go back further than them, so none is offered.
		[[ $# -eq 1 ]] || { echo 'usage: restore-points forget-update-point' >&2; exit 2; }
		is_live_or_build && exit 0
		record_last_update ""
		;;
	drop-update-point)
		# update-run, when the point before installing updates left too little room for them.
		[[ $# -eq 1 ]] || { echo 'usage: restore-points drop-update-point' >&2; exit 2; }
		is_live_or_build && exit 0
		drop_update_point
		;;
	create)
		[[ $# -eq 2 && -n "$2" ]] || { echo 'usage: restore-points create "<note>"' >&2; exit 2; }
		is_live_or_build && { log "not available in the live session"; exit 1; }
		setup
		if [[ "$2" == "${UPDATE_NOTE}" ]]; then
			take_update_point || exit 1
		else
			have_space || exit 1
			timeshift --create --scripted --comments "$2"
		fi
		prune_updates
		# Measuring can take a minute: done afterwards, at idle priority.
		systemctl start --no-block kulan-restore-points-tidy.service 2>/dev/null || { enforce_cap; record_usage; }
		;;
	status)
		if [[ -f "${CONFIG}" ]] && command -v timeshift >/dev/null 2>&1; then
			echo on
		else
			echo off
		fi
		;;
	*)
		echo 'usage: restore-points setup|scheduled|create "<note>"|status|tidy|usage|delete-all|undo-update|undo-at-start|before-auto-update|drop-update-point|forget-update-point' >&2
		exit 2
		;;
esac
