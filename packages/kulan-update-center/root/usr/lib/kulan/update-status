#!/usr/bin/python3
"""Keep /var/lib/kulan/updates.json current for the Update Center and the
top-bar indicator.

  update-status refresh   recompute available updates (apt hooks, at boot)
  update-status running   mark an install as in progress (apt hook)

Called from apt's own hooks (/etc/apt/apt.conf.d/60kulan-update-status), so
it must be quick, never prompt, and never make apt fail: every error is
swallowed and the previous status file is left in place.
"""
from __future__ import annotations

import json
import os
import re
import subprocess
import sys
import tempfile
import time
from datetime import datetime

STATUS_FILE = "/var/lib/kulan/updates.json"
HISTORY_LOG = "/var/log/apt/history.log"
APP_UPDATES = "/var/lib/kulan/app-updates.tsv"  # written by /usr/lib/kulan/app-updates
RESTART_FILE = "/run/kulan/restart-required"  # written by update-run after installing
DEBIAN_RESTART = "/run/reboot-required"  # automatic updates (a new kernel)
DEBIAN_RESTART_PKGS = "/run/reboot-required.pkgs"

# apt-get -s prints e.g. "Inst openssl [3.5.1-1] (3.5.1-1+deb13u1 Debian-Security:13/stable-security [arm64])"
INST = re.compile(r"^Inst (\S+) (?:\[([^\]]*)\] )?\((\S+) ([^)]*)\)")


def in_build_chroot() -> bool:
    """True while an ISO is being built (live-build runs apt in a chroot)."""
    if os.environ.get("KULAN_STATUS_FORCE") == "1":
        return False
    # Started by systemd (its sandbox looks like a chroot to ischroot, but
    # systemd never runs inside an ISO build).
    if os.environ.get("INVOCATION_ID"):
        return False
    try:
        return subprocess.run(["ischroot"], check=False).returncode == 0
    except OSError:
        return False


def available_updates() -> list[dict]:
    """What "Install updates" would change, without taking apt's lock."""
    proc = subprocess.run(
        ["apt-get", "-s", "-q", "-o", "Debug::NoLocking=1", "--with-new-pkgs", "upgrade"],
        capture_output=True, text=True, timeout=90, check=False,
        env={**os.environ, "LC_ALL": "C.UTF-8"},
    )
    if proc.returncode != 0:
        raise RuntimeError(proc.stderr.strip()[-300:])
    updates = []
    for line in proc.stdout.splitlines():
        match = INST.match(line)
        if match:
            name, old, new, origin = match.groups()
            updates.append({
                "name": name,
                "from": old or "",
                "to": new,
                "security": "security" in origin.lower(),
            })
    add_sources(updates)
    return updates


def add_sources(updates: list[dict]) -> None:
    """Each package's source (so libssl3t64 and openssl show as one update) and
    one-line summary, from dpkg's own records: quick, and needs no lock."""
    names = [u["name"] for u in updates if u.get("from")]
    if not names:
        return
    try:
        out = subprocess.run(
            ["dpkg-query", "-W", "-f", "${binary:Package}\t${source:Package}\t${binary:Summary}\n", *names],
            capture_output=True, text=True, timeout=30, check=False,
            env={**os.environ, "LC_ALL": "C.UTF-8"}).stdout
    except (OSError, subprocess.TimeoutExpired):
        return
    info = {}
    for line in out.splitlines():
        name, _s, rest = line.partition("\t")
        source, _s, summary = rest.partition("\t")
        info[name.split(":")[0]] = (source, summary)
    for u in updates:
        source, summary = info.get(u["name"], ("", ""))
        if source:
            u["source"] = source
        if summary:
            u["summary"] = summary


def app_updates() -> list[dict]:
    """Flatpak app updates, as last looked up online by app-updates."""
    updates = []
    try:
        with open(APP_UPDATES, encoding="utf-8") as fh:
            lines = fh.read().splitlines()
    except OSError:
        return []
    for line in lines:
        ref, _sep, rest = line.partition("\t")
        name, _sep, version = rest.partition("\t")
        parts = ref.split("/")
        if len(parts) != 4 or parts[0] not in ("app", "runtime"):
            continue
        updates.append({
            "name": name.strip() or parts[1],
            "from": "",
            "to": version.strip(),
            "security": False,
            "kind": "app" if parts[0] == "app" else "runtime",
            "ref": ref,
            "id": parts[1],
        })
    return updates


FIRMWARE_FILE = "/var/lib/kulan/firmware-updates.json"  # written by update-run check (fwupdmgr get-updates)


def firmware_updates() -> list[dict]:
    """Device firmware updates (fwupd), as last looked up by update-run."""
    try:
        with open(FIRMWARE_FILE, encoding="utf-8") as fh:
            data = json.load(fh)
    except (OSError, ValueError):
        return []
    updates = []
    for device in data.get("Devices", []) if isinstance(data, dict) else []:
        releases = device.get("Releases") or [] if isinstance(device, dict) else []
        if not releases or not isinstance(releases[0], dict):
            continue
        name = str(device.get("Name") or "Device")[:80]
        updates.append({
            "name": name,
            "from": str(device.get("Version") or "")[:40],
            "to": str(releases[0].get("Version") or "")[:40],
            "security": "is-security" in (releases[0].get("Flags") or []),
            "kind": "firmware",
            "id": str(device.get("DeviceId") or "")[:80],
            "summary": str(releases[0].get("Summary") or "")[:200],
        })
    return updates[:20]


PAUSE_FILE = "/etc/apt/apt.conf.d/54kulan-paused-after-undo"  # written by restore-points undo-update


def paused_until() -> int:
    """When automatic updates resume after an undo (0: not paused). An
    expired pause is lifted here (this runs at start-up and after apt)."""
    try:
        with open(PAUSE_FILE, encoding="utf-8") as fh:
            first = fh.readline()
    except OSError:
        return 0
    match = re.search(r"Until: (\d+)", first)
    until = int(match.group(1)) if match else 0
    if until <= time.time():
        try:
            os.unlink(PAUSE_FILE)
        except OSError:
            pass
        return 0
    return until


def restart_required() -> list[str]:
    """What needs a restart to finish updating: from Kulan's own installs, and
    from automatic updates (Debian's /run/reboot-required, which a new Linux
    kernel writes, with the packages in reboot-required.pkgs)."""
    names: list[str] = []
    for path in (RESTART_FILE, DEBIAN_RESTART_PKGS):
        try:
            with open(path, encoding="utf-8") as fh:
                names += [line.strip() for line in fh if line.strip()]
        except OSError:
            pass
    if not names and os.path.exists(DEBIAN_RESTART):
        names = ["system"]
    return list(dict.fromkeys(names))[:20]


def last_run() -> dict:
    """The most recent apt run that installed or upgraded something."""
    try:
        with open(HISTORY_LOG, encoding="utf-8", errors="replace") as fh:
            entries = fh.read().strip().split("\n\n")
    except OSError:
        return {}
    for entry in reversed(entries):
        fields = {}
        for line in entry.splitlines():
            key, sep, value = line.partition(": ")
            if sep:
                fields[key] = value
        changed = [fields[k] for k in ("Upgrade", "Install") if k in fields]
        if not changed:
            continue
        packages = [p.split(":")[0].split(" ")[0] for chunk in changed for p in chunk.split("), ") if p.strip()]
        stamp = fields.get("End-Date") or fields.get("Start-Date") or ""
        try:
            when = time.mktime(datetime.strptime(" ".join(stamp.split()), "%Y-%m-%d %H:%M:%S").timetuple())
        except ValueError:
            when = 0
        return {"time": int(when), "count": len(packages), "packages": packages[:50]}
    return {}


def read_status() -> dict:
    try:
        with open(STATUS_FILE, encoding="utf-8") as fh:
            data = json.load(fh)
        return data if isinstance(data, dict) else {}
    except (OSError, ValueError):
        return {}


def write_status(status: dict) -> None:
    directory = os.path.dirname(STATUS_FILE)
    os.makedirs(directory, mode=0o755, exist_ok=True)
    fd, tmp = tempfile.mkstemp(prefix=".updates.", dir=directory)
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as fh:
            json.dump(status, fh, indent=1)
        os.chmod(tmp, 0o644)
        os.replace(tmp, STATUS_FILE)
    except BaseException:
        os.unlink(tmp)
        raise


def counted(updates: list[dict]) -> tuple[int, int]:
    """(updates, security updates) as Software Update counts them: grouped by
    what people know (all of Firefox's packages are one update), so the top
    bar says the same number. Kulan Settings' own grouping when it's there."""
    try:
        sys.path.insert(0, "/usr/share/kulan-settings")
        from kulan_settings import updatelist  # noqa: PLC0415 - optional, from kulan-settings
        version = ""
        with open("/etc/os-release", encoding="utf-8") as fh:
            for line in fh:
                if line.startswith("VERSION_ID="):
                    version = line.split("=", 1)[1].strip().strip('"')
        summary = updatelist.summarize(updates, version)
        return int(summary["count"]), len(summary["security"])
    except Exception:  # noqa: BLE001 - kulan-settings missing or older: plain counts
        return len(updates), sum(1 for u in updates if u.get("security"))
    finally:
        if sys.path and sys.path[0] == "/usr/share/kulan-settings":
            sys.path.pop(0)


def main(argv: list[str]) -> int:
    action = argv[1] if len(argv) > 1 else ""
    if action not in ("refresh", "running"):
        print("usage: update-status refresh|running", file=sys.stderr)
        return 2
    if in_build_chroot():
        return 0

    status = read_status()
    status["version"] = 1
    if action == "running":
        status["state"] = "running"
        status["running_since"] = int(time.time())
    else:
        updates = available_updates() + app_updates() + firmware_updates()
        count, security_count = counted(updates)
        status.update({
            "state": "idle",
            "checked": int(time.time()),
            "available": updates,
            "security": sum(1 for u in updates if u["security"]),
            # What a person counts (Software Update and the top bar show these).
            "count": count,
            "security_count": security_count,
            "last_run": last_run(),
            "restart_required": restart_required(),
            "paused_until": paused_until(),
        })
        status.pop("running_since", None)
    write_status(status)
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv))
    except Exception as exc:  # never break apt
        print(f"kulan update-status: {exc}", file=sys.stderr)
        sys.exit(0)
