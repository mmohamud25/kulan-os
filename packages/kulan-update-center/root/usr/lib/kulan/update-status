#!/usr/bin/python3
"""Keep /var/lib/kulan/updates.json current for the Update Center and the
top-bar indicator.

  update-status refresh   recompute available updates (apt hooks, at boot)
  update-status running   mark an install as in progress (apt hook)

Called from apt's own hooks (/etc/apt/apt.conf.d/60kulan-update-status), so
it must be quick, never prompt, and never make apt fail: every error is
swallowed and the previous status file is left in place.
"""
from __future__ import annotations

import json
import os
import re
import subprocess
import sys
import tempfile
import time
from datetime import datetime

STATUS_FILE = "/var/lib/kulan/updates.json"
HISTORY_LOG = "/var/log/apt/history.log"

# apt-get -s prints e.g. "Inst openssl [3.5.1-1] (3.5.1-1+deb13u1 Debian-Security:13/stable-security [arm64])"
INST = re.compile(r"^Inst (\S+) (?:\[([^\]]*)\] )?\((\S+) ([^)]*)\)")


def in_build_chroot() -> bool:
    """True while an ISO is being built (live-build runs apt in a chroot)."""
    if os.environ.get("KULAN_STATUS_FORCE") == "1":
        return False
    try:
        return subprocess.run(["ischroot"], check=False).returncode == 0
    except OSError:
        return False


def available_updates() -> list[dict]:
    """What "Install updates" would change, without taking apt's lock."""
    proc = subprocess.run(
        ["apt-get", "-s", "-q", "-o", "Debug::NoLocking=1", "--with-new-pkgs", "upgrade"],
        capture_output=True, text=True, timeout=90, check=False,
        env={**os.environ, "LC_ALL": "C.UTF-8"},
    )
    if proc.returncode != 0:
        raise RuntimeError(proc.stderr.strip()[-300:])
    updates = []
    for line in proc.stdout.splitlines():
        match = INST.match(line)
        if match:
            name, old, new, origin = match.groups()
            updates.append({
                "name": name,
                "from": old or "",
                "to": new,
                "security": "security" in origin.lower(),
            })
    return updates


def last_run() -> dict:
    """The most recent apt run that installed or upgraded something."""
    try:
        with open(HISTORY_LOG, encoding="utf-8", errors="replace") as fh:
            entries = fh.read().strip().split("\n\n")
    except OSError:
        return {}
    for entry in reversed(entries):
        fields = {}
        for line in entry.splitlines():
            key, sep, value = line.partition(": ")
            if sep:
                fields[key] = value
        changed = [fields[k] for k in ("Upgrade", "Install") if k in fields]
        if not changed:
            continue
        packages = [p.split(":")[0].split(" ")[0] for chunk in changed for p in chunk.split("), ") if p.strip()]
        stamp = fields.get("End-Date") or fields.get("Start-Date") or ""
        try:
            when = time.mktime(datetime.strptime(" ".join(stamp.split()), "%Y-%m-%d %H:%M:%S").timetuple())
        except ValueError:
            when = 0
        return {"time": int(when), "count": len(packages), "packages": packages[:50]}
    return {}


def read_status() -> dict:
    try:
        with open(STATUS_FILE, encoding="utf-8") as fh:
            data = json.load(fh)
        return data if isinstance(data, dict) else {}
    except (OSError, ValueError):
        return {}


def write_status(status: dict) -> None:
    directory = os.path.dirname(STATUS_FILE)
    os.makedirs(directory, mode=0o755, exist_ok=True)
    fd, tmp = tempfile.mkstemp(prefix=".updates.", dir=directory)
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as fh:
            json.dump(status, fh, indent=1)
        os.chmod(tmp, 0o644)
        os.replace(tmp, STATUS_FILE)
    except BaseException:
        os.unlink(tmp)
        raise


def main(argv: list[str]) -> int:
    action = argv[1] if len(argv) > 1 else ""
    if action not in ("refresh", "running"):
        print("usage: update-status refresh|running", file=sys.stderr)
        return 2
    if in_build_chroot():
        return 0

    status = read_status()
    status["version"] = 1
    if action == "running":
        status["state"] = "running"
        status["running_since"] = int(time.time())
    else:
        updates = available_updates()
        status.update({
            "state": "idle",
            "checked": int(time.time()),
            "available": updates,
            "security": sum(1 for u in updates if u["security"]),
            "last_run": last_run(),
        })
        status.pop("running_since", None)
    write_status(status)
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv))
    except Exception as exc:  # never break apt
        print(f"kulan update-status: {exc}", file=sys.stderr)
        sys.exit(0)
