<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<!-- Kulan Settings: one administrator password unlocks system changes
     (updates, restore points, add-ons, security and privacy fixes, storage
     clean-up) for a few minutes. -->
<policyconfig>
  <vendor>Kulan OS</vendor>
  <vendor_url>https://github.com/mmohamud25/kulan-os</vendor_url>
  <icon_name>kulan-logo</icon_name>
  <action id="org.kulan.updates.manage">
    <description>Change Kulan OS system settings</description>
    <message>Kulan Settings needs your password to change this for the whole computer</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/lib/kulan/update-run</annotate>
  </action>
</policyconfig>
