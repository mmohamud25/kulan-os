#!/bin/sh
set -e

# Kulan's desktop defaults, logos and boot splash are extras on top of a
# working system: if one of these steps fails (a broken schema from another
# package, a full disk), say so and carry on, so the package still installs.
# Otherwise apt would refuse every later update, security fixes included,
# until the problem was fixed by hand. The next update runs them again; the
# ISO build and package tests check what they set.
soft() {
	"$@" || echo "W: kulan-desktop-settings: \"$*\" didn't finish; it runs again at the next update" >&2
}

apply() {
	soft /usr/lib/kulan/desktop-setup
}

# Debian's "vendor-logos": the logo shown by Debian's login screen defaults
# (/etc/gdm3/greeter.dconf-defaults) and other Debian software. Debian's own
# (desktop-base) is priority 50; Kulan's wins while this package is installed.
vendor_logos() {
	E=/usr/share/kulan/vendor-emblems
	V=/usr/share/icons/vendor
	# update-alternatives doesn't create the links' folders (desktop-base
	# does, but it may not be installed).
	mkdir -p /usr/share/images "$V/64x64/emblems" "$V/128x128/emblems" \
		"$V/256x256/emblems" "$V/scalable/emblems"
	set -- --install /usr/share/images/vendor-logos vendor-logos /usr/share/kulan/vendor-logos 80
	for SIZE in 64 128 256; do
		for KIND in "" -symbolic -white; do
			set -- "$@" --slave "$V/${SIZE}x${SIZE}/emblems/emblem-vendor${KIND}.png" \
				"emblem-vendor${KIND}-${SIZE}" "$E/emblem-vendor${KIND}-${SIZE}.png"
		done
	done
	for KIND in "" -symbolic -white; do
		set -- "$@" --slave "$V/scalable/emblems/emblem-vendor${KIND}.svg" \
			"emblem-vendor${KIND}-scalable" "$E/emblem-vendor${KIND}.svg"
	done
	update-alternatives --quiet "$@"
}

# Debian's boot splash also draws /usr/share/plymouth/debian-logo.png
# (owned by the plymouth package). Divert it, so plymouth updates keep their
# copy as debian-logo.png.debian, and point it at Kulan's wordmark.
SPLASH_LOGO=/usr/share/plymouth/debian-logo.png
splash_logo() {
	DIVERTED_BY="$(dpkg-divert --listpackage "${SPLASH_LOGO}")"
	if [ -n "${DIVERTED_BY}" ] && [ "${DIVERTED_BY}" != kulan-desktop-settings ]; then
		echo "kulan-desktop-settings: ${SPLASH_LOGO} is diverted by ${DIVERTED_BY}; leaving the splash logo alone" >&2
		return 0
	fi
	if [ -z "${DIVERTED_BY}" ]; then
		# Only replace Plymouth's logo once its own copy is safely set aside.
		dpkg-divert --package kulan-desktop-settings --add --rename \
			--divert "${SPLASH_LOGO}.debian" "${SPLASH_LOGO}" || return 1
	fi
	mkdir -p /usr/share/plymouth || return 1
	ln -sfn /usr/share/kulan/vendor-logos/logo-text-version-64.png "${SPLASH_LOGO}"
}

# The picture new accounts start with: Kulan's, not Debian's logo (which
# desktop-base puts in /etc/skel/.face). Debian's is kept aside, and put
# back if this package is removed. Accounts whose picture is still Debian's
# logo get Kulan's; a picture someone chose is left alone.
SKEL_FACE=/etc/skel/.face
KULAN_FACE=/usr/share/kulan/faces/kulan.png
account_picture() {
	[ -f "${KULAN_FACE}" ] || return 0
	DIVERTED_BY="$(dpkg-divert --listpackage "${SKEL_FACE}")"
	if [ -n "${DIVERTED_BY}" ] && [ "${DIVERTED_BY}" != kulan-desktop-settings ]; then
		return 0
	fi
	if [ -z "${DIVERTED_BY}" ]; then
		dpkg-divert --package kulan-desktop-settings --add --rename \
			--divert "${SKEL_FACE}.debian" "${SKEL_FACE}" || return 1
	fi
	cp "${KULAN_FACE}" "${SKEL_FACE}.kulan-new" && chmod 0644 "${SKEL_FACE}.kulan-new" &&
		mv -f "${SKEL_FACE}.kulan-new" "${SKEL_FACE}" || return 1
	[ -f "${SKEL_FACE}.debian" ] || return 0
	for FACE in /home/*/.face; do
		if [ -f "${FACE}" ] && [ ! -L "${FACE}" ] && cmp -s "${FACE}" "${SKEL_FACE}.debian"; then
			cat "${KULAN_FACE}" > "${FACE}" # keeps its owner
		fi
	done
	return 0
}

# Only Bibata Modern Classic is used: drop the other variants' cursor pictures
# (already installed ones; /etc/dpkg/dpkg.cfg.d/kulan-lean keeps them out of
# later updates).
lean_cursors() {
	[ -e /usr/share/icons/Bibata-Modern-Classic/cursors/left_ptr ] || return 0
	for DIR in /usr/share/icons/Bibata-*/cursors; do
		case "${DIR}" in
			/usr/share/icons/Bibata-Modern-Classic/cursors) ;;
			*) [ -d "${DIR}" ] && find "${DIR}" -mindepth 1 \( -type f -o -type l \) -delete ;;
		esac
	done
	return 0
}

case "$1" in
	configure)
		soft vendor_logos
		soft splash_logo
		soft lean_cursors
		soft account_picture
		apply
		# Most-used apps read into memory after sign-in (kulan-prewarm), for
		# every account; "systemctl --user disable kulan-prewarm.timer" opts out.
		systemctl --global enable kulan-prewarm.timer >/dev/null 2>&1 || true
		soft /usr/lib/kulan/boot-splash-setup
		# Rebuild the initramfs so the boot splash change takes effect.
		if command -v update-initramfs >/dev/null 2>&1; then
			dpkg-trigger --no-await update-initramfs || true
		elif command -v dracut >/dev/null 2>&1; then
			# TPM unlock (kulan-tpm) builds the start-up image with dracut.
			dracut --force --regenerate-all >/dev/null 2>&1 || true
		fi
		# Apps from the Kulan Store (Flatpak) may read the GTK settings folders,
		# so they get Kulan's window buttons too, and Qt ones open through
		# XWayland when they're allowed to (else Wayland, as before). Once;
		# removing it with "flatpak override --system --reset" is respected.
		if [ ! -e /var/lib/kulan/flatpak-style-v2 ]; then
			if command -v flatpak >/dev/null 2>&1; then
				flatpak override --system --filesystem=xdg-config/gtk-3.0:ro --filesystem=xdg-config/gtk-4.0:ro \
					--env='QT_QPA_PLATFORM=xcb;wayland' >/dev/null 2>&1 || true
			elif [ ! -e /var/lib/flatpak/overrides/global ]; then
				# Flatpak not set up yet (the ISO build): the same file it writes.
				mkdir -p /var/lib/flatpak/overrides
				printf '[Context]\nfilesystems=xdg-config/gtk-3.0:ro;xdg-config/gtk-4.0:ro;\n\n[Environment]\nQT_QPA_PLATFORM=xcb;wayland\n' \
					> /var/lib/flatpak/overrides/global
			fi
			mkdir -p /var/lib/kulan && touch /var/lib/kulan/flatpak-style-v2
		fi
		# Refresh the boot menu on installed systems (not during the ISO build).
		if [ -e /boot/grub/grub.cfg ] && command -v update-grub >/dev/null 2>&1; then
			update-grub || echo "W: update-grub failed; boot menu settings apply after the next kernel update" >&2
		fi
		;;
	triggered)
		# Extensions or the installer launcher were added or removed.
		apply
		;;
	abort-upgrade|abort-remove|abort-deconfigure)
		;;
	*)
		echo "postinst called with unknown argument '$1'" >&2
		exit 1
		;;
esac

exit 0
