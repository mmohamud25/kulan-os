#!/bin/sh
set -e

case "$1" in
	remove|purge|abort-install)
		if command -v systemctl >/dev/null 2>&1; then
			systemctl --global disable kulan-browser-look.path kulan-browser-look.service >/dev/null 2>&1 || true
		fi
		# Give Debian's splash logo back.
		SPLASH_LOGO=/usr/share/plymouth/debian-logo.png
		if [ -L "${SPLASH_LOGO}" ] && [ "$(readlink "${SPLASH_LOGO}")" = /usr/share/kulan/vendor-logos/logo-text-version-64.png ]; then
			rm -f "${SPLASH_LOGO}"
		fi
		if dpkg-divert --list "${SPLASH_LOGO}" | grep -q 'by kulan-desktop-settings$'; then
			dpkg-divert --package kulan-desktop-settings --remove --rename \
				--divert "${SPLASH_LOGO}.debian" "${SPLASH_LOGO}"
		fi
		# Give Debian's account picture back to new accounts.
		if dpkg-divert --list /etc/skel/.face | grep -q 'by kulan-desktop-settings$'; then
			rm -f /etc/skel/.face
			dpkg-divert --package kulan-desktop-settings --remove --rename \
				--divert /etc/skel/.face.debian /etc/skel/.face
		fi
		# Give GNOME Software its own Editor's Choice list back.
		if dpkg-divert --list /usr/share/swcatalog/xml/org.gnome.Software.Curated.xml | grep -q 'by kulan-desktop-settings$'; then
			dpkg-divert --package kulan-desktop-settings --remove --rename \
				--divert /usr/share/swcatalog/org.gnome.Software.Curated.xml.gnome \
				/usr/share/swcatalog/xml/org.gnome.Software.Curated.xml
		fi
		rm -f /usr/share/glib-2.0/schemas/98_kulan-os-generated.gschema.override
		rm -f /usr/share/kulan/xdg/applications/org.gnome.Console.desktop
		rm -f /usr/share/kulan/xdg/applications/org.gnome.Settings.desktop
		# The short-name launcher copies (desktop-setup).
		for f in /usr/share/kulan/xdg/applications/*.desktop; do
			if [ -f "$f" ] && grep -qxF '# Kulan OS: the same launcher with a short name.' "$f"; then
				rm -f "$f"
			fi
		done
		if command -v glib-compile-schemas >/dev/null 2>&1; then
			glib-compile-schemas /usr/share/glib-2.0/schemas || true
		fi
		rm -rf /usr/share/plymouth/themes/kulan
		if update-alternatives --query default.plymouth >/dev/null 2>&1; then
			update-alternatives --quiet --remove default.plymouth \
				/usr/share/plymouth/themes/kulan/kulan.plymouth || true
		fi
		if [ -f /etc/plymouth/plymouthd.conf ] && grep -qx 'Theme=kulan' /etc/plymouth/plymouthd.conf; then
			rm -f /etc/plymouth/plymouthd.conf
		fi
		if command -v dconf >/dev/null 2>&1; then
			dconf update || true
		fi
		# Take the Kulan splash hook and early graphics out of the boot image.
		if [ "$1" = remove ] && command -v update-initramfs >/dev/null 2>&1; then
			update-initramfs -u || true
		elif [ "$1" = remove ] && command -v dracut >/dev/null 2>&1; then
			dracut --force --regenerate-all || true
		fi
		;;
esac

exit 0
