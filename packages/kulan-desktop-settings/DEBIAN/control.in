Package: kulan-desktop-settings
Version: @VERSION@
Architecture: all
Maintainer: @PUBLISHER@ <@MAINTAINER_EMAIL@>
Section: x11
Priority: optional
Depends: kulan-base (= @VERSION@), libglib2.0-bin, dconf-cli, plymouth, plymouth-themes, papirus-icon-theme, bibata-cursor-theme, fonts-inter, fonts-jetbrains-mono, gnome-shell-extension-dashtodock, gnome-shell-extension-blur-my-shell, kulan-update-center (= @VERSION@)
Recommends: gnome-shell-extension-appindicator, gtk-update-icon-cache, initramfs-tools
Homepage: @HOME_URL@
Description: @NAME@ desktop look and defaults
 Wallpapers, logo, fonts and icon choices, the frosted-glass dock and top
 bar, login screen branding, boot splash and boot menu settings for @NAME@.
