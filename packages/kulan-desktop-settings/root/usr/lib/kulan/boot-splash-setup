#!/bin/sh
# Kulan OS boot splash (Plymouth): installs the "kulan" script theme (the
# gathering animation, see kulan.script) and makes it the default.
#
# The splash is loaded from the initramfs; the package asks initramfs-tools
# to rebuild it afterwards, and the ISO build checks the result.
set -eu

THEMES=/usr/share/plymouth/themes
THEME="${THEMES}/kulan"
SRC=/usr/share/kulan/plymouth

for FILE in kulan.plymouth kulan.script watermark.png dot-amber.png dot-mint.png glow.png wordmark.png \
	prompt.png field.png bullet.png; do
	[ -f "${SRC}/${FILE}" ] || { echo "E: ${SRC}/${FILE} missing" >&2; exit 1; }
done
FOUND=""
for SO in /usr/lib/*/plymouth/script.so /usr/lib/plymouth/script.so; do
	[ -f "${SO}" ] && FOUND="${SO}"
done
if [ -z "${FOUND}" ]; then
	echo "W: Plymouth's script module is missing (is plymouth installed?); boot splash not set" >&2
	exit 0
fi

# Rebuild the theme folder in a temporary location, then swap it in, so an
# interrupted update never leaves a half-copied theme. watermark.png stays
# for older checks and tools that look for it.
mkdir -p "${THEMES}"
STAGE="$(mktemp -d "${THEMES}/.kulan.XXXXXX")"
install -m 0644 "${SRC}"/*.png "${SRC}/kulan.script" "${SRC}/kulan.plymouth" "${STAGE}/"
chmod 0755 "${STAGE}"
rm -rf "${THEME}"
mv "${STAGE}" "${THEME}"

# Select it through every mechanism a Plymouth build may use: the config
# file, plymouth-set-default-theme, and the default.plymouth alternative.
mkdir -p /etc/plymouth
printf '[Daemon]\nTheme=kulan\n' > /etc/plymouth/plymouthd.conf

if command -v plymouth-set-default-theme >/dev/null 2>&1; then
	plymouth-set-default-theme kulan
fi

if update-alternatives --query default.plymouth >/dev/null 2>&1; then
	update-alternatives --quiet --install "${THEMES}/default.plymouth" default.plymouth \
		"${THEME}/kulan.plymouth" 200
	update-alternatives --quiet --set default.plymouth "${THEME}/kulan.plymouth"
fi

echo "I: Kulan OS boot splash theme set"
