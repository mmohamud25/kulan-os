#!/bin/sh
# Kulan OS desktop setup: turns on the Kulan GNOME extensions, sets the dock
# apps, compiles the GNOME defaults and configures the login screen.
#
# Run by the kulan-desktop-settings package on install, on update, and when
# extensions or the installer are added or removed. The ISO build runs it
# with KULAN_STRICT=1, which turns a missing required extension into an error.
set -eu

SCHEMAS=/usr/share/glib-2.0/schemas
EXT_DIR=/usr/share/gnome-shell/extensions
OVERRIDE="${SCHEMAS}/90_kulan-os.gschema.override"
GENERATED="${SCHEMAS}/98_kulan-os-generated.gschema.override"
# Kulan Installer when it's there (the live session), else Calamares.
INSTALLER_DESKTOP=org.kulan.Installer.desktop
[ -f "/usr/share/applications/${INSTALLER_DESKTOP}" ] || INSTALLER_DESKTOP=calamares-install-debian.desktop
STRICT="${KULAN_STRICT:-0}"

missing() {
	if [ "${STRICT}" = 1 ]; then
		echo "E: $*" >&2
		exit 1
	fi
	echo "W: $*" >&2
}

# --- Extensions ---------------------------------------------------------------
# Look up each extension's real ID from what the packages installed, so a
# renamed ID in a future Debian release can't silently leave it switched off.
# Format: "<label>:<glob matching the extension folder>:<required|optional>"
EXTENSIONS=""
for SPEC in \
	"dock:dash-to-dock@*:required" \
	"blur:blur-my-shell@*:required" \
	"kulan:kulan-shell@*:required" \
	"tray:*appindicator*@*:optional" \
	"tiling:tiling-assistant@*:optional" \
	"desktop:ding@*:optional" \
	"phone:gsconnect@*:optional"; do
	LABEL="${SPEC%%:*}"
	REST="${SPEC#*:}"
	PATTERN="${REST%%:*}"
	NEED="${REST#*:}"
	FOUND=""
	for DIR in "${EXT_DIR}"/${PATTERN}; do
		[ -f "${DIR}/metadata.json" ] || continue
		FOUND="$(basename "${DIR}")"
		break
	done
	if [ -z "${FOUND}" ]; then
		if [ "${NEED}" = required ]; then
			missing "GNOME extension for '${LABEL}' not found in ${EXT_DIR}"
		else
			echo "W: optional GNOME extension for '${LABEL}' not found; skipping" >&2
		fi
		continue
	fi
	EXTENSIONS="${EXTENSIONS:+${EXTENSIONS}, }'${FOUND}'"

	# An extension that ships its own compiled settings reads those instead of
	# the system ones and would ignore our defaults; recompile its copy with
	# our overrides included.
	if [ -d "${EXT_DIR}/${FOUND}/schemas" ]; then
		cp "${OVERRIDE}" "${EXT_DIR}/${FOUND}/schemas/"
		glib-compile-schemas "${EXT_DIR}/${FOUND}/schemas" 2>/dev/null ||
			echo "W: could not recompile settings for ${FOUND}" >&2
	fi
done

# --- Dock (favorite apps) -----------------------------------------------------
# calamares-settings-debian ships its own list at priority 96, so ours sorts
# after it. The installer launcher is only listed while it exists (live session).
# Ptyxis is the terminal when installed; GNOME's Console is hidden then (it
# stays installed: GNOME needs it) and comes back if Ptyxis is removed.
TERMINAL=org.gnome.Console.desktop
HIDDEN_CONSOLE=/usr/share/kulan/xdg/applications/org.gnome.Console.desktop
if [ -f /usr/share/applications/org.gnome.Ptyxis.desktop ]; then
	TERMINAL=org.gnome.Ptyxis.desktop
	if [ -f /usr/share/applications/org.gnome.Console.desktop ]; then
		mkdir -p "$(dirname "${HIDDEN_CONSOLE}")"
		printf '%s\n' '[Desktop Entry]' '# Kulan OS hides this launcher: Ptyxis is the terminal.' \
			'Type=Application' 'Name=Console' 'Hidden=true' > "${HIDDEN_CONSOLE}"
	fi
else
	rm -f "${HIDDEN_CONSOLE}"
fi
# GNOME Software is the Store: same app, Kulan's name and icon (its
# updates live in Kulan Settings > Software Update). Made from the real
# launcher each time, so changes in GNOME Software's own launcher carry over.
STORE_SRC=/usr/share/applications/org.gnome.Software.desktop
STORE=/usr/share/kulan/xdg/applications/org.gnome.Software.desktop
if [ -f "${STORE_SRC}" ]; then
	mkdir -p "$(dirname "${STORE}")"
	sed -E \
		-e '/^(Name|GenericName|X-GNOME-FullName|Comment|Icon)(\[[^]]*\])?=/d' \
		-e '0,/^\[Desktop Entry\]$/s//[Desktop Entry]\
# Kulan OS: GNOME Software, as the Store.\
Name=Store\
GenericName=App Store\
X-GNOME-FullName=Store\
Comment=Find and install apps, checked for Kulan OS\
Icon=kulan-store/' \
		"${STORE_SRC}" > "${STORE}.tmp"
	chmod 0644 "${STORE}.tmp"
	mv -f "${STORE}.tmp" "${STORE}"
else
	rm -f "${STORE}"
fi

# GNOME Settings is hidden (2.12) while Kulan Settings is there: one Settings
# app in the grid and in search (Kulan Settings' own pages are found there).
# It stays installed, because Kulan Settings opens a few of its pages (Online
# Accounts, Printers, Sharing...) and gnome-control-center <page> still works;
# the gear in the top-right menu opens Kulan Settings (Kulan Shell). A copy
# of the real launcher with NoDisplay=true, not Hidden (which would make the
# app disappear for those pages too). Remade each time; removed with either.
GNOME_SETTINGS_SRC=/usr/share/applications/org.gnome.Settings.desktop
GNOME_SETTINGS=/usr/share/kulan/xdg/applications/org.gnome.Settings.desktop
if [ -f "${GNOME_SETTINGS_SRC}" ] && [ -f /usr/share/applications/org.kulan.Settings.desktop ]; then
	mkdir -p "$(dirname "${GNOME_SETTINGS}")"
	awk '
		/^\[/ { main = ($0 == "[Desktop Entry]") }
		main && /^\[Desktop Entry\]$/ { print; print "# Kulan OS: hidden; Kulan Settings is the Settings app."; print "NoDisplay=true"; next }
		main && /^NoDisplay=/ { next }
		{ print }
	' "${GNOME_SETTINGS_SRC}" > "${GNOME_SETTINGS}.tmp"
	chmod 0644 "${GNOME_SETTINGS}.tmp"
	mv -f "${GNOME_SETTINGS}.tmp" "${GNOME_SETTINGS}"
else
	rm -f "${GNOME_SETTINGS}"
fi

# Short names for apps whose full names are cut off under their icons
# ("LibreOffice ...", "GNU Image ..."). Copies of the real launchers with only
# the English name changed (translations, search words and actions stay; the
# full name stays as X-GNOME-FullName). Remade each time, and removed when the
# app is.
SHORT_DIR=/usr/share/kulan/xdg/applications
SHORT_MARK='# Kulan OS: the same launcher with a short name.'
for SPEC in \
	"libreoffice-writer.desktop:Writer" \
	"libreoffice-calc.desktop:Calc" \
	"libreoffice-impress.desktop:Impress" \
	"libreoffice-draw.desktop:Draw" \
	"libreoffice-math.desktop:Math" \
	"libreoffice-base.desktop:Base" \
	"gimp.desktop:GIMP" \
	"vlc.desktop:VLC" \
	"simple-scan.desktop:Scanner" \
	"org.gnome.SimpleScan.desktop:Scanner" \
	"org.gnome.Evince.desktop:PDF Viewer" \
	"org.gnome.Papers.desktop:PDF Viewer" \
	"org.gnome.Ptyxis.desktop:Terminal" \
	"org.gnome.baobab.desktop:Disk Usage" \
	"gufw.desktop:Firewall"; do
	ID="${SPEC%%:*}"
	SHORT="${SPEC#*:}"
	SRC="/usr/share/applications/${ID}"
	DST="${SHORT_DIR}/${ID}"
	if [ ! -f "${SRC}" ]; then
		if [ -f "${DST}" ] && grep -qxF "${SHORT_MARK}" "${DST}"; then
			rm -f "${DST}"
		fi
		continue
	fi
	mkdir -p "${SHORT_DIR}"
	awk -v short="${SHORT}" -v mark="${SHORT_MARK}" '
		/^\[/ { main = ($0 == "[Desktop Entry]") }
		main && /^\[Desktop Entry\]$/ { print; print mark; next }
		main && /^Name=/ && !named { print "Name=" short; print "X-GNOME-FullName=" substr($0, 6); named = 1; next }
		main && /^X-GNOME-FullName=/ { next }
		{ print }
	' "${SRC}" > "${DST}.tmp"
	chmod 0644 "${DST}.tmp"
	mv -f "${DST}.tmp" "${DST}"
done

# Tor Browser through Kulan's start script (it says when the first-time
# download can't happen because there's no internet). Remade each time from
# the real launcher; removed with it.
TOR_SRC=/usr/share/applications/torbrowser.desktop
TOR=/usr/share/kulan/xdg/applications/torbrowser.desktop
if [ -f "${TOR_SRC}" ]; then
	mkdir -p "$(dirname "${TOR}")"
	awk '
		/^\[/ { main = ($0 == "[Desktop Entry]") }
		main && /^\[Desktop Entry\]$/ { print; print "# Kulan OS: Tor Browser through /usr/lib/kulan/torbrowser-start."; next }
		main && /^Exec=/ { sub(/^Exec=[^ ]*/, "Exec=/usr/lib/kulan/torbrowser-start"); print; next }
		main && /^TryExec=/ { next }
		{ print }
	' "${TOR_SRC}" > "${TOR}.tmp"
	chmod 0644 "${TOR}.tmp"
	mv -f "${TOR}.tmp" "${TOR}"
else
	rm -f "${TOR}"
fi

# KeePassXC's own launcher copy from 2.3 test builds: Qt apps now open
# through XWayland for everyone (environment.d), so it isn't needed.
rm -f /usr/share/kulan/xdg/applications/org.keepassxc.KeePassXC.desktop

# The dock's settings icon opens Kulan Settings (which links to GNOME
# Settings for Wi-Fi, printers and the rest); GNOME's own if it's missing.
SETTINGS=org.gnome.Settings.desktop
if [ -f /usr/share/applications/org.kulan.Settings.desktop ]; then
	SETTINGS=org.kulan.Settings.desktop
fi
FAVORITES="'firefox-esr.desktop', 'org.gnome.Nautilus.desktop', '${TERMINAL}', 'org.gnome.TextEditor.desktop', 'org.gnome.Software.desktop', '${SETTINGS}'"
if [ -f "/usr/share/applications/${INSTALLER_DESKTOP}" ]; then
	FAVORITES="'${INSTALLER_DESKTOP}', ${FAVORITES}"
fi

TMP="$(mktemp "${GENERATED}.XXXXXX")"
cat > "${TMP}" <<EOF
# Generated by /usr/lib/kulan/desktop-setup - do not edit; changes are overwritten.
[org.gnome.shell]
enabled-extensions=[${EXTENSIONS}]
favorite-apps=[${FAVORITES}]
EOF
chmod 0644 "${TMP}"
mv -f "${TMP}" "${GENERATED}"
rm -f "${SCHEMAS}/98_kulan-os-favorites.gschema.override"

# Unknown keys only warn (they differ between GNOME releases); syntax errors fail.
glib-compile-schemas "${SCHEMAS}"

# --- Login screen (GDM) -------------------------------------------------------
PROFILE=/etc/dconf/profile/gdm
if [ ! -f "${PROFILE}" ] || ! grep -qx 'system-db:gdm' "${PROFILE}"; then
	mkdir -p /etc/dconf/profile
	{
		echo 'user-db:user'
		echo 'system-db:gdm'
		if [ -f /usr/share/gdm/greeter-dconf-defaults ]; then
			echo 'file-db:/usr/share/gdm/greeter-dconf-defaults'
		fi
	} > "${PROFILE}"
fi
if command -v dconf >/dev/null 2>&1; then
	dconf update
fi

echo "I: Kulan OS desktop defaults applied (extensions: ${EXTENSIONS})"
