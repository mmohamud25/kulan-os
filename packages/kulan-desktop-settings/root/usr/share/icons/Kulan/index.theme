[Icon Theme]
Name=Kulan
Comment=Kulan OS folders, with GNOME's Adwaita icons for everything else
Inherits=Adwaita,hicolor
Directories=scalable/places,scalable/mimetypes

[scalable/places]
Context=Places
Size=128
MinSize=8
MaxSize=512
Type=Scalable

[scalable/mimetypes]
Context=MimeTypes
Size=128
MinSize=8
MaxSize=512
Type=Scalable
