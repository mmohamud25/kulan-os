# Kulan OS start-up screen (Plymouth script theme).
#
# The six dots of the gathering walk in from a wide circle and meet around
# the centre, which lights up with a soft glow; "Kulan OS" fades in. While the
# computer keeps starting, the ring gently breathes. Shutting down and
# restarting show the gathered ring straight away.
#
# The disk password (encrypted installs) is asked under the ring: a field with
# one dot per character typed. Images are drawn by scripts/render-assets.py
# and scaled here to the screen, so the ring looks the same on every display.

Window.SetBackgroundTopColor(0.016, 0.043, 0.086);     # #040B16
Window.SetBackgroundBottomColor(0.031, 0.102, 0.200);  # #081A33

W = Window.GetWidth();
H = Window.GetHeight();
CX = Window.GetX() + W / 2;
CY = Window.GetY() + H * 0.42;
# One unit = 1/1000 of the screen's smaller side.
if (W < H) U = W / 1000; else U = H / 1000;

RING = 60 * U;          # radius of the gathered ring
START = 230 * U;        # where the dots start walking from
DOT = 32 * U;           # dot diameter
CENTRE = 42 * U;        # centre dot diameter
GLOW = 190 * U;

fun scaled(name, size) {
    image = Image(name);
    return image.Scale(size, size * image.GetHeight() / image.GetWidth());
}

amber = scaled("dot-amber.png", DOT);
mint = scaled("dot-mint.png", DOT);
for (i = 0; i < 6; i++) {
    if (i % 2 == 0) dots[i] = Sprite(amber); else dots[i] = Sprite(mint);
    dots[i].SetOpacity(0);
    dots[i].SetZ(10);
}
glow = Sprite(scaled("glow.png", GLOW));
glow.SetPosition(CX - GLOW / 2, CY - GLOW / 2, 5);
glow.SetOpacity(0);
centre_image = scaled("dot-mint.png", CENTRE);
centre = Sprite(centre_image);
centre.SetPosition(CX - CENTRE / 2, CY - CENTRE / 2, 11);
centre.SetOpacity(0);
wordmark_image = scaled("wordmark.png", 300 * U);
wordmark = Sprite(wordmark_image);
wordmark.SetPosition(CX - wordmark_image.GetWidth() / 2, CY + 130 * U, 10);
wordmark.SetOpacity(0);

fun ease(x) {
    if (x < 0) x = 0;
    if (x > 1) x = 1;
    return x * x * (3 - 2 * x);
}

mode = Plymouth.GetMode();
if (mode == "boot" || mode == "resume") frame = 0; else frame = 50;   # skip the walk-in
FPS = 50;

fun refresh() {
    t = frame / FPS;                       # seconds
    walk = ease(t / 1.4);                  # the dots walk in over 1.4 s
    lit = ease((t - 1.1) / 0.6);           # then the centre and the name appear
    breathe = 0;
    if (t > 1.7) breathe = (1 - Math.Cos((t - 1.7) * Math.Pi * 2 / 3.0)) / 2;   # 3 s breaths
    r = RING * (1 - 0.06 * breathe) + (START - RING) * (1 - walk);
    for (i = 0; i < 6; i++) {
        a = (-90 + i * 60) * Math.Pi / 180;
        dots[i].SetPosition(CX + r * Math.Cos(a) - DOT / 2, CY + r * Math.Sin(a) - DOT / 2, 10);
        dots[i].SetOpacity(0.25 + 0.75 * walk);
    }
    centre.SetOpacity(lit);
    glow.SetOpacity(lit * (0.55 + 0.45 * breathe));
    wordmark.SetOpacity(lit);
    global.frame++;
}
Plymouth.SetRefreshFunction(refresh);

# --- Disk password -------------------------------------------------------------
prompt_image = scaled("prompt.png", 560 * U);
prompt = Sprite(prompt_image);
prompt.SetPosition(CX - prompt_image.GetWidth() / 2, CY + 210 * U, 20);
prompt.SetOpacity(0);
field_image = scaled("field.png", 360 * U);
field = Sprite(field_image);
FIELD_X = CX - field_image.GetWidth() / 2;
FIELD_Y = CY + 250 * U;
field.SetPosition(FIELD_X, FIELD_Y, 20);
field.SetOpacity(0);
BULLET = 12 * U;
bullet_image = scaled("bullet.png", BULLET);
for (i = 0; i < 40; i++) {
    bullets[i] = Sprite(bullet_image);
    bullets[i].SetOpacity(0);
}

fun show_entry(count) {
    prompt.SetOpacity(1);
    field.SetOpacity(1);
    shown = count;
    if (shown > 40) shown = 40;
    gap = BULLET * 1.6;
    left = CX - (shown * gap) / 2 + (gap - BULLET) / 2;
    for (i = 0; i < 40; i++) {
        if (i < shown) {
            bullets[i].SetPosition(left + i * gap, FIELD_Y + field_image.GetHeight() / 2 - BULLET / 2, 21);
            bullets[i].SetOpacity(1);
        } else {
            bullets[i].SetOpacity(0);
        }
    }
}

fun display_password(prompt_text, count) {
    show_entry(count);
}
Plymouth.SetDisplayPasswordFunction(display_password);

fun display_question(prompt_text, entry) {
    show_entry(0);
}
Plymouth.SetDisplayQuestionFunction(display_question);

fun display_normal() {
    prompt.SetOpacity(0);
    field.SetOpacity(0);
    for (i = 0; i < 40; i++) bullets[i].SetOpacity(0);
}
Plymouth.SetDisplayNormalFunction(display_normal);
