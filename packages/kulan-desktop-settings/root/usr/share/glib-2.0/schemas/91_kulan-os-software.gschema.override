# Kulan OS: updates live in one place, Kulan Settings > Software Update
# (Debian, Kulan and app updates together). GNOME Software stays the app
# store: its Updates page, background downloads and update notifications are
# off, so nothing is updated twice or announced twice.
[org.gnome.software]
allow-updates=false
download-updates=false
download-updates-notify=false
# Kulan's own apps (kulan-apps) and picks (kulan-picks) come from Kulan, not a
# third party; Debian's catalogue stays official too.
official-repos=['debian-*', 'kulan-*']
# Kulan's picks and Kulan's own apps get their own section on the Explore
# page (GNOME Software 47 and later; apps marked GnomeSoftware::DeploymentFeatured).
deployment-featured=['Kulan']
