# Kulan OS desktop defaults. Users can change all of these in Settings.
# (Enabled extensions and dock apps live in 98_kulan-os-generated.gschema.override,
#  generated at build time from what is actually installed.)

[org.gnome.desktop.background]
picture-uri='file:///usr/share/backgrounds/kulan/kulan-light.png'
picture-uri-dark='file:///usr/share/backgrounds/kulan/kulan-dark.png'
picture-options='zoom'
primary-color='#040B16'

[org.gnome.desktop.screensaver]
picture-uri='file:///usr/share/backgrounds/kulan/kulan-dark.png'
picture-options='zoom'
primary-color='#040B16'
# Lock as soon as the screen blanks (after 5 minutes idle, or the lid closes).
lock-enabled=true
lock-delay=uint32 0

[org.gnome.desktop.session]
idle-delay=uint32 300

# Location services stay off until an app asks and you turn them on.
[org.gnome.system.location]
enabled=false

[org.gnome.desktop.interface]
color-scheme='prefer-dark'
accent-color='teal'
# Kulan folders (teal, with symbols); GNOME's Adwaita icons for everything else.
icon-theme='Kulan'
# Older (GTK 3) apps: adw-gtk3 with the accent colour, so they look like the
# rest (Kulan Shell keeps it on the chosen accent and light or dark).
gtk-theme='Kulan-teal'
cursor-theme='Bibata-Modern-Classic'
font-name='Inter 11'
document-font-name='Inter 11'
monospace-font-name='JetBrains Mono 11'
font-antialiasing='grayscale'
font-hinting='slight'
clock-show-weekday=true
show-battery-percentage=true

# macOS-style: close, minimise, maximise on the left.
[org.gnome.desktop.wm.preferences]
button-layout='close,minimize,maximize:appmenu'
titlebar-font='Inter Semi-Bold 11'

# Kulan's own soft chimes for notifications, alerts, devices and screenshots
# (scripts/render-sounds.py). Anything it doesn't define comes from the
# standard freedesktop sounds.
[org.gnome.desktop.sound]
theme-name='kulan'

[org.gnome.desktop.peripherals.touchpad]
tap-to-click=true
natural-scroll=true

[org.gnome.mutter]
center-new-windows=true
# Fractional scaling (125%, 150%, 175%) in Settings > Displays, sharp in
# older X11 apps too.
experimental-features=['scale-monitor-framebuffer', 'xwayland-native-scaling']

# --- Mac-style shortcuts (in UTM on a Mac, Command is the Super key) ---------
# Cmd+Space: Spotlight search (Kulan Shell, org.kulan.desktop
# search-shortcut). Input sources move to Ctrl+Alt+Space so Cmd+Space is free.
[org.gnome.shell.keybindings]
# Cmd+Shift+3: whole screen. Cmd+Shift+4: pick an area or window.
# Cmd+Shift+5: record the screen. The Print key keeps working too.
screenshot=['<Shift>Print', '<Shift><Super>3']
show-screenshot-ui=['Print', '<Shift><Super>4']
show-screen-recording-ui=['<Ctrl><Shift><Alt>R', '<Shift><Super>5']

[org.gnome.desktop.wm.keybindings]
switch-input-source=['XF86Keyboard', '<Control><Alt>space']
switch-input-source-backward=['<Shift>XF86Keyboard', '<Shift><Control><Alt>space']

# Emoji and symbols (Ctrl+Cmd+Space); defined in
# /etc/dconf/db/local.d/20-kulan-shortcuts.
[org.gnome.settings-daemon.plugins.media-keys]
custom-keybindings=['/org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/kulan-emoji/']

# Files: large icons, folders first, "Delete permanently" and "Create link"
# in the menu, readable dates such as "Yesterday 14:05".
[org.gnome.nautilus.preferences]
default-folder-viewer='icon-view'
show-delete-permanently=true
show-create-link=true
date-time-format='simple'

[org.gnome.nautilus.icon-view]
default-zoom-level='large'

[org.gtk.gtk4.Settings.FileChooser]
sort-directories-first=true

[org.gtk.Settings.FileChooser]
sort-directories-first=true

# Terminal (Ptyxis): Kulan colours (light and dark follow the system), the
# system monospace font (JetBrains Mono), a roomier default size.
[org.gnome.Ptyxis]
default-columns=100
default-rows=28
toast-on-copy-clipboard=true

[org.gnome.Ptyxis.Profile]
palette='Kulan'

# Files on the desktop (Desktop Icons NG), Mac-style: they start at the top
# right with drives first; no Home or Bin icons (they're in the dock and Files).
[org.gnome.shell.extensions.ding]
show-home=false
show-trash=false
show-volumes=true
add-volumes-opposite=false
start-corner='top-right'
icon-size='standard'

# Window snapping: drag a window to an edge or corner for halves and quarters,
# with a small gap, like macOS. No popup offering other windows.
[org.gnome.shell.extensions.tiling-assistant]
enable-tiling-popup=false
window-gap=8
single-screen-gap=8
maximize-with-gap=false

# Floating, translucent dock with running-app dots.
[org.gnome.shell.extensions.dash-to-dock]
dock-position='BOTTOM'
dock-fixed=true
intellihide=true
extend-height=false
# Calmer dock: smaller icons, quick show and hide, no bounce on launch.
dash-max-icon-size=40
custom-theme-shrink=true
animation-time=0.125
show-delay=0.125
hide-delay=0.25
pressure-threshold=80.0
transparency-mode='FIXED'
background-opacity=0.35
running-indicator-style='DOTS'
# The Bin at the end of the dock, as on a Mac.
show-trash=true
show-mounts=false
show-apps-at-top=false
# Cmd+Shift+3/4/5 are screenshots (see above), not "new window of dock app 3/4/5".
app-shift-hotkey-3=@as []
app-shift-hotkey-4=@as []
app-shift-hotkey-5=@as []

# Privacy: clear old trash and temporary files after 30 days; never send
# usage or crash reports.
[org.gnome.desktop.privacy]
remove-old-trash-files=true
remove-old-temp-files=true
old-files-age=uint32 30
report-technical-problems=false
send-software-usage-stats=false

# The Kulan OS welcome app replaces GNOME's own first-login tour popup.
[org.gnome.shell]
welcome-dialog-last-shown-version='999'
