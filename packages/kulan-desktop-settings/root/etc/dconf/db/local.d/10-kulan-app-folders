# Kulan OS app grid folders. These are defaults: users can rename,
# rearrange or remove folders, and their changes are kept.
# Compiled by "dconf update" (run by the kulan-desktop-settings package).

[org/gnome/desktop/app-folders]
folder-children=['Kulan-Office', 'Kulan-Internet', 'Kulan-Media', 'Kulan-Developer', 'Kulan-Utilities', 'Kulan-System']

[org/gnome/desktop/app-folders/folders/Kulan-Office]
name='Office'
translate=false
categories=['Office']

[org/gnome/desktop/app-folders/folders/Kulan-Internet]
name='Internet'
translate=false
categories=['Network', 'WebBrowser', 'Email', 'Chat', 'InstantMessaging']
excluded-apps=['org.gnome.Software.desktop']

[org/gnome/desktop/app-folders/folders/Kulan-Media]
name='Media'
translate=false
categories=['AudioVideo', 'Audio', 'Video', 'Graphics', 'Photography']
excluded-apps=['org.gnome.Evince.desktop', 'org.gnome.Papers.desktop']

[org/gnome/desktop/app-folders/folders/Kulan-Developer]
name='Developer'
translate=false
categories=['Development', 'IDE']

[org/gnome/desktop/app-folders/folders/Kulan-Utilities]
name='Utilities'
translate=false
categories=['Utility', 'Accessories']
excluded-apps=['org.gnome.TextEditor.desktop', 'org.gnome.Calculator.desktop']

[org/gnome/desktop/app-folders/folders/Kulan-System]
name='System'
translate=false
categories=['System', 'Settings', 'Security', 'PackageManager', 'Monitor']
excluded-apps=['org.gnome.Settings.desktop', 'org.gnome.Console.desktop', 'org.kulan.Welcome.desktop']
