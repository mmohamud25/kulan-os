# Kulan OS app grid folders. Everyday apps (office, internet, media,
# developer tools) sit loose in the grid; only Utilities and System are
# folders. These are defaults: users can rename, rearrange or remove folders,
# and their changes are kept.
# Compiled by "dconf update" (run by the kulan-desktop-settings package).

[org/gnome/desktop/app-folders]
folder-children=['Kulan-Utilities', 'Kulan-System']

[org/gnome/desktop/app-folders/folders/Kulan-Utilities]
name='Utilities'
translate=false
categories=['Utility', 'Accessories']
excluded-apps=['org.gnome.TextEditor.desktop', 'org.gnome.Calculator.desktop']

[org/gnome/desktop/app-folders/folders/Kulan-System]
name='System'
translate=false
categories=['System', 'Settings', 'Security', 'PackageManager', 'Monitor']
excluded-apps=['org.gnome.Settings.desktop', 'org.gnome.Console.desktop', 'org.gnome.Ptyxis.desktop', 'org.kulan.Welcome.desktop']
