#!/bin/sh
set -e

# shellcheck source=../../../kulan.conf
. /usr/share/kulan/kulan.conf

case "$1" in
	configure)
		# /etc/os-release must stay a relative symlink to the packaged file.
		ln -sfn ../usr/lib/os-release /etc/os-release

		# CI boot test report (does nothing unless the kernel is started
		# with kulan.boot-report).
		deb-systemd-helper enable kulan-boot-report.service >/dev/null || true

		# When memory runs out, systemd-oomd closes the app causing it; this
		# says which one, so it doesn't just disappear.
		deb-systemd-helper enable kulan-oom-notice.service >/dev/null || true
		# Lighter mode: decided at every start (on by itself under 5 GB).
		deb-systemd-helper enable kulan-lighter-mode.service >/dev/null || true
		if [ -d /run/systemd/system ]; then
			systemctl --system daemon-reload >/dev/null 2>&1 || true
			deb-systemd-invoke restart kulan-oom-notice.service >/dev/null 2>&1 || true
		fi

		# Kulan Fleet (2.9a): a computer that has joined listens for "report
		# now" (the listener is enabled at its next report); after an update a
		# running listener restarts with the new code.
		if [ -d /run/systemd/system ]; then
			systemctl --system daemon-reload >/dev/null 2>&1 || true
			deb-systemd-invoke try-restart kulan-fleet-listen.service >/dev/null 2>&1 || true
		fi

		# Kernel hardening (no loading another kernel) everywhere, and fast
		# restart in ARM VMs, where a normal restart freezes (UTM on Apple
		# silicon). The generator takes effect from the next start.
		deb-systemd-helper enable kulan-kexec-guard.service >/dev/null || true
		# An organisation's USB stick: join it once online (does nothing otherwise).
		deb-systemd-helper enable kulan-fleet-autojoin.timer >/dev/null || true
		deb-systemd-helper enable kulan-fast-restart.service >/dev/null || true
		if [ -d /run/systemd/system ]; then
			systemctl --system daemon-reload >/dev/null 2>&1 || true
			deb-systemd-invoke start kulan-fast-restart.service >/dev/null 2>&1 || true
		fi

		# Encrypted disks: a mistyped password at start-up asks again instead
		# of giving up after three tries (cryptsetup's default). Only lines
		# without their own tries= setting; the start-up image is rebuilt.
		# Only disks unlocked with a typed password (key "none" or "-").
		# Done once, so someone who later removes tries=0 keeps their choice.
		if [ ! -e /var/lib/kulan/crypttab-tries-set ] && [ -f /etc/crypttab ] && awk '!/^[[:space:]]*(#|$)/ && ($3 == "none" || $3 == "-") && $4 !~ /(^|,)tries=/ {f=1} END {exit !f}' /etc/crypttab; then
			awk 'BEGIN {OFS="\t"}
				/^[[:space:]]*(#|$)/ {print; next}
				$3 != "none" && $3 != "-" {print; next}
				NF == 3 {print $1, $2, $3, "tries=0"; next}
				NF >= 4 && $4 !~ /(^|,)tries=/ {$4 = $4 ",tries=0"; print; next}
				{print}' /etc/crypttab > /etc/crypttab.kulan-new &&
				chmod --reference=/etc/crypttab /etc/crypttab.kulan-new &&
				mv /etc/crypttab.kulan-new /etc/crypttab &&
				{ dpkg-trigger --no-await update-initramfs 2>/dev/null || update-initramfs -u >/dev/null 2>&1 || true; }
		fi
		mkdir -p /var/lib/kulan && touch /var/lib/kulan/crypttab-tries-set

		# Console login banner (base-files' conffiles, so set here).
		printf '%s %s \\n \\l\n\n' "${KULAN_NAME}" "${KULAN_VERSION}" > /etc/issue
		printf '%s %s\n' "${KULAN_NAME}" "${KULAN_VERSION}" > /etc/issue.net

		# Boot speed: a desktop doesn't need to wait for the network before
		# starting up, and that wait is a known cause of a black screen at
		# boot in virtual machines. Done once (also on systems upgrading to
		# this version), so a user who re-enables it keeps their choice.
		MARK=/var/lib/kulan/network-wait-disabled
		if [ ! -e "${MARK}" ]; then
			for UNIT in NetworkManager-wait-online.service systemd-networkd-wait-online.service; do
				deb-systemd-helper disable "${UNIT}" >/dev/null 2>&1 || true
			done
			mkdir -p /var/lib/kulan
			touch "${MARK}"
		fi

		# cups-browsed listens on the network and isn't needed (CUPS finds
		# modern printers itself); new ISOs leave it out, and systems
		# upgrading have it switched off once. Re-enabling it is respected.
		MARK=/var/lib/kulan/cups-browsed-disabled
		if [ ! -e "${MARK}" ]; then
			if [ -e /lib/systemd/system/cups-browsed.service ] || [ -e /usr/lib/systemd/system/cups-browsed.service ]; then
				deb-systemd-helper disable cups-browsed.service >/dev/null 2>&1 || true
				if [ -d /run/systemd/system ]; then
					deb-systemd-invoke stop cups-browsed.service >/dev/null 2>&1 || true
				fi
			fi
			mkdir -p /var/lib/kulan
			touch "${MARK}"
		fi

		# Kulan Fleet two-step sign-in (2.8d): the group and the PAM profile.
		# Nobody is asked for a second step until they set one up in a
		# Fleet organisation, so this changes nothing on its own.
		getent group kulan-two-step >/dev/null || groupadd --system kulan-two-step
		mkdir -p /etc/kulan/two-step && chmod 700 /etc/kulan/two-step
		pam-auth-update --package

		# Security defaults: applied on first install only, so a user who
		# later turns the firewall off keeps their choice through updates.
		if [ -z "$2" ]; then
			if [ -f /etc/ufw/ufw.conf ]; then
				sed -i -E 's/^ENABLED=.*/ENABLED=yes/' /etc/ufw/ufw.conf
			fi
			if [ -f /etc/default/ufw ]; then
				sed -i -E \
					-e 's/^DEFAULT_INPUT_POLICY=.*/DEFAULT_INPUT_POLICY="DROP"/' \
					-e 's/^DEFAULT_OUTPUT_POLICY=.*/DEFAULT_OUTPUT_POLICY="ACCEPT"/' \
					-e 's/^DEFAULT_FORWARD_POLICY=.*/DEFAULT_FORWARD_POLICY="DROP"/' \
					/etc/default/ufw
			fi
			deb-systemd-helper enable ufw.service >/dev/null || true
		fi
		;;
	abort-upgrade|abort-remove|abort-deconfigure)
		;;
	*)
		echo "postinst called with unknown argument '$1'" >&2
		exit 1
		;;
esac

exit 0
