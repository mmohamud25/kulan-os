#!/bin/sh
# Hand /usr/lib/os-release back to Debian when kulan-base is removed.
set -e

OS_RELEASE=/usr/lib/os-release

case "$1" in
	purge)
		# Compliance mode's files: back to Debian's own settings.
		rm -f /etc/dconf/db/local.d/50-kulan-compliance /etc/dconf/db/local.d/locks/50-kulan-compliance \
			/etc/security/pwquality.conf.d/50-kulan-compliance.conf /etc/ssh/sshd_config.d/50-kulan-compliance.conf \
			/etc/apt/apt.conf.d/20kulan-compliance-updates /var/lib/kulan/compliance.json
		if command -v dconf >/dev/null 2>&1; then dconf update 2>/dev/null || true; fi
		deb-systemd-helper purge kulan-boot-report.service >/dev/null 2>&1 || true
		deb-systemd-helper purge kulan-oom-notice.service >/dev/null 2>&1 || true
		deb-systemd-helper purge kulan-kexec-guard.service >/dev/null 2>&1 || true
		deb-systemd-helper purge kulan-fast-restart.service >/dev/null 2>&1 || true
		deb-systemd-helper purge kulan-fleet.timer >/dev/null 2>&1 || true
		rm -f /etc/kulan/fleet.json
		rmdir /etc/kulan 2>/dev/null || true
		rm -rf /var/lib/kulan
		;;
	remove|abort-install|disappear)
		if dpkg-divert --list "${OS_RELEASE}" | grep -q 'by kulan-base$'; then
			# Our copy has been removed by dpkg; --rename moves Debian's back.
			dpkg-divert --package kulan-base --remove --rename \
				--divert "${OS_RELEASE}.debian" "${OS_RELEASE}"
		fi
		;;
esac

exit 0
