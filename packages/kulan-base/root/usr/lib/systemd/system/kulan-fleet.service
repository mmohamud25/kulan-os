[Unit]
Description=Report this computer's status to its organisation (Kulan fleet)
ConditionPathExists=/etc/kulan/fleet.json
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/bin/kulan-fleet report
Nice=10
IOSchedulingClass=idle
# On the network: only the address families it needs. (It runs the few
# actions its organisation may ask for, such as installing updates, so the
# system itself can't be read-only.)
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
# Hardening that can't get in the way of what it does.
LockPersonality=yes
RestrictRealtime=yes
SystemCallArchitectures=native
ProtectKernelLogs=yes
ProtectClock=yes
