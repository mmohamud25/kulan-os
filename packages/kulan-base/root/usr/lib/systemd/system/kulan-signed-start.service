[Unit]
Description=Signed start-up: the next step after a restart (Kulan OS)
ConditionPathExists=/var/lib/kulan/signed-start/state.json
# Not while "Undo the last update" (from the start-up menu) puts the system
# back: the undo signs the start-up files itself once it's done.
ConditionKernelCommandLine=!kulan.undo-update
After=local-fs.target kulan-undo-at-start.service

[Service]
Type=oneshot
ExecStart=/usr/bin/kulan-signed-start finish
Nice=10
IOSchedulingClass=idle
# Signing the start-up files again (and removing GRUB, once) takes minutes,
# never this long: a hang can't hold up start-up or shutdown for ever.
TimeoutStartSec=30min

[Install]
WantedBy=multi-user.target
