[Unit]
Description=Join the organisation of the USB stick Kulan OS was installed from (Kulan fleet)
ConditionPathExists=/var/lib/kulan/fleet-join.json
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/lib/kulan/fleet-autojoin
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
LockPersonality=yes
RestrictRealtime=yes
SystemCallArchitectures=native
