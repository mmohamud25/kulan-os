#!/usr/bin/python3 -I
"""At sign-in (Kulan Fleet 2.8e): if your organisation made you a work
mailbox and you haven't connected it, offer to, once a day. Connect opens
Settings › Online Accounts › Google; once the account is there, the mail app
(Geary) opens with it. Nothing otherwise."""
import os
import pwd
import subprocess
import sys
import time
from pathlib import Path

sys.dont_write_bytecode = True
sys.path.insert(0, "/usr/share/kulan-fleet")
try:
    import workmail
    me = pwd.getpwuid(os.getuid())
    mail = workmail.ask_today(me.pw_name, Path(me.pw_dir))
except Exception:  # never in the way of signing in
    sys.exit(0)
if not mail:
    sys.exit(0)

try:
    from gi.repository import Gio, GLib
except ImportError:  # no desktop session here
    sys.exit(0)

try:
    bus = Gio.bus_get_sync(Gio.BusType.SESSION, None)
    (nid,) = bus.call_sync(
        "org.freedesktop.Notifications", "/org/freedesktop/Notifications", "org.freedesktop.Notifications", "Notify",
        GLib.Variant("(susssasa{sv}i)", (
            "Kulan Settings", 0, "mail-unread-symbolic", "Connect your work email",
            f"Your organisation set up {mail['address']} for you. Connect it to get your mail, calendar, "
            "contacts and Google Drive here.",
            ["connect", "Connect", "default", "Connect", "later", "Not now"],
            {"urgency": GLib.Variant("y", 1), "desktop-entry": GLib.Variant("s", "org.kulan.Settings")}, 0)),
        GLib.VariantType("(u)"), Gio.DBusCallFlags.NONE, 10_000, None).unpack()
except GLib.Error:
    sys.exit(0)

loop = GLib.MainLoop()
WAIT_S = 15 * 60  # long enough to sign in to Google, two-step and all


def open_mail_once_connected() -> None:
    """After Connect: when the account appears, open the mail app with it."""
    started = time.monotonic()

    def check() -> bool:
        if workmail.connected(mail, Path(me.pw_dir)):
            try:
                subprocess.Popen(workmail.open_command(mail), stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                                 start_new_session=True)
            except (OSError, AttributeError):
                pass
            loop.quit()
            return False
        if time.monotonic() - started > WAIT_S:
            loop.quit()
            return False
        return True
    GLib.timeout_add_seconds(3, check)


waiting = []  # set once Connect was pressed: the notification closing then doesn't end it


def on_signal(_conn, _sender, _path, _iface, signal, params):
    values = params.unpack()
    if values[0] != nid or waiting:
        return
    if signal == "ActionInvoked" and values[1] in ("connect", "default"):
        try:
            subprocess.Popen(workmail.connect_command(mail), stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                             start_new_session=True)
        except OSError:
            loop.quit()
            return
        if hasattr(workmail, "open_command"):
            waiting.append(True)
            GLib.source_remove(answer_timeout)
            open_mail_once_connected()
            return
    loop.quit()


bus.signal_subscribe("org.freedesktop.Notifications", "org.freedesktop.Notifications", None,
                     "/org/freedesktop/Notifications", None, Gio.DBusSignalFlags.NONE, on_signal)
answer_timeout = GLib.timeout_add_seconds(3600, loop.quit)  # an hour to answer; Kulan Settings has it any time
loop.run()
