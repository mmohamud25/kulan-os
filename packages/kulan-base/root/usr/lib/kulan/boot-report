#!/bin/sh
# Kulan OS boot report, for the automatic boot test in CI. Runs only when the
# kernel command line has "kulan.boot-report" (see kulan-boot-report.service):
# waits for the desktop, then writes a short report to the first serial port.
set -u
OUT=/dev/ttyS0
[ -w "${OUT}" ] || OUT=/dev/console

desktop_user() {
	# The person's session (a regular account, ID 1000 or above), not the
	# login screen's own GNOME Shell.
	for PID in $(pgrep -x gnome-shell); do
		ID="$(stat -c %u "/proc/${PID}" 2>/dev/null)" || continue
		if [ "${ID}" -ge 1000 ] && [ "${ID}" -lt 60000 ]; then
			getent passwd "${ID}" | cut -d: -f1
			return
		fi
	done
}

i=0
while [ "${i}" -lt 300 ]; do
	STATE="$(systemctl is-system-running 2>/dev/null)"
	if [ -n "$(desktop_user)" ] && [ "${STATE}" != starting ] && [ "${STATE}" != initializing ]; then
		break
	fi
	sleep 1
	i=$((i + 1))
done
sleep 5 # let the session settle

{
	echo "KULAN-BOOT-REPORT-BEGIN"
	echo "state=$(systemctl is-system-running 2>/dev/null)"
	echo "desktop_user=$(desktop_user)"
	echo "time=$(systemd-analyze 2>/dev/null | head -n 1)"
	systemctl --failed --no-legend --plain 2>/dev/null | awk '{print "failed=" $1}'
	systemd-analyze blame --no-pager 2>/dev/null | head -n 8 | sed 's/^ */blame=/'
	# What the login screen waited on (the slowest chain to it).
	systemd-analyze critical-chain --no-pager display-manager.service 2>/dev/null | grep -v '^The time' | grep -v '^$' | head -n 10 | sed 's/^[^a-zA-Z0-9]*/chain=/'
	echo "memory=$(free -m | awk '/^Mem:/ {print $3 " MB used of " $2 " MB"}')"
	echo "timezone=$(readlink /etc/localtime 2>/dev/null | sed "s|.*/zoneinfo/||")"
	echo "background=$(systemctl show -p CPUWeight --value apt-daily-upgrade.service 2>/dev/null) $(systemctl is-failed thermald.service 2>/dev/null)"
	echo "swap=$(swapon --show=NAME,SIZE --noheadings 2>/dev/null | tr -s ' ' | tr '\n' ';')"
	# Names through systemd-resolved (Kulan Settings' encrypted DNS), and whether a lookup works.
	echo "dns=$(readlink /etc/resolv.conf 2>/dev/null || echo file) $(systemctl is-active systemd-resolved.service 2>/dev/null) lookup=$(timeout 8 getent hosts deb.debian.org >/dev/null 2>&1 && echo yes || echo no)"
	echo "oomd=$(systemctl is-active systemd-oomd.service 2>/dev/null) $(systemctl is-active kulan-oom-notice.service 2>/dev/null)"
	# Kernel loading switched off (1) on PCs; left on (0) with fast restart
	# set up in ARM VMs, where a normal restart freezes.
	FAST=no
	[ -e /run/systemd/generator/systemd-reboot.service.d/50-kulan-fast-restart.conf ] && FAST=yes
	echo "kexec=$(cat /proc/sys/kernel/kexec_load_disabled 2>/dev/null) ${FAST} $(uname -m)"
	# "no": start-up skipped ldconfig and friends (the image is marked up to date).
	echo "needs_update=$(systemctl show -P ConditionResult ldconfig.service 2>/dev/null)"
	# AppArmor's compiled profiles (made by the installer): the folder this kernel
	# uses, and each folder there with its file count and time (seconds).
	echo "aacache=$(apparmor_parser --print-cache-dir 2>/dev/null) $(for d in /var/cache/apparmor/*/; do [ -d "$d" ] && printf '%s:%s:%s;' "$(basename "$d")" "$(find "$d" -maxdepth 1 -type f | wc -l)" "$(stat -c %Y "$d")"; done) aaload=$(systemctl show -P ExecMainStartTimestampMonotonic apparmor.service 2>/dev/null)"
	# How an encrypted disk was opened (TPM unlock test): systemd-cryptsetup's own words.
	echo "unlock=$(journalctl -b -o cat -t systemd-cryptsetup 2>/dev/null | grep -m1 -iE 'tpm2|token' | cut -c1-200)"
	echo "boot_id=$(cat /proc/sys/kernel/random/boot_id 2>/dev/null)"
	# How it started (signed start-up test): systemd-boot's image, systemd-stub's
	# word (a signed start-up file), Secure Boot, and kulan-signed-start's step.
	V=/sys/firmware/efi/efivars
	G=4a67b082-0a4c-41cf-b6c7-440b29bb8c4f
	efitext() { [ -r "$1" ] && cat "$1" | tail -c +5 | tr -d '\000' | tr -c '[:print:]' ' '; }
	echo "loader=$(efitext "${V}/LoaderImageIdentifier-${G}") stub=$(efitext "${V}/StubInfo-${G}" | cut -c1-40) secureboot=$(od -An -tu1 "${V}/SecureBoot-8be4df61-93ca-11d2-aa0d-00e098032b8c" 2>/dev/null | awk '{print $NF}') signedstart=$(kulan-signed-start status 2>/dev/null | head -n 1 | cut -c1-80)"
	# Kulan's sandboxed services still do their job: the status service
	# itself, and app updates' lookup under the same sandbox settings (the
	# service skips the live session, so it's run through systemd-run).
	systemctl start kulan-update-status.service 2>/dev/null
	echo "statusservice=$(systemctl show -P Result kulan-update-status.service 2>/dev/null) $(stat -c %Y /var/lib/kulan/updates.json 2>/dev/null)"
	# Kulan Shell really running in the person's desktop (state 1 = active;
	# a JavaScript error shows as state 3 with the error).
	SHELL_EXT=""
	U="$(desktop_user)"
	if [ -n "${U}" ]; then
		UID_="$(id -u "${U}")"
		SHELL_EXT="$(runuser -u "${U}" -- env DBUS_SESSION_BUS_ADDRESS="unix:path=/run/user/${UID_}/bus" \
			timeout 10 gdbus call --session --dest org.gnome.Shell --object-path /org/gnome/Shell \
			--method org.gnome.Shell.Extensions.GetExtensionInfo kulan-shell@kulangroup.com 2>&1 |
			grep -oE "'(state|error)': <[^>]*>" | tr '\n' ' ' | cut -c1-300)"
	fi
	echo "kulanshell=${SHELL_EXT}"
	# A window that asks to be bigger than the screen opens to fit it, above the
	# dock (Kulan Shell's windowfit.js): its size and the screen's.
	FIT=""
	if [ -n "${U}" ]; then
		FIT="$(runuser -u "${U}" -- env XDG_RUNTIME_DIR="/run/user/${UID_}" WAYLAND_DISPLAY=wayland-0 GDK_BACKEND=wayland \
			DBUS_SESSION_BUS_ADDRESS="unix:path=/run/user/${UID_}/bus" timeout 60 python3 -I -c '
import gi
gi.require_version("Gtk", "4.0")
from gi.repository import GLib, Gtk
app = Gtk.Application(application_id="org.kulan.BootReportFit")
def report(win):
    g = win.get_display().get_monitor_at_surface(win.get_surface()).get_geometry()
    print(win.get_width(), win.get_height(), g.width, g.height, flush=True)
    app.quit()
    return False
def activate(a):
    win = Gtk.ApplicationWindow(application=a, title="Kulan fit test")
    win.set_default_size(5000, 5000)
    win.present()
    GLib.timeout_add(4000, report, win)
app.connect("activate", activate)
app.run([])
' 2>/tmp/kulan-fit.err | tail -n 1)"
		[ -n "${FIT}" ] || FIT="none: $(tail -n 2 /tmp/kulan-fit.err 2>/dev/null | tr '\n' ' ' | cut -c1-200)"
		rm -f /tmp/kulan-fit.err
	fi
	echo "windowfit=${FIT}"
	# Lighter mode (on by itself under 5 GB): the flag, and file search
	# really running at the lowest priority in the person's session.
	LIGHT=off
	[ -e /run/kulan/lighter-mode ] && LIGHT=on
	SEARCH_NICE=""
	if [ -n "$(desktop_user)" ]; then
		SEARCH_NICE="$(systemctl --user --machine="$(desktop_user)@" show -P Nice localsearch-3.service 2>/dev/null)"
	fi
	echo "lighter=${LIGHT} $(systemctl show -P Result kulan-lighter-mode.service 2>/dev/null) search_nice=${SEARCH_NICE:-?} mem_kib=$(awk '/^MemTotal:/ {print $2}' /proc/meminfo)"
	# On an installed system (the install test), once: a restore point
	# through the sandboxed service, the way the daily timer takes one.
	if grep -qw 'kulan.restart-test' /proc/cmdline && [ -f /usr/lib/systemd/system/kulan-restore-points.service ] &&
		[ ! -e /var/lib/kulan/boot-report-restore-point ]; then
		mkdir -p /var/lib/kulan && touch /var/lib/kulan/boot-report-restore-point
		timeout 1200 systemctl start kulan-restore-points.service 2>/dev/null
		echo "restorepoint=$(systemctl show -P Result kulan-restore-points.service 2>/dev/null) $(find /timeshift/snapshots -mindepth 1 -maxdepth 1 -type d 2>/dev/null | wc -l)"
		# The one Software Update takes before installing updates (the
		# same command update-run runs), and its free-space check.
		BEFORE="$(find /timeshift/snapshots -mindepth 1 -maxdepth 1 -type d 2>/dev/null | wc -l)"
		timeout 1200 /usr/lib/kulan/restore-points create "Before installing updates" >/tmp/kulan-rp.log 2>&1
		RC=$?
		echo "updatepoint=${RC} $(( $(find /timeshift/snapshots -mindepth 1 -maxdepth 1 -type d 2>/dev/null | wc -l) - BEFORE )) $(tail -n 2 /tmp/kulan-rp.log | tr '\n' ' ' | cut -c1-200)"
		SPACE="$(bash -c 'set -euo pipefail; APT_LOCK=(-o DPkg::Lock::Timeout=60); die() { echo "die: $*"; exit 3; }
			ROOM_PROBLEM=""; run_apt() { :; }
			for f in check_space room_for_updates room_for_kernel free_mb remove_old_kernels; do
				eval "$(sed -n "/^${f}() {/,/^}/p" /usr/lib/kulan/update-run)"
			done
			eval "$(grep -E "^KERNEL_(BOOT|ESP)_MB=" /usr/lib/kulan/update-run)"
			check_space --with-new-pkgs upgrade && echo ok' 2>&1 | tail -n 1 | cut -c1-200)"
		echo "spacecheck=${SPACE}"
	fi
	UNIT=/usr/lib/systemd/system/kulan-app-updates.service
	if [ -f "${UNIT}" ] && command -v systemd-run >/dev/null 2>&1; then
		PROPS="$(mktemp)"
		sed -n '/^\[Service\]/,/^\[/p' "${UNIT}" |
			grep -E '^(Protect|Private|Restrict|Lock|SystemCall|NoNew|Capability|ReadWrite)' > "${PROPS}"
		set --
		while IFS= read -r PROP; do
			set -- "$@" -p "${PROP}"
		done < "${PROPS}"
		rm -f "${PROPS}"
		OUTPUT="$(timeout 120 systemd-run --wait --collect --pipe --quiet "$@" /usr/lib/kulan/app-updates list 2>&1)"
		echo "appsandbox=$? $(printf '%s' "${OUTPUT}" | grep -iE 'read-only|permission denied|operation not permitted' | head -n 1 | cut -c1-150)"
	fi
	if command -v flatpak >/dev/null 2>&1; then
		if timeout 60 flatpak remote-ls --system --updates --columns=ref,name,version >/dev/null 2>/tmp/kulan-flatpak.err; then
			echo "appupdates=ok"
		else
			echo "appupdates=$(tail -n 1 /tmp/kulan-flatpak.err)"
		fi
	fi
	# Debian's package servers (2.14: HTTPS) and whether the update check
	# works with them (last: it keeps a small computer busy for a while) (into a folder of its own; the real lists are untouched).
	# Only Debian's sources are checked (the test's own update channel may
	# not be reachable from the test machine).
	LISTS="$(mktemp -d)" && mkdir -p "${LISTS}/partial" "${LISTS}/parts"
	for f in /etc/apt/sources.list.d/*.list /etc/apt/sources.list.d/*.sources; do
		[ -f "$f" ] && grep -q 'debian\.org' "$f" && cp "$f" "${LISTS}/parts/"
	done
	echo "aptsources=$(cat /etc/apt/sources.list "${LISTS}"/parts/* 2>/dev/null | grep -v '^[[:space:]]*#' | grep -oE 'https?://[a-z.]*debian\.org[^[:space:]]*' | sort -u | tr '\n' ' ')"
	echo "aptcheck=$(timeout 120 apt-get -q -o Dir::State::Lists="${LISTS}" -o Dir::Etc::SourceParts="${LISTS}/parts" -o Dir::Cache::pkgcache= -o Dir::Cache::srcpkgcache= update >"${LISTS}/log" 2>&1 && ! grep -q '^[WE]:' "${LISTS}/log" && echo ok || echo "failed: $(grep -m2 '^[WE]:' "${LISTS}/log" | tr '\n' ' ' | cut -c1-200)")"
	rm -rf "${LISTS}"
	echo "KULAN-BOOT-REPORT-END"
} > "${OUT}" 2>&1

# Install test (ci/install-test.sh): restart once, so the second start's
# report shows the system comes back after a restart.
MARK=/var/lib/kulan/restart-test-done
if grep -qw kulan.restart-test /proc/cmdline && [ ! -e "${MARK}" ]; then
	mkdir -p /var/lib/kulan && touch "${MARK}" && sync
	systemctl reboot
fi
