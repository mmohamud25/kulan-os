#!/usr/bin/python3
"""Kulan OS fleet management, the computer's side.

  kulan-fleet status [--json]          joined or not, and what is shared (no root needed)
  kulan-fleet join SERVER [--allow-erase]  join an organisation; the one-time code on stdin (root)
  kulan-fleet report                   send this computer's status now (root; hourly by timer)
  kulan-fleet allow-erase on|off       let the organisation erase this computer if it's lost (root)
  kulan-fleet leave                    stop reporting and forget the organisation (root)

A joined computer reports once an hour to its organisation's server over
HTTPS: what it is (model, processor, memory, disk space), what it runs (Kulan
OS version, kernel), whether it's up to date, its compliance and TPM status,
whether the disk is encrypted and the firewall on, and once a day the names
and versions of its apps, and which accounts use it and when each was last
used. Never files, names of files, browsing, messages or passwords.

The server can only answer with these actions, nothing else:
  refresh          report again now
  install-updates  install waiting updates (as Software Update does)
  compliance-on    turn compliance mode on
  lock-screen      lock the screen now
  restart          restart in 5 minutes, with a notice to whoever is using it
  shutdown         switch off in 5 minutes, with the same notice
  lost-mode-on     lost mode: nobody can sign in (the sign-in screen says the
                   computer is lost and whom to tell), and anyone signed in
                   is signed out after a 20-second notice; it keeps reporting,
                   so the organisation can find it and release it
  lost-mode-off    release it from lost mode
  install-app      install one app now (a Debian package or a Flathub app)
  erase            make the disk unreadable and switch off: only when this
                   computer's user allowed it (allow-erase on) and the disk is
                   encrypted (its keys are destroyed; nothing can be recovered)

And with the organisation's policy, which this computer keeps to:
  auto_updates          automatic updates on
  firewall              firewall on
  screen_lock_minutes   lock the screen after this many idle minutes (locked
                        setting; compliance mode's stricter one wins)
  require_encryption    reported only: encryption can't be switched on from afar
  usb                   "block": USB storage doesn't work (keyboards, mice and
                        the rest do); "approved": only the drives the
                        organisation approved (usb_drives) work
  required_apps         installed and kept installed
  blocked_apps          removed and kept off (never part of Kulan OS, never
                        when removing it would take other packages with it)
(fleetpolicy.py does USB and apps; leaving takes all of it away, apps stay.)

The protocol (JSON over HTTPS, version 1):
  POST {server}/v1/enrol   {code, hostname, os, kulan_version}
                           -> {device_id, token, organisation}
  POST {server}/v1/report  Authorization: Bearer {token}, {device_id, ...status}
                           -> {actions: [{id, type, payload?}], policy, accounts}
  POST {server}/v1/actions/{id}   {device_id, status: done|failed, detail}
  POST {server}/v1/leave   {device_id}
"""
from __future__ import annotations

import json
import os
import platform
import pwd
import shutil
import socket
import subprocess
import sys
import time
import urllib.error
import urllib.parse
import urllib.request

# People (Fleet accounts) live in their own module; kulan-fleet runs as root,
# so no compiled copies are written next to it.
sys.dont_write_bytecode = True
sys.path.insert(0, "/usr/share/kulan-fleet")
import fleetpolicy  # noqa: E402
import people  # noqa: E402
import signins  # noqa: E402
import twostep  # noqa: E402
import workmail  # noqa: E402
from pathlib import Path

CONFIG = Path("/etc/kulan/fleet.json")            # secret (token): root only
LOCK = Path("/run/kulan/fleet.lock")
PUBLIC = Path("/var/lib/kulan/fleet-public.json")  # what anyone may see
UPDATES = Path("/var/lib/kulan/updates.json")
POLICY_PUBLIC = Path("/var/lib/kulan/fleet-policy.json")  # the policy kept to, for Kulan Settings
APPS_SENT = Path("/var/lib/kulan/fleet-apps-sent")
# An erase that was asked for and allowed: written before the notice, so
# switching the computer off during it doesn't stop the erase (the next
# report, 5 minutes after start-up, finishes it first, online or not).
ERASE_PENDING = Path("/var/lib/kulan/fleet-erase-pending")
ERASE_NOTICE_S = 20
NOTICE = Path("/usr/lib/kulan/oom-notice")  # shows a notification in someone's session
# After compliance mode's 50-kulan-compliance, so this file decides; it holds
# the stricter of the two screen locks (see set_screen_lock).
POLICY_DCONF = Path("/etc/dconf/db/local.d/60-kulan-fleet")
POLICY_LOCKS = Path("/etc/dconf/db/local.d/locks/60-kulan-fleet")
OLD_POLICY_FILES = (Path("/etc/dconf/db/local.d/40-kulan-fleet"), Path("/etc/dconf/db/local.d/locks/40-kulan-fleet"))
COMPLIANCE_DCONF = Path("/etc/dconf/db/local.d/50-kulan-compliance")
DCONF_DB = Path("/etc/dconf/db/local")
ALLOWED_ACTIONS = ("refresh", "install-updates", "compliance-on", "lock-screen", "restart", "shutdown",
                   "lost-mode-on", "lost-mode-off", "install-app", "erase")
# Lost mode: /etc/nologin stops every sign-in but root's (pam_nologin, in
# GDM's and the console's sign-in), and stays across restarts; the sign-in
# screen shows why. Only a nologin file starting with LOST_MARK is ours.
LOST = Path("/var/lib/kulan/fleet-lost")
NOLOGIN = Path("/etc/nologin")
LOST_MARK = "Kulan Fleet lost mode"
LOST_BANNER = Path("/etc/dconf/db/gdm.d/90-kulan-fleet-lost")
LOST_NOTICE_S = 20
SHARED = ["Computer model, processor, memory and disk space", "Kulan OS version and kernel",
          "Waiting updates and whether a restart is needed", "Compliance mode results", "TPM unlock on or off",
          "Disk encryption and firewall on or off", "Names and versions of installed apps (once a day)",
          "Host name and when it last started",
          "For accounts the organisation manages: a scrambled form (hash) of a new password, never the password",
          "If the organisation controls USB drives: the maker, model, serial number and name of drives plugged in "
          "(nothing about what's on them)",
          "Who uses it: each account's username and when it was last used (not what they do)",
          "If you set up two-step sign-in: your security key's public key or your phone code's secret, so it "
          "works on the organisation's other computers you use"]
APPS_EVERY_S = 24 * 3600
MAX_APPS = 3000
TIMEOUT = 30


def run(argv: list[str], timeout: int = 60) -> subprocess.CompletedProcess:
    try:
        return subprocess.run(argv, capture_output=True, text=True, timeout=timeout, check=False,
                              env={**os.environ, "LC_ALL": "C.UTF-8"})
    except (OSError, subprocess.TimeoutExpired) as e:
        return subprocess.CompletedProcess(argv, 127, "", str(e))


def say(text: str) -> None:
    print(text, file=sys.stderr, flush=True)


def need_root() -> None:
    if os.geteuid() != 0:
        sys.exit("kulan-fleet: this needs administrator rights (run it with sudo)")


def read_json(path: Path, default):
    try:
        return json.loads(path.read_text())
    except (OSError, ValueError):
        return default


def write_json(path: Path, data: dict, mode: int) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_name(path.name + ".kulan-new")
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, mode)
    with os.fdopen(fd, "w") as fh:
        fh.write(json.dumps(data, indent=2) + "\n")
    os.chmod(tmp, mode)
    os.replace(tmp, path)


def check_server(server: str) -> str:
    """HTTPS only (plain HTTP just for a server on this computer, for tests)."""
    server = server.strip().rstrip("/")
    parts = urllib.parse.urlsplit(server)
    local = parts.hostname in ("localhost", "127.0.0.1", "::1")
    if parts.scheme != "https" and not (parts.scheme == "http" and local):
        raise ValueError("the server address must start with https://")
    if not parts.hostname:
        raise ValueError("that isn't a server address")
    return server


def post(server: str, path: str, body: dict, token: str | None = None) -> dict:
    headers = {"Content-Type": "application/json", "User-Agent": f"kulan-fleet/1 ({kulan_version()})"}
    if token:
        headers["Authorization"] = f"Bearer {token}"
    request = urllib.request.Request(server + path, data=json.dumps(body).encode(), headers=headers, method="POST")
    try:
        with urllib.request.urlopen(request, timeout=TIMEOUT) as reply:
            text = reply.read(1_000_000).decode("utf-8", "replace")
    except urllib.error.HTTPError as e:
        raise RuntimeError(f"the server said {e.code} {e.reason}") from e
    except (urllib.error.URLError, OSError) as e:
        raise RuntimeError(f"couldn't reach the server: {getattr(e, 'reason', e)}") from e
    try:
        data = json.loads(text) if text.strip() else {}
    except ValueError as e:
        raise RuntimeError("the server's answer wasn't JSON") from e
    if not isinstance(data, dict):
        raise RuntimeError("the server's answer wasn't a JSON object")
    return data


# --- what is reported ------------------------------------------------------------------
def os_release() -> dict:
    info = {}
    try:
        for line in Path("/etc/os-release").read_text().splitlines():
            key, _, value = line.partition("=")
            info[key] = value.strip().strip('"')
    except OSError:
        pass
    return info


def kulan_version() -> str:
    info = os_release()
    return info.get("VERSION_ID", "") + (f" (build {info['BUILD_ID']})" if info.get("BUILD_ID") else "")


def read_text(path: str) -> str:
    try:
        return Path(path).read_text().strip()
    except OSError:
        return ""


def hardware() -> dict:
    memory_kb = 0
    for line in read_text("/proc/meminfo").splitlines():
        if line.startswith("MemTotal:"):
            memory_kb = int(line.split()[1])
    cpu = ""
    for line in read_text("/proc/cpuinfo").splitlines():
        if line.startswith(("model name", "Model")):
            cpu = line.split(":", 1)[1].strip()
            break
    disk = shutil.disk_usage("/")
    return {
        "vendor": read_text("/sys/class/dmi/id/sys_vendor"),
        "model": read_text("/sys/class/dmi/id/product_name"),
        "cpu": cpu or platform.processor(),
        "cpus": os.cpu_count(),
        "arch": platform.machine(),
        "memory_mb": memory_kb // 1024,
        "disk_total_gb": round(disk.total / 1e9, 1),
        "disk_free_gb": round(disk.free / 1e9, 1),
    }


def tool_json(argv: list[str]):
    if not shutil.which(argv[0]):
        return None
    r = run([*argv, "status", "--json"])
    try:
        return json.loads(r.stdout)
    except ValueError:
        return None


def firewall_on() -> bool:
    try:
        enabled = "ENABLED=yes" in Path("/etc/ufw/ufw.conf").read_text().split()
    except OSError:
        return False
    return enabled and run(["systemctl", "is-active", "ufw"]).stdout.strip() == "active"


def auto_updates_on() -> bool:
    return 'Unattended-Upgrade "1"' in run(["apt-config", "dump", "APT::Periodic::Unattended-Upgrade"]).stdout


# Kulan Installer's encrypted layout keeps these unencrypted: start-up files only, no personal files.
NOT_DATA = ("/boot", "/boot/efi", "/efi")
REMOVABLE = ("/media/", "/run/media/", "/mnt/")


def _chain(device: str) -> list[dict] | None:
    """device and everything it sits on (partitions, LVM, RAID, LUKS), flattened."""
    try:
        data = json.loads(run(["lsblk", "-J", "-s", "-p", "-o", "NAME,TYPE,FSTYPE", device]).stdout)
    except ValueError:
        return None
    out: list[dict] = []

    def walk(nodes) -> None:
        for node in nodes or []:
            if isinstance(node, dict):
                out.append(node)
                walk(node.get("children"))
    walk(data.get("blockdevices") if isinstance(data, dict) else None)
    return out or None


def disk_protection() -> tuple[bool, list[str], str]:
    """Whether everything personal on this computer's disks is encrypted.
    Returns (all encrypted, the LUKS partitions holding it, why not). Every
    mounted filesystem except the start-up ones and removable drives, every
    swap that isn't compressed memory, and every LUKS partition in crypttab
    count. One definition, for the report and for erasing."""
    try:
        mounts = json.loads(run(["findmnt", "-J", "-v", "--real", "-o", "SOURCE,TARGET"]).stdout)
    except ValueError:
        return False, [], "couldn't read what's mounted"
    flat: list[dict] = []

    def walk(nodes) -> None:
        for node in nodes or []:
            if isinstance(node, dict):
                flat.append(node)
                walk(node.get("children"))
    walk(mounts.get("filesystems") if isinstance(mounts, dict) else None)
    luks: set[str] = set()
    checked = 0
    for m in flat:
        source, target = str(m.get("source") or ""), str(m.get("target") or "")
        if not source.startswith("/dev/") or source.startswith("/dev/loop") or target in NOT_DATA \
                or target.startswith(REMOVABLE):
            continue
        chain = _chain(source)
        if chain is None:
            return False, [], f"couldn't read the disk layout under {target}"
        found = [n["name"] for n in chain if n.get("fstype") == "crypto_LUKS" and str(n.get("name", "")).startswith("/dev/")]
        if not found:
            return False, [], f"{target} isn't encrypted"
        luks.update(found)
        checked += 1
    if not checked:
        return False, [], "couldn't find the system disk"
    for name in run(["swapon", "--noheadings", "--raw", "--show=NAME"]).stdout.split():
        if name.startswith("/dev/zram"):
            continue
        chain = _chain(name) or []
        if not any(n.get("type") == "crypt" for n in chain):
            return False, [], f"swap {name} isn't encrypted"
        luks.update(n["name"] for n in chain if n.get("fstype") == "crypto_LUKS")
    # Encrypted partitions set to open at start-up (a separate /home, say).
    try:
        lines = Path("/etc/crypttab").read_text().splitlines()
    except OSError:
        lines = []
    for line in lines:
        parts = line.split()
        if len(parts) < 2 or parts[0].startswith("#"):
            continue
        spec = parts[1]
        if spec.startswith("UUID="):
            dev = run(["blkid", "-U", spec[5:]]).stdout.strip()
        elif spec.startswith("/dev/"):
            dev = spec
        else:
            continue
        if dev and run(["lsblk", "-dno", "FSTYPE", dev]).stdout.strip() == "crypto_LUKS":
            luks.add(dev)
    return True, sorted(luks), ""


def encrypted() -> bool:
    return disk_protection()[0]


def state(config: dict) -> dict:
    return {"encrypted": encrypted(), "firewall": firewall_on(), "auto_updates": auto_updates_on(),
            "erase_allowed": bool(config.get("allow_erase")), "screen_lock_minutes": screen_lock_minutes(),
            "lost_mode": LOST.exists()}


def screen_lock_minutes() -> int:
    try:
        for line in POLICY_DCONF.read_text().splitlines():
            if line.startswith("idle-delay="):
                return int(line.split()[-1]) // 60
    except (OSError, ValueError):
        pass
    return 0


def apps() -> list[dict]:
    """Installed apps: Flatpak apps and the Debian packages someone chose (not
    every library). Names and versions only."""
    found = []
    r = run(["flatpak", "list", "--system", "--app", "--columns=application,version"]) if shutil.which("flatpak") else None
    for line in (r.stdout.splitlines() if r and r.returncode == 0 else []):
        parts = line.split("\t")
        if parts and parts[0].strip():
            found.append({"name": parts[0].strip(), "version": parts[1].strip() if len(parts) > 1 else "",
                          "source": "flatpak"})
    manual = run(["apt-mark", "showmanual"]).stdout.split()
    if manual:
        q = run(["dpkg-query", "-W", "-f", "${Package}\t${Version}\n", *manual[:MAX_APPS]])
        for line in q.stdout.splitlines():
            name, _, version = line.partition("\t")
            if name:
                found.append({"name": name, "version": version, "source": "debian"})
    return found[:MAX_APPS]


def status_report(device_id: str) -> dict:
    updates = read_json(UPDATES, {})
    waiting = updates.get("available", []) if isinstance(updates, dict) else []
    compliance = tool_json(["kulan-compliance"])
    tpm = tool_json(["kulan-tpm"])
    try:
        uptime = int(float(read_text("/proc/uptime").split()[0]))
    except (IndexError, ValueError):
        uptime = 0
    return {
        "device_id": device_id,
        "sent": int(time.time()),
        "hostname": socket.gethostname(),
        "os": os_release().get("PRETTY_NAME", "Linux"),
        "kulan_version": kulan_version(),
        "kernel": platform.release(),
        "hardware": hardware(),
        "uptime_s": uptime,
        "updates": {
            "waiting": len(waiting) if isinstance(waiting, list) else 0,
            "security": sum(1 for u in waiting if isinstance(u, dict) and u.get("security")),
            "restart_required": bool(updates.get("restart_required")) if isinstance(updates, dict) else False,
        },
        "compliance": None if compliance is None else {
            "mode": compliance.get("mode"), "passed": compliance.get("passed"), "total": compliance.get("total"),
            "compliant": compliance.get("compliant"), "baseline": compliance.get("baseline"),
            "controls": [{k: c.get(k) for k in ("id", "title", "status", "cis", "nist")}
                         for c in compliance.get("controls", []) if isinstance(c, dict)],
        },
        "tpm": None if tpm is None else {"on": tpm.get("on"), "possible": tpm.get("possible")},
        "state": state(read_json(CONFIG, {})),
        "policy_status": read_json(POLICY_PUBLIC, {}).get("status", {}),
    }


# --- the organisation's policy --------------------------------------------------------------
def clean_policy(raw) -> dict:
    """Only the policy keys Kulan OS knows, with sensible values."""
    if not isinstance(raw, dict):
        return {}
    policy = {key: True for key in ("auto_updates", "firewall", "require_encryption") if raw.get(key) is True}
    minutes = raw.get("screen_lock_minutes")
    if isinstance(minutes, int) and not isinstance(minutes, bool) and 1 <= minutes <= 60:
        policy["screen_lock_minutes"] = minutes
    if raw.get("usb") in ("block", "approved"):
        policy["usb"] = raw["usb"]
        if raw["usb"] == "approved":
            policy["usb_drives"] = fleetpolicy.clean_drives(raw.get("usb_drives"))
    for key in ("required_apps", "blocked_apps"):
        apps_list = fleetpolicy.clean_apps(raw.get(key))
        if apps_list:
            policy[key] = apps_list
    return policy


def compliance_idle_seconds() -> int:
    """Compliance mode's screen lock, if it's on (0 if not)."""
    try:
        for line in COMPLIANCE_DCONF.read_text().splitlines():
            if line.startswith("idle-delay="):
                return int(line.split()[-1])
    except (OSError, ValueError):
        pass
    return 0


def set_screen_lock(minutes: int) -> bool:
    """Lock after `minutes` idle, or compliance mode's time if that's
    shorter, with every lock setting locked so it stays; 0 takes it away."""
    removed_old = False
    for old in OLD_POLICY_FILES:  # 2.6 test builds wrote these
        if old.exists():
            old.unlink()
            removed_old = True
    if minutes:
        seconds = minutes * 60
        if compliance_idle_seconds():
            seconds = min(seconds, compliance_idle_seconds())
        text = ("# Set by your organisation (Kulan fleet policy).\n"
                f"[org/gnome/desktop/session]\nidle-delay=uint32 {seconds}\n\n"
                "[org/gnome/desktop/screensaver]\nlock-enabled=true\nlock-delay=uint32 0\n\n"
                "[org/gnome/desktop/lockdown]\ndisable-lock-screen=false\n")
        locks = ("/org/gnome/desktop/session/idle-delay\n/org/gnome/desktop/screensaver/lock-enabled\n"
                 "/org/gnome/desktop/screensaver/lock-delay\n/org/gnome/desktop/lockdown/disable-lock-screen\n")
        try:
            # Already set, and dconf's database was rebuilt after it was written.
            if not removed_old and POLICY_DCONF.read_text() == text and POLICY_LOCKS.read_text() == locks and \
                    DCONF_DB.stat().st_mtime >= POLICY_DCONF.stat().st_mtime:
                return True
        except OSError:
            pass
        POLICY_LOCKS.parent.mkdir(parents=True, exist_ok=True)
        if not POLICY_DCONF.exists() or POLICY_DCONF.read_text() != text or \
                not POLICY_LOCKS.exists() or POLICY_LOCKS.read_text() != locks:
            POLICY_DCONF.write_text(text)
            POLICY_LOCKS.write_text(locks)
    elif POLICY_DCONF.exists() or POLICY_LOCKS.exists() or removed_old:
        POLICY_DCONF.unlink(missing_ok=True)
        POLICY_LOCKS.unlink(missing_ok=True)
    else:
        return True
    return run(["dconf", "update"]).returncode == 0


def apply_policy(raw) -> dict:
    """Keep to the policy; say, per item, whether it's met."""
    policy = clean_policy(raw)
    status = {}
    if policy.get("auto_updates"):
        if not auto_updates_on():
            run(["/usr/lib/kulan/update-run", "auto-on"])
        status["auto_updates"] = "met" if auto_updates_on() else "not met"
    if policy.get("firewall"):
        if not firewall_on():
            run(["/usr/lib/kulan/update-run", "firewall-on"], timeout=120)
        status["firewall"] = "met" if firewall_on() else "not met"
    minutes = policy.get("screen_lock_minutes", 0)
    ok = set_screen_lock(minutes)
    if minutes:
        status["screen_lock_minutes"] = "met" if ok else "not met"
    if policy.get("require_encryption"):
        status["require_encryption"] = "met" if encrypted() else "not met"
    usb = fleetpolicy.apply_usb(run, policy.get("usb"), policy.get("usb_drives", []))
    if usb is not None:
        status["usb"] = usb
    status.update(fleetpolicy.apply_apps(run, policy.get("required_apps", []), policy.get("blocked_apps", [])))
    write_json(POLICY_PUBLIC, {"policy": policy, "status": status, "applied": int(time.time())}, 0o644)
    return status


def remove_policy() -> None:
    set_screen_lock(0)
    fleetpolicy.remove_all(run)  # USB storage works again; apps stay as they are
    POLICY_PUBLIC.unlink(missing_ok=True)


# --- actions ------------------------------------------------------------------------------
def do_action(kind: str, payload=None) -> tuple[bool, str]:
    if kind == "refresh":
        return True, "reported"
    if kind == "install-app":
        app = fleetpolicy.clean_apps([payload] if isinstance(payload, dict) else [])
        if not app:
            return False, "which app? (not one Kulan OS can install)"
        return fleetpolicy.install(run, app[0])
    if kind == "install-updates":
        r = run(["/usr/lib/kulan/update-run", "install"], timeout=3600)
        return r.returncode == 0, (r.stderr.strip().splitlines() or ["updated"])[-1][:200]
    if kind == "compliance-on":
        r = run(["kulan-compliance", "on"], timeout=1800)
        return r.returncode == 0, (r.stdout.strip().splitlines() or ["done"])[-1][:200]
    if kind == "lock-screen":
        r = run(["loginctl", "lock-sessions"])
        return r.returncode == 0, "screen locked" if r.returncode == 0 else r.stderr.strip()[:200]
    if kind == "erase":
        return erase()
    if kind in ("restart", "shutdown"):
        org = read_json(CONFIG, {}).get("organisation") or "Your organisation"
        if kind == "restart":
            argv = ["shutdown", "-r", "+5", f"{org} is restarting this computer in 5 minutes to finish updates."]
        else:
            argv = ["shutdown", "-h", "+5", f"{org} is switching this computer off in 5 minutes. Please save your work."]
        r = run(argv)
        what = "restart" if kind == "restart" else "switch off"
        return r.returncode == 0, f"{what} in 5 minutes" if r.returncode == 0 else r.stderr.strip()[:200]
    if kind == "lost-mode-on":
        return lost_mode_on()
    if kind == "lost-mode-off":
        return lost_mode_off()
    return False, "not an action Kulan OS allows"


def gvariant_string(text: str) -> str:
    return "'" + " ".join(text.split()).replace("\\", "\\\\").replace("'", "\\'") + "'"


def lost_mode_on(notice_s: int = LOST_NOTICE_S) -> tuple[bool, str]:
    """Nobody can sign in until the organisation releases the computer, and
    whoever is signed in is signed out after a short notice. Sign-ins stop
    first, so nobody new gets in during the notice."""
    org = read_json(CONFIG, {}).get("organisation") or "Your organisation"
    already = LOST.exists()
    message = (f"This computer was reported lost. {org} has locked it: nobody can sign in. "
               f"If you found it, please return it to {org}.")
    try:
        current = NOLOGIN.read_text()
    except OSError:
        current = None
    own = current is None or current.startswith(LOST_MARK)
    if own:  # someone else's /etc/nologin already stops sign-ins: left as it is
        NOLOGIN.write_text(f"{LOST_MARK}\n{message}\n")
        os.chmod(NOLOGIN, 0o644)
    write_json(LOST, {"since": int(time.time()), "own_nologin": own}, 0o600)
    LOST_BANNER.parent.mkdir(parents=True, exist_ok=True)
    LOST_BANNER.write_text("# Kulan Fleet lost mode (kulan-fleet removes this when the computer is released)\n"
                           "[org/gnome/login-screen]\nbanner-message-enable=true\n"
                           f"banner-message-text={gvariant_string(message)}\n")
    run(["dconf", "update"])
    if not already:
        warn_users("This computer is in lost mode",
                   f"{org} reported it lost. Everyone is signed out in {notice_s} seconds: save your work now.")
        time.sleep(notice_s)
    signed_out = 0
    for line in run(["loginctl", "list-users", "--no-legend"]).stdout.splitlines():
        parts = line.split()
        if len(parts) >= 2 and parts[0].isdigit() and int(parts[0]) >= 1000:
            signed_out += run(["loginctl", "terminate-user", parts[0]]).returncode == 0
    return True, f"lost mode on: nobody can sign in; {signed_out} signed out"


def lost_mode_off() -> tuple[bool, str]:
    """Released: sign-in works again (only Fleet's own nologin is removed)."""
    try:
        if NOLOGIN.read_text().startswith(LOST_MARK):
            NOLOGIN.unlink()
    except OSError:
        pass
    had_banner = LOST_BANNER.exists()
    LOST_BANNER.unlink(missing_ok=True)
    if had_banner:
        run(["dconf", "update"])
    was = LOST.exists()
    LOST.unlink(missing_ok=True)
    return True, "released from lost mode" if was else "wasn't in lost mode"


def erase_check() -> tuple[bool, list[str] | str]:
    """Whether this computer may be erased now: (True, the LUKS partitions)
    or (False, why not)."""
    if not read_json(CONFIG, {}).get("allow_erase"):
        return False, "not allowed on this computer (Kulan Settings > About > Organisation)"
    ok, devices, why = disk_protection()
    if not ok or not devices:
        return False, f"can't be erased from afar: {why or 'nothing encrypted found'}"
    return True, devices


def erase() -> tuple[bool, str]:
    """Make everything personal unreadable: destroy every key of every LUKS
    partition holding it. The computer keeps running (the open partitions
    stay open) long enough to report; then it switches off. If any partition
    couldn't be erased, it says so and doesn't switch off."""
    ok, devices = erase_check()
    if not ok:
        return False, str(devices)
    failed = []
    for device in devices:
        r = run(["cryptsetup", "luksErase", "--batch-mode", device], timeout=120)
        if r.returncode != 0:
            failed.append(f"{device} ({(r.stderr.strip().splitlines() or ['error'])[-1][:80]})")
    if failed:
        return False, "erase failed on " + ", ".join(failed) + "; not switched off"
    return True, f"erased {len(devices)} encrypted partition(s); switching off"


def warn_users(title: str, body: str) -> None:
    """Tell everyone using the computer: a notification on each signed-in
    desktop, and a message in every terminal."""
    run(["wall", f"{title}. {body}"], timeout=10)
    if not NOTICE.exists():
        return
    for bus in sorted(Path("/run/user").glob("*/bus")):
        uid = bus.parent.name
        if not uid.isdigit() or int(uid) < 1000:
            continue
        try:
            user = pwd.getpwuid(int(uid)).pw_name
        except KeyError:
            continue
        run(["runuser", "-u", user, "--", "env", f"DBUS_SESSION_BUS_ADDRESS=unix:path={bus}",
             f"XDG_RUNTIME_DIR={bus.parent}", str(NOTICE), "notify", title, body], timeout=20)


def erase_with_notice(action_id: str, resumed: bool = False) -> tuple[bool, str]:
    """Erase, after a short notice to whoever is using the computer. The
    pending mark is written first, so the erase still happens if the
    computer is switched off during the notice."""
    ok, why = erase_check()
    if not ok:
        ERASE_PENDING.unlink(missing_ok=True)
        return False, str(why)
    write_json(ERASE_PENDING, {"action": action_id, "since": int(time.time())}, 0o600)
    org = read_json(CONFIG, {}).get("organisation") or "Your organisation"
    if resumed:
        warn_users("This computer is being erased",
                   f"{org} asked for it to be erased, and it was switched off before that finished. "
                   "It's being erased now and will switch off.")
    else:
        warn_users("This computer will be erased",
                   f"{org} is erasing this computer, as it was allowed to if the computer was lost. "
                   f"In {ERASE_NOTICE_S} seconds everything on it becomes unreadable and it switches off.")
        time.sleep(ERASE_NOTICE_S)
    result = erase()
    ERASE_PENDING.unlink(missing_ok=True)
    return result


def resume_erase(config: dict) -> bool:
    """An erase interrupted by switching off: finish it first. True if the
    computer was erased (and is switching off)."""
    pending = read_json(ERASE_PENDING, None)
    if not isinstance(pending, dict):
        return False
    action_id = str(pending.get("action", ""))
    ok, detail = erase_with_notice(action_id, resumed=True)
    say(f"erase (interrupted earlier): {'done' if ok else 'failed'} ({detail})")
    if action_id:
        try:
            post(config["server"], f"/v1/actions/{urllib.parse.quote(action_id, safe='')}",
                 {"device_id": config["device_id"], "status": "done" if ok else "failed", "detail": detail},
                 config["token"])
        except (RuntimeError, KeyError):
            pass  # offline: the erase matters, not the report
    if ok:
        say("Erased, as the organisation asked: switching off")
        power_off()
    return ok


def power_off() -> None:
    run(["sync"])
    run(["systemctl", "poweroff", "--force", "--force"])


# --- commands -------------------------------------------------------------------------------
def publish(config: dict | None, last_report: int | None = None, error: str | None = None) -> None:
    if config is None:
        PUBLIC.unlink(missing_ok=True)
        return
    old = read_json(PUBLIC, {})
    write_json(PUBLIC, {
        "joined": True,
        "organisation": config.get("organisation", ""),
        "server": urllib.parse.urlsplit(config.get("server", "")).hostname or "",
        "since": config.get("since"),
        "last_report": last_report or old.get("last_report"),
        "last_error": error,
        "shared": SHARED,
        "actions": list(ALLOWED_ACTIONS),
        "allow_erase": bool(config.get("allow_erase")),
    }, 0o644)


def join(server: str, allow_erase: bool = False) -> int:
    need_root()
    try:
        server = check_server(server)
    except ValueError as e:
        say(str(e))
        return 64
    code = sys.stdin.readline().strip()
    if not code:
        say("The one-time code from your organisation is needed (one line on standard input)")
        return 64
    try:
        reply = post(server, "/v1/enrol", {"code": code, "hostname": socket.gethostname(),
                                           "os": os_release().get("PRETTY_NAME", "Linux"),
                                           "kulan_version": kulan_version()})
    except RuntimeError as e:
        say(f"Couldn't join: {e}")
        return 1
    device_id, token = str(reply.get("device_id", "")), str(reply.get("token", ""))
    if not device_id or not token:
        say("Couldn't join: the server didn't give this computer an ID and a key")
        return 1
    config = {"server": server, "device_id": device_id, "token": token,
              "organisation": str(reply.get("organisation", "")).strip()[:80] or urllib.parse.urlsplit(server).hostname,
              "since": int(time.time()), "allow_erase": allow_erase}
    write_json(CONFIG, config, 0o600)
    publish(config)
    run(["systemctl", "enable", "--now", "kulan-fleet.timer"])
    say(f"Joined {config['organisation']}")
    return report()


def report() -> int:
    need_root()
    config = read_json(CONFIG, None)
    if not config:
        say("This computer hasn't joined an organisation")
        return 3
    server, token, device_id = config["server"], config["token"], config["device_id"]
    if resume_erase(config):
        return 0
    erasing = False
    for _round in range(3):  # "refresh" asks for another report straight away; at most three
        body = status_report(device_id)
        # The apps once a day (or when the list hasn't been sent yet).
        try:
            apps_due = time.time() - APPS_SENT.stat().st_mtime > APPS_EVERY_S
        except OSError:
            apps_due = True
        if apps_due:
            body["apps"] = apps()
        # People: passwords changed here (they follow the person), and how
        # the accounts the organisation manages are doing on this computer.
        people_state = people.load_state()
        passwords = people.changed_passwords(people_state)
        if passwords:
            body["passwords"] = passwords
        if people_state.get("status"):
            body["people_status"] = people_state["status"]
        # Two-step sign-in set up or removed here since the server last had it.
        factors_added, factors_removed = twostep.pending()
        if factors_added:
            body["factors"] = factors_added
        if factors_removed:
            body["factors_removed"] = factors_removed
        # Who uses this computer: usernames and when each was last used, nothing more.
        body["sign_ins"] = signins.collect(run)
        # USB drives seen, only while a policy controls them (so an admin can approve one).
        if read_json(POLICY_PUBLIC, {}).get("policy", {}).get("usb"):
            body["usb_seen"] = fleetpolicy.usb_seen()
        try:
            reply = post(server, "/v1/report", body, token)
        except RuntimeError as e:
            publish(config, error=str(e))
            say(f"Report not sent: {e}")
            return 1
        publish(config, last_report=int(time.time()))
        if apps_due:
            APPS_SENT.parent.mkdir(parents=True, exist_ok=True)
            APPS_SENT.touch()
        if passwords:
            people.sent(people_state, passwords)
        if "accounts" in reply:
            people_state, accounts_status = people.apply(reply.get("accounts"), run, people_state)
            people_state["status"] = accounts_status
            changed = {u: v for u, v in accounts_status.items() if v != "up to date"}
            if changed:
                say("People: " + "; ".join(f"{u} {v}" for u, v in changed.items()))
        if passwords or "accounts" in reply:
            people.save_state(people_state)
        if "accounts" in reply:
            two_step = twostep.apply(run, reply.get("accounts"), set(people_state.get("people", {})))
            asked = [u for u, v in two_step.items() if v == "asked, not set up"]
            if asked:
                say("Two-step sign-in not set up yet: " + ", ".join(asked))
            # Work email (2.8e): who has a mailbox from the organisation, to offer to connect it.
            workmail.apply(reply.get("accounts"), set(people_state.get("people", {})))
        if "policy" in reply:
            status = apply_policy(reply.get("policy"))
            if status:
                say("Policy: " + ", ".join(f"{k.replace('_', ' ')} {v}" for k, v in status.items()))
        again = False
        actions = reply.get("actions")
        for action in (actions if isinstance(actions, list) else [])[:10]:
            if not isinstance(action, dict):
                continue
            kind, action_id = str(action.get("type", "")), str(action.get("id", ""))
            if kind not in ALLOWED_ACTIONS:
                ok, detail = False, "not an action Kulan OS allows"
            elif kind == "erase":
                ok, detail = erase_with_notice(action_id)
            else:
                ok, detail = do_action(kind, action.get("payload"))
            # Report again straight away after refresh, and after lost mode on
            # or off, so the organisation sees it now rather than in an hour.
            again = again or kind in ("refresh", "lost-mode-on", "lost-mode-off")
            erasing = erasing or (kind == "erase" and ok)
            if action_id:
                try:
                    post(server, f"/v1/actions/{urllib.parse.quote(action_id, safe='')}",
                         {"device_id": device_id, "status": "done" if ok else "failed", "detail": detail}, token)
                except RuntimeError:
                    pass
            say(f"{kind}: {'done' if ok else 'failed'} ({detail})")
        if erasing:
            say("Erased, as the organisation asked: switching off")
            power_off()
            return 0
        if not again:
            break
    say("Report sent")
    return 0


def allow_erase(value: str) -> int:
    need_root()
    config = read_json(CONFIG, None)
    if not config:
        say("This computer hasn't joined an organisation")
        return 3
    config["allow_erase"] = value == "on"
    write_json(CONFIG, config, 0o600)
    publish(config)
    say("The organisation may erase this computer if it's lost" if config["allow_erase"]
        else "The organisation can't erase this computer")
    return 0


def leave() -> int:
    need_root()
    config = read_json(CONFIG, None)
    if config:
        try:
            post(config["server"], "/v1/leave", {"device_id": config["device_id"]}, config["token"])
        except RuntimeError as e:
            say(f"The server wasn't told ({e}); this computer stops reporting anyway")
    run(["systemctl", "disable", "--now", "kulan-fleet.timer"])
    CONFIG.unlink(missing_ok=True)
    remove_policy()  # automatic updates and the firewall stay as they are
    signins.forget()
    twostep.remove_all(run)  # people sign in with their password alone again
    workmail.remove_all()  # no work email offered (people's own Online Accounts stay theirs)
    APPS_SENT.unlink(missing_ok=True)
    ERASE_PENDING.unlink(missing_ok=True)  # an organisation it left can't erase it
    lost_mode_off()  # nor keep it locked as lost
    # Its accounts stay as ordinary accounts on this computer, no longer managed.
    people.STATE.unlink(missing_ok=True)
    publish(None)
    say("Left the organisation: nothing is reported any more")
    return 0


def status(as_json: bool) -> int:
    public = read_json(PUBLIC, {}) or {"joined": False, "shared": SHARED, "actions": list(ALLOWED_ACTIONS)}
    if as_json:
        print(json.dumps(public, indent=2))
    elif public.get("joined"):
        last = public.get("last_report")
        print(f"Managed by {public.get('organisation')} ({public.get('server')})")
        print("Last report: " + (time.strftime("%d %b %Y %H:%M", time.localtime(last)) if last else "not yet"))
        if public.get("last_error"):
            print("Last problem: " + public["last_error"])
    else:
        print("Not managed: this computer doesn't report to anyone")
    return 0


def locked(fn):
    """One kulan-fleet at a time (an hourly report never races a leave)."""
    def wrapper(*args, **kwargs):
        import fcntl
        LOCK.parent.mkdir(parents=True, exist_ok=True)
        with open(LOCK, "w") as fh:
            fcntl.flock(fh, fcntl.LOCK_EX)
            return fn(*args, **kwargs)
    return wrapper


def main(argv: list[str]) -> int:
    command = argv[1] if len(argv) > 1 else "status"
    if command == "status":
        return status("--json" in argv[2:])
    if command in ("join", "report", "allow-erase", "leave"):
        need_root()
    if command == "join" and len(argv) in (3, 4) and argv[3:] in ([], ["--allow-erase"]):
        return locked(join)(argv[2], allow_erase=len(argv) == 4)
    if command == "allow-erase" and argv[2:] in (["on"], ["off"]):
        return locked(allow_erase)(argv[2])
    if command == "report":
        return locked(report)()
    if command == "leave":
        return locked(leave)()
    print(__doc__.split("\n\n")[1], file=sys.stderr)
    return 64


if __name__ == "__main__":
    sys.exit(main(sys.argv))
