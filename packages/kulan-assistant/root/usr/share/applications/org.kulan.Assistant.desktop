[Desktop Entry]
Type=Application
Name=Kulan Assistant
Comment=Ask questions, get things done, writing help and summaries, all on this computer
Keywords=assistant;ai;agent;do it for me;writing;proofread;rewrite;summarise;summarize;translate;
Exec=kulan-assistant do
Actions=settings;
Icon=org.kulan.Assistant
Categories=Utility;
OnlyShowIn=GNOME;
StartupNotify=true

[Desktop Action settings]
Name=Assistant Settings
Exec=kulan-settings assistant
