[Desktop Entry]
Type=Application
Name=Ask Kulan
GenericName=Assistant
Comment=Ask questions and get things done, in a conversation that stays on this computer
Keywords=assistant;ai;agent;chat;kulan assistant;do it for me;writing;proofread;rewrite;summarise;summarize;translate;
Exec=kulan-assistant do
Actions=settings;
Icon=org.kulan.Assistant
Categories=Utility;
OnlyShowIn=GNOME;
StartupNotify=true

[Desktop Action settings]
Name=Assistant Settings
Exec=kulan-settings assistant
