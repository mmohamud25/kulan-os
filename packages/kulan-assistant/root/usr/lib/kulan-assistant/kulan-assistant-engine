#!/usr/bin/python3
"""Run the local assistant engine for this user, and stop it when idle.

Started by kulan-assistant-engine.service (a systemd user service) when an
assistant feature needs it. Listens only on a Unix socket in the user's
private runtime folder, and needs the user's key. Exits after kulan_assistant.engine.idle_minutes() without a request (2 in lighter mode, otherwise 10).
"""
import os
import signal
import subprocess
import sys
import time

sys.path.insert(0, "/usr/share/kulan-assistant")
from kulan_assistant import engine  # noqa: E402


def main() -> int:
    model_id = engine.usable_model()
    if model_id is None:
        print("kulan-assistant: no model downloaded; choose one in Kulan Settings > Assistant", file=sys.stderr)
        return 1
    model = engine.model_path(model_id)
    # Half the processor's threads (its cores, on most): the rest stay free for
    # what you're doing while it answers.
    threads = max(1, min(8, (os.cpu_count() or 2) // 2))
    try:
        engine.prepare_runtime_dir()
    except engine.EngineError as exc:
        print(f"kulan-assistant: {exc}", file=sys.stderr)
        return 1
    sock = engine.socket_path()
    try:
        sock.unlink()  # left behind by an engine that was stopped
    except FileNotFoundError:
        pass
    argv = [str(engine.ENGINE), "--model", str(model), "--host", str(sock),
            "--api-key-file", str(engine.key_file()), "--ctx-size", str(engine.CONTEXT), "--parallel", "1",
            "--threads", str(threads), "--jinja", "--reasoning-budget", "0", "--no-webui", "--log-disable"]
    engine.api_key()  # make sure the key file exists (mode 0600)
    engine.touch_last_use()
    # The key is read from a file only this user can read: on the command
    # line it would be visible to everyone through ps.
    proc = subprocess.Popen(argv, stdin=subprocess.DEVNULL)

    def stop(*_args) -> None:
        proc.terminate()

    signal.signal(signal.SIGTERM, stop)
    signal.signal(signal.SIGINT, stop)
    last_use = engine.runtime_dir() / "last-use"
    while proc.poll() is None:
        time.sleep(15)
        try:
            idle = time.time() - last_use.stat().st_mtime
        except OSError:
            idle = 0
        if idle > engine.idle_minutes() * 60:
            proc.terminate()
            try:
                proc.wait(timeout=20)
            except subprocess.TimeoutExpired:
                proc.kill()
            return 0
    return 0 if proc.returncode in (0, -signal.SIGTERM) else proc.returncode


if __name__ == "__main__":
    sys.exit(main())
