[Unit]
Description=Kulan Assistant engine (runs on this computer only)
Documentation=man:kulan-assistant(1)

[Service]
Type=simple
ExecStart=/usr/lib/kulan-assistant/kulan-assistant-engine
# A model uses a lot of memory: let the system take it back first when short.
OOMScoreAdjust=500
# It always gives way to the app in front of you (a video, a call, typing):
# low processor and disk priority, so answers wait, the desktop doesn't.
Nice=10
CPUWeight=20
IOWeight=20
Restart=no
# The engine needs nothing from the network and nothing outside its model.
PrivateTmp=yes
NoNewPrivileges=yes
# It talks only over its Unix socket: no internet sockets at all.
RestrictAddressFamilies=AF_UNIX
