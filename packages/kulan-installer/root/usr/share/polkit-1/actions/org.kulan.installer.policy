<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<!-- Kulan Installer's engine. Only on the live USB stick (the installer
     removes this package from installed systems, and the engine refuses to
     run through pkexec anywhere but the live session). -->
<policyconfig>
  <vendor>Kulan OS</vendor>
  <action id="org.kulan.installer.engine">
    <description>Install Kulan OS</description>
    <message>Installing Kulan OS needs administrator rights</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/lib/kulan/installer-engine</annotate>
  </action>
</policyconfig>
