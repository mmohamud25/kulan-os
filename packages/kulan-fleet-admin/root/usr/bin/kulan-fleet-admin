SAMPLE_PNG = "iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR42mNkaPhfDwAEhgHHwhxYFAAAAABJRU5ErkJggg=="


def ago(iso: str | None) -> str:
    if not iso:
        return "never"
    try:
        when = datetime.fromisoformat(iso.replace("Z", "+00:00"))
    except ValueError:
        return iso
    s = (datetime.now(timezone.utc) - when).total_seconds()
    if s < 90:
        return "just now"
    if s < 3600:
        return f"{round(s / 60)} min ago"
    if s < 86400:
        return f"{round(s / 3600)} h ago"
    days = round(s / 86400)
    return f"{days} day{'s' if days != 1 else ''} ago"


def ago_seconds(seconds: int | float | None) -> str:
    """ago() for a time in seconds since 1970."""
    if not seconds:
        return "never"
    return ago(datetime.fromtimestamp(seconds, timezone.utc).isoformat())


def day_label(iso: str | None) -> str:
    """26 Oct 2026, from an ISO date or time."""
    if not iso:
        return ""
    try:
        return datetime.fromisoformat(str(iso).replace("Z", "+00:00")).strftime("%-d %b %Y")
    except ValueError:
        return str(iso)


def plural(n: int, word: str, words: str | None = None) -> str:
    return f"{n} {word if n == 1 else (words or word + 's')}"


def weekly_sections(s: dict, prev: dict | None) -> list[tuple[str, list[tuple[str, str, str]]]]:
    """The weekly report as (heading, [(line, detail, good|bad|dim)]), for the page and the PDF."""
    c, p, a, rv = s.get("computers") or {}, s.get("people") or {}, s.get("activity") or {}, s.get("review") or {}
    pc, pp = (prev or {}).get("computers") or {}, (prev or {}).get("people") or {}
    total = int(c.get("total") or 0)

    def n(src: dict, key: str) -> int:
        """How many: the server's count (its lists name at most 50), or the list's length."""
        counts = src.get("counts") or {}
        if key in counts:
            return int(counts[key] or 0)
        v = src.get(key)
        return len(v) if isinstance(v, list) else int(v or 0)

    def since(key: str, now: int, before_from: dict) -> str:
        if prev is None or (key not in before_from and key not in (before_from.get("counts") or {})):
            return ""
        d = now - n(before_from, key)
        return "same as last week" if d == 0 else f"{'+' if d > 0 else '−'}{abs(d)} since last week"

    def names(src: dict, key: str) -> str:
        lst = src.get(key) or []
        text = ", ".join(x if isinstance(x, str) else
                         f"{x.get('hostname', '')}" + (f" ({x['count']})" if x.get("count") else "") +
                         (f" ({x['failing']} failing)" if x.get("failing") else "") for x in lst)
        extra = n(src, key) - len(lst)
        return f"{text} and {extra} more" if extra > 0 and text else text

    def detail(*parts: str) -> str:
        return " · ".join(x for x in parts if x)

    def problem(title_none: str, title_some, key: str, src: dict, before: dict) -> tuple[str, str, str]:
        k = n(src, key)
        return ((title_none, detail(since(key, k, before)), "good") if k == 0 else
                (title_some(k), detail(names(src, key), since(key, k, before)), "bad"))

    comp = [
        (f"{plural(total, 'computer')}", f"{c.get('reported_this_week', 0)} reported this week", "dim"),
        (f"Up to date: {c.get('up_to_date', 0)} of {total}", "", "good" if c.get("up_to_date", 0) == total else "dim"),
        problem("No security updates waiting", lambda k: f"Security updates waiting on {plural(k, 'computer')}",
                "security_waiting", c, pc),
        problem("No restart needed", lambda k: f"Restart needed on {plural(k, 'computer')}", "restart_needed", c, pc),
        (f"Encrypted: {c.get('encrypted', 0)} of {total}", names(c, "not_encrypted") and
         f"Not encrypted: {names(c, 'not_encrypted')}", "good" if not n(c, "not_encrypted") else "bad"),
        problem("Firewall on everywhere", lambda k: f"Firewall off on {plural(k, 'computer')}", "firewall_off", c, pc),
        (f"Compliance passing: {c.get('compliance_passing', 0)} of {total}", names(c, "compliance_failing"),
         "good" if not n(c, "compliance_failing") else "bad"),
        problem("Every policy met", lambda k: f"Policy not met on {plural(k, 'computer')}", "policy_not_met", c, pc),
        problem("Every computer reported this week", lambda k: f"Not seen for a week: {plural(k, 'computer')}",
                "not_seen_week", c, pc),
    ]
    if n(c, "lost_mode"):
        comp.append((f"In lost mode: {plural(n(c, 'lost_mode'), 'computer')}", names(c, "lost_mode"), "bad"))
    if c.get("versions"):
        comp.append(("Kulan OS versions", ", ".join(f"{v}: {plural(k, 'computer')}"
                                                    for v, k in sorted(c["versions"].items(), reverse=True)), "dim"))
    people = [
        (plural(int(p.get("total") or 0), "person", "people"), since("total", int(p.get("total") or 0), pp), "dim"),
        (f"Administrator rights: {n(p, 'admins')}", names(p, "admins"), "dim"),
        problem("Nobody disabled", lambda k: f"Disabled: {k}", "disabled", p, pp),
        problem("Every setup code used", lambda k: f"Setup code not used for a week: {k}", "setup_code_unused", p, pp),
    ]
    if p.get("two_step"):
        people.append(problem("Everyone required has two-step sign-in",
                              lambda k: f"Two-step sign-in not set up: {k}", "two_step_missing", p, pp))
    if n(p, "mailbox_problems"):
        people.append((f"Mailboxes needing attention: {n(p, 'mailbox_problems')}",
                       ", ".join(f"{x.get('username')} ({MAILBOX_TODO.get(x.get('todo'), x.get('todo'))})"
                                 for x in p.get("mailbox_problems") or []), "bad"))
    kinds = ", ".join(f"{x.get('what')} {x.get('count')}" for x in a.get("by_kind") or [])
    activity = [(f"{plural(int(a.get('changes') or 0), 'change')} this week", kinds, "dim")]
    review = [(("Admin-rights review due" if rv.get("due") else "Admin-rights review up to date"),
               (f"Last on {day_label(rv['at'])} by {rv.get('by')}" if rv.get("at") else "No review yet"),
               "bad" if rv.get("due") else "good")]
    return [("Computers", comp), ("People", people), ("Activity", activity), ("Admin rights", review)]


def write_pdf(path: str, title: str, subtitle: str, sections: list[tuple[str, list[tuple[str, str, str]]]]) -> None:
    """A plain A4 PDF of a report (Cairo and Pango; nothing else needed)."""
    gi.require_foreign("cairo")
    gi.require_version("Pango", "1.0")
    gi.require_version("PangoCairo", "1.0")
    import cairo
    from gi.repository import Pango, PangoCairo
    width, height, margin = 595, 842, 56
    surface = cairo.PDFSurface(path, width, height)
    cr = cairo.Context(surface)
    y = margin

    def text(markup: str, size: float, bold: bool = False, colour=(0.12, 0.16, 0.22), indent: float = 0) -> None:
        nonlocal y
        layout = PangoCairo.create_layout(cr)
        layout.set_width(int((width - 2 * margin - indent) * Pango.SCALE))
        layout.set_wrap(Pango.WrapMode.WORD_CHAR)
        layout.set_font_description(Pango.FontDescription.from_string(f"Inter, Sans {'Bold ' if bold else ''}{size}"))
        layout.set_markup(markup, -1)
        h = layout.get_pixel_size()[1]
        if y + h > height - margin:
            cr.show_page()
            y = margin
        cr.set_source_rgb(*colour)
        cr.move_to(margin + indent, y)
        PangoCairo.show_layout(cr, layout)
        y += h
    esc = GLib.markup_escape_text
    text(esc(title), 18, bold=True)
    y += 4
    text(esc(subtitle), 9.5, colour=(0.38, 0.42, 0.5))
    for heading, rows in sections:
        y += 16
        text(esc(heading), 12.5, bold=True)
        y += 4
        for line, detail, kind in rows:
            mark = {"good": "✓", "bad": "!", "dim": "·"}.get(kind, "·")
            colour = {"good": (0.06, 0.46, 0.43), "bad": (0.73, 0.11, 0.11)}.get(kind, (0.12, 0.16, 0.22))
            text(f"{mark}  {esc(line)}", 10.5, colour=colour, indent=4)
            if detail:
                text(esc(detail), 9, colour=(0.38, 0.42, 0.5), indent=20)
            y += 3
    y += 18
    text(esc("Made by Kulan Fleet from each computer's last report."), 8, colour=(0.5, 0.53, 0.6))
    surface.finish()


def csv_cell(v) -> str:
    """One CSV cell; text that a spreadsheet would read as a formula starts with '."""
    t = "" if v is None else v if isinstance(v, str) else json.dumps(v, ensure_ascii=False)
    if t[:1] in ("=", "+", "-", "@", "\t", "\r"):
        t = "'" + t
    return f'"{t.replace(chr(34), chr(34) * 2)}"' if any(ch in t for ch in ',"\n\r') else t


def log_csv(entries: list[dict]) -> str:
    rows = [["When (UTC)", "Who", "What", "Computer", "Details"]]
    rows += [[e.get("at") or "", e.get("email") or "", e.get("what") or "", e.get("hostname") or "",
              e.get("detail") if e.get("detail") is not None else ""] for e in entries]
    return "".join(",".join(csv_cell(c) for c in r) + "\r\n" for r in rows)


def yes_no(value, yes: str = "yes", no: str = "no") -> str:
    return "–" if value is None else yes if value else no


def app_problem(source: str, app_id: str, blocking: bool) -> str | None:
    """Why an app can't go in a policy, or None (the server checks the same)."""
    if source == "debian" and not DEBIAN_NAME.match(app_id):
        return "Use lowercase letters, numbers and + . - (for example vlc)"
    if source == "flatpak" and (len(app_id) > 255 or not FLATPAK_ID.match(app_id)):
        return "A Flathub app id has at least three parts (for example org.videolan.VLC)"
    if blocking and source == "debian" and PROTECTED.match(app_id):
        return "That's part of Kulan OS and can't be blocked"
    return None


def policy_key_label(key: str) -> str:
    """A policy status key as an admin reads it."""
    m = re.match(r"^app:(install|block):(debian|flatpak):(.+)$", key)
    if m:
        return f"{'Install' if m[1] == 'install' else 'Block'} {m[3]}"
    return POLICY_LABEL.get(key, key.replace("_", " "))


def policy_summary(policy: dict) -> str:
    parts = [POLICY_LABEL[k].lower() for k in ("auto_updates", "firewall", "require_encryption") if policy.get(k)]
    if policy.get("screen_lock_minutes"):
        parts.append(f"lock after {policy['screen_lock_minutes']} min")
    if policy.get("usb"):
        parts.append("approved USB drives only" if policy["usb"] == "approved" else "USB blocked")
    if policy.get("two_step"):
        parts.append("two-step sign-in for " + ("everyone" if policy["two_step"] == "everyone" else "admins"))
    for key, word in (("required_apps", "required"), ("blocked_apps", "blocked")):
        if policy.get(key):
            parts.append(f"{len(policy[key])} app{'s' if len(policy[key]) != 1 else ''} {word}")
    text = ", ".join(parts)
    return text[:1].upper() + text[1:] if parts else "No policy of its own"


def tag(text: str, kind: str) -> Gtk.Label:
    return Gtk.Label(label=text[:1].upper() + text[1:], css_classes=["fleet-tag", kind], valign=Gtk.Align.CENTER)


def compliance_tag(d: dict) -> Gtk.Label:
    if d.get("compliance_total") is None:
        return tag("compliance unknown", "dim")
    ok = d.get("compliance_passed") == d.get("compliance_total")
    on = " · mode on" if d.get("compliance_mode") == "on" else ""
    return tag(f"{d['compliance_passed']} of {d['compliance_total']}{on}", "good" if ok else "warn")


def updates_tag(d: dict) -> Gtk.Label:
    u = d.get("updates")
    if not u:
        return tag("updates unknown", "dim")
    if u.get("security"):
        return tag(f"{u['security']} security", "bad")
    if u.get("waiting"):
        return tag(f"{u['waiting']} waiting", "warn")
    return tag("up to date", "good")


def offline(d: dict, now: datetime | None = None) -> bool:
    """Not heard from for over a day."""
    try:
        seen = datetime.fromisoformat(str(d["last_seen"]).replace("Z", "+00:00"))
    except (KeyError, TypeError, ValueError):
        return True
    return ((now or datetime.now(timezone.utc)) - seen).total_seconds() > 86400


def health(d: dict, alerts: list[dict]) -> tuple[str, str, str]:
    """A computer's health, as in the web dashboard: (label, tag kind, tab)."""
    if d.get("left_at"):
        return "Left", "dim", "left"
    if d.get("approved") is False:
        return "Waiting for approval", "warn", "attention"
    if (d.get("state") or {}).get("lost_mode"):
        return "Lost mode", "bad", "lost"
    if offline(d):
        return "Offline", "dim", "offline"
    issues = sum(1 for a in alerts if a.get("device_id") == d.get("id") and a.get("kind") not in ("offline", "help"))
    return (f"{issues} issue{'s' if issues != 1 else ''}", "warn", "attention") if issues else ("Healthy", "good", "healthy")


def device_model(d: dict) -> str:
    hw = d.get("hardware") or {}
    return " ".join(x for x in (hw.get("vendor"), hw.get("model")) if x) or d.get("os") or ""


def used_by(d: dict, names: dict[str, str]) -> str:
    """Who's signed in now, or who used it last."""
    ins = d.get("sign_ins") or []
    now = [x.get("username", "") for x in ins if x.get("now")]
    if now:
        return ", ".join(names.get(u) or u for u in now)
    return (names.get(ins[0].get("username")) or ins[0].get("username", "")) if ins else ""


# --- the window ------------------------------------------------------------------------
class FleetWindow(Adw.ApplicationWindow):
    def __init__(self, app: Adw.Application, session: Session, sample: dict | None = None) -> None:
        super().__init__(application=app, title="Kulan Fleet", default_width=1100, default_height=760,
                         width_request=480, height_request=420)
        self.session = session
        self.data: dict | None = sample
        self.org_id: str | None = None
        self.org_groups: dict[str, list[dict]] = {}  # each organisation's groups, for the person dialogs
        self.toasts = Adw.ToastOverlay()
        self.stack = Gtk.Stack(transition_type=Gtk.StackTransitionType.CROSSFADE)
        self.toasts.set_child(self.stack)
        self.set_content(self.toasts)
        self.stack.add_named(self.build_signin(), "signin")
        self.stack.add_named(self.build_main(), "main")
        if sample is not None:
            self.stack.set_visible_child_name("main")
            self.show_data()
        elif session.refresh_token:
            self.stack.set_visible_child_name("main")
            self.reload()
        else:
            self.stack.set_visible_child_name("signin")

    # --- background calls ----------------------------------------------------------------
    def background(self, work, done) -> None:
        def run() -> None:
            try:
                result, error = work(), None
            except FleetError as e:
                result, error = None, ErrorText(str(e))
                error.two_step = e.two_step
                if e.two_step:
                    GLib.idle_add(lambda kind=e.two_step: (self.two_step_needed(kind), False)[1])
            except Exception as e:  # noqa: BLE001 - never leave the app hanging
                result, error = None, f"Something went wrong: {e}"
            GLib.idle_add(lambda: (done(result, error), False)[1])
        threading.Thread(target=run, daemon=True).start()

    def toast(self, text: str) -> None:
        self.toasts.add_toast(Adw.Toast(title=GLib.markup_escape_text(text), timeout=4))

    # --- sign in ---------------------------------------------------------------------------
    def build_signin(self) -> Gtk.Widget:
        view = Adw.ToolbarView()
        view.add_top_bar(Adw.HeaderBar())
        status = Adw.StatusPage(icon_name="org.kulan.Fleet", title="Kulan Fleet",
                                description="Sign in with your email. Only fleet admins see computers.")
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12, width_request=360,
                      halign=Gtk.Align.CENTER)
        rows = Gtk.ListBox(css_classes=["boxed-list"], selection_mode=Gtk.SelectionMode.NONE)
        self.email_row = Adw.EntryRow(title="Email")
        self.code_row = Adw.EntryRow(title="Code or sign-in link from the email", visible=False)
        rows.append(self.email_row)
        rows.append(self.code_row)
        self.signin_button = Gtk.Button(label="Email me a sign-in link", css_classes=["suggested-action", "pill"],
                                        halign=Gtk.Align.CENTER)
        self.signin_button.connect("clicked", lambda _b: self.signin_step())
        self.email_row.connect("entry-activated", lambda _r: self.signin_step())
        self.code_row.connect("entry-activated", lambda _r: self.signin_step())
        self.signin_note = Gtk.Label(wrap=True, css_classes=["dim-label"])
        box.append(rows)
        box.append(self.signin_button)
        box.append(self.signin_note)
        status.set_child(box)
        view.set_content(status)
        return view

    def signin_step(self) -> None:
        email = self.email_row.get_text().strip()
        if not email or "@" not in email:
            self.signin_note.set_label("Type your email first.")
            return
        self.signin_button.set_sensitive(False)
        if not self.code_row.get_visible():
            def sent(_r, error):
                self.signin_button.set_sensitive(True)
                if error:
                    self.signin_note.set_label(error)
                    return
                self.code_row.set_visible(True)
                self.code_row.grab_focus()
                self.signin_button.set_label("Sign in")
                self.signin_note.set_label(f"We emailed {email}. Copy the “Sign in” link from the email and paste it here. "
                                        "If you already opened it, paste the address from your browser. If you ask "
                                        "again, only the newest email's link works.")
            self.background(lambda: self.session.send_code(email), sent)
            return
        code = self.code_row.get_text().strip()

        def verified(_r, error):
            self.signin_button.set_sensitive(True)
            if error:
                self.signin_note.set_label(error)
                return
            self.code_row.set_text("")
            self.stack.set_visible_child_name("main")
            self.reload()
        self.background(lambda: self.session.verify(email, code), verified)

    # --- Your authenticator app (2.8d) ------------------------------------------------------
    def two_step_needed(self, kind: str) -> Adw.AlertDialog | None:
        """The server wants an authenticator app code: ask for it, or set one up."""
        if getattr(self, "two_step_dialog", None) is not None:
            return None
        self.two_step_dialog = (self.ask_authenticator_code() if kind == "code" else
                                self.set_up_authenticator(required=True))
        self.two_step_dialog.connect("closed", lambda _d: setattr(self, "two_step_dialog", None))
        return self.two_step_dialog

    def code_dialog(self, heading: str, body: str, extra: Gtk.Widget | None, on_code) -> Adw.AlertDialog:
        dialog = Adw.AlertDialog(heading=heading, body=body)
        outer = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        if extra is not None:
            outer.append(extra)
        box = Gtk.ListBox(css_classes=["boxed-list"], selection_mode=Gtk.SelectionMode.NONE)
        code = Adw.EntryRow(title="6-digit code", input_purpose=Gtk.InputPurpose.DIGITS)
        box.append(code)
        outer.append(box)
        note = Gtk.Label(wrap=True, xalign=0, css_classes=["dim-label"])
        outer.append(note)
        dialog.set_extra_child(outer)
        dialog.add_response("cancel", "Cancel")
        dialog.add_response("ok", "Continue")
        dialog.set_response_appearance("ok", Adw.ResponseAppearance.SUGGESTED)
        dialog.set_response_enabled("ok", False)
        dialog.set_close_response("cancel")
        code.connect("changed", lambda e: dialog.set_response_enabled("ok", bool(re.fullmatch(r"\d{6}", e.get_text().strip()))))

        def answered(_d, response):
            if response == "ok":
                on_code(code.get_text().strip(), note, dialog)
            else:
                self.after_code = None  # cancelled: what was waiting for the code isn't done
        dialog.connect("response", answered)
        code.connect("entry-activated", lambda _e: dialog.get_response_enabled("ok") and
                     (dialog.close(), on_code(code.get_text().strip(), note, dialog)))
        dialog.set_can_close(True)
        dialog.present(self)
        return dialog

    def ask_authenticator_code(self) -> Adw.AlertDialog:
        def check(code: str, note: Gtk.Label, dialog: Adw.AlertDialog) -> None:
            def work():
                factors = [f for f in self.session.authenticators() if f.get("status") == "verified"]
                if not factors:
                    raise FleetError("No authenticator app is set up for this email")
                self.session.verify_authenticator(factors[0]["id"], code)

            def done(_r, error):
                if error:
                    self.toast(f"Not signed in: {error}")
                    return
                self.toast("Signed in with your authenticator app")
                self.reload()
                self.code_done()
            self.background(work, done)
        return self.code_dialog("Your authenticator app's code",
                                "Enter the 6-digit code from your authenticator app.",
                                None, check)

    def set_up_authenticator(self, required: bool = False) -> Adw.AlertDialog:
        holder = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        holder.append(Gtk.Label(label="Making a QR code…", css_classes=["dim-label"]))
        state: dict = {}

        def enrolled(result, error):
            for child in list(holder):
                holder.remove(child)
            if error:
                holder.append(Gtk.Label(label=error, wrap=True, css_classes=["error"]))
                return
            state["id"] = result.get("id")
            totp = result.get("totp") or {}
            try:
                png = subprocess.run(["qrencode", "-t", "PNG", "-s", "6", "-m", "2", "-o", "-", totp.get("uri", "")],
                                     capture_output=True, timeout=10, check=True).stdout
                picture = Gtk.Picture.new_for_paintable(Gdk.Texture.new_from_bytes(GLib.Bytes.new(png)))
                picture.set_size_request(220, 220)
                holder.append(picture)
            except (OSError, subprocess.SubprocessError, GLib.Error):
                pass
            secret = str(totp.get("secret") or "")
            holder.append(Gtk.Label(label=" ".join(secret[i:i + 4] for i in range(0, len(secret), 4)), selectable=True,
                                    wrap=True, css_classes=["monospace", "dim-label"]))

        def check(code: str, note: Gtk.Label, dialog: Adw.AlertDialog) -> None:
            if not state.get("id"):
                return

            def done(_r, error):
                if error:
                    self.toast(f"Not set up: {error}")
                    return
                self.toast("Authenticator app set up")
                self.reload()
                self.code_done()
            self.background(lambda: self.session.verify_authenticator(state["id"], code), done)
        dialog = self.code_dialog(
            "Set up an authenticator app",
            ("Your organisation requires an authenticator app for admins. " if required else "") +
            "Scan the QR code with an authenticator app on your phone, or type the key, then enter the code it shows. "
            "If you lose your phone, the Owner can reset it.",
            holder, check)
        if self.sample_mode():
            enrolled({"id": "f-sample", "totp": {"uri": "otpauth://totp/Kulan%20Fleet:admin?secret=JBSWY3DPEHPK3PXP",
                                                 "secret": "JBSWY3DPEHPK3PXP"}}, None)
        else:
            self.background(self.session.enroll_authenticator, enrolled)
        return dialog

    def my_authenticator(self) -> Adw.AlertDialog | None:
        """The menu's "Your authenticator app": set one up, or remove it."""
        def got(factors, error):
            if error:
                self.toast(error)
                return
            verified = [f for f in factors or [] if f.get("status") == "verified"]
            if not verified:
                self.set_up_authenticator()
                return
            dialog = Adw.AlertDialog(heading="Your authenticator app",
                                     body="Kulan Fleet asks for its code after your email code. Your organisation may "
                                          "require it, so remove it only to set it up again.")
            dialog.add_response("close", "Close")
            dialog.add_response("remove", "Remove it")
            dialog.set_response_appearance("remove", Adw.ResponseAppearance.DESTRUCTIVE)
            dialog.connect("response", lambda _d, r: r == "remove" and self.background(
                lambda: [self.session.remove_authenticator(f["id"]) for f in verified],
                lambda _r, err: self.toast(err or "Authenticator app removed")))
            dialog.present(self)
        self.call({}, got, [] ) if self.sample_mode() else self.background(self.session.authenticators, got)
        return None

    def sign_out(self) -> None:
        self.background(self.session.sign_out, lambda _r, _e: None)
        self.data, self.org_id, self.section = None, None, "computers"
        self.people_cache.clear()
        self.org_groups.clear()
        self.code_row.set_visible(False)
        self.signin_button.set_label("Email me a sign-in link")
        self.signin_note.set_label("Signed out.")
        self.stack.set_visible_child_name("signin")

    # --- main view -----------------------------------------------------------------------------
    def build_main(self) -> Gtk.Widget:
        # The sidebar: the organisation, its sections, and who's signed in.
        side = Adw.ToolbarView()
        side_header = Adw.HeaderBar(show_title=False)
        brand = Gtk.Box(spacing=8)
        brand.append(Gtk.Image(icon_name=APP_ID, pixel_size=20))
        brand.append(Gtk.Label(label="Kulan Fleet", css_classes=["fleet-brand"]))
        side_header.pack_start(brand)
        self.new_org_button = Gtk.Button(icon_name="list-add-symbolic", tooltip_text="New organisation",
                                         visible=False)
        self.new_org_button.connect("clicked", lambda _b: self.new_org())
        side_header.pack_end(self.new_org_button)
        side.add_top_bar(side_header)
        column = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        self.org_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4, margin_start=12, margin_end=12,
                               margin_top=4, margin_bottom=8)
        self.org_box.append(Gtk.Label(label="Organisation", xalign=0, css_classes=["fleet-small"]))
        self.org_model = Gtk.StringList()
        self.org_pick = Gtk.DropDown(model=self.org_model)
        names = Gtk.SignalListItemFactory()  # long names are cut short, not a wider sidebar
        names.connect("setup", lambda _f, item: item.set_child(Gtk.Label(xalign=0, ellipsize=Pango.EllipsizeMode.END,
                                                                         width_chars=8, max_width_chars=24)))
        names.connect("bind", lambda _f, item: item.get_child().set_label(item.get_item().get_string()))
        self.org_pick.set_factory(names)
        self.org_pick.update_property([Gtk.AccessibleProperty.LABEL], ["Organisation"])
        self.org_pick.connect("notify::selected", self.on_org_picked)
        self.org_box.append(self.org_pick)
        column.append(self.org_box)
        self.org_ids: list[str] = []
        self.updating_orgs = False
        self.section_list = Gtk.ListBox(css_classes=["navigation-sidebar", "fleet-sections"])
        self.section_rows: dict[str, Gtk.ListBoxRow] = {}
        self.section_counts: dict[str, Gtk.Label] = {}
        for key, label, icon in SECTIONS:
            row = Gtk.ListBoxRow()
            row.section = key
            line = Gtk.Box(spacing=12)
            line.append(Gtk.Image(icon_name=icon))
            line.append(Gtk.Label(label=label, xalign=0, hexpand=True))
            count = Gtk.Label(css_classes=["fleet-count"])
            line.append(count)
            row.set_child(line)
            self.section_list.append(row)
            self.section_rows[key], self.section_counts[key] = row, count
        self.section_list.connect("row-selected", self.on_section)
        # Tapping the section already chosen (a narrow window shows the sidebar alone) opens it.
        self.section_list.connect("row-activated", lambda _l, _r: self.data is not None and self.split.set_show_content(True))
        column.append(Gtk.ScrolledWindow(child=self.section_list, vexpand=True,
                                         hscrollbar_policy=Gtk.PolicyType.NEVER))
        me = Gtk.Box(spacing=10, css_classes=["fleet-me"])
        self.me_avatar = Adw.Avatar(size=32, show_initials=True)
        me.append(self.me_avatar)
        who = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, valign=Gtk.Align.CENTER)
        self.me_email = Gtk.Label(xalign=0, ellipsize=Pango.EllipsizeMode.END, css_classes=["heading"])
        self.me_role = Gtk.Label(label="Kulan Fleet admin", xalign=0, css_classes=["fleet-small"])
        who.append(self.me_email)
        who.append(self.me_role)
        me.append(who)
        column.append(me)
        side.set_content(column)
        sidebar = Adw.NavigationPage(title="Kulan Fleet", child=side)

        # The content: one page per section, with what's opened from it pushed on top.
        self.nav = Adw.NavigationView()
        self.content_page = Adw.NavigationPage(title="Computers", child=self.nav)
        for name, handler in (("sign-out", self.sign_out), ("recover", self.recover_owner),
                              ("authenticator", self.my_authenticator)):
            action = Gio.SimpleAction.new(name, None)
            action.connect("activate", lambda *_a, h=handler: h())
            self.add_action(action)
        self.section = "computers"
        self.page: Adw.PreferencesPage | None = None
        self.groups: list[Adw.PreferencesGroup] = []
        self.people_cache: dict[str, list[dict]] = {}
        self.rendering = False
        self.split = Adw.NavigationSplitView(sidebar=sidebar, content=self.content_page, min_sidebar_width=220,
                                             max_sidebar_width=260)
        self.status_page("Loading your organisations…", "", spinner=True)
        breakpoint_ = Adw.Breakpoint.new(Adw.BreakpointCondition.parse("max-width: 860sp"))
        breakpoint_.add_setter(self.split, "collapsed", True)
        self.add_breakpoint(breakpoint_)
        return self.split

    def header(self, root: bool) -> Adw.HeaderBar:
        """The content's header bar: Refresh and the menu."""
        header = Adw.HeaderBar(show_title=not root)
        refresh = Gtk.Button(icon_name="view-refresh-symbolic", tooltip_text="Refresh")
        refresh.connect("clicked", lambda _b: self.reload())
        menu = Gio.Menu()
        menu.append("Your authenticator app…", "win.authenticator")
        menu.append("Become the Owner with a recovery code…", "win.recover")
        menu.append("Sign out", "win.sign-out")
        header.pack_end(Gtk.MenuButton(icon_name="open-menu-symbolic", menu_model=menu, tooltip_text="Menu"))
        header.pack_end(refresh)
        return header

    def status_page(self, title: str, description: str, spinner: bool = False) -> None:
        view = Adw.ToolbarView()
        view.add_top_bar(self.header(False))
        status = Adw.StatusPage(title=title, description=GLib.markup_escape_text(description))
        if spinner:
            status.set_child(Gtk.Spinner(spinning=True, width_request=32, height_request=32))
        view.set_content(status)
        self.nav.replace([Adw.NavigationPage(title="Kulan Fleet", child=view, tag="org")])
        self.page, self.groups = None, []

    def section_page(self, key: str, subtitle: str | None = None) -> tuple[Adw.PreferencesPage, Gtk.Box]:
        """A section's page, in place of whatever was showing: (page, the box for its buttons)."""
        label = SECTION_LABEL[key]
        view = Adw.ToolbarView()
        view.add_top_bar(self.header(True))
        page = Adw.PreferencesPage()
        view.set_content(page)
        head = Adw.PreferencesGroup()
        line = Gtk.Box(spacing=12)
        texts = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4, hexpand=True)
        texts.append(Gtk.Label(label=label, xalign=0, css_classes=["fleet-title"]))
        self.page_sub = Gtk.Label(label=subtitle or SECTION_SUB.get(key, ""), xalign=0, wrap=True,
                                  css_classes=["fleet-sub"], visible=bool(subtitle or SECTION_SUB.get(key)))
        texts.append(self.page_sub)
        actions = Gtk.Box(spacing=8, valign=Gtk.Align.CENTER)
        line.append(texts)
        line.append(actions)
        head.add(line)
        page.add(head)
        self.nav.replace([Adw.NavigationPage(title=label, child=view, tag="org")])
        self.content_page.set_title(label)
        self.page, self.groups = page, []
        self.section = key
        row = self.section_rows.get(key)
        if row is not None and self.section_list.get_selected_row() is not row:
            self.choosing_section = True
            self.section_list.select_row(row)
            self.choosing_section = False
        return page, actions

    def reload(self) -> None:
        first = self.data is None
        if first:  # nothing to show yet: say it's loading, not a blank window
            self.status_page("Loading your organisations…", "", spinner=True)

        def done(result, error):
            if error:
                if "sign in" in error.lower():
                    self.sign_out()
                elif first:
                    self.status_page("Couldn’t load", error + " Press Refresh to try again.")
                self.toast(error)
                return
            self.data = result
            self.show_data()
        self.background(lambda: self.session.call({"op": "overview"}), done)

    def show_data(self) -> None:
        data = self.data or {}
        self.new_org_button.set_visible(bool(data.get("global")))
        email = self.session.email or ("admin@kulan.example" if self.sample_mode() else "")
        self.me_avatar.set_text(email)
        self.me_email.set_label(email or "Signed in")
        self.me_role.set_label("Kulan Fleet admin, all organisations" if data.get("global") else "Kulan Fleet admin")
        orgs = data.get("organisations", [])
        self.org_ids = [o["id"] for o in orgs]
        keep = self.org_id if self.org_id in self.org_ids else (self.org_ids[0] if self.org_ids else None)
        self.updating_orgs = True
        self.org_model.splice(0, self.org_model.get_n_items(), [o["name"] for o in orgs])
        if keep:
            self.org_pick.set_selected(self.org_ids.index(keep))
        self.updating_orgs = False
        self.org_box.set_visible(bool(orgs))
        self.org_id = keep
        self.render_section()

    def on_org_picked(self, pick: Gtk.DropDown, _p) -> None:
        i = pick.get_selected()
        if self.updating_orgs or i >= len(self.org_ids):
            return
        if self.org_ids[i] != self.org_id:
            self.org_id = self.org_ids[i]
            self.render_section()

    def on_section(self, _list, row) -> None:
        if row is None or getattr(self, "choosing_section", False) or self.data is None:
            return  # (still loading, or couldn't load: its page stays)
        self.section = row.section
        self.split.set_show_content(True)
        self.render_section()

    def current_org(self) -> dict | None:
        return next((o for o in (self.data or {}).get("organisations", []) if o["id"] == self.org_id), None)

    def update_counts(self, org: dict | None) -> None:
        counts = {"computers": len([d for d in self.org_computers(org) if not d.get("left_at")]) if org else None,
                  "people": len(self.people_cache[org["id"]]) if org and org["id"] in self.people_cache else None,
                  "groups": len(self.org_groups[org["id"]]) if org and org["id"] in self.org_groups else None}
        for key, label in self.section_counts.items():
            label.set_label(str(counts[key]) if counts.get(key) is not None else "")

    def render_section(self) -> None:
        """The chosen section of the chosen organisation, built afresh."""
        data = self.data or {}
        org = self.current_org()
        self.update_counts(org)
        if not org:
            self.section_page(self.section, "Add one with the + button." if data.get("global") else
                              "Ask the fleet owner to add you to one.")
            self.add_group().add(Gtk.Label(label="No organisation yet", xalign=0, css_classes=["title-2"]))
            return

        def loaded(oid: str) -> None:
            """Counts, and on the computers' list people's names and groups, once they're known."""
            if oid != self.org_id:
                return
            self.update_counts(self.current_org())
            if (not self.rendering and self.section == "computers" and self.nav.get_visible_page().get_tag() == "org"
                    and not getattr(self, "computer_search", Gtk.SearchEntry()).get_text()):
                self.render_computers(self.current_org())
        self.rendering = True  # (replies straight away with sample data: the page is built just below)
        if org["id"] not in self.org_groups and self.section != "groups":  # (Groups loads them itself)
            self.load_groups(org, lambda _g, error, oid=org["id"]: error or loaded(oid))
        if org["id"] not in self.people_cache and self.section != "people":  # (and People them)
            def got_people(result, error, oid=org["id"]) -> None:
                if not error:
                    self.people_cache[oid] = (result or {}).get("people") or []
                    loaded(oid)
            self.call({"op": "people", "organisation_id": org["id"]}, got_people,
                      lambda: {"people": (self.data or {}).get("sample_people", [])})
        self.rendering = False
        {"computers": self.render_computers, "people": self.open_people, "groups": self.open_groups,
         "policy": self.render_policy, "scripts": self.open_scripts, "activity": self.render_activity,
         "settings": self.open_admins}[self.section](org)

    def render_org(self) -> None:  # the older name, still used after changes
        self.render_section()

    def clear(self) -> None:
        if self.page is not None:
            for g in self.groups:
                self.page.remove(g)
        self.groups = []

    def add_group(self, title: str = "", description: str = "") -> Adw.PreferencesGroup:
        g = Adw.PreferencesGroup(title=title, description=description)
        self.page.add(g)
        self.groups.append(g)
        return g

    def policy_group(self, org: dict) -> None:
        group = self.add_group()

        def save(new, done):
            if self.sample_mode():
                org["policy"] = new
                done(new, None)
                return
            self.background(lambda: self.session.call({"op": "set-policy", "organisation_id": org["id"], "policy": new}),
                            lambda r, error: done((r or {}).get("policy", new), error))
        self.policy_editor(group, org.get("policy") or {}, save, lambda: self.render_org())

    def policy_editor(self, group: Adw.PreferencesGroup, saved: dict, save, reset) -> None:
        """The policy's rows in `group`; each change is saved with save(new, done(policy, error))."""
        policy = dict(saved)
        rows = {}
        for key, subtitle in (("auto_updates", "Install updates automatically, with a restore point first"),
                              ("firewall", "Block incoming connections")):
            row = Adw.SwitchRow(title=POLICY_LABEL[key], subtitle=subtitle, active=bool(policy.get(key)))
            group.add(row)
            rows[key] = row
        lock = Adw.ComboRow(title=POLICY_LABEL["screen_lock_minutes"], subtitle="Locks when idle. Users can't "
                            "turn it off.", model=Gtk.StringList.new([t for _m, t in SCREEN_LOCK]))
        minutes = int(policy.get("screen_lock_minutes") or 0)
        lock.set_selected(next((i for i, (m, _t) in enumerate(SCREEN_LOCK) if m == minutes), 0))
        group.add(lock)
        enc = Adw.SwitchRow(title="Require disk encryption", subtitle="Can't be turned on remotely. Computers without it show an alert.",
                            active=bool(policy.get("require_encryption")))
        group.add(enc)
        rows["require_encryption"] = enc
        two = Adw.ComboRow(title=POLICY_LABEL["two_step"], model=Gtk.StringList.new([t for _v, t in TWO_STEP_CHOICES]),
                           subtitle="A security key or phone code after the password. People set it up in Kulan "
                                    "Settings and are reminded until they do.", subtitle_lines=0)
        two.set_selected(next((i for i, (v, _t) in enumerate(TWO_STEP_CHOICES) if v == policy.get("two_step")), 0))
        group.add(two)
        usb = Adw.ComboRow(title=POLICY_LABEL["usb"], model=Gtk.StringList.new([t for _v, t, _h in USB_CHOICES]),
                           subtitle_lines=0)
        usb.set_selected(next((i for i, (v, _t, _h) in enumerate(USB_CHOICES) if v == policy.get("usb")), 0))
        usb.set_subtitle(USB_CHOICES[usb.get_selected()][2] + ". Keyboards, mice and other USB devices always work")
        group.add(usb)
        apps_rows = {}
        for key, title in (("required_apps", "Required apps"), ("blocked_apps", "Blocked apps")):
            row = Adw.ActionRow(title=title, activatable=True, subtitle_lines=2)
            row.add_suffix(Gtk.Image(icon_name="go-next-symbolic"))
            group.add(row)
            apps_rows[key] = row

        def show_apps() -> None:
            for key, row in apps_rows.items():
                apps = policy.get(key) or []
                row.set_subtitle(GLib.markup_escape_text(", ".join(a["id"] for a in apps[:6]) + (" …" if len(apps) > 6 else ""))
                                 if apps else ("Installed and kept on every computer" if key == "required_apps"
                                               else "Removed and kept off every computer"))
        show_apps()

        def collect() -> dict:
            new = {key: True for key, row in rows.items() if row.get_active()}
            mins = SCREEN_LOCK[lock.get_selected()][0]
            if mins:
                new["screen_lock_minutes"] = mins
            if USB_CHOICES[usb.get_selected()][0]:
                new["usb"] = USB_CHOICES[usb.get_selected()][0]
            if TWO_STEP_CHOICES[two.get_selected()][0]:
                new["two_step"] = TWO_STEP_CHOICES[two.get_selected()][0]
            for key in apps_rows:
                if policy.get(key):
                    new[key] = policy[key]
            return new

        def changed(*_a) -> None:
            usb.set_subtitle(USB_CHOICES[usb.get_selected()][2] + ". Keyboards, mice and other USB devices always work")
            new = collect()
            if new == {k: v for k, v in saved.items() if v}:
                return

            def done(result, error):
                if error:
                    self.toast(error)
                    reset()  # back to what's saved
                    return
                saved.clear()
                saved.update(result or new)
                self.toast("Policy saved")
            save(new, done)
        for row in rows.values():
            row.connect("notify::active", changed)
        lock.connect("notify::selected", changed)
        usb.connect("notify::selected", changed)
        two.connect("notify::selected", changed)

        def edit_apps(key: str) -> None:
            def chosen(apps: list[dict]) -> None:
                if apps:
                    policy[key] = apps
                else:
                    policy.pop(key, None)
                show_apps()
                changed()
            self.apps_dialog(key, list(policy.get(key) or []), chosen)
        for key, row in apps_rows.items():
            row.connect("activated", lambda _r, k=key: edit_apps(k))

    def apps_dialog(self, key: str, apps: list[dict], chosen) -> Adw.AlertDialog:
        blocking = key == "blocked_apps"
        dialog = Adw.AlertDialog(heading="Blocked apps" if blocking else "Required apps",
                                 body="Removed from the computers and kept off. A Debian package stays if removing it "
                                      "would remove other packages. Parts of Kulan OS can't be blocked." if blocking
                                 else "Installed from Debian or Flathub, and reinstalled if someone removes it.")
        listing = Gtk.ListBox(css_classes=["boxed-list"], selection_mode=Gtk.SelectionMode.NONE)
        adding = Gtk.ListBox(css_classes=["boxed-list"], selection_mode=Gtk.SelectionMode.NONE, margin_top=12)
        source = Adw.ComboRow(title="From", model=Gtk.StringList.new([SOURCE_LABEL["debian"], SOURCE_LABEL["flatpak"]]))
        entry = Adw.EntryRow(title="App to add (for example vlc, or org.videolan.VLC)", show_apply_button=True)
        adding.append(source)
        adding.append(entry)
        note = Gtk.Label(wrap=True, xalign=0, css_classes=["dim-label"], margin_top=6)
        outer = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        outer.append(listing)
        outer.append(adding)
        outer.append(note)
        dialog.set_extra_child(outer)

        def show() -> None:
            while (child := listing.get_first_child()) is not None:
                listing.remove(child)
            if not apps:
                listing.append(Adw.ActionRow(title="None yet"))
            for a in apps:
                row = Adw.ActionRow(title=GLib.markup_escape_text(a["id"]), subtitle=SOURCE_LABEL[a["source"]])
                remove = Gtk.Button(icon_name="user-trash-symbolic", tooltip_text="Remove", valign=Gtk.Align.CENTER,
                                    css_classes=["flat"])
                remove.connect("clicked", lambda _b, app=a: (apps.remove(app), show()))
                row.add_suffix(remove)
                listing.append(row)
        show()

        def add(_e=None) -> None:
            src = "flatpak" if source.get_selected() == 1 else "debian"
            app_id = entry.get_text().strip()
            problem = app_problem(src, app_id, blocking)
            if not app_id or problem:
                note.set_label(problem or "")
                return
            if not any(a["source"] == src and a["id"] == app_id for a in apps):
                apps.append({"source": src, "id": app_id})
            entry.set_text("")
            note.set_label("")
            show()
        entry.connect("apply", add)
        entry.connect("entry-activated", add)
        dialog.add_response("cancel", "Cancel")
        dialog.add_response("save", "Save")
        dialog.set_response_appearance("save", Adw.ResponseAppearance.SUGGESTED)

        def answered(_d, response):
            if response == "save":
                add()  # an app typed but not added yet
                chosen(apps)
        dialog.connect("response", answered)
        dialog.present(self)
        return dialog

    def alerts_group(self, org: dict) -> None:
        # Help requests have their own list, just below.
        alerts = [a for a in (self.data or {}).get("alerts", []) if a.get("organisation_id") == org["id"]
                  and a.get("kind") != "help"]
        devices = {d["id"]: d for d in (self.data or {}).get("devices", [])}
        group = self.add_group("Needs attention") if alerts else None
        for a in alerts[:30]:
            row = Adw.ActionRow(title=GLib.markup_escape_text(a.get("title") or a.get("hostname") or "Computer"),
                                subtitle=GLib.markup_escape_text(a.get("text", "")), activatable=True)
            row.add_prefix(Gtk.Image(icon_name=ALERT_ICON.get(a.get("kind"), "dialog-warning-symbolic")))
            row.add_suffix(Gtk.Image(icon_name="go-next-symbolic"))
            dev = devices.get(a.get("device_id"))
            if a.get("kind") == "help" and a.get("request_id"):
                row.connect("activated", lambda _r, rid=a["request_id"]: self.open_help_request(org, rid))
            elif dev:
                row.connect("activated", lambda _r, d=dev: self.open_device(d))
            elif a.get("kind") == "review":
                row.connect("activated", lambda _r: self.open_review(org))
            elif a.get("kind") == "mailbox":
                row.connect("activated", lambda _r: self.open_people(org))
            elif a.get("kind") == "mail":
                row.connect("activated", lambda _r: self.open_mail(org))
            group.add(row)
        if len(alerts) > 30:
            group.add(Adw.ActionRow(title=f"And {len(alerts) - 30} more"))
        self.help_requests_group(org)

    # --- Get help (2.9c) ----------------------------------------------------------------------
    def help_requests_group(self, org: dict) -> None:
        """What people asked for in Settings › Get help: open ones first, then those done this week."""
        requests = [h for h in (self.data or {}).get("help_requests", []) if h.get("organisation_id") == org["id"]]
        if not requests:
            return
        group = self.add_group("Help requests", "What people asked for in Settings › Get help on their computers")
        for h in requests[:30]:
            first = (str(h.get("body") or "").splitlines() or [""])[0]
            done = h.get("state") == "done"
            row = Adw.ActionRow(title=GLib.markup_escape_text(f"{h.get('full_name') or h.get('username')} on "
                                                              f"{h.get('hostname') or 'a computer'}"),
                                subtitle=GLib.markup_escape_text(" · ".join(x for x in (
                                    ago(h.get("created_at")), "Done" if done else "", first[:120]) if x)),
                                activatable=True)
            row.add_prefix(Gtk.Image(icon_name="object-select-symbolic" if done else "help-browser-symbolic"))
            if h.get("has_screenshot"):
                row.add_suffix(Gtk.Image(icon_name="camera-photo-symbolic", tooltip_text="Has a screenshot"))
            row.add_suffix(Gtk.Image(icon_name="go-next-symbolic"))
            row.connect("activated", lambda _r, rid=h["id"]: self.open_help_request(org, rid))
            group.add(row)

    def open_help_request(self, org: dict, request_id: str) -> None:
        view = Adw.ToolbarView()
        view.add_top_bar(Adw.HeaderBar())
        page = Adw.PreferencesPage()
        view.set_content(page)
        self.nav.push(Adw.NavigationPage(title="Help request", child=view))
        about = Adw.PreferencesGroup(title="Help request", description="Loading…")
        page.add(about)
        self.help_page = page  # for the self-test

        def done(r, error):
            if error:
                about.set_description(error)
                return
            h = (r or {}).get("request") or {}
            who = f"{h['full_name']} ({h.get('username')})" if h.get("full_name") else h.get("username") or "Someone"
            about.set_title(GLib.markup_escape_text(f"From {who}"))
            about.set_description(GLib.markup_escape_text(f"{h.get('hostname') or 'A computer'} · {ago(h.get('created_at'))}"))
            text = Gtk.Label(label=str(h.get("body") or ""), wrap=True, xalign=0, selectable=True, margin_top=4,
                             margin_bottom=4)
            about.add(text)
            if h.get("screenshot"):
                try:
                    texture = Gdk.Texture.new_from_bytes(GLib.Bytes.new(base64.b64decode(h["screenshot"])))
                    shot = Adw.PreferencesGroup(title="Screenshot", description="Kept for 30 days")
                    shot.add(Gtk.Picture(paintable=texture, content_fit=Gtk.ContentFit.CONTAIN, height_request=320,
                                         can_shrink=True, alternative_text="The screenshot they added"))
                    page.add(shot)
                except (GLib.Error, ValueError):
                    pass
            device = next((d for d in self.org_computers(org) if d["id"] == h.get("device_id")), None)
            actions = Adw.PreferencesGroup()
            page.add(actions)
            if device:
                remote = Adw.ActionRow(title="Start remote help", subtitle="They’re asked first, and see your email",
                                       activatable=True)
                remote.add_prefix(Gtk.Image(icon_name="preferences-desktop-remote-desktop-symbolic"))
                remote.add_suffix(Gtk.Image(icon_name="adw-external-link-symbolic"))
                remote.connect("activated", lambda _r: self.open_remote_help(device))
                actions.add(remote)
            if h.get("state") == "done":
                actions.add(Adw.ActionRow(title="Done", subtitle=GLib.markup_escape_text(
                    f"{ago(h.get('done_at'))} by {h.get('done_by') or '–'}" +
                    (f" · Answer: {h['reply']}" if h.get("reply") else " · No answer was written")), subtitle_lines=0))
                return
            answer_group = Adw.PreferencesGroup(title="Answer", description="Optional. It appears on their screen when you "
                                                                             "mark the request done")
            answer = Gtk.TextView(wrap_mode=Gtk.WrapMode.WORD_CHAR, top_margin=10, bottom_margin=10, left_margin=12,
                                  right_margin=12, accepts_tab=False)
            answer.update_property([Gtk.AccessibleProperty.LABEL], ["Answer"])
            answer_group.add(Gtk.Frame(child=Gtk.ScrolledWindow(child=answer, min_content_height=90,
                                                                hscrollbar_policy=Gtk.PolicyType.NEVER)))
            mark = Gtk.Button(label="Mark as done", css_classes=["suggested-action", "pill"], halign=Gtk.Align.END,
                              margin_top=12)
            answer_group.add(mark)
            page.add(answer_group)
            self.help_answer, self.help_mark = answer, mark  # for the self-test

            def close_it(_b) -> None:
                buf = answer.get_buffer()
                reply = buf.get_text(buf.get_start_iter(), buf.get_end_iter(), False).strip()
                if len(reply) > 500:
                    self.toast("The answer is up to 500 characters")
                    return
                mark.set_sensitive(False)
                body = {"op": "close-help", "request_id": request_id, **({"reply": reply} if reply else {})}
                self.last_close_help = body  # for the self-test

                def closed(_r, err):
                    if err:
                        mark.set_sensitive(True)
                        self.toast(err)
                        return
                    self.toast("Marked as done" + (". Your answer goes to their screen" if reply else ""))
                    if self.sample_mode():
                        h["state"] = "done"
                        return
                    self.nav.pop()
                    self.reload()
                self.call(body, closed, {})
            mark.connect("clicked", close_it)
        self.call({"op": "help-request", "request_id": request_id}, done,
                  lambda: {"request": next((dict(h) for h in (self.data or {}).get("sample_help", []) if h["id"] == request_id), {})})

    def render_computers(self, org: dict) -> None:
        data = self.data or {}
        devices = [d for d in data.get("devices", []) if d["organisation_id"] == org["id"]]
        active = [d for d in devices if not d.get("left_at")]
        latest = max((d.get("last_seen") or "" for d in active), default="")
        page, actions = self.section_page("computers", " · ".join(x for x in (
            plural(len(active), "computer"), f"last report {ago(latest)}" if latest else "") if x))
        search = Gtk.SearchEntry(placeholder_text="Search by name, person or model", hexpand=True, margin_top=6,
                                 margin_bottom=6, margin_start=6, margin_end=6)
        add = Gtk.Button(label="Add computers", css_classes=["suggested-action"])
        add.connect("clicked", lambda _b: self.add_computers_dialog(org))
        actions.append(add)
        alerts = [a for a in data.get("alerts", []) if a.get("organisation_id") == org["id"]]
        self.add_group().add(self.health_card(active, alerts))
        self.alerts_group(org)

        # Every computer, the most urgent first, by tab and search.
        names = {p["username"]: p.get("full_name") or p["username"] for p in self.people_cache.get(org["id"], [])}
        group_names = {}
        for g in self.org_groups.get(org["id"], []):
            for i in g.get("devices") or []:
                group_names.setdefault(i, []).append(g["name"])
        group = self.add_group("All computers", "Computers report every hour.")
        tabs = Gtk.Box(css_classes=["linked"], valign=Gtk.Align.CENTER)
        # Scrolls sideways rather than widen the page when every tab shows.
        group.set_header_suffix(Gtk.ScrolledWindow(child=tabs, propagate_natural_width=True,
                                                   vscrollbar_policy=Gtk.PolicyType.NEVER, valign=Gtk.Align.CENTER))
        group.add(Adw.PreferencesRow(child=search, activatable=False, title="Search"))
        rows = []
        for d in sorted(devices, key=lambda x: (HEALTH_RANK[health(x, alerts)[2]], (x.get("hostname") or "").lower())):
            label, kind, where = health(d, alerts)
            person = used_by(d, names)
            subtitle = " · ".join(x for x in (device_model(d), ", ".join(group_names.get(d["id"], [])),
                                               f"used by {person}" if person else "",
                                               f"left {ago(d['left_at'])}" if d.get("left_at") else
                                               f"last report {ago(d.get('last_seen'))}") if x)
            row = Adw.ActionRow(title=GLib.markup_escape_text(d.get("hostname") or "(no name)"),
                                subtitle=GLib.markup_escape_text(subtitle), activatable=True)
            row.add_prefix(Gtk.Image(icon_name="computer-symbolic"))
            row.add_suffix(tag(label, kind))
            if not d.get("left_at"):
                row.add_suffix(updates_tag(d))
            row.add_suffix(Gtk.Image(icon_name="go-next-symbolic"))
            row.connect("activated", lambda _r, dev=d: self.open_device(dev))
            group.add(row)
            text = " ".join((d.get("hostname") or "", device_model(d), person,
                             *(x.get("username", "") for x in d.get("sign_ins") or []))).lower()
            rows.append((row, where, text))
        empty = Adw.ActionRow(title="No computers yet" if not devices else "No computers here",
                              subtitle="Add them with Add computers" if not devices else "")
        group.add(empty)
        state = {"tab": "all"}

        def show(*_a) -> None:
            words = search.get_text().strip().lower().split()
            shown = 0
            for row, where, text in rows:
                in_tab = (where != "left" if state["tab"] == "all" else
                          where in ("attention", "lost") if state["tab"] == "attention" else where == state["tab"])
                row.set_visible(in_tab and all(w in text for w in words))
                shown += row.get_visible()
            empty.set_visible(not shown)
        first = None
        for key, label in COMPUTER_TABS:
            n = sum(1 for _r, where, _t in rows if (where != "left" if key == "all" else
                                                    where in ("attention", "lost") if key == "attention" else where == key))
            if key not in ("all", "attention") and not n:
                continue  # only the tabs with something in them
            button = Gtk.ToggleButton(label=f"{label} {n}", active=key == "all", group=first)
            first = first or button
            button.connect("toggled", lambda b, k=key: b.get_active() and (state.__setitem__("tab", k), show()))
            tabs.append(button)
        search.connect("search-changed", show)
        show()
        self.computer_rows = rows  # for the self-test
        self.computer_search = search

    def health_card(self, active: list[dict], alerts: list[dict]) -> Gtk.Widget:
        """Fleet health: how many are healthy, need attention or are offline, as one bar."""
        kinds = [health(d, alerts)[2] for d in active]
        good = kinds.count("healthy")
        attention = kinds.count("attention") + kinds.count("lost")
        away = kinds.count("offline")
        baseline = sum(1 for d in active if d.get("compliance_total") and d.get("compliance_passed") == d.get("compliance_total"))
        card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10, css_classes=["card", "fleet-health"])
        top = Gtk.Box(spacing=8)
        top.append(Gtk.Label(label="Fleet health", xalign=0, hexpand=True, css_classes=["heading"]))
        top.append(Gtk.Label(label=f"{baseline} of {len(active)} meet the compliance baseline", css_classes=["fleet-small"]))
        card.append(top)
        bar = Gtk.DrawingArea(content_height=10, hexpand=True)
        parts = [(good, (0.051, 0.580, 0.533)), (attention, (0.961, 0.620, 0.043)), (away, (0.580, 0.639, 0.722))]

        def draw(_area, cr, width, height) -> None:
            total = sum(n for n, _c in parts)
            radius = height / 2
            cr.new_sub_path()
            cr.arc(radius, radius, radius, 1.5708, 4.7124)
            cr.arc(width - radius, radius, radius, -1.5708, 1.5708)
            cr.close_path()
            cr.clip()
            cr.set_source_rgba(0.5, 0.5, 0.5, 0.15)
            cr.paint()
            x = 0.0
            for n, (r, g, b) in parts:
                if total and n:
                    w = width * n / total
                    cr.set_source_rgb(r, g, b)
                    cr.rectangle(x, 0, w, height)
                    cr.fill()
                    x += w
        bar.set_draw_func(draw)
        bar.update_property([Gtk.AccessibleProperty.LABEL],
                            [f"{good} healthy, {attention} need attention, {away} offline for over a day"])
        card.append(bar)
        legend = Gtk.Box(spacing=18)
        for n, text, kind in ((good, "healthy", "good"), (attention, "need attention", "warn"),
                              (away, "offline for over a day", "dim")):
            item = Gtk.Box(spacing=6)
            item.append(Gtk.Box(css_classes=["fleet-dot", kind], valign=Gtk.Align.CENTER))
            item.append(Gtk.Label(label=f"{n} {text}", css_classes=["fleet-sub"]))
            legend.append(item)
        card.append(legend)
        self.health_text = f"{good} healthy, {attention} need attention, {away} offline"  # for the self-test
        return card

    def add_computers_dialog(self, org: dict) -> Adw.AlertDialog:
        dialog = Adw.AlertDialog(heading="Add computers",
                                 body="Make a join code. On each computer, open Kulan Settings › About › Organisation › "
                                      "Join an organisation, and type it there. Installing on new computers? Put the code "
                                      "on the USB stick with Kulan USB Maker (For an organisation): every computer "
                                      "installed from it joins by itself.")
        rows = Gtk.ListBox(css_classes=["boxed-list"], selection_mode=Gtk.SelectionMode.NONE)
        hours = Adw.ComboRow(title="Code works for", model=Gtk.StringList.new(["1 day", "3 days", "1 week", "30 days"]),
                             selected=1)
        uses = Adw.SpinRow.new_with_range(1, 500, 1)
        uses.set_title("Number of computers")
        rows.append(hours)
        rows.append(uses)
        # The join codes still usable (never the codes themselves), each with Withdraw.
        codes = Gtk.ListBox(css_classes=["boxed-list"], selection_mode=Gtk.SelectionMode.NONE, visible=False)
        holder = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
        holder.append(rows)
        codes_title = Gtk.Label(label="Join codes still usable", xalign=0, css_classes=["heading"], visible=False)
        holder.append(codes_title)
        holder.append(codes)
        dialog.set_extra_child(holder)

        def show_codes(result, error):
            while (child := codes.get_first_child()) is not None:
                codes.remove(child)
            listed = [] if error else (result or {}).get("codes", [])
            codes.set_visible(bool(listed))
            codes_title.set_visible(bool(listed))
            for c in listed:
                row = Adw.ActionRow(title=GLib.markup_escape_text(f"Made {ago(c.get('created_at'))} by {c.get('created_by') or 'an admin'}"),
                                    subtitle=GLib.markup_escape_text(
                                        f"{c.get('uses_left')} of {c.get('uses') or c.get('uses_left')} left · until "
                                        f"{str(c.get('expires_at', ''))[:10]}"
                                        + ("" if c.get("trusted") else " · computers wait for approval")),
                                    subtitle_lines=0)
                button = Gtk.Button(label="Withdraw", valign=Gtk.Align.CENTER)
                button.connect("clicked", lambda _b, cid=c["id"]: self.call(
                    {"op": "revoke-code", "organisation_id": org["id"], "code_id": cid},
                    lambda _r, err: self.toast(err) if err else load_codes()))
                row.add_suffix(button)
                codes.append(row)

        def load_codes():
            self.call({"op": "codes", "organisation_id": org["id"]}, show_codes,
                      lambda: {"codes": (self.data or {}).get("sample_codes", [])})
        self.codes_list = codes  # for the self-test
        load_codes()
        dialog.add_response("cancel", "Cancel")
        dialog.add_response("make", "Make a join code")
        dialog.set_response_appearance("make", Adw.ResponseAppearance.SUGGESTED)
        dialog.set_close_response("cancel")
        dialog.connect("response", lambda _d, r: r == "make" and self.make_code(org["id"], hours.get_selected(),
                                                                                int(uses.get_value())))
        dialog.present(self)
        return dialog

    def render_policy(self, org: dict) -> None:
        page, actions = self.section_page("policy")
        self.policy_group(org)

    def render_activity(self, org: dict) -> None:
        page, actions = self.section_page("activity")
        security = self.add_group()
        for title, subtitle, icon, opener in (
                ("Weekly security report", "This week compared with last, ready to save as a PDF", "security-high-symbolic", self.open_weekly),
                ("Admin-rights review", "Check who has administrator rights, every 90 days", "security-medium-symbolic", self.open_review),
                ("Activity log", "Who changed what, and when. Search it, or export it as a CSV file.",
                 "document-open-recent-symbolic", self.open_log)):
            row = Adw.ActionRow(title=title, subtitle=subtitle, activatable=True, subtitle_lines=2)
            row.add_prefix(Gtk.Image(icon_name=icon))
            row.add_suffix(Gtk.Image(icon_name="go-next-symbolic"))
            row.connect("activated", lambda _r, f=opener: f(org))
            security.add(row)
        data = self.data or {}
        names = {d["id"]: d.get("hostname") or "" for d in data.get("devices", [])}
        ids = {d["id"] for d in data.get("devices", []) if d["organisation_id"] == org["id"]}
        acts = [a for a in data.get("actions", []) if a["device_id"] in ids][:15]
        history = self.add_group("Recent requests", "What was asked of the computers, newest first")
        if not acts:
            history.add(Adw.ActionRow(title="Nothing asked yet"))
        for a in acts:
            what = FIX_LABEL.get(a.get("what"), a.get("what")) if a["type"] == "run-fix" else a.get("what")
            label = ACTION_LABEL.get(a["type"], a["type"]) + (f": {what}" if what else "")
            row = Adw.ActionRow(title=GLib.markup_escape_text(f"{label} · {names.get(a['device_id'], '')}"),
                                subtitle=GLib.markup_escape_text(" · ".join(x for x in (ago(a.get("created_at")), a.get("requested_by") or "",
                                                                                       a.get("detail") or "") if x)))
            row.add_suffix(tag(STATUS_LABEL.get(a["status"], a["status"]),
                               {"done": "good", "failed": "bad"}.get(a["status"], "dim")))
            if a["status"] == "pending":
                cancel = Gtk.Button(label="Cancel", valign=Gtk.Align.CENTER,
                                    css_classes=["destructive-action"] if a["type"] == "erase" else [])
                cancel.connect("clicked", lambda _b, act=a: self.cancel_action(act))
                row.add_suffix(cancel)
            if a.get("has_output"):
                output = Gtk.Button(label="Output", valign=Gtk.Align.CENTER)
                output.connect("clicked", lambda _b, act=a: self.open_output(act, names.get(act["device_id"])))
                row.add_suffix(output)
            history.add(row)

    # --- one computer ---------------------------------------------------------------------------
    def open_device(self, d: dict) -> None:
        page = Adw.PreferencesPage()
        view = Adw.ToolbarView()
        view.add_top_bar(Adw.HeaderBar())
        view.set_content(page)
        self.nav.push(Adw.NavigationPage(title=d.get("hostname") or "Computer", child=view))
        # Its name and health, what needs attention, and the usual requests, as in the web dashboard.
        alerts = (self.data or {}).get("alerts", [])
        label, kind, _where = health(d, alerts)
        org = self.org_of(d["organisation_id"])
        head = Adw.PreferencesGroup()
        page.add(head)
        line = Gtk.Box(spacing=12)
        texts = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4, hexpand=True)
        texts.append(Gtk.Label(label=d.get("hostname") or "(no name)", xalign=0, css_classes=["fleet-title"]))
        groups = [g["name"] for g in self.org_groups.get(d["organisation_id"], []) if d["id"] in (g.get("devices") or [])]
        where = " · ".join(x for x in (device_model(d), ", ".join(groups)) if x)
        if where:
            texts.append(Gtk.Label(label=where, xalign=0, wrap=True, css_classes=["fleet-sub"]))
        line.append(texts)
        line.append(tag(label, kind))
        head.add(line)
        waiting = d.get("approved") is False and not d.get("left_at")
        if waiting:
            approve = Adw.PreferencesGroup(title="Waiting for approval", description=(
                "It joined with a join code an admin made. Until the Owner approves it, it gets no accounts, Wi-Fi "
                "or printers, and takes no requests."))
            page.add(approve)
            if (org or {}).get("is_owner"):
                row = Adw.ActionRow(title="Approve", subtitle="Only if you know it's one of your organisation's computers",
                                    activatable=True)
                row.add_prefix(Gtk.Image(icon_name="emblem-ok-symbolic"))
                row.connect("activated", lambda _r: self.approve_computer(d))
                approve.add(row)
        if not d.get("left_at") and not waiting:
            quick = Gtk.Box(spacing=8, margin_top=14, homogeneous=True)
            for text, handler, style in (
                    ("Remote help", lambda: self.open_remote_help(d), ["suggested-action"]),
                    ("Run a fix", lambda: self.job_dialog("run-fix", org, d.get("hostname") or "this computer",
                                                          {"op": "action", "device_id": d["id"]}), []),
                    ("Lock the screen", lambda: self.send_action(d, "lock-screen"), [])):
                button = Gtk.Button(label=text, css_classes=style)
                button.connect("clicked", lambda _b, h=handler: h())
                quick.append(button)
            head.add(quick)
            issues = [a for a in alerts if a.get("device_id") == d["id"] and a.get("kind") != "offline"]
            if issues:
                attention = Adw.PreferencesGroup(title="Needs attention")
                page.add(attention)
                for a in issues:
                    row = Adw.ActionRow(title=GLib.markup_escape_text(a.get("title") or "Needs attention"),
                                        subtitle=GLib.markup_escape_text(a.get("text", "")), subtitle_lines=0)
                    row.add_prefix(Gtk.Image(icon_name=ALERT_ICON.get(a.get("kind"), "dialog-warning-symbolic")))
                    if a.get("kind") == "help" and a.get("request_id"):
                        row.set_activatable(True)
                        row.add_suffix(Gtk.Image(icon_name="go-next-symbolic"))
                        row.connect("activated", lambda _r, rid=a["request_id"]: self.open_help_request(org, rid))
                    attention.add(row)
        info = Adw.PreferencesGroup(title="Details")
        page.add(info)
        hw = d.get("hardware") or {}
        for title, value in (("Kulan OS", d.get("kulan_version") or "–"), ("System", d.get("os") or "–"),
                             ("Computer", " ".join(x for x in (hw.get("vendor"), hw.get("model")) if x) or "–"),
                             ("Memory", f"{round((hw.get('memory_mb') or 0) / 1024, 1)} GB" if hw.get("memory_mb") else "–"),
                             ("Disk", f"{hw.get('disk_free_gb')} GB free of {hw.get('disk_total_gb')} GB"
                              if hw.get("disk_total_gb") else "–"),
                             ("Last report", ago(d.get("last_seen"))), ("Joined", ago(d.get("enrolled_at"))),
                             ("TPM unlock", "on" if (d.get("tpm") or {}).get("on") else "off" if d.get("tpm") else "–"),
                             ("Disk encryption", yes_no((d.get("state") or {}).get("encrypted"))),
                             ("Firewall", yes_no((d.get("state") or {}).get("firewall"), "on", "off")),
                             ("Automatic updates", yes_no((d.get("state") or {}).get("auto_updates"), "on", "off"))):
            row = Adw.ActionRow(title=title, subtitle=GLib.markup_escape_text(str(value)), subtitle_selectable=True)
            row.add_css_class("property")
            info.add(row)
        status = d.get("policy_status") or {}
        if status:
            pol = Adw.PreferencesGroup(title="Policy")
            page.add(pol)
            for key, value in status.items():
                row = Adw.ActionRow(title=GLib.markup_escape_text(policy_key_label(key)), subtitle_lines=0,
                                    subtitle=GLib.markup_escape_text(value[:1].upper() + value[1:])
                                    if isinstance(value, str) and value not in ("met", "not met") else "")
                row.add_suffix(tag("met" if value == "met" else "not met", "good" if value == "met" else "bad"))
                pol.add(row)
        users = Adw.PreferencesGroup(title="Who uses it", description="Accounts and when they were last used" if d.get("sign_ins") else
                                     "Not reported yet. Needs Kulan OS 2.8c or later.")
        page.add(users)
        for si in (d.get("sign_ins") or [])[:50]:
            row = Adw.ActionRow(title=GLib.markup_escape_text(si.get("username", "")),
                                subtitle="Signed in now" if si.get("now") else f"Last used {ago_seconds(si.get('last'))}")
            row.add_prefix(Gtk.Image(icon_name="avatar-default-symbolic"))
            if si.get("now"):
                row.add_suffix(tag("signed in", "good"))
            users.add(row)
        apps = Adw.PreferencesGroup()
        page.add(apps)
        apps_row = Adw.ActionRow(title="Apps", subtitle=f"{d.get('app_count') or 0} · sent {ago(d.get('apps_at'))}"
                                 if d.get("apps_at") else "Not sent yet", activatable=bool(d.get("apps_at")))
        apps_row.add_prefix(Gtk.Image(icon_name="view-app-grid-symbolic"))
        if d.get("apps_at"):
            apps_row.add_suffix(Gtk.Image(icon_name="go-next-symbolic"))
            apps_row.connect("activated", lambda _r: self.open_apps(d))
        apps.add(apps_row)
        if not d.get("left_at") and not waiting:
            ask = Adw.PreferencesGroup(title="Ask it to", description="The computer does it at its next report.")
            page.add(ask)
            for kind, label, icon in ACTIONS:
                row = Adw.ActionRow(title=label, activatable=True)
                row.add_prefix(Gtk.Image(icon_name=icon))
                row.connect("activated", lambda _r, k=kind: self.send_action(d, k))
                ask.add(row)
            row = Adw.ActionRow(title="Install an app", subtitle="Once, from Debian or Flathub", activatable=True)
            row.add_prefix(Gtk.Image(icon_name="list-add-symbolic"))
            row.connect("activated", lambda _r: self.install_app_dialog(d.get("hostname") or "this computer",
                                                                         {"op": "action", "device_id": d["id"]}))
            ask.add(row)
            self.add_job_rows(ask, self.org_of(d["organisation_id"]), d.get("hostname") or "this computer",
                              {"op": "action", "device_id": d["id"]})
            helping = Adw.PreferencesGroup(title="Help the person using it")
            page.add(helping)
            now = [x.get("username") for x in (d.get("sign_ins") or []) if x.get("now")]
            help_row = Adw.ActionRow(title="Remote help", subtitle_lines=0, activatable=True,
                                     subtitle="See their screen and, if they allow it, use their mouse and keyboard. "
                                     "They're asked first and can stop at any time. Opens in your browser."
                                     + (f" {', '.join(now)} {'is' if len(now) == 1 else 'are'} signed in." if now
                                        else " Nobody was signed in at its last report."))
            help_row.add_prefix(Gtk.Image(icon_name="preferences-desktop-remote-desktop-symbolic"))
            help_row.add_suffix(Gtk.Image(icon_name="adw-external-link-symbolic"))
            help_row.connect("activated", lambda _r: self.open_remote_help(d))
            helping.add(help_row)
            st = d.get("state") or {}
            lost = Adw.PreferencesGroup(title="If it’s lost or stolen")
            page.add(lost)
            erase = Adw.ActionRow(title="Erase this computer", activatable=bool(st.get("erase_allowed") and st.get("encrypted")),
                                  subtitle="Makes everything on its disk unreadable and switches it off. This can’t be undone."
                                  if st.get("erase_allowed") and st.get("encrypted") else
                                  "Needs an encrypted disk" if st.get("erase_allowed") else
                                  "The person using it hasn’t allowed it in Kulan Settings", subtitle_lines=0)
            erase.add_prefix(Gtk.Image(icon_name="edit-delete-symbolic"))
            if st.get("lost_mode"):
                lost_row = Adw.ActionRow(title="Release from lost mode", subtitle="Nobody can sign in until you "
                                         "release it", activatable=True, subtitle_lines=0)
                lost_row.add_prefix(Gtk.Image(icon_name="changes-allow-symbolic"))
                lost_row.connect("activated", lambda _r: self.send_action(d, "lost-mode-off"))
            else:
                lost_row = Adw.ActionRow(title="Turn on lost mode", subtitle="Nobody can sign in until you release it. "
                                         "Anyone using it is signed out after 20 seconds' notice. It keeps "
                                         "reporting, so you'll see when it's online", activatable=True,
                                         subtitle_lines=0)
                lost_row.add_prefix(Gtk.Image(icon_name="system-lock-screen-symbolic"))
                lost_row.connect("activated", lambda _r: self.send_action(d, "lost-mode-on"))
            lost.add(lost_row)
            if st.get("erase_allowed") and st.get("encrypted"):
                erase.add_css_class("error")
                erase.connect("activated", lambda _r: self.ask_erase(d))
            lost.add(erase)
        if not d.get("left_at"):
            leave = Adw.PreferencesGroup()
            page.add(leave)
            remove = Adw.ActionRow(title="Remove from the organisation", activatable=True, subtitle_lines=0,
                                   subtitle="Its key stops working at once. Nothing on it is erased.")
            remove.add_prefix(Gtk.Image(icon_name="list-remove-symbolic"))
            remove.add_css_class("error")
            remove.connect("activated", lambda _r: self.ask_remove(d))
            leave.add(remove)
        controls = Adw.PreferencesGroup(title="Compliance", description="Loading the latest report…")
        page.add(controls)

        def done(result, error):
            if error:
                controls.set_description(error)
                return
            report = (result or {}).get("report") or {}
            comp = report.get("compliance") or {}
            if not comp.get("controls"):
                controls.set_description("This computer hasn't sent compliance results.")
                return
            controls.set_description(f"{comp.get('passed')} of {comp.get('total')} pass · {comp.get('baseline') or ''}")
            for c in comp["controls"]:
                row = Adw.ActionRow(title=GLib.markup_escape_text(f"{c.get('id', '')} {c.get('title', '')}"),
                                    subtitle=GLib.markup_escape_text(f"CIS {c.get('cis', '')} · NIST {c.get('nist', '')}"))
                status = c.get("status")
                row.add_suffix(tag(status or "?", {"pass": "good", "fail": "bad"}.get(status, "dim")))
                controls.add(row)
        if self.data and self.data.get("sample"):
            done({"report": self.data.get("sample_report")}, None)
        else:
            self.background(lambda: self.session.call({"op": "report", "device_id": d["id"]}), done)

    def cancel_action(self, a: dict) -> None:
        if self.data and self.data.get("sample"):
            a["status"] = "cancelled"
            self.render_org()
            return
        self.background(lambda: self.session.call({"op": "cancel-action", "action_id": a["id"]}),
                        lambda _r, error: (self.toast(error) if error else
                                           (self.toast(f"{ACTION_LABEL.get(a['type'], a['type'])} cancelled"),
                                            self.reload())))

    def push_list(self, title: str, description: str) -> Adw.PreferencesGroup:
        page = Adw.PreferencesPage()
        view = Adw.ToolbarView()
        view.add_top_bar(Adw.HeaderBar())
        view.set_content(page)
        self.nav.push(Adw.NavigationPage(title=title, child=view))
        group = Adw.PreferencesGroup(title=title, description=description)
        page.add(group)
        return group

    def open_apps(self, d: dict) -> None:
        group = self.push_list(f"Apps on {d.get('hostname') or 'this computer'}", "Loading…")

        def done(result, error):
            if error:
                group.set_description(error)
                return
            apps = sorted((result or {}).get("apps") or [], key=lambda a: (a.get("source") != "flatpak", a.get("name", "").lower()))
            group.set_description(f"{len(apps)} apps people installed · sent {ago((result or {}).get('apps_at'))}")
            for a in apps[:1000]:
                row = Adw.ActionRow(title=GLib.markup_escape_text(a.get("name", "")),
                                    subtitle=GLib.markup_escape_text(a.get("version", "")))
                row.add_suffix(tag("Flatpak" if a.get("source") == "flatpak" else "Debian", "dim"))
                group.add(row)
        if self.data and self.data.get("sample"):
            done({"apps": self.data.get("sample_apps", []), "apps_at": d.get("apps_at")}, None)
        else:
            self.background(lambda: self.session.call({"op": "apps", "device_id": d["id"]}), done)

    # --- Security and activity (2.8c) -------------------------------------------------------
    def push_page(self, title: str, tag_name: str | None = None) -> tuple[Adw.PreferencesPage, Adw.HeaderBar]:
        page = Adw.PreferencesPage()
        view = Adw.ToolbarView()
        header = Adw.HeaderBar()
        view.add_top_bar(header)
        view.set_content(page)
        self.nav.push(Adw.NavigationPage(title=title, child=view, **({"tag": tag_name} if tag_name else {})))
        return page, header

    def save_file(self, name: str, write, done_text: str) -> Gtk.FileDialog:
        """Ask where to save, then write(path) in the background."""
        dialog = Gtk.FileDialog(title="Save", initial_name=name, modal=True)

        def chosen(d, result):
            try:
                f = d.save_finish(result)
            except GLib.Error:
                return  # cancelled
            path = f.get_path() if f else None
            if path:
                self.background(lambda: write(path), lambda _r, error: self.toast(error or done_text))
        dialog.save(self, None, chosen)
        return dialog

    def open_weekly(self, org: dict) -> None:
        page, header = self.push_page("Weekly security report")
        pdf = Gtk.Button(label="Save as PDF", sensitive=False, css_classes=["suggested-action"])
        header.pack_end(pdf)
        head = Adw.PreferencesGroup(title=f"Weekly security report for {org['name']}", description="Loading…")
        page.add(head)

        def done(result, error):
            if error:
                head.set_description(error)
                return
            result = result or {}
            prev = (result.get("previous") or {}).get("summary")
            week = day_label(result.get("week"))
            head.set_description(f"Week of {week}, from each computer's last report" +
                                 (f". Compared with the week of {day_label(result['previous']['week'])}." if prev else "."))
            sections = weekly_sections(result.get("summary") or {}, prev)
            for heading, rows in sections:
                group = Adw.PreferencesGroup(title=heading)
                page.add(group)
                for line, detail, kind in rows:
                    row = Adw.ActionRow(title=GLib.markup_escape_text(line), subtitle=GLib.markup_escape_text(detail),
                                        subtitle_lines=0)
                    row.add_prefix(Gtk.Image(icon_name={"good": "object-select-symbolic",
                                                        "bad": "dialog-warning-symbolic"}.get(kind, "pan-end-symbolic")))
                    group.add(row)
            pdf.set_sensitive(True)
            title = f"Weekly security report for {org['name']}"
            subtitle = f"Week of {week} · made {day_label(result.get('made_at'))}"
            pdf.connect("clicked", lambda _b: self.save_file(
                f"Kulan Fleet weekly report {result.get('week', '')}.pdf",
                lambda path: write_pdf(path, title, subtitle, sections), "Report saved as a PDF"))
        self.call({"op": "weekly-report", "organisation_id": org["id"]}, done,
                  lambda: (self.data or {}).get("sample_weekly", {}))

    def open_review(self, org: dict) -> None:
        page, header = self.push_page("Admin-rights review", "review")
        finish = Gtk.Button(label="Finish review", sensitive=False, css_classes=["suggested-action"])
        header.pack_end(finish)
        head = Adw.PreferencesGroup(title="Who has administrator rights", description="Loading…")
        page.add(head)

        def done(result, error):
            if error:
                head.set_description(error)
                return
            result = result or {}
            last = result.get("last_review")
            owner = bool(result.get("is_owner"))
            head.set_description(
                ("Review due. " if result.get("due") else "") +
                (f"Last reviewed {day_label(last.get('reviewed_at'))} by {last.get('reviewed_by')}." if last else
                 "Not reviewed yet.") + " Untick anyone who no longer needs administrator rights, then Finish review." +
                ("" if owner else " Only the Owner can finish a review."))
            keeps: list[tuple[str, str, Gtk.CheckButton]] = []
            on_computers = Adw.PreferencesGroup(title="On the computers", description="Admins and the Owner have "
                                                "administrator rights on the computers they use")
            page.add(on_computers)
            for p in result.get("people") or []:
                where = "all computers" if p.get("where") == "all" else ", ".join(p.get("where") or []) or "no computers yet"
                si = (p.get("signed_in") or [None])[0]
                used = (f"signed in now on {si['hostname']}" if si and si.get("now") else
                        f"last used {ago_seconds(si.get('last'))} on {si['hostname']}" if si else "not used yet")
                row = Adw.ActionRow(title=GLib.markup_escape_text(f"{p.get('full_name') or p['username']} ({p['username']})"),
                                    subtitle=GLib.markup_escape_text(f"{ROLE_LABEL.get(p.get('role'), p.get('role'))} · "
                                                                     f"{where} · {used}"), subtitle_lines=0)
                keep = Gtk.CheckButton(active=True, valign=Gtk.Align.CENTER, tooltip_text="Keep",
                                       sensitive=owner and p.get("role") != "owner")
                row.add_suffix(Gtk.Label(label="Keep", css_classes=["dim-label"]))
                row.add_suffix(keep)
                keeps.append(("person", p["id"], keep))
                on_computers.add(row)
            if not result.get("people"):
                on_computers.add(Adw.ActionRow(title="Nobody"))
            fleet = Adw.PreferencesGroup(title="In Kulan Fleet", description="Admins who can see and manage this "
                                         "organisation's computers and people")
            page.add(fleet)
            for a in result.get("admins") or []:
                row = Adw.ActionRow(title=GLib.markup_escape_text(a["email"]),
                                    subtitle=("The Owner · " if a.get("owner") else "") + f"admin since {day_label(a.get('created_at'))}")
                keep = Gtk.CheckButton(active=True, valign=Gtk.Align.CENTER, sensitive=owner and not a.get("owner"))
                row.add_suffix(Gtk.Label(label="Keep", css_classes=["dim-label"]))
                row.add_suffix(keep)
                keeps.append(("admin", a["email"], keep))
                fleet.add(row)
            if result.get("all_organisations_admins"):
                everywhere = Adw.PreferencesGroup(title="Kulan Fleet admins for every organisation",
                                                  description="Kulan's own administrators. They can't be changed here.")
                page.add(everywhere)
                for a in result["all_organisations_admins"]:
                    everywhere.add(Adw.ActionRow(title=GLib.markup_escape_text(a["email"])))
            finish.set_sensitive(owner)
            finish.connect("clicked", lambda _b: self.finish_review(org, keeps))
        self.call({"op": "access-review", "organisation_id": org["id"]}, done,
                  lambda: (self.data or {}).get("sample_review", {}))

    def finish_review(self, org: dict, keeps) -> Adw.AlertDialog:
        people = [i for kind, i, c in keeps if kind == "person" and not c.get_active()]
        admins = [i for kind, i, c in keeps if kind == "admin" and not c.get_active()]
        kept = len(keeps) - len(people) - len(admins)
        body = (f"Keeping {kept}. " +
                (f"Removing the admin role from {plural(len(people), 'person', 'people')}. They stay as employees. "
                 if people else "") +
                (f"Removing Kulan Fleet access for {', '.join(admins)}. " if admins else "") +
                "The review is saved in the activity log.")
        dialog = Adw.AlertDialog(heading="Finish the review?", body=body)
        dialog.add_response("cancel", "Cancel")
        dialog.add_response("finish", "Finish review")
        dialog.set_response_appearance("finish", Adw.ResponseAppearance.DESTRUCTIVE if people or admins
                                       else Adw.ResponseAppearance.SUGGESTED)

        def answered(_d, response):
            if response != "finish":
                return

            def done(r, error):
                if error:
                    self.toast(error)
                    return
                self.toast(f"Review saved: {r.get('kept', kept)} kept, {r.get('removed', 0)} removed")
                if not self.sample_mode():
                    self.reload()
                self.nav.pop_to_tag("org")
            self.call({"op": "review-access", "organisation_id": org["id"], "remove_people": people,
                       "remove_admins": admins}, done, {"kept": kept, "removed": len(people) + len(admins)})
        dialog.connect("response", answered)
        dialog.present(self)
        return dialog

    def open_log(self, org: dict) -> None:
        page, header = self.push_page("Activity log", "log")
        export = Gtk.Button(label="Export CSV", tooltip_text="Export every matching entry")
        header.pack_end(export)
        search = Adw.PreferencesGroup(title="Find", description="Write dates as 2026-10-26. Any field can be empty.")
        page.add(search)
        fields = {}
        for key, title in (("from", "From (date)"), ("to", "To (date)"), ("who", "Who (email)"),
                           ("what", "What, or a computer's name")):
            row = Adw.EntryRow(title=title)
            search.add(row)
            fields[key] = row
        results = Adw.PreferencesGroup(title="Entries", description="Loading…")
        page.add(results)
        state = {"rows": [], "more": None, "query": {}}

        def query(**extra) -> dict:
            body = {"op": "log", "organisation_id": org["id"], **extra}
            for key, row in fields.items():
                if row.get_text().strip():
                    body[key] = row.get_text().strip()
            return body

        def problem() -> str | None:
            for key in ("from", "to"):
                v = fields[key].get_text().strip()
                try:
                    if v and (not re.fullmatch(r"\d{4}-\d{2}-\d{2}", v) or datetime.strptime(v, "%Y-%m-%d") is None):
                        return "Write dates as 2026-10-26"
                except ValueError:
                    return f"{v} isn't a real date"
            return None

        def show(entries: list[dict], more: bool, fresh: bool) -> None:
            if fresh:
                for row in state["rows"]:
                    results.remove(row)
                state["rows"] = []
            if state["more"] is not None:
                results.remove(state["more"])
                state["more"] = None
            for e in entries:
                what = e.get("what", "")
                if what.startswith("asked: "):
                    what = f"asked {e.get('hostname') or 'a computer'} to {ACTION_LABEL.get(what[7:], what[7:]).lower()}"
                row = Adw.ActionRow(title=GLib.markup_escape_text(f"{e.get('email', '')} {what}"),
                                    subtitle=GLib.markup_escape_text(f"{day_label(e.get('at'))} · {ago(e.get('at'))}"),
                                    subtitle_lines=0)
                results.add(row)
                state["rows"].append(row)
            shown = len(state["rows"])
            results.set_description(f"{plural(shown, 'entry', 'entries')}, newest first" if shown else "Nothing found.")
            if more and entries:
                button = Gtk.Button(label="Show more", halign=Gtk.Align.CENTER, margin_top=12)
                button.connect("clicked", lambda _b, before=entries[-1].get("id"): load(before))
                results.add(button)
                state["more"] = button

        def load(before=None) -> None:
            if before is None:  # a new search; "Show more" carries on with the same one
                if problem():
                    self.toast(problem())
                    return
                state["query"] = query()
            extra = {"limit": 100, **({"before": before} if before else {})}
            self.call({**state["query"], **extra}, lambda r, error: self.toast(error) if error else
                      show((r or {}).get("entries") or [], bool((r or {}).get("more")), before is None),
                      lambda: {"entries": (self.data or {}).get("sample_log", []), "more": False})
        go = Gtk.Button(label="Search", halign=Gtk.Align.END, margin_top=12, css_classes=["suggested-action"])
        go.connect("clicked", lambda _b: load())
        search.add(go)
        for row in fields.values():
            row.connect("entry-activated", lambda _r: load())

        def everything(base: dict) -> list[dict]:
            """Every matching entry (in the background: base is the query, read from the page first)."""
            if self.sample_mode():
                return list((self.data or {}).get("sample_log", []))
            out, before = [], None
            for _page in range(20):  # up to 200,000 entries
                r = self.session.call({**base, "limit": 10000, **({"before": before} if before else {})})
                out += r.get("entries") or []
                if not r.get("more") or not out:
                    break
                before = out[-1].get("id")
            return out

        def export_csv(_b) -> None:
            if problem():
                self.toast(problem())
                return

            base = query()  # the filters as they are now, read here on GTK's thread

            def write(path: str) -> None:
                with open(path, "w", encoding="utf-8", newline="") as f:
                    f.write(log_csv(everything(base)))
            self.save_file(f"Kulan Fleet activity {org['name']} {datetime.now().strftime('%Y-%m-%d')}.csv", write,
                           "Activity log exported")
        export.connect("clicked", export_csv)
        load()

    def ask_erase(self, d: dict) -> Adw.AlertDialog:
        name = d.get("hostname") or ""
        dialog = Adw.AlertDialog(heading=f"Erase {name}?",
                                 body="At its next report, anyone using it gets a 20-second warning. Then everything "
                                      "on its disk is made unreadable and it switches off. This can’t be undone, "
                                      "and switching it off only delays it. Type the computer’s name to confirm.")
        entry = Adw.EntryRow(title=f"Type {name}")
        box = Gtk.ListBox(css_classes=["boxed-list"], selection_mode=Gtk.SelectionMode.NONE)
        box.append(entry)
        dialog.set_extra_child(box)
        dialog.add_response("cancel", "Cancel")
        dialog.add_response("erase", "Erase")
        dialog.set_response_appearance("erase", Adw.ResponseAppearance.DESTRUCTIVE)
        dialog.set_response_enabled("erase", False)
        dialog.set_default_response("cancel")
        entry.connect("changed", lambda e: dialog.set_response_enabled("erase", bool(name) and e.get_text().strip() == name))

        def answered(_d, response):
            if response != "erase" or entry.get_text().strip() != name:
                return
            self.background(lambda: self.session.call({"op": "action", "device_id": d["id"], "type": "erase",
                                                        "confirm": entry.get_text().strip()}),
                            lambda _r, error: (self.toast(error) if error else
                                               (self.toast(f"{name} will be erased at its next report"), self.reload())))
        dialog.connect("response", answered)
        dialog.present(self)
        return dialog

    def approve_computer(self, d: dict) -> None:
        self.background(lambda: self.session.call({"op": "approve-computer", "device_id": d["id"]}),
                        lambda _r, error: (self.toast(error) if error else
                                           (self.toast(f"{d.get('hostname') or 'The computer'} is approved"), self.reload())))

    def ask_remove(self, d: dict) -> Adw.AlertDialog:
        name = d.get("hostname") or ""
        dialog = Adw.AlertDialog(heading=f"Remove {name} from the organisation?",
                                 body="It stops getting accounts, Wi-Fi, printers and requests at once, and its "
                                      "requests waiting are cancelled. Nothing on it is erased, and it isn't told. "
                                      "To join again it needs a new join code. Type the computer’s name to confirm.")
        entry = Adw.EntryRow(title=f"Type {name}")
        box = Gtk.ListBox(css_classes=["boxed-list"], selection_mode=Gtk.SelectionMode.NONE)
        box.append(entry)
        dialog.set_extra_child(box)
        dialog.add_response("cancel", "Cancel")
        dialog.add_response("remove", "Remove")
        dialog.set_response_appearance("remove", Adw.ResponseAppearance.DESTRUCTIVE)
        dialog.set_response_enabled("remove", False)
        dialog.set_default_response("cancel")
        entry.connect("changed", lambda e: dialog.set_response_enabled("remove", e.get_text().strip() == name))

        def answered(_d, response):
            if response != "remove" or entry.get_text().strip() != name:
                return
            self.background(lambda: self.session.call({"op": "remove-computer", "device_id": d["id"],
                                                        "confirm": entry.get_text().strip()}),
                            lambda _r, error: (self.toast(error) if error else
                                               (self.toast(f"{name or 'The computer'} was removed"), self.nav.pop(),
                                                self.reload())))
        dialog.connect("response", answered)
        dialog.present(self)
        return dialog

    def send_action(self, d: dict, kind: str) -> Adw.AlertDialog | None:
        def go() -> None:
            self.background(lambda: self.session.call({"op": "action", "device_id": d["id"], "type": kind}),
                            lambda _r, error: (self.toast(error) if error else
                                               (self.toast(f"Asked {d.get('hostname')} to {ACTION_LABEL[kind].lower()}"),
                                                self.reload())))
        bodies = {"restart": "Anyone using it gets 5 minutes' notice.",
                  "shutdown": "Anyone using it gets 5 minutes' notice. It reports again when it's switched on.",
                  "install-updates": "Updates install in the background. A restart may be needed.",
                  "lost-mode-on": "At its next report, nobody can sign in. Anyone using it is signed out after a "
                                  "20-second warning, and unsaved work is lost. The sign-in screen asks for it to be "
                                  "returned to your organisation."}
        if kind not in bodies:
            go()
            return None
        dialog = Adw.AlertDialog(heading=f"{ACTION_LABEL[kind]} on {d.get('hostname')}?", body=bodies[kind])
        dialog.add_response("cancel", "Cancel")
        dialog.add_response("go", ACTION_LABEL[kind])
        dialog.set_response_appearance("go", Adw.ResponseAppearance.SUGGESTED if kind == "install-updates"
                                       else Adw.ResponseAppearance.DESTRUCTIVE)
        dialog.connect("response", lambda _d, r: r == "go" and go())
        dialog.present(self)
        return dialog

    # --- codes and organisations ------------------------------------------------------------------
    def make_code(self, org_id: str, hours_index: int, uses: int) -> None:
        hours = [24, 72, 168, 720][hours_index]

        def done(result, error):
            if error:
                self.toast(error)
                return
            box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
            box.append(Gtk.Label(label="Server address", xalign=0, css_classes=["dim-label"]))
            box.append(Gtk.Label(label=FLEET_SERVER, xalign=0, selectable=True, wrap=True))
            box.append(Gtk.Label(label="Join code", xalign=0, css_classes=["dim-label"], margin_top=8))
            box.append(Gtk.Label(label=result["code"], xalign=0, selectable=True, css_classes=["fleet-code"]))
            dialog = Adw.AlertDialog(heading="Join code",
                                     body=f"Works for {result['uses']} computer{'s' if result['uses'] != 1 else ''} "
                                          f"within {result['hours']} hours. It's shown only once."
                                          + (" Computers that join with it wait for the Owner's approval."
                                             if result.get("approved") is False else ""))
            dialog.set_extra_child(box)
            dialog.add_response("copy", "Copy code")
            dialog.add_response("close", "Done")
            dialog.set_default_response("close")
            dialog.connect("response", lambda _d, r: r == "copy" and Gdk.Display.get_default().get_clipboard().set(result["code"]))
            dialog.present(self)
        self.background(lambda: self.session.call({"op": "new-code", "organisation_id": org_id,
                                                    "hours": hours, "uses": uses}), done)

    def new_org(self) -> None:
        dialog = Adw.AlertDialog(heading="New organisation",
                                 body="The Owner decides who the admins are. Leave it empty to be the Owner yourself.")
        entry = Adw.EntryRow(title="Name")
        owner = Adw.EntryRow(title="Owner's email (optional)")
        box = Gtk.ListBox(css_classes=["boxed-list"], selection_mode=Gtk.SelectionMode.NONE)
        box.append(entry)
        box.append(owner)
        dialog.set_extra_child(box)
        dialog.add_response("cancel", "Cancel")
        dialog.add_response("add", "Add")
        dialog.set_response_appearance("add", Adw.ResponseAppearance.SUGGESTED)

        def answered(_d, response):
            name = entry.get_text().strip()
            if response != "add" or not name:
                return
            body = {"op": "new-organisation", "name": name}
            if owner.get_text().strip():
                body["owner_email"] = owner.get_text().strip()

            def done(r, error):
                if error:
                    self.toast(error)
                    return
                self.org_id = r["id"]
                self.reload()
                self.show_recovery_code(name, r.get("recovery_code"))
            self.background(lambda: self.session.call(body), done)
        dialog.connect("response", answered)
        dialog.present(self)
        return dialog

    def install_app_dialog(self, where: str, body: dict) -> Adw.AlertDialog:
        """Ask for an app to install once; body is the action's call without type and payload."""
        dialog = Adw.AlertDialog(heading=f"Install an app on {where}",
                                 body="Installs once, at the next report. To keep it installed, add it to a policy's "
                                      "required apps.")
        box = Gtk.ListBox(css_classes=["boxed-list"], selection_mode=Gtk.SelectionMode.NONE)
        source = Adw.ComboRow(title="From", model=Gtk.StringList.new([SOURCE_LABEL["debian"], SOURCE_LABEL["flatpak"]]))
        entry = Adw.EntryRow(title="App (for example vlc, or org.videolan.VLC)")
        box.append(source)
        box.append(entry)
        note = Gtk.Label(wrap=True, xalign=0, css_classes=["dim-label"], margin_top=6)
        outer = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        outer.append(box)
        outer.append(note)
        dialog.set_extra_child(outer)
        dialog.add_response("cancel", "Cancel")
        dialog.add_response("install", "Install")
        dialog.set_response_appearance("install", Adw.ResponseAppearance.SUGGESTED)
        dialog.set_response_enabled("install", False)

        def app() -> dict:
            return {"source": "flatpak" if source.get_selected() == 1 else "debian", "id": entry.get_text().strip()}

        def check(*_a) -> None:
            a = app()
            problem = app_problem(a["source"], a["id"], False) if a["id"] else None
            note.set_label(problem or "")
            dialog.set_response_enabled("install", bool(a["id"]) and problem is None)
        entry.connect("changed", check)
        source.connect("notify::selected", check)

        def answered(_d, response):
            a = app()
            if response != "install" or app_problem(a["source"], a["id"], False):
                return

            def done(r, error):
                if error:
                    self.toast(error)
                    return
                count = (r or {}).get("count")
                self.toast(f"{a['id']} will be installed on {where}" + (f" ({count} computers)" if count else ""))
                if not self.sample_mode():
                    self.reload()
            self.call({**body, "type": "install-app", "payload": a}, done, {"count": 1})
        dialog.connect("response", answered)
        dialog.present(self)
        return dialog

    # --- Groups and USB drives -----------------------------------------------------------------
    def load_groups(self, org: dict, then=None) -> None:
        """The organisation's groups, kept for the person dialogs (and `then` once loaded)."""
        def done(result, error):
            if not error:
                self.org_groups[org["id"]] = (result or {}).get("groups") or []
            if then:
                then(self.org_groups.get(org["id"]), error)
        self.call({"op": "groups", "organisation_id": org["id"]}, done,
                  lambda: {"groups": (self.data or {}).get("sample_groups", [])})

    def open_groups(self, org: dict) -> None:
        if org.get("id") != self.org_id:
            return  # a reply about another organisation, after it was switched
        page, actions = self.section_page("groups")
        add = Gtk.Button(label="Add a group", css_classes=["suggested-action"])
        add.connect("clicked", lambda _b: self.add_group_dialog(org))
        actions.append(add)
        group = Adw.PreferencesGroup(description="Loading…")
        page.add(group)
        drives = Adw.PreferencesGroup()
        page.add(drives)
        row = Adw.ActionRow(title="USB drives", subtitle="Drives approved for computers that limit USB drives",
                            activatable=True)
        row.add_prefix(Gtk.Image(icon_name="drive-removable-media-symbolic"))
        row.add_suffix(Gtk.Image(icon_name="go-next-symbolic"))
        row.connect("activated", lambda _r: self.open_drives(org))
        drives.add(row)
        names = {d["id"]: d.get("hostname") or "" for d in self.org_computers(org)}

        def done(groups, error):
            if error:
                group.set_description(error)
                return
            self.update_counts(self.current_org())
            group.set_description("" if groups else "No groups yet. Add one, for example Office or Finance.")
            for g in groups or []:
                n = len([i for i in g.get("devices") or [] if i in names])
                row = Adw.ActionRow(title=GLib.markup_escape_text(g["name"]), activatable=True, subtitle_lines=2,
                                    subtitle=GLib.markup_escape_text(f"{n} computer{'s' if n != 1 else ''} · "
                                                                     f"{policy_summary(g.get('policy') or {})}"))
                row.add_prefix(Gtk.Image(icon_name="view-grid-symbolic"))
                row.add_suffix(Gtk.Image(icon_name="go-next-symbolic"))
                row.connect("activated", lambda _r, gr=g: self.open_group(org, gr))
                group.add(row)
        self.load_groups(org, done)

    def add_group_dialog(self, org: dict) -> Adw.AlertDialog:
        dialog = Adw.AlertDialog(heading="Add a group", body="Then choose its computers and policy.")
        entry = Adw.EntryRow(title="Name")
        box = Gtk.ListBox(css_classes=["boxed-list"], selection_mode=Gtk.SelectionMode.NONE)
        box.append(entry)
        dialog.set_extra_child(box)
        dialog.add_response("cancel", "Cancel")
        dialog.add_response("add", "Add")
        dialog.set_response_appearance("add", Adw.ResponseAppearance.SUGGESTED)
        dialog.set_response_enabled("add", False)
        entry.connect("changed", lambda e: dialog.set_response_enabled("add", 0 < len(e.get_text().strip()) <= 60))

        def answered(_d, response):
            name = " ".join(entry.get_text().split())
            if response != "add" or not name:
                return

            def done(r, error):
                if error:
                    self.toast(error)
                    return
                g = {"id": (r or {}).get("id"), "name": name, "policy": {}, "devices": [], "people": []}
                if self.sample_mode():
                    self.data.setdefault("sample_groups", []).append(g)
                self.open_groups(org)
                self.open_group(org, g)
            self.call({"op": "add-group", "organisation_id": org["id"], "name": name}, done, {"id": f"g{name}"})
        dialog.connect("response", answered)
        dialog.present(self)
        return dialog

    def open_group(self, org: dict, g: dict) -> None:
        page = Adw.PreferencesPage()
        view = Adw.ToolbarView()
        view.add_top_bar(Adw.HeaderBar())
        view.set_content(page)
        self.nav.push(Adw.NavigationPage(title=g["name"], child=view))
        info = Adw.PreferencesGroup(title=g["name"])
        page.add(info)
        rename = Adw.ActionRow(title="Name", subtitle=GLib.markup_escape_text(g["name"]), activatable=True)
        rename.add_suffix(Gtk.Image(icon_name="document-edit-symbolic"))
        rename.connect("activated", lambda _r: self.rename_group(org, g))
        info.add(rename)

        pol = Adw.PreferencesGroup(title="Policy", description="Adds to the organisation's policy. "
                                                               "The stricter rule wins.")
        page.add(pol)

        def save(new, done):
            if self.sample_mode():
                g["policy"] = new
                done(new, None)
                return
            self.call({"op": "edit-group", "group_id": g["id"], "policy": new},
                      lambda _r, error: (g.__setitem__("policy", new) if not error else None, done(new, error)))

        def reset():
            self.nav.pop()
            self.open_group(org, g)
        self.policy_editor(pol, g.setdefault("policy", {}), save, reset)

        computers = Adw.PreferencesGroup(title="Computers", description="Each computer takes the group's "
                                         "policy at its next report.")
        page.add(computers)
        checks = []
        for d in self.org_computers(org):
            row = Adw.ActionRow(title=GLib.markup_escape_text(d.get("hostname") or "(no name)"))
            check = Gtk.CheckButton(active=d["id"] in (g.get("devices") or []), valign=Gtk.Align.CENTER)
            row.add_prefix(check)
            row.set_activatable_widget(check)
            checks.append((d["id"], check))
            computers.add(row)
        if not checks:
            computers.add(Adw.ActionRow(title="No computers yet"))
        else:
            save_button = Gtk.Button(label="Save", css_classes=["suggested-action"], halign=Gtk.Align.END, margin_top=12)

            def save_computers(_b):
                chosen = [i for i, c in checks if c.get_active()]

                def done(_r, error):
                    if error:
                        self.toast(error)
                        return
                    g["devices"] = chosen
                    self.toast(f"{g['name']}: {len(chosen)} computer{'s' if len(chosen) != 1 else ''}")
                self.call({"op": "edit-group", "group_id": g["id"], "devices": chosen}, done)
            save_button.connect("clicked", save_computers)
            computers.add(save_button)

        ask = Adw.PreferencesGroup(title="Ask all its computers to", description="Each does it at its next report.")
        page.add(ask)
        for kind, label, icon in GROUP_ACTIONS:
            row = Adw.ActionRow(title=label, activatable=True)
            row.add_prefix(Gtk.Image(icon_name=icon))
            row.connect("activated", lambda _r, k=kind: self.group_action(g, k))
            ask.add(row)
        row = Adw.ActionRow(title="Install an app", subtitle="Once, from Debian or Flathub", activatable=True)
        row.add_prefix(Gtk.Image(icon_name="list-add-symbolic"))
        row.connect("activated", lambda _r: self.install_app_dialog(f"{g['name']}'s computers",
                                                                     {"op": "group-action", "group_id": g["id"]}))
        ask.add(row)
        self.add_job_rows(ask, org, f"{g['name']}'s computers", {"op": "group-action", "group_id": g["id"]})

        # Wi-Fi networks and printers the group's computers get (2.9b), and how each went on them.
        members = [d for d in self.org_computers(org) if d["id"] in (g.get("devices") or [])]
        wifi = Adw.PreferencesGroup(title="Wi-Fi networks", description="The group's computers connect to these at their "
                                    "next report. Passwords are kept encrypted and only sent to the computers.")
        page.add(wifi)
        for n in g.get("networks") or []:
            row = Adw.ActionRow(title=GLib.markup_escape_text(n["ssid"]), subtitle_lines=0, subtitle=GLib.markup_escape_text(
                " · ".join(["Open" if n.get("security") == "open" else "Password"] + (["Hidden"] if n.get("hidden") else []) +
                           [pushed_line(members, "networks", n["id"])])))
            row.add_prefix(Gtk.Image(icon_name="network-wireless-symbolic"))
            gone = Gtk.Button(icon_name="user-trash-symbolic", valign=Gtk.Align.CENTER, css_classes=["flat"],
                              tooltip_text=f"Remove {n['ssid']}")
            gone.connect("clicked", lambda _b, x=n: self.remove_pushed(org, g, "network", x))
            row.add_suffix(gone)
            wifi.add(row)
        row = Adw.ActionRow(title="Add a Wi-Fi network", activatable=True)
        row.add_prefix(Gtk.Image(icon_name="list-add-symbolic"))
        row.connect("activated", lambda _r: self.network_dialog(org, g))
        wifi.add(row)
        printing = Adw.PreferencesGroup(title="Printers", description="Network printers that work without a driver "
                                        "(most office printers made since 2015).")
        page.add(printing)
        for pr in g.get("printers") or []:
            row = Adw.ActionRow(title=GLib.markup_escape_text(pr["name"]), subtitle_lines=0, subtitle=GLib.markup_escape_text(
                f"{pr['uri']} · {pushed_line(members, 'printers', pr['id'])}"))
            row.add_prefix(Gtk.Image(icon_name="printer-symbolic"))
            gone = Gtk.Button(icon_name="user-trash-symbolic", valign=Gtk.Align.CENTER, css_classes=["flat"],
                              tooltip_text=f"Remove {pr['name']}")
            gone.connect("clicked", lambda _b, x=pr: self.remove_pushed(org, g, "printer", x))
            row.add_suffix(gone)
            printing.add(row)
        row = Adw.ActionRow(title="Add a printer", activatable=True)
        row.add_prefix(Gtk.Image(icon_name="list-add-symbolic"))
        row.connect("activated", lambda _r: self.printer_dialog(org, g))
        printing.add(row)

        danger = Adw.PreferencesGroup()
        page.add(danger)
        remove = Adw.ActionRow(title="Remove this group", subtitle="Its computers keep their other policies. People "
                               "who used them only through this group lose access",
                               activatable=True, subtitle_lines=0, css_classes=["error"])
        remove.add_prefix(Gtk.Image(icon_name="user-trash-symbolic"))
        remove.connect("activated", lambda _r: self.remove_group(org, g))
        danger.add(remove)

    def group_action(self, g: dict, kind: str) -> Adw.AlertDialog | None:
        def go() -> None:
            self.call({"op": "group-action", "group_id": g["id"], "type": kind},
                      lambda r, error: self.toast(error) if error else
                      self.toast(f"Asked {(r or {}).get('count', 0)} computers in {g['name']} to {ACTION_LABEL[kind].lower()}"),
                      {"count": len(g.get("devices") or [])})
        if kind not in ("restart", "shutdown", "install-updates"):
            go()
            return None
        dialog = Adw.AlertDialog(heading=f"{ACTION_LABEL[kind]} on every computer in {g['name']}?",
                                 body="Anyone using them gets 5 minutes' notice." if kind != "install-updates"
                                 else "Updates install in the background. A restart may be needed.")
        dialog.add_response("cancel", "Cancel")
        dialog.add_response("go", ACTION_LABEL[kind])
        dialog.set_response_appearance("go", Adw.ResponseAppearance.SUGGESTED if kind == "install-updates"
                                       else Adw.ResponseAppearance.DESTRUCTIVE)
        dialog.connect("response", lambda _d, r: r == "go" and go())
        dialog.present(self)
        return dialog

    def rename_group(self, org: dict, g: dict) -> Adw.AlertDialog:
        dialog = Adw.AlertDialog(heading="Rename the group")
        entry = Adw.EntryRow(title="Name", text=g["name"])
        box = Gtk.ListBox(css_classes=["boxed-list"], selection_mode=Gtk.SelectionMode.NONE)
        box.append(entry)
        dialog.set_extra_child(box)
        dialog.add_response("cancel", "Cancel")
        dialog.add_response("save", "Save")
        dialog.set_response_appearance("save", Adw.ResponseAppearance.SUGGESTED)

        def answered(_d, response):
            name = " ".join(entry.get_text().split())[:60]
            if response != "save" or not name or name == g["name"]:
                return

            def done(_r, error):
                if error:
                    self.toast(error)
                    return
                g["name"] = name
                self.open_groups(org)
                self.open_group(org, g)
            self.call({"op": "edit-group", "group_id": g["id"], "name": name}, done)
        dialog.connect("response", answered)
        dialog.present(self)
        return dialog

    def remove_group(self, org: dict, g: dict) -> Adw.AlertDialog:
        dialog = Adw.AlertDialog(heading=f"Remove {g['name']}?",
                                 body="Its computers stop following its policy at their next report. Apps stay as "
                                      "they are, and USB drives work again unless another policy blocks them. "
                                      "Type the group's name to confirm.")
        entry = Adw.EntryRow(title=f"Type {g['name']}")
        box = Gtk.ListBox(css_classes=["boxed-list"], selection_mode=Gtk.SelectionMode.NONE)
        box.append(entry)
        dialog.set_extra_child(box)
        dialog.add_response("cancel", "Cancel")
        dialog.add_response("remove", "Remove")
        dialog.set_response_appearance("remove", Adw.ResponseAppearance.DESTRUCTIVE)
        dialog.set_response_enabled("remove", False)
        dialog.set_default_response("cancel")
        entry.connect("changed", lambda e: dialog.set_response_enabled("remove", e.get_text().strip() == g["name"]))

        def answered(_d, response):
            if response != "remove" or entry.get_text().strip() != g["name"]:
                return

            def done(_r, error):
                if error:
                    self.toast(error)
                    return
                if self.sample_mode():
                    self.data["sample_groups"] = [x for x in self.data.get("sample_groups", []) if x is not g]
                self.toast(f"{g['name']} removed")
                self.open_groups(org)
            self.call({"op": "remove-group", "group_id": g["id"], "confirm": g["name"]}, done)
        dialog.connect("response", answered)
        dialog.present(self)
        return dialog

    def open_drives(self, org: dict) -> None:
        if self.nav.find_page("drives") is not None:
            self.nav.pop_to_tag("org")
        page = Adw.PreferencesPage()
        view = Adw.ToolbarView()
        view.add_top_bar(Adw.HeaderBar())
        view.set_content(page)
        self.nav.push(Adw.NavigationPage(title="USB drives", child=view, tag="drives"))
        approved = Adw.PreferencesGroup(title="Approved drives", description="Loading…")
        seen = Adw.PreferencesGroup(title="Seen on computers", description="Drives plugged into computers with a "
                                    "USB policy. Approve one to let it work.")
        page.add(approved)
        page.add(seen)

        def done(result, error):
            if error:
                approved.set_description(error)
                return
            result = result or {}
            approved.set_description("They work where a policy allows approved drives only, but not where USB "
                                     "drives are blocked." if result.get("approved") else
                                     "None yet. Plug a drive into a computer with a USB policy, then approve it below.")
            for a in result.get("approved") or []:
                row = Adw.ActionRow(title=GLib.markup_escape_text(a.get("name") or "Drive"),
                                    subtitle=GLib.markup_escape_text(f"{a.get('vendor_id')}:{a.get('product_id')} · "
                                                                     f"serial {a.get('serial')} · added by "
                                                                     f"{a.get('created_by') or ''}"))
                row.add_prefix(Gtk.Image(icon_name="drive-removable-media-symbolic"))
                remove = Gtk.Button(label="Remove", valign=Gtk.Align.CENTER)
                remove.connect("clicked", lambda _b, dr=a: self.call(
                    {"op": "remove-drive", "drive_id": dr.get("id")},
                    lambda _r, err: self.toast(err) if err else (self.toast(f"{dr.get('name')} no longer approved"),
                                                                  self.open_drives(org))))
                row.add_suffix(remove)
                approved.add(row)
            if not result.get("seen"):
                seen.add(Adw.ActionRow(title="None seen yet"))
            for d in result.get("seen") or []:
                where = ", ".join(d.get("computers") or [])
                row = Adw.ActionRow(title=GLib.markup_escape_text(d.get("name") or "USB drive"),
                                    subtitle=GLib.markup_escape_text(f"{d.get('vendor_id')}:{d.get('product_id')} · "
                                                                     f"serial {d.get('serial')} · on {where}"))
                row.add_prefix(Gtk.Image(icon_name="drive-removable-media-symbolic"))
                ok = Gtk.Button(label="Approve", valign=Gtk.Align.CENTER, css_classes=["suggested-action"])
                ok.connect("clicked", lambda _b, dr=d: self.approve_drive(org, dr))
                row.add_suffix(ok)
                seen.add(row)
        self.call({"op": "drives", "organisation_id": org["id"]}, done,
                  lambda: (self.data or {}).get("sample_drives", {}))

    def approve_drive(self, org: dict, d: dict) -> Adw.AlertDialog:
        dialog = Adw.AlertDialog(heading="Approve this drive",
                                 body="It will work where a policy allows approved drives only. Other drives of the "
                                      "same model aren't included.")
        entry = Adw.EntryRow(title="A name you'll recognise (for example Finance backup drive)",
                             text=(d.get("name") or "")[:80])
        box = Gtk.ListBox(css_classes=["boxed-list"], selection_mode=Gtk.SelectionMode.NONE)
        box.append(entry)
        dialog.set_extra_child(box)
        dialog.add_response("cancel", "Cancel")
        dialog.add_response("approve", "Approve")
        dialog.set_response_appearance("approve", Adw.ResponseAppearance.SUGGESTED)
        entry.connect("changed", lambda e: dialog.set_response_enabled("approve", bool(e.get_text().strip())))
        dialog.set_response_enabled("approve", bool(entry.get_text().strip()))

        def answered(_d, response):
            name = entry.get_text().strip()[:80]
            if response != "approve" or not name:
                return
            self.call({"op": "approve-drive", "organisation_id": org["id"], "name": name,
                       "vendor_id": d.get("vendor_id"), "product_id": d.get("product_id"), "serial": d.get("serial")},
                      lambda _r, error: self.toast(error) if error else
                      (self.toast(f"{name} approved"), self.open_drives(org)))
        dialog.connect("response", answered)
        dialog.present(self)
        return dialog

    # --- Fixes, scripts and messages (2.9b) -------------------------------------------------------
    def org_of(self, org_id: str) -> dict:
        return next((o for o in (self.data or {}).get("organisations", []) if o["id"] == org_id), {})

    def add_job_rows(self, group: Adw.PreferencesGroup, org: dict, where: str, body: dict) -> None:
        for kind, title, subtitle, icon in JOB_ROWS:
            if kind == "run-script" and not org.get("allow_scripts"):
                continue
            row = Adw.ActionRow(title=title, subtitle=subtitle, activatable=True)
            row.add_prefix(Gtk.Image(icon_name=icon))
            row.connect("activated", lambda _r, k=kind: self.job_dialog(k, org, where, body))
            group.add(row)

    def code_first(self, then) -> None:
        """Scripts need the authenticator app's code: asked first, so nothing typed is lost."""
        if self.sample_mode():
            then()
            return

        def work():
            return None if self.session.aal() == "aal2" else self.session.authenticators()

        def got(factors, error):
            if error:
                self.toast(error)
                return
            if factors is None:
                then()
                return
            if getattr(self, "two_step_dialog", None) is not None:
                return
            self.after_code = then
            verified = any(f.get("status") == "verified" for f in factors)
            self.two_step_dialog = self.ask_authenticator_code() if verified else self.set_up_authenticator(False)
            self.two_step_dialog.connect("closed", lambda _d: setattr(self, "two_step_dialog", None))
        self.background(work, got)

    def code_done(self) -> None:
        then, self.after_code = getattr(self, "after_code", None), None
        if then:
            then()

    def send_job(self, kind: str, body: dict, payload: dict, said: str) -> None:
        """body: {op: action, device_id}, {op: group-action, group_id} or {op: message-person, person_id}."""
        call = {**body, **payload} if body.get("op") == "message-person" else {**body, "type": kind, "payload": payload}

        def done(r, error):
            if error:
                self.toast(error)
                return
            n = (r or {}).get("count")
            self.toast(said + (f" ({n} computer{'s' if n != 1 else ''})" if n is not None else ""))
            if not self.sample_mode():
                self.reload()
        self.call(call, done, {"count": 1})

    def job_dialog(self, kind: str, org: dict, where: str, body: dict) -> Adw.AlertDialog | None:
        if kind == "run-script":
            self.code_first(lambda: self.load_scripts(org, lambda out, error: self.toast(error) if error else
                                                      self.script_run_dialog(where, body, out)))
            return None
        box = Gtk.ListBox(css_classes=["boxed-list"], selection_mode=Gtk.SelectionMode.NONE)
        outer = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        outer.append(box)
        if kind == "run-fix":
            dialog = Adw.AlertDialog(heading=f"Run a fix on {where}", body="It runs at the next report. Whoever is "
                                     "using the computer sees which fix is running.")
            pick = Adw.ComboRow(title="Fix", model=Gtk.StringList.new([t for _k, t, _a in FIXES]))
            box.append(pick)
            about = Gtk.Label(label=FIXES[0][2], wrap=True, xalign=0, css_classes=["dim-label"])
            pick.connect("notify::selected", lambda r, _p: about.set_label(FIXES[r.get_selected()][2]))
            outer.append(about)
            dialog.add_response("cancel", "Cancel")
            dialog.add_response("go", "Run")

            def go():
                key, label, _a = FIXES[pick.get_selected()]
                self.send_job(kind, body, {"fix": key}, f"{label} will run on {where}")
        else:
            dialog = Adw.AlertDialog(heading=f"Send a message to {where}", body="It shows as a notification on the "
                                     "screen of whoever is signed in, with your organisation's name.")
            title = Adw.EntryRow(title="Title")
            box.append(title)
            text = Gtk.TextView(wrap_mode=Gtk.WrapMode.WORD_CHAR, top_margin=8, bottom_margin=8, left_margin=10,
                                right_margin=10, accepts_tab=False)
            text.update_property([Gtk.AccessibleProperty.LABEL], ["Message"])
            frame = Gtk.Frame(child=Gtk.ScrolledWindow(child=text, min_content_height=96))
            outer.append(Gtk.Label(label="Message", xalign=0, css_classes=["dim-label"]))
            outer.append(frame)
            dialog.add_response("cancel", "Cancel")
            dialog.add_response("go", "Send")
            dialog.set_response_enabled("go", False)
            title.connect("changed", lambda e: dialog.set_response_enabled("go", bool(e.get_text().strip())))

            def go():
                buf = text.get_buffer()
                self.send_job(kind, body, {"title": title.get_text().strip()[:80],
                                           "body": buf.get_text(buf.get_start_iter(), buf.get_end_iter(), False).strip()[:500]},
                              f"The message will show on {where}")
        dialog.set_extra_child(outer)
        dialog.set_response_appearance("go", Adw.ResponseAppearance.SUGGESTED)
        dialog.connect("response", lambda _d, r: r == "go" and go())
        dialog.present(self)
        return dialog

    def load_scripts(self, org: dict, then) -> None:
        self.call({"op": "scripts", "organisation_id": org["id"]}, then,
                  lambda: (self.data or {}).get("sample_scripts", {"allowed": False, "scripts": []}))

    def script_run_dialog(self, where: str, body: dict, out: dict | None) -> Adw.AlertDialog | None:
        scripts = (out or {}).get("scripts") or []
        if not (out or {}).get("allowed"):
            self.toast("The Owner hasn't allowed scripts for this organisation")
            return None
        if not scripts:
            self.toast("No scripts yet. Add one under Scripts first")
            return None
        dialog = Adw.AlertDialog(heading=f"Run a script on {where}", body="It runs as root at the next report, for up to "
                                 "10 minutes. The computer checks that it's this exact script before running it, and "
                                 "whoever is using it sees the script's name.")
        box = Gtk.ListBox(css_classes=["boxed-list"], selection_mode=Gtk.SelectionMode.NONE)
        pick = Adw.ComboRow(title="Script", model=Gtk.StringList.new([x["name"] for x in scripts]))
        box.append(pick)
        about = Gtk.Label(wrap=True, xalign=0, css_classes=["dim-label"])
        shown = Gtk.TextView(editable=False, cursor_visible=False, monospace=True, top_margin=8, bottom_margin=8,
                             left_margin=10, right_margin=10)
        shown.update_property([Gtk.AccessibleProperty.LABEL], ["The script"])

        def describe(*_a):
            x = scripts[pick.get_selected()]
            about.set_label(" · ".join(y for y in (x.get("description"), f"changed {ago(x.get('updated_at'))} by "
                                                                         f"{x.get('updated_by') or '–'}") if y))
            shown.get_buffer().set_text(x.get("body") or "")
        pick.connect("notify::selected", describe)
        describe()
        outer = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        for w in (box, about, Gtk.Frame(child=Gtk.ScrolledWindow(child=shown, min_content_height=140))):
            outer.append(w)
        dialog.set_extra_child(outer)
        dialog.add_response("cancel", "Cancel")
        dialog.add_response("go", "Run")
        dialog.set_response_appearance("go", Adw.ResponseAppearance.SUGGESTED)

        def answered(_d, r):
            if r == "go":
                x = scripts[pick.get_selected()]
                self.send_job("run-script", body, {"script_id": x["id"]}, f"{x['name']} will run on {where}")
        dialog.connect("response", answered)
        dialog.present(self)
        return dialog

    def open_output(self, a: dict, hostname: str | None) -> None:
        what = FIX_LABEL.get(a.get("what"), a.get("what")) if a["type"] == "run-fix" else a.get("what")
        view = Adw.ToolbarView()
        header = Adw.HeaderBar()
        save = Gtk.Button(icon_name="document-save-symbolic", tooltip_text="Save as a file", sensitive=False)
        header.pack_end(save)
        view.add_top_bar(header)
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10, margin_top=12, margin_bottom=12,
                      margin_start=18, margin_end=18)
        status = Gtk.Label(wrap=True, xalign=0, css_classes=["dim-label"],
                           label=f"{ago(a.get('created_at'))} · asked by {a.get('requested_by') or '–'}")
        text = Gtk.TextView(editable=False, cursor_visible=False, monospace=True, wrap_mode=Gtk.WrapMode.WORD_CHAR,
                            top_margin=10, bottom_margin=10, left_margin=12, right_margin=12)
        text.update_property([Gtk.AccessibleProperty.LABEL], ["Output"])
        text.get_buffer().set_text("Loading…")
        box.append(status)
        box.append(Gtk.Frame(child=Gtk.ScrolledWindow(child=text, vexpand=True)))
        view.set_content(box)
        self.nav.push(Adw.NavigationPage(title=f"{what or ACTION_LABEL.get(a['type'], a['type'])} on {hostname or 'a computer'}",
                                         child=view))
        kept = {"text": ""}

        def done(r, error):
            if error:
                text.get_buffer().set_text(error)
                return
            kept["text"] = (r or {}).get("output") or ""
            text.get_buffer().set_text(kept["text"] or "No output kept. Output is kept for 90 days.")
            if (r or {}).get("exit_code") is not None:
                status.set_label(f"{status.get_label()} · exit code {r['exit_code']}")
            save.set_sensitive(bool(kept["text"]))
        name = f"{re.sub(r'[^A-Za-z0-9._-]+', '-', hostname or 'computer')}-{(a.get('created_at') or '')[:10]}.txt"

        def write(path: str) -> None:
            with open(path, "w", encoding="utf-8") as fh:
                fh.write(kept["text"])
        save.connect("clicked", lambda _b: self.save_file(name, write, "Output saved"))
        self.call({"op": "action-output", "action_id": a["id"]}, done, lambda: (self.data or {}).get("sample_output"))

    def open_scripts(self, org: dict) -> None:
        if org.get("id") != self.org_id:
            return  # a reply about another organisation, after it was switched
        page, actions = self.section_page("scripts")
        add = Gtk.Button(label="Add a script", css_classes=["suggested-action"], visible=False)
        add.connect("clicked", lambda _b: self.script_dialog(org, None))
        actions.append(add)
        group = Adw.PreferencesGroup(description="Loading…")
        page.add(group)

        def done(out, error):
            if error:
                group.set_description(error)
                return
            allowed, scripts = bool((out or {}).get("allowed")), (out or {}).get("scripts") or []
            group.set_description("Your organisation's own scripts, run as root on the computers you choose, with their "
                                  "output shown here. Adding, changing and running them needs your authenticator app's code."
                                  if allowed else "Off. Only the Owner can allow your organisation's own scripts on its "
                                  "computers. Kulan's fixes work either way.")
            add.set_visible(allowed)
            if (out or {}).get("is_owner"):
                switch = Adw.SwitchRow(title="Allow scripts on this organisation's computers", subtitle_lines=0,
                                       subtitle="Every script and every run is in the activity log", active=allowed)
                switch.connect("notify::active", lambda sw, _p: self.set_scripts_allowed(org, sw))
                group.add(switch)
            if not allowed:
                return
            for x in scripts:
                row = Adw.ActionRow(title=GLib.markup_escape_text(x["name"]), activatable=True, subtitle_lines=2,
                                    subtitle=GLib.markup_escape_text(" · ".join(y for y in (
                                        x.get("description"), f"changed {ago(x.get('updated_at'))} by {x.get('updated_by') or '–'}") if y)))
                row.add_prefix(Gtk.Image(icon_name="text-x-script-symbolic"))
                row.add_suffix(Gtk.Image(icon_name="document-edit-symbolic"))
                row.connect("activated", lambda _r, s=x: self.script_dialog(org, s))
                group.add(row)
            if not scripts:
                group.add(Adw.ActionRow(title="No scripts yet", subtitle="Add one with Add a script"))
        self.load_scripts(org, done)

    def set_scripts_allowed(self, org: dict, switch: Adw.SwitchRow) -> Adw.AlertDialog | None:
        if getattr(self, "toggling_scripts", False):
            return None
        want = switch.get_active()

        def put_back() -> None:
            self.toggling_scripts = True
            switch.set_active(not want)
            self.toggling_scripts = False

        def go() -> None:
            def done(_r, error):
                if error:
                    put_back()
                    self.toast(error)
                    return
                org["allow_scripts"] = want
                self.toast("Scripts allowed" if want else "Scripts stopped. Any still waiting won't run")
                self.open_scripts(org)
                if not self.sample_mode():
                    self.reload()
            self.call({"op": "set-scripts-allowed", "organisation_id": org["id"], "allowed": want}, done)
        if not want:
            go()
            return None
        dialog = Adw.AlertDialog(heading="Allow scripts?", body="Admins who sign in with their authenticator app can "
                                 "then run any command as root on this organisation's computers. Every script and every "
                                 "run is in the activity log.")
        dialog.add_response("cancel", "Cancel")
        dialog.add_response("allow", "Allow scripts")
        dialog.set_response_appearance("allow", Adw.ResponseAppearance.DESTRUCTIVE)
        dialog.set_close_response("cancel")
        dialog.connect("response", lambda _d, r: self.code_first(go) if r == "allow" else put_back())
        dialog.present(self)
        return dialog

    def script_dialog(self, org: dict, script: dict | None) -> None:
        def ready() -> None:
            if script is None or script.get("body") is not None:
                self.script_editor(org, script)
                return
            # Listed before the code was given: fetched again, now with what it says.
            self.load_scripts(org, lambda out, error: self.toast(error) if error else self.script_editor(
                org, next((x for x in (out or {}).get("scripts") or [] if x["id"] == script["id"]), script)))
        self.code_first(ready)

    def script_editor(self, org: dict, script: dict | None) -> Adw.Dialog:
        dialog = Adw.Dialog(title=script["name"] if script else "Add a script", content_width=640, content_height=620)
        view = Adw.ToolbarView()
        header = Adw.HeaderBar(show_start_title_buttons=False, show_end_title_buttons=False)
        cancel = Gtk.Button(label="Cancel")
        cancel.connect("clicked", lambda _b: dialog.close())
        save = Gtk.Button(label="Save", css_classes=["suggested-action"], sensitive=False)
        header.pack_start(cancel)
        header.pack_end(save)
        view.add_top_bar(header)
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12, margin_top=12, margin_bottom=18,
                      margin_start=18, margin_end=18)
        rows = Gtk.ListBox(css_classes=["boxed-list"], selection_mode=Gtk.SelectionMode.NONE)
        name = Adw.EntryRow(title="Name", text=(script or {}).get("name", ""))
        about = Adw.EntryRow(title="What it does (for other admins)", text=(script or {}).get("description", ""))
        rows.append(name)
        rows.append(about)
        box.append(rows)
        box.append(Gtk.Label(label="Bash, run as root with a 10-minute limit. Only the first 64 KB of what it prints is kept.",
                             wrap=True, xalign=0, css_classes=["dim-label"]))
        text = Gtk.TextView(monospace=True, top_margin=10, bottom_margin=10, left_margin=12, right_margin=12)
        text.update_property([Gtk.AccessibleProperty.LABEL], ["Script"])
        text.get_buffer().set_text((script or {}).get("body") or "")
        box.append(Gtk.Frame(child=Gtk.ScrolledWindow(child=text, vexpand=True)))
        note = Gtk.Label(wrap=True, xalign=0, css_classes=["error"])
        box.append(note)
        if script:
            remove = Gtk.Button(label="Remove this script", css_classes=["destructive-action"], halign=Gtk.Align.START)
            remove.connect("clicked", lambda _b: (dialog.close(), self.remove_script(org, script)))
            box.append(remove)
        view.set_content(box)
        dialog.set_child(view)

        def body_text() -> str:
            buf = text.get_buffer()
            return buf.get_text(buf.get_start_iter(), buf.get_end_iter(), False)

        def check(*_a) -> None:
            save.set_sensitive(bool(name.get_text().strip()) and bool(body_text().strip()))
        name.connect("changed", check)
        text.get_buffer().connect("changed", check)
        check()

        def saved(_r, error):
            if error:
                note.set_label(error)
                save.set_sensitive(True)
                return
            dialog.close()
            self.toast(f"{name.get_text().strip()} saved")
            self.open_scripts(org)

        def do_save(_b) -> None:
            save.set_sensitive(False)
            which = {"op": "edit-script", "script_id": script["id"]} if script else \
                {"op": "add-script", "organisation_id": org["id"]}
            self.call({**which, "name": name.get_text().strip(), "description": about.get_text().strip(),
                       "body": body_text()}, saved)
        save.connect("clicked", do_save)
        dialog.present(self)
        return dialog

    def remove_script(self, org: dict, script: dict) -> Adw.AlertDialog:
        dialog = Adw.AlertDialog(heading=f"Remove {script['name']}?", body="Requests already sent still run if they "
                                 "haven't yet. It stays in the activity log.")
        dialog.add_response("cancel", "Cancel")
        dialog.add_response("remove", "Remove")
        dialog.set_response_appearance("remove", Adw.ResponseAppearance.DESTRUCTIVE)
        dialog.connect("response", lambda _d, r: r == "remove" and self.call(
            {"op": "remove-script", "script_id": script["id"]},
            lambda _r, error: self.toast(error) if error else (self.toast(f"{script['name']} removed"), self.open_scripts(org))))
        dialog.present(self)
        return dialog

    # --- Wi-Fi networks and printers for a group (2.9b) -------------------------------------------
    def reopen_group(self, org: dict, g: dict) -> None:
        def done(groups, error):
            if error:
                self.toast(error)
                return
            fresh = next((x for x in groups or [] if x["id"] == g["id"]), g)
            self.nav.pop()
            self.open_group(org, fresh)
        self.load_groups(org, done)

    def remove_pushed(self, org: dict, g: dict, kind: str, item: dict) -> Adw.AlertDialog:
        label = item.get("ssid") or item.get("name")
        dialog = Adw.AlertDialog(heading=f"Remove {label}?", body=f"It's taken off {g['name']}'s computers at their next "
                                 "report. Networks and printers people added themselves stay.")
        dialog.add_response("cancel", "Cancel")
        dialog.add_response("remove", "Remove")
        dialog.set_response_appearance("remove", Adw.ResponseAppearance.DESTRUCTIVE)

        def answered(_d, r):
            if r != "remove":
                return
            if self.sample_mode():
                key = "networks" if kind == "network" else "printers"
                g[key] = [x for x in g.get(key) or [] if x is not item]
            self.call({"op": f"remove-{kind}", f"{kind}_id": item["id"]},
                      lambda _r, error: self.toast(error) if error else self.reopen_group(org, g))
        dialog.connect("response", answered)
        dialog.present(self)
        return dialog

    def network_dialog(self, org: dict, g: dict) -> Adw.AlertDialog:
        dialog = Adw.AlertDialog(heading=f"Add a Wi-Fi network to {g['name']}",
                                 body="Its computers connect to it at their next report.")
        box = Gtk.ListBox(css_classes=["boxed-list"], selection_mode=Gtk.SelectionMode.NONE)
        ssid = Adw.EntryRow(title="Network name")
        security = Adw.ComboRow(title="Security", model=Gtk.StringList.new(["Password (WPA2 or WPA3 personal)",
                                                                           "Open, no password"]))
        password = Adw.PasswordEntryRow(title="Password")
        hidden = Adw.SwitchRow(title="Hidden network", subtitle="It doesn't show its name")
        for w in (ssid, security, password, hidden):
            box.append(w)
        note = Gtk.Label(wrap=True, xalign=0, css_classes=["dim-label"])
        outer = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        outer.append(box)
        outer.append(note)
        outer.append(Gtk.Label(label="The password is kept encrypted and sent only to the group's computers. It isn't "
                               "shown in Kulan Fleet again. People using those computers may be able to see it, as with "
                               "any shared Wi-Fi password.", wrap=True, xalign=0, css_classes=["dim-label"]))
        dialog.set_extra_child(outer)
        dialog.add_response("cancel", "Cancel")
        dialog.add_response("add", "Add")
        dialog.set_response_appearance("add", Adw.ResponseAppearance.SUGGESTED)
        dialog.set_response_enabled("add", False)
        kind = lambda: "open" if security.get_selected() == 1 else "wpa-psk"  # noqa: E731

        def check(*_a) -> None:
            password.set_sensitive(kind() != "open")
            problem = network_problem(ssid.get_text(), kind(), password.get_text())
            note.set_label(problem if problem and ssid.get_text() else "")
            dialog.set_response_enabled("add", problem is None)
        for w, signal in ((ssid, "changed"), (password, "changed"), (security, "notify::selected")):
            w.connect(signal, check)

        def answered(_d, r):
            if r != "add" or network_problem(ssid.get_text(), kind(), password.get_text()):
                return
            body = {"op": "add-network", "group_id": g["id"], "ssid": ssid.get_text(), "security": kind(),
                    "hidden": hidden.get_active(), **({"password": password.get_text()} if kind() != "open" else {})}

            def done(r_, error):
                if error:
                    self.toast(error)
                    return
                if self.sample_mode():
                    g.setdefault("networks", []).append({"id": "n-new", "ssid": body["ssid"], "security": kind(),
                                                         "hidden": body["hidden"]})
                self.toast(f"{body['ssid']} added to {g['name']}")
                self.reopen_group(org, g)
            self.call(body, done, {"id": "n-new"})
        dialog.connect("response", answered)
        dialog.present(self)
        return dialog

    def printer_dialog(self, org: dict, g: dict) -> Adw.AlertDialog:
        dialog = Adw.AlertDialog(heading=f"Add a printer to {g['name']}",
                                 body="Its computers get it at their next report. Most office printers made since 2015 "
                                      "work without a driver.")
        box = Gtk.ListBox(css_classes=["boxed-list"], selection_mode=Gtk.SelectionMode.NONE)
        name = Adw.EntryRow(title="Name people see")
        uri = Adw.EntryRow(title="Printer address")
        box.append(name)
        box.append(uri)
        note = Gtk.Label(label="The address is usually ipp://, the printer's IP address, then /ipp/print. For example "
                         "ipp://192.168.1.20/ipp/print", wrap=True, xalign=0, css_classes=["dim-label"])
        outer = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        outer.append(box)
        outer.append(note)
        dialog.set_extra_child(outer)
        dialog.add_response("cancel", "Cancel")
        dialog.add_response("add", "Add")
        dialog.set_response_appearance("add", Adw.ResponseAppearance.SUGGESTED)
        dialog.set_response_enabled("add", False)
        ready = lambda: bool(name.get_text().strip()) and bool(PRINTER_URI.match(uri.get_text().strip()))  # noqa: E731
        name.connect("changed", lambda _e: dialog.set_response_enabled("add", ready()))
        uri.connect("changed", lambda _e: dialog.set_response_enabled("add", ready()))

        def answered(_d, r):
            if r != "add" or not ready():
                return
            body = {"op": "add-printer", "group_id": g["id"], "name": name.get_text().strip(), "uri": uri.get_text().strip()}

            def done(_r, error):
                if error:
                    self.toast(error)
                    return
                if self.sample_mode():
                    g.setdefault("printers", []).append({"id": "pr-new", "name": body["name"], "uri": body["uri"]})
                self.toast(f"{body['name']} added to {g['name']}")
                self.reopen_group(org, g)
            self.call(body, done, {"id": "pr-new"})
        dialog.connect("response", answered)
        dialog.present(self)
        return dialog

    # --- People ---------------------------------------------------------------------------------
    def sample_mode(self) -> bool:
        return bool(self.data and self.data.get("sample"))

    def call(self, body: dict, done, sample_reply=None) -> None:
        """A fleet-admin call in the background; with sample data (the self-test), its stand-in reply."""
        if self.sample_mode():
            done(sample_reply() if callable(sample_reply) else (sample_reply or {}), None)
            return
        self.background(lambda: self.session.call(body), done)

    def org_computers(self, org: dict) -> list[dict]:
        return [d for d in (self.data or {}).get("devices", []) if d["organisation_id"] == org["id"] and not d.get("left_at")]

    def open_remote_help(self, d: dict) -> None:
        """Remote help is in the web dashboard (the screen plays in the browser): opened at this computer."""
        url = f"{DASHBOARD}/#help={d['id']}"
        self.last_opened = url  # for the self-test
        if self.sample_mode():
            return
        Gtk.UriLauncher.new(url).launch(self, None, None, None)

    def computer_picker(self, org: dict, all_on: bool, chosen: list[str], chosen_groups: list[str] | None = None):
        """All the organisation's computers, or chosen ones and groups' (now and later): (rows to add to a
        list, a function giving (all_computers, [device ids], [group ids]))."""
        everything = Adw.SwitchRow(title="All the organisation's computers",
                                   subtitle="Including computers that join later", active=all_on)
        checks, group_checks = [], []
        rows = [everything]
        for g in self.org_groups.get(org["id"]) or []:
            row = Adw.ActionRow(title=GLib.markup_escape_text(f"Every computer in {g['name']}"),
                                subtitle="Including computers added to it later", visible=not all_on)
            check = Gtk.CheckButton(active=g["id"] in (chosen_groups or []), valign=Gtk.Align.CENTER)
            row.add_prefix(check)
            row.set_activatable_widget(check)
            group_checks.append((g["id"], check))
            rows.append(row)
        for d in self.org_computers(org):
            row = Adw.ActionRow(title=GLib.markup_escape_text(d.get("hostname") or "(no name)"), visible=not all_on)
            check = Gtk.CheckButton(active=d["id"] in chosen, valign=Gtk.Align.CENTER)
            row.add_prefix(check)
            row.set_activatable_widget(check)
            checks.append((d["id"], check))
            rows.append(row)
        everything.connect("notify::active", lambda sw, _p: [r.set_visible(not sw.get_active()) for r in rows[1:]])
        return rows, lambda: (everything.get_active(), [i for i, c in checks if c.get_active()],
                              [i for i, c in group_checks if c.get_active()])

    def open_people(self, org: dict) -> None:
        if org.get("id") != self.org_id:
            return  # a reply about another organisation, after it was switched
        page, actions = self.section_page("people")
        add = Gtk.Button(label="Add a person", css_classes=["suggested-action"], sensitive=False)
        actions.append(add)
        group = Adw.PreferencesGroup(description="Loading…")
        page.add(group)
        self.people_page = page

        def done(result, error):
            if error:
                group.set_description(error)
                return
            people = (result or {}).get("people") or []
            self.people_cache[org["id"]] = people
            self.update_counts(self.current_org())
            is_owner = bool((result or {}).get("is_owner"))
            add.set_sensitive(True)
            add.connect("clicked", lambda _b: self.add_person(org, is_owner))
            group.set_description(f"{len(people)} {'person' if len(people) == 1 else 'people'}. Computers get "
                                  "changes at their next report." if people else
                                  "Nobody yet. Add someone with Add a person.")
            for person in people:
                n = len(person.get("on") or [])
                where = "all computers" if person.get("all_computers") else f"{n} computer{'s' if n != 1 else ''}"
                row = Adw.ActionRow(title=GLib.markup_escape_text(person.get("full_name") or person["username"]),
                                    subtitle=GLib.markup_escape_text(f"{person['username']} · {where}"), activatable=True)
                row.add_prefix(Gtk.Image(icon_name="avatar-default-symbolic"))
                if person.get("role") != "employee":
                    row.add_suffix(tag(ROLE_LABEL.get(person.get("role"), person.get("role")), "dim"))
                if not person.get("enabled"):
                    row.add_suffix(tag("disabled", "bad"))
                elif person.get("must_change"):
                    row.add_suffix(tag("setup code not used yet", "warn"))
                if person.get("mailbox_todo"):
                    row.add_suffix(tag(f"mailbox {MAILBOX_TODO.get(person['mailbox_todo'], 'needs a retry')}", "bad"))
                row.add_suffix(Gtk.Image(icon_name="go-next-symbolic"))
                row.connect("activated", lambda _r, pe=person: self.open_person(org, pe, is_owner))
                group.add(row)
            # Removed people whose mailbox still has something left to do.
            leaving = (result or {}).get("removed_with_mailbox_todo") or []
            if leaving:
                gone = Adw.PreferencesGroup(title="Removed, mailbox still to finish",
                                            description="Google refused or couldn't be reached when they were removed.")
                page.add(gone)
                for pe in leaving:
                    gone.add(self.mailbox_todo_row(org, pe, is_owner))
        self.call({"op": "people", "organisation_id": org["id"]}, done,
                  lambda: {"people": (self.data or {}).get("sample_people", []), "is_owner": True})

    def open_person(self, org: dict, person: dict, is_owner: bool) -> None:
        page = Adw.PreferencesPage()
        view = Adw.ToolbarView()
        view.add_top_bar(Adw.HeaderBar())
        view.set_content(page)
        name = person.get("full_name") or person["username"]
        self.nav.push(Adw.NavigationPage(title=name, child=view))
        info = Adw.PreferencesGroup(title=name)
        page.add(info)
        state = ("Disabled" if not person.get("enabled") else
                 "Hasn't used the setup code yet" if person.get("must_change") else "Signs in with their own password")
        for title, value in (("Username", person["username"]), ("Email", person.get("email") or "–"),
                             ("Role", ROLE_LABEL.get(person.get("role"), person.get("role"))), ("Sign-in", state),
                             ("Added", f"{ago(person.get('created_at'))} by {person.get('created_by') or '–'}")):
            row = Adw.ActionRow(title=title, subtitle=GLib.markup_escape_text(str(value)), subtitle_selectable=True)
            row.add_css_class("property")
            info.add(row)

        where = Adw.PreferencesGroup(title="On these computers",
                                     description="All the organisation's computers" if person.get("all_computers")
                                     else "Only the computers chosen for them")
        page.add(where)
        for c in person.get("on") or []:
            status = c.get("status") or "not yet"
            row = Adw.ActionRow(title=GLib.markup_escape_text(c.get("hostname") or "(no name)"))
            row.add_prefix(Gtk.Image(icon_name="computer-symbolic"))
            kind = "bad" if status.startswith(("conflict", "couldn")) else "dim" if status == "not yet" else "good"
            row.add_suffix(tag("waiting for its next report" if status == "not yet" else status, kind))
            where.add(row)
        if not person.get("on"):
            where.add(Adw.ActionRow(title="No computers yet"))

        change = Adw.PreferencesGroup(title="Change")
        page.add(change)
        row = Adw.ActionRow(title="Name and email", activatable=True)
        row.add_prefix(Gtk.Image(icon_name="document-edit-symbolic"))
        row.connect("activated", lambda _r: self.edit_person_details(org, person))
        change.add(row)
        roles = ["employee", "admin", "owner"]
        role = Adw.ComboRow(title="Role", model=Gtk.StringList.new([ROLE_LABEL[r] for r in roles]),
                            subtitle=ROLE_HELP.get(person.get("role"), "") if is_owner else
                            "Only the Owner can change roles",
                            selected=roles.index(person.get("role")) if person.get("role") in roles else 0,
                            sensitive=is_owner)
        role.connect("notify::selected", lambda r, _p: self.change_role(org, person, roles[r.get_selected()], r))
        change.add(role)
        n_groups = len(person.get("groups") or [])
        row = Adw.ActionRow(title="Computers", subtitle="All" if person.get("all_computers") else
                            f"{len(person.get('computers') or [])} chosen" +
                            (f", and every computer in {n_groups} group{'s' if n_groups != 1 else ''}" if n_groups else ""),
                            activatable=True)
        row.add_prefix(Gtk.Image(icon_name="computer-symbolic"))
        row.connect("activated", lambda _r: self.edit_person_computers(org, person))
        change.add(row)

        used = Adw.PreferencesGroup(title="Last used", description=None if person.get("signed_in") else
                                    "Not used on any computer yet")
        page.add(used)
        for si in (person.get("signed_in") or [])[:20]:
            row = Adw.ActionRow(title=GLib.markup_escape_text(si.get("hostname") or ""),
                                subtitle="Signed in now" if si.get("now") else ago_seconds(si.get("last")))
            row.add_prefix(Gtk.Image(icon_name="computer-symbolic"))
            used.add(row)
        if any(si.get("now") for si in person.get("signed_in") or []):
            row = Adw.ActionRow(title="Send a message", subtitle="A notification on the screens they're signed in on now",
                                activatable=True)
            row.add_prefix(Gtk.Image(icon_name="mail-send-symbolic"))
            row.connect("activated", lambda _r: self.job_dialog("message", org, name, {"op": "message-person",
                                                                                         "person_id": person["id"]}))
            used.add(row)
        manages = is_owner or person.get("role") == "employee"
        two = Adw.PreferencesGroup(title="Two-step sign-in", description=None if person.get("two_step") else
                                   "Not set up. They sign in with a password only, and can set it up in Kulan Settings.")
        page.add(two)
        for f in person.get("two_step") or []:
            row = Adw.ActionRow(title=GLib.markup_escape_text(f.get("label") or "Second step"),
                                subtitle=GLib.markup_escape_text(("Security key" if f.get("kind") == "key" else "Phone code") +
                                                                 (f" · set up on {f['created_on']}" if f.get("created_on") else "") +
                                                                 f" · {ago(f.get('created_at'))}"))
            row.add_prefix(Gtk.Image(icon_name="auth-smartcard-symbolic" if f.get("kind") == "key" else "phone-symbolic"))
            two.add(row)
        if person.get("two_step"):
            row = Adw.ActionRow(title="Reset two-step sign-in", subtitle="For a lost security key or phone", activatable=manages, sensitive=manages)
            row.add_prefix(Gtk.Image(icon_name="view-refresh-symbolic"))
            row.connect("activated", lambda _r: self.reset_two_step(org, person))
            two.add(row)
        if org.get("mail_domain") or person.get("mailbox"):
            page.add(self.mailbox_group(org, person, is_owner, manages))
        sign_in = Adw.PreferencesGroup(title="Signing in")
        page.add(sign_in)
        row = Adw.ActionRow(title="Give a new setup code", subtitle="For a forgotten password. Their current one stops "
                            "working at each computer's next report", activatable=manages, sensitive=manages)
        row.add_prefix(Gtk.Image(icon_name="dialog-password-symbolic"))
        row.connect("activated", lambda _r: self.new_setup_code(org, person))
        sign_in.add(row)
        enabled = person.get("enabled")
        row = Adw.ActionRow(title="Disable" if enabled else "Enable again",
                            subtitle="Locked on every computer at its next report. Their files stay." if enabled else
                            "They can sign in again at each computer's next report", activatable=manages,
                            sensitive=manages)
        row.add_prefix(Gtk.Image(icon_name="action-unavailable-symbolic" if enabled else "object-select-symbolic"))
        row.connect("activated", lambda _r: self.set_person_enabled(org, person, not enabled))
        sign_in.add(row)
        leave = Adw.PreferencesGroup()
        page.add(leave)
        row = Adw.ActionRow(title=f"Remove {person['username']}", subtitle="Removed from every computer. You choose "
                            "whether to keep their files.", activatable=manages, sensitive=manages)
        row.add_prefix(Gtk.Image(icon_name="user-trash-symbolic"))
        row.add_css_class("error")
        row.connect("activated", lambda _r: self.remove_person(org, person))
        leave.add(row)
        if not manages:
            leave.set_description("Only the Owner can change an admin's or the Owner's sign-in.")

    def after_people_change(self, org: dict, message: str) -> None:
        self.toast(message)
        self.open_people(org)

    def add_person(self, org: dict, is_owner: bool) -> Adw.AlertDialog:
        dialog = Adw.AlertDialog(heading="Add a person", body="They sign in with a setup code, then choose their own "
                                 "password. Computers add the account at their next report.")
        box = Gtk.ListBox(css_classes=["boxed-list"], selection_mode=Gtk.SelectionMode.NONE)
        full = Adw.EntryRow(title="Full name")
        user = Adw.EntryRow(title="Username")
        email = Adw.EntryRow(title="Work email (optional)")
        roles = ["employee"] + (["admin", "owner"] if is_owner else [])
        role = Adw.ComboRow(title="Role", model=Gtk.StringList.new([ROLE_LABEL[r] for r in roles]),
                            subtitle=ROLE_HELP["employee"] if is_owner else "Only the Owner can add admins")
        role.connect("notify::selected", lambda r, _p: r.set_subtitle(ROLE_HELP[roles[r.get_selected()]]))
        for w in (full, user, email, role):
            box.append(w)
        domain = org.get("mail_domain")
        make_mailbox = Adw.SwitchRow(title="Make a Google mailbox", subtitle=GLib.markup_escape_text(
            f"On {domain}. Google asks them to choose a password at first sign-in."), active=bool(domain),
            visible=bool(domain))
        address = Adw.EntryRow(title="Mailbox address", visible=bool(domain))
        make_mailbox.connect("notify::active", lambda sw, _p: (address.set_visible(sw.get_active()),
                                                                email.set_visible(not sw.get_active())))
        email.set_visible(not domain)
        box.append(make_mailbox)
        box.append(address)
        rows, picked = self.computer_picker(org, True, [])
        for r in rows:
            box.append(r)
        note = Gtk.Label(wrap=True, xalign=0, css_classes=["dim-label"], margin_top=6)
        outer = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        outer.append(box)
        outer.append(note)
        dialog.set_extra_child(outer)
        dialog.add_response("cancel", "Cancel")
        dialog.add_response("add", "Add")
        dialog.set_response_appearance("add", Adw.ResponseAppearance.SUGGESTED)
        dialog.set_response_enabled("add", False)
        suggested = {"last": ""}

        suggested_address = {"last": ""}

        def name_changed(_e):
            if user.get_text() in ("", suggested["last"]):
                suggested["last"] = suggest_username(full.get_text())
                user.set_text(suggested["last"])

        def problem_now() -> str | None:
            problem = username_problem(user.get_text())
            if not problem and domain and make_mailbox.get_active() and \
                    not MAILBOX_ADDRESS.match(address.get_text().strip().lower()):
                problem = "The mailbox address doesn't look right"
            return problem

        def user_changed(_e):
            text = user.get_text()
            if text != text.lower():  # capitals typed: lower case, as the computers need
                at = user.get_position()
                user.set_text(text.lower())  # runs this again with the lower-case name
                user.set_position(at)
                return
            if domain and address.get_text() in ("", suggested_address["last"]):
                suggested_address["last"] = f"{user.get_text()}@{domain}" if user.get_text() else ""
                address.set_text(suggested_address["last"])
            problem = problem_now()
            note.set_label(problem or "")
            dialog.set_response_enabled("add", problem is None)

        def address_changed(_e):
            problem = problem_now()
            note.set_label(problem or "")
            dialog.set_response_enabled("add", problem is None)
        full.connect("changed", name_changed)
        user.connect("changed", user_changed)
        address.connect("changed", address_changed)
        make_mailbox.connect("notify::active", address_changed)

        def answered(_d, response):
            if response != "add" or problem_now():
                return
            all_computers, computers, groups = picked()
            display = full.get_text().strip() or user.get_text()
            code = setup_code()
            body = {"op": "add-person", "organisation_id": org["id"], "username": user.get_text(),
                    "full_name": full.get_text().strip(), "role": roles[role.get_selected()],
                    "all_computers": all_computers, "computers": computers, "groups": groups}
            if domain and make_mailbox.get_active():
                body["mailbox"] = {"action": "create", "address": address.get_text().strip().lower()}
                body["email"] = body["mailbox"]["address"]
            elif email.get_text().strip():
                body["email"] = email.get_text().strip()

            def work():
                body["password_hash"] = hash_password(code)
                return ({"mailbox": body["mailbox"]["address"], "mailbox_password": "abcd-EFGH-2346-mnpq"}
                        if "mailbox" in body else {}) if self.sample_mode() else self.session.call(body)

            def done(r, error):
                if error:
                    self.toast(error)
                    return
                r = r or {}
                self.show_setup_code(display, code, first=True)
                if r.get("mailbox_password"):
                    self.show_mailbox_password(display, r["mailbox"], r["mailbox_password"])
                self.after_people_change(org, f"Added {user.get_text()}" + (
                    f", but the mailbox wasn't made: {r['mailbox_error']}" if r.get("mailbox_error") else ""))
            self.background(work, done)
        dialog.connect("response", answered)
        dialog.present(self)
        return dialog

    def show_setup_code(self, display: str, code: str, first: bool) -> Adw.AlertDialog:
        dialog = Adw.AlertDialog(
            heading=f"Setup code for {display}",
            body=(f"Give this to {display} in person or by phone, not by email. At the sign-in screen of "
                  f"{'any computer they can use' if first else 'their computer'}, they choose their name, "
                  "type this code with its capitals and dashes, then choose a password. "
                  "It works from each computer's next report. It's shown only once."))
        label = Gtk.Label(label=code, selectable=True, css_classes=["fleet-code"], margin_top=6)
        dialog.set_extra_child(label)
        dialog.add_response("copy", "Copy code")
        dialog.add_response("close", "Done")
        dialog.set_default_response("close")
        dialog.connect("response", lambda _d, r: r == "copy" and Gdk.Display.get_default().get_clipboard().set(code))
        dialog.present(self)
        return dialog

    def edit_person_details(self, org: dict, person: dict) -> Adw.AlertDialog:
        dialog = Adw.AlertDialog(heading=f"Name and email for {person['username']}")
        box = Gtk.ListBox(css_classes=["boxed-list"], selection_mode=Gtk.SelectionMode.NONE)
        full = Adw.EntryRow(title="Full name", text=person.get("full_name") or "")
        email = Adw.EntryRow(title="Work email", text=person.get("email") or "")
        box.append(full)
        box.append(email)
        dialog.set_extra_child(box)
        dialog.add_response("cancel", "Cancel")
        dialog.add_response("save", "Save")
        dialog.set_response_appearance("save", Adw.ResponseAppearance.SUGGESTED)

        def answered(_d, response):
            if response != "save":
                return
            self.call({"op": "edit-person", "person_id": person["id"], "full_name": full.get_text().strip(),
                       "email": email.get_text().strip()},
                      lambda r, error: self.toast(error) if error else self.after_people_change(
                          org, "Saved" + self.mailbox_note(r)))
        dialog.connect("response", answered)
        dialog.present(self)
        return dialog

    def change_role(self, org: dict, person: dict, role: str, combo: Adw.ComboRow) -> None:
        if role == person.get("role"):
            return

        def done(_r, error):
            if error:
                self.toast(error)
                roles = ["employee", "admin", "owner"]
                combo.set_selected(roles.index(person.get("role")) if person.get("role") in roles else 0)
                return
            person["role"] = role
            self.toast(f"{person['username']} is now {'the Owner' if role == 'owner' else 'an ' + ROLE_LABEL[role].lower()}")
        self.call({"op": "edit-person", "person_id": person["id"], "role": role}, done)

    def edit_person_computers(self, org: dict, person: dict) -> Adw.AlertDialog:
        dialog = Adw.AlertDialog(heading=f"Where {person['username']} can sign in",
                                 body="If you take them off a computer, their account there is removed and their files "
                                      "are kept.")
        box = Gtk.ListBox(css_classes=["boxed-list"], selection_mode=Gtk.SelectionMode.NONE)
        rows, picked = self.computer_picker(org, bool(person.get("all_computers")), person.get("computers") or [],
                                            person.get("groups") or [])
        for r in rows:
            box.append(r)
        dialog.set_extra_child(box)
        dialog.add_response("cancel", "Cancel")
        dialog.add_response("save", "Save")
        dialog.set_response_appearance("save", Adw.ResponseAppearance.SUGGESTED)

        def answered(_d, response):
            if response != "save":
                return
            all_computers, computers, groups = picked()
            self.call({"op": "edit-person", "person_id": person["id"], "all_computers": all_computers,
                       "computers": computers, "groups": groups},
                      lambda _r, error: self.toast(error) if error else self.after_people_change(org, "Saved"))
        dialog.connect("response", answered)
        dialog.present(self)
        return dialog

    def new_setup_code(self, org: dict, person: dict) -> Adw.AlertDialog:
        name = person.get("full_name") or person["username"]
        dialog = Adw.AlertDialog(heading=f"A new setup code for {name}?",
                                 body="Their password stops working at each computer's next report. They sign in "
                                      "with the new code and choose a new password.")
        dialog.add_response("cancel", "Cancel")
        dialog.add_response("go", "Make a code")
        dialog.set_response_appearance("go", Adw.ResponseAppearance.SUGGESTED)

        def answered(_d, response):
            if response != "go":
                return
            code = setup_code()

            def work():
                body = {"op": "new-setup-code", "person_id": person["id"], "password_hash": hash_password(code)}
                return {} if self.sample_mode() else self.session.call(body)

            def done(_r, error):
                if error:
                    self.toast(error)
                    return
                self.show_setup_code(name, code, first=False)
                self.after_people_change(org, f"New setup code for {person['username']}")
            self.background(work, done)
        dialog.connect("response", answered)
        dialog.present(self)
        return dialog

    def set_person_enabled(self, org: dict, person: dict, enabled: bool) -> Adw.AlertDialog | None:
        def go():
            self.call({"op": "set-person-enabled", "person_id": person["id"], "enabled": enabled},
                      lambda r, error: self.toast(error) if error else self.after_people_change(
                          org, f"{person['username']} {'enabled' if enabled else 'disabled'}" + self.mailbox_note(r)))
        if enabled:
            go()
            return None
        has_mailbox = person.get("mailbox") and person.get("mailbox_state") not in (None, "deleted") and org.get("mail_domain")
        dialog = Adw.AlertDialog(heading=f"Disable {person['username']}?",
                                 body="At each computer's next report, their account is locked and they're signed "
                                      "out. Their files stay, and you can enable them again." +
                                      (f" Their mailbox {person['mailbox']} is suspended now and unsuspended when "
                                       "they're enabled." if has_mailbox else ""))
        dialog.add_response("cancel", "Cancel")
        dialog.add_response("go", "Disable")
        dialog.set_response_appearance("go", Adw.ResponseAppearance.DESTRUCTIVE)
        dialog.connect("response", lambda _d, r: r == "go" and go())
        dialog.present(self)
        return dialog

    def remove_person(self, org: dict, person: dict) -> Adw.AlertDialog:
        user = person["username"]
        dialog = Adw.AlertDialog(heading=f"Remove {user}?",
                                 body="Their account is removed from every computer at its next report. Type their "
                                      "username to confirm.")
        box = Gtk.ListBox(css_classes=["boxed-list"], selection_mode=Gtk.SelectionMode.NONE)
        files = Adw.SwitchRow(title="Delete their files too",
                              subtitle="If off, each computer keeps their files in /home/.kulan-left for an "
                                       "administrator to hand over")
        entry = Adw.EntryRow(title=f"Type {user}")
        box.append(files)
        mailbox = person.get("mailbox") if person.get("mailbox_state") not in (None, "deleted") and org.get("mail_domain") else None
        choice = Adw.ComboRow(title=GLib.markup_escape_text(f"Their mailbox {mailbox}" if mailbox else "Their mailbox"),
                              model=Gtk.StringList.new(["Suspend it", "Delete it"]), visible=bool(mailbox),
                              subtitle="Mail is kept and can be restored. Google may still charge for it.")
        choice.connect("notify::selected", lambda c, _p: c.set_subtitle(
            "Mail is kept and can be restored. Google may still charge for it." if c.get_selected() == 0 else
            "Google can restore it for 20 days, then it's gone."))
        box.append(choice)
        box.append(entry)
        dialog.set_extra_child(box)
        dialog.add_response("cancel", "Cancel")
        dialog.add_response("remove", "Remove")
        dialog.set_response_appearance("remove", Adw.ResponseAppearance.DESTRUCTIVE)
        dialog.set_response_enabled("remove", False)
        dialog.set_default_response("cancel")
        entry.connect("changed", lambda e: dialog.set_response_enabled("remove", e.get_text().strip() == user))

        def answered(_d, response):
            if response != "remove" or entry.get_text().strip() != user:
                return
            body = {"op": "remove-person", "person_id": person["id"], "remove_files": files.get_active(), "confirm": user}
            if mailbox:
                body["mailbox"] = "suspend" if choice.get_selected() == 0 else "delete"
            self.call(body, lambda r, error: self.toast(error) if error else self.after_people_change(
                org, f"{user} removed" + self.mailbox_note(r)))
        dialog.connect("response", answered)
        dialog.present(self)
        return dialog

    # --- Google Workspace mailboxes (2.8e) ------------------------------------------------------
    @staticmethod
    def mailbox_note(reply: dict | None) -> str:
        """What a toast adds when Google couldn't follow Fleet's change."""
        err = (reply or {}).get("mailbox_error")
        return f". The mailbox wasn't updated ({err}). Retry it from their page." if err else ""

    def mailbox_group(self, org: dict, person: dict, is_owner: bool, manages: bool) -> Adw.PreferencesGroup:
        mailbox, state = person.get("mailbox"), person.get("mailbox_state")
        live = bool(mailbox) and state != "deleted"
        group = Adw.PreferencesGroup(title="Work email", description=None if live else
                                     "No mailbox yet. Once one is made, their computers offer to connect it.")
        if mailbox:
            label, kind = MAILBOX_STATE.get(state, (state or "unknown", "dim"))
            row = Adw.ActionRow(title=GLib.markup_escape_text(mailbox), subtitle_selectable=True,
                                subtitle="Google Workspace" if live else "Deleted when they were removed")
            row.add_prefix(Gtk.Image(icon_name="mail-unread-symbolic"))
            row.add_suffix(tag(label, kind))
            group.add(row)
        if person.get("mailbox_todo"):
            group.add(self.mailbox_todo_row(org, person, is_owner))
        if not org.get("mail_domain"):
            return group
        if live:
            for title, subtitle, icon, action in (
                    ("Give a new Google password", "For a forgotten password",
                     "dialog-password-symbolic", "new-password"),
                    ("Stop managing this mailbox", "The mailbox stays in Google as it is",
                     "list-remove-symbolic", "unlink")):
                row = Adw.ActionRow(title=title, subtitle=subtitle, activatable=manages, sensitive=manages)
                row.add_prefix(Gtk.Image(icon_name=icon))
                row.connect("activated", lambda _r, a=action: self.mailbox_action(org, person, a))
                group.add(row)
        else:
            choices = [("Make a mailbox", f"A new Google mailbox on {org['mail_domain']}", "list-add-symbolic", "create",
                        manages)]
            choices.append(("Link an existing mailbox", "Only the Owner can link a mailbox", "insert-link-symbolic",
                            "link", is_owner))
            for title, subtitle, icon, action, allowed in choices:
                row = Adw.ActionRow(title=title, subtitle=subtitle, activatable=allowed, sensitive=allowed)
                row.add_prefix(Gtk.Image(icon_name=icon))
                row.connect("activated", lambda _r, a=action: self.give_mailbox(org, person, a))
                group.add(row)
        return group

    def mailbox_todo_row(self, org: dict, person: dict, is_owner: bool) -> Adw.ActionRow:
        todo = MAILBOX_TODO.get(person.get("mailbox_todo"), "needs a retry")
        row = Adw.ActionRow(title=GLib.markup_escape_text(f"{person.get('username')}: mailbox {todo}"),
                            subtitle=GLib.markup_escape_text(person.get("mailbox_error") or "Google didn't answer"),
                            subtitle_lines=0)
        row.add_prefix(Gtk.Image(icon_name="dialog-warning-symbolic"))
        manages = is_owner or person.get("role", "employee") == "employee"
        for label, action in (("Retry", "retry"), ("Done by hand", "forget")):
            b = Gtk.Button(label=label, valign=Gtk.Align.CENTER, sensitive=manages,
                           css_classes=["suggested-action"] if action == "retry" else ["flat"],
                           tooltip_text=None if action == "retry" else "Already done in the Google Admin console")
            b.connect("clicked", lambda _b, a=action: self.mailbox_action(org, person, a))
            row.add_suffix(b)
        return row

    def mailbox_action(self, org: dict, person: dict, action: str) -> Adw.AlertDialog | None:
        """retry, forget, new-password or unlink (the last two asked first)."""
        def go() -> None:
            def done(r, error):
                r = r or {}
                if error or r.get("mailbox_error"):
                    self.toast(error or f"Still not done: {r['mailbox_error']}")
                    return
                if r.get("mailbox_password"):
                    self.show_mailbox_password(person.get("full_name") or person["username"], r["mailbox"],
                                               r["mailbox_password"])
                self.after_people_change(org, {"retry": "Done", "forget": "No longer retried",
                                               "new-password": f"New Google password for {person['username']}",
                                               "unlink": "Kulan Fleet no longer manages that mailbox"}[action])
            self.call({"op": "mailbox", "person_id": person["id"], "action": action}, done,
                      {"mailbox": person.get("mailbox"), "mailbox_password": "abcd-EFGH-2346-mnpq"}
                      if action == "new-password" else {})
        if action in ("retry", "forget"):
            go()
            return None
        dialog = Adw.AlertDialog(
            heading=f"A new Google password for {person['username']}?" if action == "new-password" else
            f"Stop managing {person.get('mailbox')}?",
            body="Their current Google password stops working now. The new one is shown once. Give it to them "
                 "in person." if action == "new-password" else
                 "The mailbox stays in Google Workspace. Kulan Fleet stops suspending, renaming or removing it "
                 "with their account, and their computers stop offering it.")
        dialog.add_response("cancel", "Cancel")
        dialog.add_response("go", "Make a password" if action == "new-password" else "Stop managing")
        dialog.set_response_appearance("go", Adw.ResponseAppearance.SUGGESTED if action == "new-password"
                                       else Adw.ResponseAppearance.DESTRUCTIVE)
        dialog.connect("response", lambda _d, r: r == "go" and go())
        dialog.present(self)
        return dialog

    def give_mailbox(self, org: dict, person: dict, action: str) -> Adw.AlertDialog:
        """Make (create) or link a mailbox for someone who has none."""
        domain = org.get("mail_domain") or ""
        dialog = Adw.AlertDialog(
            heading=f"A mailbox for {person['username']}" if action == "create" else f"Link a mailbox to {person['username']}",
            body=("Its first password is shown once. Google asks them to change it at first sign-in."
                  if action == "create" else
                  "A mailbox already in Google Workspace. From now on it's suspended, renamed and removed "
                  "with their account."))
        box = Gtk.ListBox(css_classes=["boxed-list"], selection_mode=Gtk.SelectionMode.NONE)
        address = Adw.EntryRow(title="Mailbox address", text=f"{person['username']}@{domain}" if domain else "")
        box.append(address)
        note = Gtk.Label(wrap=True, xalign=0, css_classes=["dim-label"], margin_top=6)
        outer = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        outer.append(box)
        outer.append(note)
        dialog.set_extra_child(outer)
        dialog.add_response("cancel", "Cancel")
        dialog.add_response("go", "Make it" if action == "create" else "Link it")
        dialog.set_response_appearance("go", Adw.ResponseAppearance.SUGGESTED)

        def check(_e=None) -> None:
            ok = bool(MAILBOX_ADDRESS.match(address.get_text().strip().lower()))
            note.set_label("" if ok else "That address doesn't look right")
            dialog.set_response_enabled("go", ok)
        address.connect("changed", check)
        check()

        def answered(_d, response):
            if response != "go":
                return
            where = address.get_text().strip().lower()

            def done(r, error):
                r = r or {}
                if error:
                    self.toast(error)
                    return
                if r.get("mailbox_password"):
                    self.show_mailbox_password(person.get("full_name") or person["username"], r["mailbox"],
                                               r["mailbox_password"])
                self.after_people_change(org, f"{where} {'made' if action == 'create' else 'linked'}" +
                                         self.mailbox_note(r))
            self.call({"op": "mailbox", "person_id": person["id"], "action": action, "address": where}, done,
                      {"mailbox": where, **({"mailbox_password": "abcd-EFGH-2346-mnpq"} if action == "create" else {})})
        dialog.connect("response", answered)
        dialog.present(self)
        return dialog

    def show_mailbox_password(self, display: str, address: str, password: str) -> Adw.AlertDialog:
        dialog = Adw.AlertDialog(
            heading=f"Google password for {display}",
            body=(f"Give this to {display} in person or by phone, not by email. They use it to sign in to "
                  f"Google as {address}, then choose their own password. It's shown only once."))
        dialog.set_extra_child(Gtk.Label(label=password, selectable=True, css_classes=["fleet-code"], margin_top=6))
        dialog.add_response("copy", "Copy password")
        dialog.add_response("close", "Done")
        dialog.set_default_response("close")
        dialog.connect("response", lambda _d, r: r == "copy" and Gdk.Display.get_default().get_clipboard().set(password))
        dialog.present(self)
        return dialog

    def open_mail(self, org: dict) -> None:
        if self.nav.find_page("mail") is not None:
            self.nav.pop_to_tag("org")
        page, _header = self.push_page("Google Workspace", "mail")
        group = Adw.PreferencesGroup(title="Google Workspace", description="Loading…")
        page.add(group)

        def done(result, error):
            if error:
                group.set_description(error)
                return
            result = result or {}
            c, is_owner = result.get("connection"), bool(result.get("is_owner"))
            org["mail_domain"] = c.get("domain") if c else None
            group.set_description(
                "Mailboxes are made, suspended and removed along with people's accounts." if c else
                "Connect Google Workspace to manage mailboxes with People. New people get a mailbox. Mailboxes "
                "are suspended when people are disabled, and suspended or deleted when they're removed.")
            if c:
                for title, value in (("Domain", c.get("domain")), ("Acting as", c.get("admin_email")),
                                     ("Service account", c.get("client_email")), ("Client ID", c.get("client_id") or "–"),
                                     ("Connected", f"{ago(c.get('connected_at'))} by {c.get('connected_by') or '–'}"),
                                     ("Managed mailboxes", str(result.get("mailboxes", 0)))):
                    row = Adw.ActionRow(title=title, subtitle=GLib.markup_escape_text(str(value)), subtitle_selectable=True)
                    row.add_css_class("property")
                    group.add(row)
                if c.get("last_error"):
                    row = Adw.ActionRow(title="Last problem", subtitle=GLib.markup_escape_text(c["last_error"]),
                                        subtitle_lines=0)
                    row.add_prefix(Gtk.Image(icon_name="dialog-warning-symbolic"))
                    group.add(row)
            actions = Adw.PreferencesGroup(description=None if is_owner else "Only the Owner can connect or disconnect it.")
            page.add(actions)
            for title, subtitle, icon, opener, show in (
                    ("Connect again with a new key" if c else "Connect Google Workspace",
                     "Choose a service account's JSON key. Kulan Fleet checks it before saving.",
                     "insert-link-symbolic", lambda: self.connect_mail(org), True),
                    ("Existing mailboxes", "Every mailbox on the domain, and who has each", "mail-unread-symbolic", lambda: self.open_mail_users(org), bool(c)),
                    ("Disconnect", "Mailboxes stay in Google as they are",
                     "list-remove-symbolic", lambda: self.disconnect_mail(org), bool(c))):
                if not show:
                    continue
                row = Adw.ActionRow(title=title, subtitle=subtitle, activatable=is_owner, sensitive=is_owner,
                                    subtitle_lines=0)
                row.add_prefix(Gtk.Image(icon_name=icon))
                row.connect("activated", lambda _r, f=opener: f())
                if title == "Disconnect":
                    row.add_css_class("error")
                actions.add(row)
            how = Adw.PreferencesGroup(title="How to connect it",
                                       description="Do this once as a Google Workspace super admin. It takes about 10 minutes.")
            page.add(how)
            for n_, step in enumerate((
                    "In Google Cloud at console.cloud.google.com, make a project and turn on the Admin SDK API",
                    "In IAM & Admin › Service accounts, make a service account with no roles, then add a JSON key "
                    "under Keys",
                    "In the Google Admin console, go to Security › Access and data control › API controls › "
                    f"Domain-wide delegation and add the service account's client ID with the scope {GOOGLE_SCOPE}",
                    "Here, choose Connect Google Workspace, then the key file and a super admin's email"), 1):
                row = Adw.ActionRow(title=GLib.markup_escape_text(f"{n_}. {step}"), title_lines=0)
                how.add(row)
            guide = Adw.ActionRow(title="Full guide", activatable=True)
            guide.add_suffix(Gtk.Image(icon_name="adw-external-link-symbolic"))
            guide.connect("activated", lambda _r: Gtk.UriLauncher.new(GOOGLE_GUIDE).launch(self, None, None, None))
            how.add(guide)
        self.call({"op": "mail", "organisation_id": org["id"]}, done,
                  lambda: (self.data or {}).get("sample_mail", {}))

    def connect_mail(self, org: dict) -> Adw.AlertDialog:
        dialog = Adw.AlertDialog(heading="Connect Google Workspace",
                                 body="Choose the service account's JSON key file and enter a Google super admin's "
                                      "email. Kulan Fleet acts as that admin. The key is stored encrypted and can't "
                                      "be read back, so you can delete the file afterwards.")
        box = Gtk.ListBox(css_classes=["boxed-list"], selection_mode=Gtk.SelectionMode.NONE)
        key_row = Adw.ActionRow(title="Key file", subtitle="None chosen", activatable=True)
        key_row.add_prefix(Gtk.Image(icon_name="dialog-password-symbolic"))
        choose = Gtk.Button(label="Choose…", valign=Gtk.Align.CENTER)
        key_row.add_suffix(choose)
        admin = Adw.EntryRow(title="Super admin's email")
        box.append(key_row)
        box.append(admin)
        note = Gtk.Label(wrap=True, xalign=0, selectable=True, css_classes=["dim-label"], margin_top=6)
        outer = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        outer.append(box)
        outer.append(note)
        dialog.set_extra_child(outer)
        dialog.add_response("cancel", "Cancel")
        dialog.add_response("connect", "Connect")
        dialog.set_response_appearance("connect", Adw.ResponseAppearance.SUGGESTED)
        dialog.set_response_enabled("connect", False)
        key: dict = {}

        def ready(*_a) -> None:
            dialog.set_response_enabled("connect", bool(key) and "@" in admin.get_text())
        admin.connect("changed", ready)

        def take(text: str) -> None:
            try:
                k = json.loads(text)
                assert isinstance(k, dict) and k.get("type") == "service_account" and k.get("client_email") \
                    and k.get("private_key")
            except (ValueError, AssertionError):
                key.clear()
                key_row.set_subtitle("That isn't a service account's JSON key")
                ready()
                return
            key.clear()
            key.update(k)
            key_row.set_subtitle(GLib.markup_escape_text(f"{k['client_email']} · client ID {k.get('client_id') or '?'}"))
            note.set_label(f"Domain-wide delegation for client ID {k.get('client_id') or '?'} with the scope "
                           f"{GOOGLE_SCOPE} must be set up in the Google Admin console first.")
            ready()
        dialog.take_key = take  # for the self-test

        def chosen(d, result):
            try:
                f = d.open_finish(result)
            except GLib.Error:
                return
            try:
                ok, data, _etag = f.load_contents(None)
                take(data[:20000].decode("utf-8", "replace") if ok else "")
            except GLib.Error as e:
                key_row.set_subtitle(GLib.markup_escape_text(f"Couldn't read it: {e.message}"))

        def pick(*_a) -> None:
            files = Gtk.FileDialog(title="The service account's JSON key")
            flt = Gtk.FileFilter(name="JSON key")
            flt.add_pattern("*.json")
            store = Gio.ListStore.new(Gtk.FileFilter)
            store.append(flt)
            files.set_filters(store)
            files.open(self, None, chosen)
        choose.connect("clicked", pick)
        key_row.connect("activated", pick)

        def answered(_d, response):
            if response != "connect" or not key:
                return

            def done(r, error):
                if error:
                    self.toast(error)
                    return
                key.clear()
                self.toast(f"Connected to {(r or {}).get('domain', '')}")
                self.reload()
                self.open_mail(org)
            self.call({"op": "connect-mail", "organisation_id": org["id"], "key": json.dumps(key),
                       "admin_email": admin.get_text().strip()}, done, {"domain": "kulan.example"})
        dialog.connect("response", answered)
        dialog.present(self)
        return dialog

    def disconnect_mail(self, org: dict) -> Adw.AlertDialog:
        dialog = Adw.AlertDialog(heading="Disconnect Google Workspace?",
                                 body="Kulan Fleet deletes its copy of the key. Mailboxes stay in Google but are no "
                                      "longer managed with People, and computers stop offering them. Unfinished "
                                      "suspensions or deletions are left for you to do by hand. To revoke the key, "
                                      "delete it in Google Cloud.")
        dialog.add_response("cancel", "Cancel")
        dialog.add_response("go", "Disconnect")
        dialog.set_response_appearance("go", Adw.ResponseAppearance.DESTRUCTIVE)

        def done(_r, error):
            if error:
                self.toast(error)
                return
            org["mail_domain"] = None
            self.toast("Google Workspace disconnected")
            self.reload()
            self.open_mail(org)
        dialog.connect("response", lambda _d, r: r == "go" and self.call(
            {"op": "disconnect-mail", "organisation_id": org["id"]}, done))
        dialog.present(self)
        return dialog

    def open_mail_users(self, org: dict) -> None:
        page, _header = self.push_page("Existing mailboxes")
        group = Adw.PreferencesGroup(title=f"Mailboxes on {org.get('mail_domain') or ''}", description="Loading…")
        page.add(group)

        def done(result, error):
            if error:
                group.set_description(error)
                return
            users = (result or {}).get("users") or []
            group.set_description(f"{plural(len(users), 'mailbox', 'mailboxes')}. To link one, open the person in "
                                  "People and choose Link an existing mailbox.")
            for u in users[:500]:
                row = Adw.ActionRow(title=GLib.markup_escape_text(u.get("address") or ""),
                                    subtitle=GLib.markup_escape_text(" · ".join(x for x in (
                                        u.get("name"), f"in People as {u['username']}" if u.get("username") else
                                        "not in People") if x)))
                if u.get("admin"):
                    row.add_suffix(tag("Google admin", "dim"))
                if u.get("suspended"):
                    row.add_suffix(tag("suspended", "warn"))
                group.add(row)
        self.call({"op": "mail-users", "organisation_id": org["id"]}, done,
                  lambda: (self.data or {}).get("sample_mail_users", {}))

    # --- admins and the Owner ---------------------------------------------------------------------
    def open_admins(self, org: dict) -> None:
        """Settings: the admins and the Owner, Google Workspace, your sign-in, organisations."""
        if org.get("id") != self.org_id:
            return  # a reply about another organisation, after it was switched
        page, _actions = self.section_page("settings")
        group = Adw.PreferencesGroup(title="Kulan Fleet admins and the Owner", description="Loading…")
        page.add(group)

        def done(result, error):
            if error:
                group.set_description(error)
                self.settings_groups(page, org)
                return
            result = result or {}
            owner, is_owner = result.get("owner"), bool(result.get("is_owner"))
            group.set_description("Admins manage computers and people. "
                                  + ("As the Owner, you choose who they are." if is_owner else
                                     "Only the Owner can change who they are."))
            row = Adw.ActionRow(title=GLib.markup_escape_text(owner or "No Owner yet"), subtitle="Owner")
            row.add_prefix(Gtk.Image(icon_name="starred-symbolic"))
            group.add(row)
            for a in result.get("admins") or []:
                if a.get("email") == owner:
                    continue
                row = Adw.ActionRow(title=GLib.markup_escape_text(a["email"]), subtitle=f"admin since {ago(a.get('created_at'))}")
                row.add_prefix(Gtk.Image(icon_name="avatar-default-symbolic"))
                if is_owner:
                    reset = Gtk.Button(icon_name="view-refresh-symbolic", tooltip_text="Reset their authenticator app", valign=Gtk.Align.CENTER, css_classes=["flat"])
                    reset.connect("clicked", lambda _b, e=a["email"]: self.reset_admin_authenticator(org, e))
                    row.add_suffix(reset)
                    remove = Gtk.Button(icon_name="user-trash-symbolic", tooltip_text="Remove admin",
                                        valign=Gtk.Align.CENTER, css_classes=["flat"])
                    remove.connect("clicked", lambda _b, e=a["email"]: self.change_admin(org, "remove-admin", e))
                    row.add_suffix(remove)
                group.add(row)
            security = Adw.PreferencesGroup(title="Signing in to Kulan Fleet")
            page.add(security)
            require = Adw.SwitchRow(title="Require an authenticator app for admins",
                                    subtitle="Admins enter a code from their phone after the email code. Set up "
                                             "yours first from the menu.", subtitle_lines=0,
                                    active=bool(org.get("admin_two_step")), sensitive=is_owner)

            def required(row_, _p):
                want = row_.get_active()
                if want == bool(org.get("admin_two_step")):
                    return

                def done(_r, error):
                    if error:
                        self.toast(error)
                        row_.set_active(not want)
                        return
                    org["admin_two_step"] = want
                    self.toast("Authenticator app required for admins" if want else
                               "An authenticator app is no longer required")
                self.call({"op": "set-admin-two-step", "organisation_id": org["id"], "required": want}, done)
            require.connect("notify::active", required)
            security.add(require)
            if is_owner:
                add = Adw.PreferencesGroup(title="Add an admin")
                page.add(add)
                entry = Adw.EntryRow(title="Their email", show_apply_button=True)
                entry.connect("apply", lambda e: e.get_text().strip() and self.change_admin(org, "add-admin", e.get_text().strip()))
                add.add(entry)
            if (self.data or {}).get("global"):
                boss = Adw.PreferencesGroup(title="Ownership")
                page.add(boss)
                entry = Adw.EntryRow(title="Make this email the Owner", show_apply_button=True)
                entry.connect("apply", lambda e: e.get_text().strip() and self.set_owner(org, e.get_text().strip()))
                boss.add(entry)
            self.settings_groups(page, org)
        self.call({"op": "admins", "organisation_id": org["id"]}, done,
                  lambda: (self.data or {}).get("sample_admins", {}))

    def settings_groups(self, page: Adw.PreferencesPage, org: dict) -> None:
        """The rest of Settings, below the admins."""
        def link(group, title, subtitle, icon, opened, external=False) -> None:
            row = Adw.ActionRow(title=title, subtitle=GLib.markup_escape_text(subtitle), activatable=True, subtitle_lines=2)
            row.add_prefix(Gtk.Image(icon_name=icon))
            row.add_suffix(Gtk.Image(icon_name="adw-external-link-symbolic" if external else "go-next-symbolic"))
            row.connect("activated", lambda _r: opened())
            group.add(row)
        mail = Adw.PreferencesGroup(title="Email")
        page.add(mail)
        link(mail, "Google Workspace", f"Mailboxes on {org['mail_domain']} are managed with People" if org.get("mail_domain")
             else "Not connected. Connect it to manage mailboxes with People", "mail-unread-symbolic", lambda: self.open_mail(org))
        mine = Adw.PreferencesGroup(title="Your sign-in", description=GLib.markup_escape_text(self.session.email or ""))
        page.add(mine)
        link(mine, "Your authenticator app", "Asked for after the email link, once you've set one up", "phone-symbolic",
             self.my_authenticator)
        link(mine, "Sign out", "From Kulan Fleet on this computer", "system-log-out-symbolic", self.sign_out)
        orgs = Adw.PreferencesGroup(title="Organisations")
        page.add(orgs)
        if (self.data or {}).get("global"):
            link(orgs, "New organisation", "With its own computers, people and Owner", "list-add-symbolic", self.new_org)
        link(orgs, "Become the Owner with a recovery code", "If the Owner lost their email account",
             "starred-symbolic", self.recover_owner)

    def reset_admin_authenticator(self, org: dict, email: str) -> Adw.AlertDialog:
        dialog = Adw.AlertDialog(heading=f"Reset {email}'s authenticator app?",
                                 body="Use this for a lost or new phone. They set up their authenticator app again "
                                      "at their next sign-in. Make sure the request really comes from them.")
        dialog.add_response("cancel", "Cancel")
        dialog.add_response("reset", "Reset")
        dialog.set_response_appearance("reset", Adw.ResponseAppearance.DESTRUCTIVE)
        dialog.connect("response", lambda _d, r: r == "reset" and self.call(
            {"op": "reset-admin-two-step", "organisation_id": org["id"], "email": email},
            lambda res, error: self.toast(error or f"{email} will set it up at their next sign-in"),
            {"removed": 1}))
        dialog.present(self)
        return dialog

    def reset_two_step(self, org: dict, person: dict) -> Adw.AlertDialog:
        dialog = Adw.AlertDialog(heading=f"Reset {person['username']}'s two-step sign-in?",
                                 body="Use this for a lost security key or phone. Their keys and codes stop working at "
                                      "each computer's next report, and they sign in with only their password until "
                                      "they set up a new one.")
        dialog.add_response("cancel", "Cancel")
        dialog.add_response("reset", "Reset")
        dialog.set_response_appearance("reset", Adw.ResponseAppearance.DESTRUCTIVE)
        dialog.connect("response", lambda _d, r: r == "reset" and self.call(
            {"op": "reset-two-step", "person_id": person["id"]},
            lambda _res, error: self.toast(error) if error else self.after_people_change(
                org, f"{person['username']}'s two-step sign-in reset"), {"removed": 1}))
        dialog.present(self)
        return dialog

    def change_admin(self, org: dict, op: str, email: str) -> None:
        def done(_r, error):
            if error:
                self.toast(error)
                return
            self.toast(f"{email} {'is an admin' if op == 'add-admin' else 'is no longer an admin'}")
            self.open_admins(org)
        self.call({"op": op, "organisation_id": org["id"], "email": email}, done)

    def set_owner(self, org: dict, email: str) -> None:
        def done(r, error):
            if error:
                self.toast(error)
                return
            org["owner_email"] = email.lower()
            self.open_admins(org)
            self.show_recovery_code(org["name"], (r or {}).get("recovery_code"))
        self.call({"op": "set-owner", "organisation_id": org["id"], "email": email}, done,
                  lambda: {"recovery_code": "ABCDE-FGHJK-LMNPQ-RSTUV"})

    def show_recovery_code(self, name: str, code: str | None) -> Adw.AlertDialog | None:
        if not code:
            return None
        dialog = Adw.AlertDialog(
            heading=f"Recovery code for {name}",
            body="Write this down and keep it safe, away from this computer. If the Owner loses their email "
                 "account, sign in with another email and enter this code under Become the Owner in the menu. "
                 "It's shown only once. Using it makes a new one.")
        dialog.set_extra_child(Gtk.Label(label=code, selectable=True, css_classes=["fleet-code"], wrap=True,
                                         margin_top=6))
        dialog.add_response("copy", "Copy code")
        dialog.add_response("close", "I wrote it down")
        dialog.set_default_response("close")
        dialog.connect("response", lambda _d, r: r == "copy" and Gdk.Display.get_default().get_clipboard().set(code))
        dialog.present(self)
        return dialog

    def recover_owner(self) -> Adw.AlertDialog:
        dialog = Adw.AlertDialog(heading="Become the Owner",
                                 body="Enter the organisation's recovery code. The email you're signed in with "
                                      "becomes the Owner.")
        box = Gtk.ListBox(css_classes=["boxed-list"], selection_mode=Gtk.SelectionMode.NONE)
        entry = Adw.EntryRow(title="Recovery code")
        box.append(entry)
        dialog.set_extra_child(box)
        dialog.add_response("cancel", "Cancel")
        dialog.add_response("go", "Become the Owner")
        dialog.set_response_appearance("go", Adw.ResponseAppearance.SUGGESTED)

        def answered(_d, response):
            if response != "go" or not entry.get_text().strip():
                return

            def done(r, error):
                if error:
                    self.toast(error)
                    return
                self.org_id = ((r or {}).get("organisation") or {}).get("id", self.org_id)
                self.reload()
                self.show_recovery_code(((r or {}).get("organisation") or {}).get("name", "your organisation"),
                                        (r or {}).get("recovery_code"))
            self.call({"op": "recover-owner", "recovery_code": entry.get_text().strip()}, done)
        dialog.connect("response", answered)
        dialog.present(self)
        return dialog


