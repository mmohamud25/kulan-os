                                                                              "people": {"total": 1, "disabled": []}}}},
            "sample_review": {"is_owner": True, "due": True, "days_since": 120, "last_review": None,
                              "people": [{"id": "p2", "username": "omar", "full_name": "Omar Ali", "role": "admin",
                                          "where": ["kca-laptop-01"],
                                          "signed_in": [{"hostname": "kca-laptop-01", "last": now.timestamp() - 86400 * 12,
                                                         "now": False}]},
                                         {"id": "p3", "username": "mo", "full_name": "Mohamud", "role": "owner",
                                          "where": "all", "signed_in": []}],
                              "admins": [{"email": "admin@kulan.example", "owner": True, "created_at": iso(86400 * 9)},
                                         {"email": "helper@kulan.example", "owner": False, "created_at": iso(86400)}],
                              "all_organisations_admins": [{"email": "fleet@kulangroup.com"}]},
            "sample_mail": {"is_owner": True, "mailboxes": 1, "connection": {
                "provider": "google", "domain": "kulan.example", "admin_email": "it@kulan.example",
                "client_email": "kulan-fleet@kulan-mail.iam.gserviceaccount.com", "client_id": "112233445566778899001",
                "connected_by": "admin@kulan.example", "connected_at": iso(86400),
                "last_error": "Google couldn't be reached: try again in a minute"}},
            "sample_mail_users": {"users": [{"address": "amina@kulan.example", "name": "Amina Yusuf", "suspended": False,
                                             "admin": False, "username": "amina"},
                                            {"address": "ceo@kulan.example", "name": "Mohamud", "suspended": False,
                                             "admin": True, "username": None}]},
            "sample_report": {"compliance": {"passed": 1, "total": 2, "baseline": "Kulan OS baseline 1",
                                             "controls": controls}}}


class FleetApp(Adw.Application):
    def __init__(self, self_test: bool) -> None:
        super().__init__(application_id=APP_ID, flags=Gio.ApplicationFlags.NON_UNIQUE if self_test
                         else Gio.ApplicationFlags.DEFAULT_FLAGS)
        self.self_test = self_test
        self.status = 0

    def do_startup(self) -> None:
        Adw.Application.do_startup(self)
        provider = Gtk.CssProvider()
        provider.load_from_string(CSS)
        Gtk.StyleContext.add_provider_for_display(Gdk.Display.get_default(), provider,
                                                  Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)

    def do_activate(self) -> None:
        win = self.get_active_window()
        if win is None:
            win = FleetWindow(self, Session(), sample() if self.self_test else None)
        win.present()
        if self.self_test:
            def check() -> bool:
                try:
                    win.open_device(win.data["devices"][0])
                    win.open_apps(win.data["devices"][0])
                    win.nav.pop()
                    win.nav.pop()
                    win.open_device(win.data["devices"][1])
                    win.nav.pop()
                    win.open_log(win.data["organisations"][0])
                    win.nav.pop()
                    win.ask_erase(win.data["devices"][0]).force_close()
                    for kind in ("shutdown", "lost-mode-on"):
                        win.send_action(win.data["devices"][0], kind).force_close()
                    # People: the list, each person, every dialog.
                    org = win.data["organisations"][0]
                    win.open_people(org)
                    for person in win.data["sample_people"]:
                        win.open_person(org, person, True)
                        for dialog in (win.edit_person_details(org, person), win.edit_person_computers(org, person),
                                       win.new_setup_code(org, person), win.remove_person(org, person),
                                       win.set_person_enabled(org, person, False)):
                            dialog.force_close()
                        win.open_person(org, person, False)
                    win.add_person(org, True).force_close()
                    win.add_person(org, False).force_close()
                    win.show_setup_code("Amina", setup_code(), True).force_close()
                    win.open_admins(org)
                    win.recover_owner().force_close()
                    win.show_recovery_code("Kulan", "ABCDE-FGHJK-LMNPQ-RSTUV").force_close()
                    win.new_org().force_close()
                    win.nav.pop_to_tag("org")
                    # Groups, policies, USB drives, installing an app.
                    win.open_groups(org)
                    for g in list(win.data["sample_groups"]):
                        win.open_group(org, g)
                        for dialog in (win.rename_group(org, g), win.remove_group(org, g),
                                       win.group_action(g, "restart"),
                                       win.install_app_dialog(g["name"], {"op": "group-action", "group_id": g["id"]}),
                                       win.apps_dialog("blocked_apps", list(g["policy"].get("blocked_apps", [])), lambda _a: None),
                                       win.apps_dialog("required_apps", [], lambda _a: None)):
                            dialog.force_close()
                        win.nav.pop()
                    win.add_group_dialog(org).force_close()
                    win.open_drives(org)
                    win.approve_drive(org, win.data["sample_drives"]["seen"][0]).force_close()
                    win.install_app_dialog("kca-laptop-01", {"op": "action", "device_id": "d1"}).force_close()
                    win.nav.pop_to_tag("org")
                    assert app_problem("debian", "kulan-base", True) and app_problem("debian", "vlc", True) is None
                    assert app_problem("flatpak", "vlc", False) and app_problem("flatpak", "org.videolan.VLC", False) is None
                    assert app_problem("debian", "Bad Name", False)
                    assert policy_key_label("app:block:debian:steam") == "Block steam" and policy_key_label("usb") == "USB drives"
                    summary = policy_summary({"firewall": True, "usb": "approved", "required_apps": [{"source": "debian", "id": "x"}]})
                    assert summary == "Firewall, USB: approved drives only, 1 app required", summary
                    assert policy_summary({}) == "No policy of its own"
                    # Security and activity (2.8c): the report, the PDF, the review, the log and its CSV.
                    win.open_weekly(org)
                    win.nav.pop()
                    win.open_review(org)
                    win.finish_review(org, [("person", "p2", Gtk.CheckButton(active=False)),
                                            ("admin", "helper@kulan.example", Gtk.CheckButton(active=True))]).force_close()
                    win.nav.pop_to_tag("org")
                    win.open_log(org)
                    win.nav.pop_to_tag("org")
                    sections = weekly_sections(win.data["sample_weekly"]["summary"], win.data["sample_weekly"]["previous"]["summary"])
                    flat = [line for _h, rows_ in sections for line in rows_]
                    assert ("Security updates waiting on 1 computer", "kca-desk-02 (2) · +1 since last week", "bad") in flat, flat
                    assert any(l[0] == "Admin-rights review due" and l[2] == "bad" for l in flat), flat
                    assert weekly_sections({}, None)[0][1][0] == ("0 computers", "0 reported this week", "dim")
                    big = weekly_sections({"computers": {"total": 120, "restart_needed": ["a", "b"],
                                                         "counts": {"restart_needed": 120}, "versions": {"2.8.3": 120}}},
                                          {"computers": {"counts": {"restart_needed": 100}}})
                    flat_big = [line for _h, rows_ in big for line in rows_]
                    assert ("Restart needed on 120 computers", "a, b and 118 more · +20 since last week", "bad") in flat_big, flat_big
                    assert ("Kulan OS versions", "2.8.3: 120 computers", "dim") in flat_big, flat_big
                    pdf_path = os.path.join(GLib.get_tmp_dir(), f"kulan-fleet-self-test-{os.getpid()}.pdf")
                    write_pdf(pdf_path, "Kulan: weekly security report", "Week of 26 Oct 2026", sections * 6)
                    with open(pdf_path, "rb") as f:
                        head = f.read(5)
                    os.unlink(pdf_path)
                    assert head == b"%PDF-", head
                    csv = log_csv([{"at": "2026-10-26T10:00:00Z", "email": "a@x", "what": "=HYPERLINK(1)", "hostname": "pc, one",
                                    "detail": {"n": 1}}])
                    assert csv.splitlines()[1] == "2026-10-26T10:00:00Z,a@x,'=HYPERLINK(1),\"pc, one\",\"{\"\"n\"\": 1}\"", csv
                    # Stronger sign-in (2.8d): the code, setting one up, the menu, the Owner's resets.
                    first = win.two_step_needed("code")
                    assert first is not None and win.two_step_needed("code") is None, "one code dialog at a time"
                    first.force_close()
                    win.two_step_dialog = None
                    win.two_step_needed("set-up").force_close()
                    win.two_step_dialog = None
                    win.my_authenticator()
                    win.two_step_dialog = None
                    for dialog in (win.reset_admin_authenticator(org, "helper@kulan.example"),
                                   win.reset_two_step(org, win.data["sample_people"][0])):
                        dialog.force_close()
                    flat2 = [line for _h, rows_ in weekly_sections(win.data["sample_weekly"]["summary"], None) for line in rows_]
                    assert ("Two-step sign-in not set up: 1", "omar", "bad") in flat2, flat2
                    # Google Workspace mailboxes (2.8e): the page, connecting, each mailbox dialog.
                    assert ("Mailboxes with something left to do: 1", "amina (name still to change)", "bad") in flat2, flat2
                    win.open_mail(org)
                    connect = win.connect_mail(org)
                    assert not connect.get_response_enabled("connect")
                    connect.take_key(json.dumps({"type": "service_account", "client_email": "x@y.iam.gserviceaccount.com",
                                                 "client_id": "1", "private_key": "-----BEGIN PRIVATE KEY-----"}))
                    connect.get_extra_child().get_first_child().get_row_at_index(1).set_text("it@kulan.example")
                    assert connect.get_response_enabled("connect"), "a key and a super admin: ready to connect"
                    connect.take_key("{not json")
                    assert not connect.get_response_enabled("connect"), "not a key: not ready"
                    connect.force_close()
                    win.disconnect_mail(org).force_close()
                    win.open_mail_users(org)
                    win.nav.pop_to_tag("org")
                    amina, omar = win.data["sample_people"][0], win.data["sample_people"][1]
                    for dialog in (win.give_mailbox(org, omar, "create"), win.give_mailbox(org, omar, "link"),
                                   win.mailbox_action(org, amina, "new-password"), win.mailbox_action(org, amina, "unlink"),
                                   win.show_mailbox_password("Amina", "amina@kulan.example", "abcd-EFGH-2346-mnpq")):
                        dialog.force_close()
                    assert win.mailbox_note({"mailbox_error": "x"}).startswith(". The mailbox isn't done yet")
                    assert win.mailbox_note({}) == "" and MAILBOX_ADDRESS.match("amina.y@kulan.example")
                    assert not MAILBOX_ADDRESS.match("Amina@kulan.example") and not MAILBOX_ADDRESS.match("a@b")
                    assert policy_summary({"two_step": "everyone"}) == "Two-step sign-in for everyone"
                    rows, picked = win.computer_picker(org, False, ["d1"], ["g1"])
                    assert picked() == (False, ["d1"], ["g1"]), picked()
                    # Setup codes: 12 of the 32 clear characters; the hash is one the computers take,
                    # and it really is the code's (checked with openssl for SHA-512 crypt).
                    code = setup_code()
                    assert re.fullmatch(r"[A-HJ-NP-Z2-9]{4}-[A-HJ-NP-Z2-9]{4}-[A-HJ-NP-Z2-9]{4}", code), code
                    assert len({setup_code() for _ in range(50)}) == 50
                    hashed = hash_password(code)
                    assert HASH.match(hashed) and code not in hashed, hashed
                    if hashed.startswith("$6$"):
                        salt = hashed.split("$")[2]
                        again = subprocess.run(["openssl", "passwd", "-6", "-salt", salt, "-stdin"], input=code + "\n",
                                               capture_output=True, text=True).stdout.strip()
                        assert again == hashed, (again, hashed)
                    assert suggest_username("Amina Yusuf") == "amina" and suggest_username("Ãbdi Ali") == "abdi"
                    assert suggest_username("Root") == "" and username_problem("amina") is None
                    assert username_problem("Amina") and username_problem("sudo") and username_problem("a:b")
                    win.cancel_action(win.data["actions"][0])
                    assert win.data["actions"][0]["status"] == "cancelled"
                    win.org_id = None
                    win.render_org()
                    print("Kulan Fleet: every page built")
                except Exception as e:  # noqa: BLE001
                    print(f"FAIL {e}")
                    self.status = 1
                self.quit()
                return False
            GLib.timeout_add(500, check)


def main(argv: list[str]) -> int:
    self_test = "--self-test" in argv
    app = FleetApp(self_test)
    code = app.run([argv[0]])
    return app.status or code


if __name__ == "__main__":
    sys.exit(main(sys.argv))
