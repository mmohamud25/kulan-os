# --- the session ---------------------------------------------------------------------
SECRET_SCHEMA = None
if Secret is not None:
    SECRET_SCHEMA = Secret.Schema.new(APP_ID, Secret.SchemaFlags.NONE, {"kind": Secret.SchemaAttributeType.STRING})


def keyring_get() -> str | None:
    if SECRET_SCHEMA is None:
        return None
    try:
        return Secret.password_lookup_sync(SECRET_SCHEMA, {"kind": "refresh-token"}, None)
    except GLib.Error:
        return None


def keyring_set(token: str | None) -> None:
    if SECRET_SCHEMA is None:
        return
    try:
        if token:
            Secret.password_store_sync(SECRET_SCHEMA, {"kind": "refresh-token"}, Secret.COLLECTION_DEFAULT,
                                       "Kulan Fleet sign-in", token, None)
        else:
            Secret.password_clear_sync(SECRET_SCHEMA, {"kind": "refresh-token"}, None)
    except GLib.Error:
        pass


class FleetError(Exception):
    pass


class FleetOffline(FleetError):
    """The server couldn't be reached (no internet, server down): not a reason
    to forget the sign-in."""


def http(url: str, body: dict | None, headers: dict | None = None) -> dict:
    request = urllib.request.Request(url, data=json.dumps(body or {}).encode(), method="POST",
                                     headers={"Content-Type": "application/json", "apikey": PUBLISHABLE_KEY,
                                              "User-Agent": "kulan-fleet-admin/1", **(headers or {})})
    try:
        with urllib.request.urlopen(request, timeout=TIMEOUT) as reply:
            text = reply.read(5_000_000).decode("utf-8", "replace")
    except urllib.error.HTTPError as e:
        try:
            detail = json.loads(e.read().decode("utf-8", "replace"))
            message = detail.get("error") or detail.get("msg") or detail.get("error_description") or detail.get("message")
        except (ValueError, AttributeError):
            message = None
        raise FleetError(message or f"The server said {e.code}") from e
    except (urllib.error.URLError, OSError) as e:
        raise FleetOffline("Couldn't reach the Kulan Fleet server. Check the internet connection, then try "
                           f"again ({getattr(e, 'reason', e)})") from e
    try:
        return json.loads(text) if text.strip() else {}
    except ValueError as e:
        raise FleetError("The server's answer wasn't JSON") from e


class Session:
    """Supabase Auth with an emailed one-time code; refresh token in the keyring."""

    def __init__(self) -> None:
        self.access_token: str | None = None
        self.expires = 0.0
        self.refresh_token: str | None = keyring_get()
        self.email = ""

    def _take(self, data: dict) -> None:
        self.access_token = data.get("access_token")
        self.refresh_token = data.get("refresh_token")
        self.expires = time.time() + float(data.get("expires_in") or 3600) - 60
        self.email = (data.get("user") or {}).get("email", self.email)
        keyring_set(self.refresh_token)

    def send_code(self, email: str) -> None:
        http(f"{SUPABASE_URL}/auth/v1/otp", {"email": email, "create_user": True})

    def verify(self, email: str, code: str) -> None:
        """Takes the code from the email, or its sign-in link.

        Supabase's built-in email has only a link (its text can be changed only with
        your own mail server), so either works: the link copied from the email, or
        the address the browser landed on after opening it.
        """
        # Phones and mail apps add line breaks or spaces, and copying from the
        # address bar can drop "http://" (or keep only the part after "#").
        code = "".join(code.split())
        if not code.isdigit() and "://" not in code and "refresh_token=" in code:
            code = "http://localhost/" + ("" if code.startswith("#") or "/" in code.split("#")[0] else "#") + \
                (code.split("/", 1)[1] if "/" in code.split("#")[0] else code)
        if code.isdigit():
            self._take(http(f"{SUPABASE_URL}/auth/v1/verify", {"type": "email", "email": email, "token": code}))
            return
        url = urllib.parse.urlsplit(code)
        if url.scheme != "https" and not code.startswith("http://localhost"):
            raise FleetError("Paste the 6-digit code, or the whole sign-in link from the email.")
        fragment = urllib.parse.parse_qs(url.fragment)
        query = urllib.parse.parse_qs(url.query)
        if "error_description" in fragment or "error_description" in query:
            raise FleetError((fragment.get("error_description") or query["error_description"])[0])
        if "refresh_token" in fragment:
            # The browser already used the link: swap its refresh token for our own session.
            self._take(http(f"{SUPABASE_URL}/auth/v1/token?grant_type=refresh_token",
                            {"refresh_token": fragment["refresh_token"][0]}))
        elif "token" in query and url.netloc == urllib.parse.urlsplit(SUPABASE_URL).netloc:
            kind = (query.get("type") or ["magiclink"])[0]
            self._take(http(f"{SUPABASE_URL}/auth/v1/verify", {"type": kind, "token_hash": query["token"][0]}))
        else:
            raise FleetError("That doesn't look like the sign-in link from the email.")
        if email and self.email and self.email.lower() != email.lower():
            self.sign_out()
            raise FleetError(f"That link is for {self.email}, not {email}.")

    def token(self) -> str:
        if self.access_token and time.time() < self.expires:
            return self.access_token
        if not self.refresh_token:
            raise FleetError("Please sign in")
        try:
            self._take(http(f"{SUPABASE_URL}/auth/v1/token?grant_type=refresh_token",
                            {"refresh_token": self.refresh_token}))
        except FleetOffline:
            raise  # offline: keep the sign-in for when the connection is back
        except FleetError:
            self.sign_out(local_only=True)
            raise FleetError("Your sign-in ran out; please sign in again")
        return self.access_token

    def call(self, body: dict) -> dict:
        return http(API, body, {"Authorization": f"Bearer {self.token()}"})

    def sign_out(self, local_only: bool = False) -> None:
        if not local_only and self.access_token:
            try:
                http(f"{SUPABASE_URL}/auth/v1/logout", {}, {"Authorization": f"Bearer {self.access_token}"})
            except FleetError:
                pass
        self.access_token = self.refresh_token = None
        keyring_set(None)


# --- setup codes -----------------------------------------------------------------------
def setup_code() -> str:
    """12 random characters (60 bits) in groups of four: typed once, at the
    sign-in screen, then replaced by the person's own password."""
    chars = "".join(secrets.choice(CODE_LETTERS) for _ in range(12))
    return "-".join(chars[i:i + 4] for i in range(0, 12, 4))


def hash_password(code: str) -> str:
    """The one-way crypt(3) hash the computers put in /etc/shadow: yescrypt
    (Debian's own) when mkpasswd is here, otherwise SHA-512 crypt."""
    tries = []
    if shutil.which("mkpasswd"):
        tries.append(["mkpasswd", "--method=yescrypt", "--stdin"])
    if shutil.which("openssl"):
        tries.append(["openssl", "passwd", "-6", "-stdin"])
    for argv in tries:
        try:
            out = subprocess.run(argv, input=code + "\n", capture_output=True, text=True, timeout=30).stdout.strip()
        except (OSError, subprocess.TimeoutExpired):
            continue
        if HASH.match(out):
            return out
    raise FleetError("Couldn't make the setup code on this computer (mkpasswd or openssl is needed)")


def suggest_username(name: str) -> str:
    """"Amina Yusuf" -> "amina"; letters only, as the computers allow."""
    plain = unicodedata.normalize("NFKD", name).encode("ascii", "ignore").decode().lower()
    first = re.sub(r"[^a-z0-9]", "", (plain.split() or [""])[0])
    first = first.lstrip("0123456789")[:32]
    return first if first and first not in RESERVED else ""


def username_problem(name: str) -> str | None:
    if not USERNAME.match(name):
        return "Lower-case letters, digits, - or _, starting with a letter"
    return "That name is kept for the system" if name in RESERVED else None


def ago(iso: str | None) -> str:
    if not iso:
        return "never"
    try:
        when = datetime.fromisoformat(iso.replace("Z", "+00:00"))
    except ValueError:
        return iso
    s = (datetime.now(timezone.utc) - when).total_seconds()
    if s < 90:
        return "just now"
    if s < 3600:
        return f"{round(s / 60)} min ago"
    if s < 86400:
        return f"{round(s / 3600)} h ago"
    days = round(s / 86400)
    return f"{days} day{'s' if days != 1 else ''} ago"


def yes_no(value, yes: str = "yes", no: str = "no") -> str:
    return "–" if value is None else yes if value else no


def tag(text: str, kind: str) -> Gtk.Label:
    return Gtk.Label(label=text, css_classes=["fleet-tag", kind], valign=Gtk.Align.CENTER)


def compliance_tag(d: dict) -> Gtk.Label:
    if d.get("compliance_total") is None:
        return tag("compliance unknown", "dim")
    ok = d.get("compliance_passed") == d.get("compliance_total")
    on = " · mode on" if d.get("compliance_mode") == "on" else ""
    return tag(f"{d['compliance_passed']} of {d['compliance_total']}{on}", "good" if ok else "warn")


def updates_tag(d: dict) -> Gtk.Label:
    u = d.get("updates")
    if not u:
        return tag("updates unknown", "dim")
    if u.get("security"):
        return tag(f"{u['security']} security", "bad")
    if u.get("waiting"):
        return tag(f"{u['waiting']} waiting", "warn")
    return tag("up to date", "good")


# --- the window ------------------------------------------------------------------------
class FleetWindow(Adw.ApplicationWindow):
    def __init__(self, app: Adw.Application, session: Session, sample: dict | None = None) -> None:
        super().__init__(application=app, title="Kulan Fleet", default_width=1040, default_height=720)
        self.session = session
        self.data: dict | None = sample
        self.org_id: str | None = None
        self.toasts = Adw.ToastOverlay()
        self.stack = Gtk.Stack(transition_type=Gtk.StackTransitionType.CROSSFADE)
        self.toasts.set_child(self.stack)
        self.set_content(self.toasts)
        self.stack.add_named(self.build_signin(), "signin")
        self.stack.add_named(self.build_main(), "main")
        if sample is not None:
            self.stack.set_visible_child_name("main")
            self.show_data()
        elif session.refresh_token:
            self.stack.set_visible_child_name("main")
            self.reload()
        else:
            self.stack.set_visible_child_name("signin")

    # --- background calls ----------------------------------------------------------------
    def background(self, work, done) -> None:
        def run() -> None:
            try:
                result, error = work(), None
            except FleetError as e:
                result, error = None, str(e)
            except Exception as e:  # noqa: BLE001 - never leave the app hanging
                result, error = None, f"Something went wrong: {e}"
            GLib.idle_add(lambda: (done(result, error), False)[1])
        threading.Thread(target=run, daemon=True).start()

    def toast(self, text: str) -> None:
        self.toasts.add_toast(Adw.Toast(title=GLib.markup_escape_text(text), timeout=4))

    # --- sign in ---------------------------------------------------------------------------
    def build_signin(self) -> Gtk.Widget:
        view = Adw.ToolbarView()
        view.add_top_bar(Adw.HeaderBar())
        status = Adw.StatusPage(icon_name="org.kulan.Fleet", title="Kulan Fleet",
                                description="Sign in with your email. Only fleet admins see computers.")
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12, width_request=360,
                      halign=Gtk.Align.CENTER)
        rows = Gtk.ListBox(css_classes=["boxed-list"], selection_mode=Gtk.SelectionMode.NONE)
        self.email_row = Adw.EntryRow(title="Email")
        self.code_row = Adw.EntryRow(title="Code or sign-in link from the email", visible=False)
        rows.append(self.email_row)
        rows.append(self.code_row)
        self.signin_button = Gtk.Button(label="Email me a sign-in link", css_classes=["suggested-action", "pill"],
                                        halign=Gtk.Align.CENTER)
        self.signin_button.connect("clicked", lambda _b: self.signin_step())
        self.email_row.connect("entry-activated", lambda _r: self.signin_step())
        self.code_row.connect("entry-activated", lambda _r: self.signin_step())
        self.signin_note = Gtk.Label(wrap=True, css_classes=["dim-label"])
        box.append(rows)
        box.append(self.signin_button)
        box.append(self.signin_note)
        status.set_child(box)
        view.set_content(status)
        return view

    def signin_step(self) -> None:
        email = self.email_row.get_text().strip()
        if not email or "@" not in email:
            self.signin_note.set_label("Type your email first.")
            return
        self.signin_button.set_sensitive(False)
        if not self.code_row.get_visible():
            def sent(_r, error):
                self.signin_button.set_sensitive(True)
                if error:
                    self.signin_note.set_label(error)
                    return
                self.code_row.set_visible(True)
                self.code_row.grab_focus()
                self.signin_button.set_label("Sign in")
                self.signin_note.set_label((f"We emailed {email}. Right-click “Sign in” in the email, choose Copy Link, "
                                        "and paste it here. (Opened it already? Paste the address the browser went to.)"))
            self.background(lambda: self.session.send_code(email), sent)
            return
        code = self.code_row.get_text().strip()

        def verified(_r, error):
            self.signin_button.set_sensitive(True)
            if error:
                self.signin_note.set_label(error)
                return
            self.code_row.set_text("")
            self.stack.set_visible_child_name("main")
            self.reload()
        self.background(lambda: self.session.verify(email, code), verified)

    def sign_out(self) -> None:
        self.background(self.session.sign_out, lambda _r, _e: None)
        self.data = None
        self.code_row.set_visible(False)
        self.signin_button.set_label("Email me a sign-in link")
        self.signin_note.set_label("Signed out.")
        self.stack.set_visible_child_name("signin")

    # --- main view -----------------------------------------------------------------------------
    def build_main(self) -> Gtk.Widget:
        self.org_list = Gtk.ListBox(css_classes=["navigation-sidebar"])
        self.org_list.connect("row-selected", self.on_org)
        side = Adw.ToolbarView()
        side_header = Adw.HeaderBar()
        self.new_org_button = Gtk.Button(icon_name="list-add-symbolic", tooltip_text="New organisation",
                                         visible=False)
        self.new_org_button.connect("clicked", lambda _b: self.new_org())
        side_header.pack_start(self.new_org_button)
        side.add_top_bar(side_header)
        side.set_content(Gtk.ScrolledWindow(child=self.org_list, vexpand=True))
        sidebar = Adw.NavigationPage(title="Kulan Fleet", child=side)

        self.nav = Adw.NavigationView()
        content_view = Adw.ToolbarView()
        header = Adw.HeaderBar()
        refresh = Gtk.Button(icon_name="view-refresh-symbolic", tooltip_text="Refresh")
        refresh.connect("clicked", lambda _b: self.reload())
        header.pack_end(refresh)
        menu = Gio.Menu()
        menu.append("Become the Owner with a recovery code…", "win.recover")
        menu.append("Sign out", "win.sign-out")
        header.pack_end(Gtk.MenuButton(icon_name="open-menu-symbolic", menu_model=menu, tooltip_text="Menu"))
        action = Gio.SimpleAction.new("sign-out", None)
        action.connect("activate", lambda *_a: self.sign_out())
        self.add_action(action)
        action = Gio.SimpleAction.new("recover", None)
        action.connect("activate", lambda *_a: self.recover_owner())
        self.add_action(action)
        content_view.add_top_bar(header)
        self.page = Adw.PreferencesPage()
        content_view.set_content(self.page)
        self.nav.add(Adw.NavigationPage(title="Computers", child=content_view, tag="org"))
        content = Adw.NavigationPage(title="Computers", child=self.nav)

        self.groups: list[Adw.PreferencesGroup] = []
        split = Adw.NavigationSplitView(sidebar=sidebar, content=content, min_sidebar_width=220)
        return split

    def reload(self) -> None:
        first = self.data is None
        if first:  # nothing to show yet: say it's loading, not a blank window
            self.org_list.remove_all()
            loading = Adw.ActionRow(title="Loading your organisations…")
            loading.add_prefix(Gtk.Spinner(spinning=True))
            self.org_list.append(loading)

        def done(result, error):
            if error:
                if "sign in" in error.lower():
                    self.sign_out()
                elif first:
                    self.org_list.remove_all()
                    self.org_list.append(Adw.ActionRow(title="Couldn’t load", subtitle=GLib.markup_escape_text(
                        error + " Press Refresh to try again."), subtitle_lines=0))
                self.toast(error)
                return
            self.data = result
            self.show_data()
        self.background(lambda: self.session.call({"op": "overview"}), done)

    def show_data(self) -> None:
        data = self.data or {}
        self.new_org_button.set_visible(bool(data.get("global")))
        keep = self.org_id
        self.org_list.remove_all()
        for org in data.get("organisations", []):
            row = Adw.ActionRow(title=GLib.markup_escape_text(org["name"]))
            row.org_id = org["id"]
            count = sum(1 for d in data.get("devices", []) if d["organisation_id"] == org["id"] and not d.get("left_at"))
            row.add_suffix(Gtk.Label(label=str(count), css_classes=["dim-label"]))
            self.org_list.append(row)
        rows = [self.org_list.get_row_at_index(i) for i in range(len(data.get("organisations", [])))]
        chosen = next((r for r in rows if getattr(r, "org_id", None) == keep), None)
        target = chosen or (rows[0] if rows else None)
        if target is not None:
            self.org_list.select_row(target)
        else:
            self.org_id = None
            self.render_org()

    def on_org(self, _list, row) -> None:
        if row is None:
            return
        self.org_id = getattr(row, "org_id", None)
        self.nav.pop_to_tag("org")
        self.render_org()

    def clear(self) -> None:
        for g in self.groups:
            self.page.remove(g)
        self.groups = []

    def add_group(self, title: str = "", description: str = "") -> Adw.PreferencesGroup:
        g = Adw.PreferencesGroup(title=title, description=description)
        self.page.add(g)
        self.groups.append(g)
        return g

    def policy_group(self, org: dict) -> None:
        policy = dict(org.get("policy") or {})
        group = self.add_group("Policy", "Every computer in the organisation keeps to this, from its next report. "
                                         "Encryption can't be switched on from afar: computers without it show "
                                         "an alert.")
        rows = {}
        for key, subtitle in (("auto_updates", "Updates install by themselves, with a restore point first"),
                              ("firewall", "Block connections from outside")):
            row = Adw.SwitchRow(title=POLICY_LABEL[key], subtitle=subtitle, active=bool(policy.get(key)))
            group.add(row)
            rows[key] = row
        lock = Adw.ComboRow(title=POLICY_LABEL["screen_lock_minutes"], subtitle="Locks when not used; users can't "
                            "turn it off", model=Gtk.StringList.new([t for _m, t in SCREEN_LOCK]))
        minutes = int(policy.get("screen_lock_minutes") or 0)
        lock.set_selected(next((i for i, (m, _t) in enumerate(SCREEN_LOCK) if m == minutes), 0))
        group.add(lock)
        enc = Adw.SwitchRow(title="Require disk encryption", subtitle="Computers without it show an alert",
                            active=bool(policy.get("require_encryption")))
        group.add(enc)
        rows["require_encryption"] = enc

        def changed(*_a) -> None:
            new = {key: True for key, row in rows.items() if row.get_active()}
            mins = SCREEN_LOCK[lock.get_selected()][0]
            if mins:
                new["screen_lock_minutes"] = mins
            if new == {k: v for k, v in policy.items() if v}:
                return
            if self.data and self.data.get("sample"):
                org["policy"] = new
                return

            def done(result, error):
                if error:
                    self.toast(error)
                    self.render_org()  # back to what's saved
                    return
                org["policy"] = result.get("policy", new)
                policy.clear()
                policy.update(org["policy"])
                self.toast("Policy saved: computers apply it at their next report")
            self.background(lambda: self.session.call({"op": "set-policy", "organisation_id": org["id"],
                                                        "policy": new}), done)
        for row in rows.values():
            row.connect("notify::active", changed)
        lock.connect("notify::selected", changed)

    def alerts_group(self, org: dict) -> None:
        alerts = [a for a in (self.data or {}).get("alerts", []) if a.get("organisation_id") == org["id"]]
        group = self.add_group("Needs attention", None if alerts else "Nothing: every computer looks fine.")
        devices = {d["id"]: d for d in (self.data or {}).get("devices", [])}
        for a in alerts[:30]:
            row = Adw.ActionRow(title=GLib.markup_escape_text(a.get("hostname") or "Computer"),
                                subtitle=GLib.markup_escape_text(a.get("text", "")), activatable=True)
            row.add_prefix(Gtk.Image(icon_name=ALERT_ICON.get(a.get("kind"), "dialog-warning-symbolic")))
            row.add_suffix(Gtk.Image(icon_name="go-next-symbolic"))
            dev = devices.get(a.get("device_id"))
            if dev:
                row.connect("activated", lambda _r, d=dev: self.open_device(d))
            group.add(row)
        if len(alerts) > 30:
            group.add(Adw.ActionRow(title=f"And {len(alerts) - 30} more"))

    def render_org(self) -> None:
        self.clear()
        data = self.data or {}
        org = next((o for o in data.get("organisations", []) if o["id"] == self.org_id), None)
        head = self.add_group()
        head.add(Gtk.Label(label=org["name"] if org else "No organisation yet", xalign=0,
                           css_classes=["kulan-page-title", "title-1"]))
        if not org:
            note = "Add one with the + button." if data.get("global") else "Ask the fleet owner to add you to one."
            head.add(Gtk.Label(label=note, xalign=0, css_classes=["dim-label"]))
            return
        devices = [d for d in data.get("devices", []) if d["organisation_id"] == org["id"]]
        active = [d for d in devices if not d.get("left_at")]
        now = datetime.now(timezone.utc)

        def recent(d):
            try:
                return (now - datetime.fromisoformat(d["last_seen"].replace("Z", "+00:00"))).total_seconds() < 86400
            except (KeyError, AttributeError, ValueError):
                return False
        stats = Gtk.FlowBox(selection_mode=Gtk.SelectionMode.NONE, min_children_per_line=2, max_children_per_line=4,
                            column_spacing=12, row_spacing=12, homogeneous=True)
        for number, text in ((len(active), "computers"), (sum(map(recent, active)), "reported in the last day"),
                             (sum(1 for d in active if d.get("compliance_total") and
                                  d.get("compliance_passed") == d.get("compliance_total")), "meet the baseline"),
                             (sum(1 for d in active if (d.get("updates") or {}).get("security")), "need security updates")):
            card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, css_classes=["card", "fleet-stat"])
            card.append(Gtk.Label(label=str(number), xalign=0, css_classes=["fleet-stat-number"]))
            card.append(Gtk.Label(label=text, xalign=0, css_classes=["dim-label"], wrap=True))
            stats.append(card)
        head.add(stats)
        self.alerts_group(org)

        people = self.add_group("People", "The accounts on the organisation's computers: each person signs in with "
                                          "their own name and password, on the computers you choose.")
        row = Adw.ActionRow(title="People", subtitle="Add someone, change their role or computers, disable or remove "
                            "them", activatable=True)
        row.add_prefix(Gtk.Image(icon_name="system-users-symbolic"))
        row.add_suffix(Gtk.Image(icon_name="go-next-symbolic"))
        row.connect("activated", lambda _r: self.open_people(org))
        people.add(row)
        owner = org.get("owner_email")
        row = Adw.ActionRow(title="Kulan Fleet admins and the Owner",
                            subtitle=GLib.markup_escape_text(f"Owner: {owner}" if owner else "No Owner set yet"),
                            activatable=True)
        row.add_prefix(Gtk.Image(icon_name="avatar-default-symbolic"))
        row.add_suffix(Gtk.Image(icon_name="go-next-symbolic"))
        row.connect("activated", lambda _r: self.open_admins(org))
        people.add(row)

        group = self.add_group("Computers", "Reports arrive every hour. Select a computer for its details.")
        if not devices:
            group.add(Adw.ActionRow(title="No computers yet", subtitle="Make a join code below"))
        for d in devices:
            left = bool(d.get("left_at"))
            hw = " ".join(x for x in ((d.get("hardware") or {}).get("vendor"), (d.get("hardware") or {}).get("model")) if x)
            subtitle = " · ".join(x for x in (f"Kulan OS {d['kulan_version']}" if d.get("kulan_version") else "",
                                               hw, f"left {ago(d['left_at'])}" if left else ago(d.get("last_seen"))) if x)
            row = Adw.ActionRow(title=GLib.markup_escape_text(d.get("hostname") or "(no name)"),
                                subtitle=GLib.markup_escape_text(subtitle), activatable=True)
            row.add_prefix(Gtk.Image(icon_name="computer-symbolic"))
            if not left:
                if (d.get("state") or {}).get("lost_mode"):
                    row.add_suffix(tag("lost mode", "bad"))
                row.add_suffix(compliance_tag(d))
                row.add_suffix(updates_tag(d))
            row.add_suffix(Gtk.Image(icon_name="go-next-symbolic"))
            if left:
                row.set_opacity(0.55)
            row.connect("activated", lambda _r, dev=d: self.open_device(dev))
            group.add(row)

        self.policy_group(org)

        add = self.add_group("Add computers",
                             "On each computer: Kulan Settings → About → Organisation → Join an organisation.")
        hours = Adw.ComboRow(title="Code works for", model=Gtk.StringList.new(["1 day", "3 days", "1 week", "30 days"]),
                             selected=1)
        uses = Adw.SpinRow.new_with_range(1, 500, 1)
        uses.set_title("Number of computers")
        make = Adw.ButtonRow(title="Make a join code") if hasattr(Adw, "ButtonRow") else None
        add.add(hours)
        add.add(uses)
        if make is not None:
            make.add_css_class("suggested-action")
            make.connect("activated", lambda _r: self.make_code(org["id"], hours.get_selected(), int(uses.get_value())))
            add.add(make)
        else:
            button = Gtk.Button(label="Make a join code", css_classes=["suggested-action"], margin_top=12)
            button.connect("clicked", lambda _b: self.make_code(org["id"], hours.get_selected(), int(uses.get_value())))
            add.add(button)

        names = {d["id"]: d.get("hostname") or "" for d in data.get("devices", [])}
        ids = {d["id"] for d in devices}
        acts = [a for a in data.get("actions", []) if a["device_id"] in ids][:15]
        history = self.add_group("Recent requests")
        log = Adw.ActionRow(title="Activity log", subtitle="Who changed the policy, made join codes or asked "
                            "computers to do something, and when", activatable=True)
        log.add_prefix(Gtk.Image(icon_name="document-open-recent-symbolic"))
        log.add_suffix(Gtk.Image(icon_name="go-next-symbolic"))
        log.connect("activated", lambda _r: self.open_log(org))
        history.add(log)
        if not acts:
            history.add(Adw.ActionRow(title="Nothing asked yet"))
        for a in acts:
            row = Adw.ActionRow(title=GLib.markup_escape_text(f"{ACTION_LABEL.get(a['type'], a['type'])} · {names.get(a['device_id'], '')}"),
                                subtitle=GLib.markup_escape_text(" · ".join(x for x in (ago(a.get("created_at")), a.get("requested_by") or "",
                                                                                       a.get("detail") or "") if x)))
            row.add_suffix(tag(STATUS_LABEL.get(a["status"], a["status"]),
                               {"done": "good", "failed": "bad"}.get(a["status"], "dim")))
            if a["status"] == "pending":
                cancel = Gtk.Button(label="Cancel", valign=Gtk.Align.CENTER,
                                    css_classes=["destructive-action"] if a["type"] == "erase" else [])
                cancel.connect("clicked", lambda _b, act=a: self.cancel_action(act))
                row.add_suffix(cancel)
            history.add(row)

    # --- one computer ---------------------------------------------------------------------------
    def open_device(self, d: dict) -> None:
        page = Adw.PreferencesPage()
        view = Adw.ToolbarView()
        view.add_top_bar(Adw.HeaderBar())
        view.set_content(page)
        self.nav.push(Adw.NavigationPage(title=d.get("hostname") or "Computer", child=view))
        info = Adw.PreferencesGroup(title=d.get("hostname") or "Computer")
        page.add(info)
        hw = d.get("hardware") or {}
        for title, value in (("Kulan OS", d.get("kulan_version") or "–"), ("System", d.get("os") or "–"),
                             ("Computer", " ".join(x for x in (hw.get("vendor"), hw.get("model")) if x) or "–"),
                             ("Memory", f"{round((hw.get('memory_mb') or 0) / 1024, 1)} GB" if hw.get("memory_mb") else "–"),
                             ("Disk", f"{hw.get('disk_free_gb')} GB free of {hw.get('disk_total_gb')} GB"
                              if hw.get("disk_total_gb") else "–"),
                             ("Last report", ago(d.get("last_seen"))), ("Joined", ago(d.get("enrolled_at"))),
                             ("TPM unlock", "on" if (d.get("tpm") or {}).get("on") else "off" if d.get("tpm") else "–"),
                             ("Disk encryption", yes_no((d.get("state") or {}).get("encrypted"))),
                             ("Firewall", yes_no((d.get("state") or {}).get("firewall"), "on", "off")),
                             ("Automatic updates", yes_no((d.get("state") or {}).get("auto_updates"), "on", "off"))):
            row = Adw.ActionRow(title=title, subtitle=GLib.markup_escape_text(str(value)), subtitle_selectable=True)
            row.add_css_class("property")
            info.add(row)
        status = d.get("policy_status") or {}
        if status:
            pol = Adw.PreferencesGroup(title="Policy")
            page.add(pol)
            for key, value in status.items():
                row = Adw.ActionRow(title=POLICY_LABEL.get(key, key))
                row.add_suffix(tag("met" if value == "met" else "not met", "good" if value == "met" else "bad"))
                pol.add(row)
        apps = Adw.PreferencesGroup()
        page.add(apps)
        apps_row = Adw.ActionRow(title="Apps", subtitle=f"{d.get('app_count') or 0} · sent {ago(d.get('apps_at'))}"
                                 if d.get("apps_at") else "Not sent yet (once a day)", activatable=bool(d.get("apps_at")))
        apps_row.add_prefix(Gtk.Image(icon_name="view-app-grid-symbolic"))
        if d.get("apps_at"):
            apps_row.add_suffix(Gtk.Image(icon_name="go-next-symbolic"))
            apps_row.connect("activated", lambda _r: self.open_apps(d))
        apps.add(apps_row)
        if not d.get("left_at"):
            ask = Adw.PreferencesGroup(title="Ask it to", description="The computer does it at its next report "
                                                                       "(within the hour, or now with Report now).")
            page.add(ask)
            for kind, label, icon in ACTIONS:
                row = Adw.ActionRow(title=label, activatable=True)
                row.add_prefix(Gtk.Image(icon_name=icon))
                row.connect("activated", lambda _r, k=kind: self.send_action(d, k))
                ask.add(row)
            st = d.get("state") or {}
            lost = Adw.PreferencesGroup(title="If it’s lost or stolen")
            page.add(lost)
            erase = Adw.ActionRow(title="Erase this computer", activatable=bool(st.get("erase_allowed") and st.get("encrypted")),
                                  subtitle="Makes everything on its disk unreadable, for good, and switches it off"
                                  if st.get("erase_allowed") and st.get("encrypted") else
                                  "Not possible: its disk isn’t encrypted" if st.get("erase_allowed") else
                                  "Not possible: the person using it hasn’t allowed it (Kulan Settings › About › "
                                  "Organisation on that computer)", subtitle_lines=0)
            erase.add_prefix(Gtk.Image(icon_name="edit-delete-symbolic"))
            if st.get("lost_mode"):
                lost_row = Adw.ActionRow(title="Release from lost mode", subtitle="It's in lost mode: nobody can sign "
                                         "in until you release it", activatable=True, subtitle_lines=0)
                lost_row.add_prefix(Gtk.Image(icon_name="changes-allow-symbolic"))
                lost_row.connect("activated", lambda _r: self.send_action(d, "lost-mode-off"))
            else:
                lost_row = Adw.ActionRow(title="Turn on lost mode", subtitle="Nobody can sign in until you release it; "
                                         "whoever is using it is signed out after 20 seconds' notice. It keeps "
                                         "reporting, so you see when it's next online", activatable=True,
                                         subtitle_lines=0)
                lost_row.add_prefix(Gtk.Image(icon_name="system-lock-screen-symbolic"))
                lost_row.connect("activated", lambda _r: self.send_action(d, "lost-mode-on"))
            lost.add(lost_row)
            if st.get("erase_allowed") and st.get("encrypted"):
                erase.add_css_class("error")
                erase.connect("activated", lambda _r: self.ask_erase(d))
            lost.add(erase)
        controls = Adw.PreferencesGroup(title="Compliance", description="Loading the latest report…")
        page.add(controls)

        def done(result, error):
            if error:
                controls.set_description(error)
                return
            report = (result or {}).get("report") or {}
            comp = report.get("compliance") or {}
            if not comp.get("controls"):
                controls.set_description("This computer hasn't sent compliance results.")
                return
            controls.set_description(f"{comp.get('passed')} of {comp.get('total')} pass · {comp.get('baseline') or ''}")
            for c in comp["controls"]:
                row = Adw.ActionRow(title=GLib.markup_escape_text(f"{c.get('id', '')} {c.get('title', '')}"),
                                    subtitle=GLib.markup_escape_text(f"CIS {c.get('cis', '')} · NIST {c.get('nist', '')}"))
                status = c.get("status")
                row.add_suffix(tag(status or "?", {"pass": "good", "fail": "bad"}.get(status, "dim")))
                controls.add(row)
        if self.data and self.data.get("sample"):
            done({"report": self.data.get("sample_report")}, None)
        else:
            self.background(lambda: self.session.call({"op": "report", "device_id": d["id"]}), done)

    def cancel_action(self, a: dict) -> None:
        if self.data and self.data.get("sample"):
            a["status"] = "cancelled"
            self.render_org()
            return
        self.background(lambda: self.session.call({"op": "cancel-action", "action_id": a["id"]}),
                        lambda _r, error: (self.toast(error) if error else
                                           (self.toast(f"{ACTION_LABEL.get(a['type'], a['type'])} cancelled"),
                                            self.reload())))

    def push_list(self, title: str, description: str) -> Adw.PreferencesGroup:
        page = Adw.PreferencesPage()
        view = Adw.ToolbarView()
        view.add_top_bar(Adw.HeaderBar())
        view.set_content(page)
        self.nav.push(Adw.NavigationPage(title=title, child=view))
        group = Adw.PreferencesGroup(title=title, description=description)
        page.add(group)
        return group

    def open_apps(self, d: dict) -> None:
        group = self.push_list(f"Apps on {d.get('hostname') or 'this computer'}", "Loading…")

        def done(result, error):
            if error:
                group.set_description(error)
                return
            apps = sorted((result or {}).get("apps") or [], key=lambda a: (a.get("source") != "flatpak", a.get("name", "").lower()))
            group.set_description(f"{len(apps)} apps and programs someone chose to install · sent {ago((result or {}).get('apps_at'))}")
            for a in apps[:1000]:
                row = Adw.ActionRow(title=GLib.markup_escape_text(a.get("name", "")),
                                    subtitle=GLib.markup_escape_text(a.get("version", "")))
                row.add_suffix(tag("Flatpak" if a.get("source") == "flatpak" else "Debian", "dim"))
                group.add(row)
        if self.data and self.data.get("sample"):
            done({"apps": self.data.get("sample_apps", []), "apps_at": d.get("apps_at")}, None)
        else:
            self.background(lambda: self.session.call({"op": "apps", "device_id": d["id"]}), done)

    def open_log(self, org: dict) -> None:
        group = self.push_list("Activity log", "Loading…")

        def done(result, error):
            if error:
                group.set_description(error)
                return
            entries = (result or {}).get("entries") or []
            group.set_description("The last 100 changes, newest first." if entries else "Nothing changed yet.")
            for e in entries:
                what = e.get("what", "")
                if what.startswith("asked: "):
                    what = f"asked {e.get('hostname') or 'a computer'} to {ACTION_LABEL.get(what[7:], what[7:]).lower()}"
                row = Adw.ActionRow(title=GLib.markup_escape_text(f"{e.get('email', '')} {what}"),
                                    subtitle=GLib.markup_escape_text(ago(e.get("at"))))
                group.add(row)
        if self.data and self.data.get("sample"):
            done({"entries": self.data.get("sample_log", [])}, None)
        else:
            self.background(lambda: self.session.call({"op": "log", "organisation_id": org["id"]}), done)

    def ask_erase(self, d: dict) -> Adw.AlertDialog:
        name = d.get("hostname") or ""
        dialog = Adw.AlertDialog(heading=f"Erase {name}?",
                                 body="At its next report it tells whoever is using it, 20 seconds later makes "
                                      "everything on its disk unreadable, for good, and switches off. Switching it "
                                      "off then only delays it. Nobody can undo this or get the files back. To "
                                      "confirm, type the computer’s name.")
        entry = Adw.EntryRow(title=f"Type {name}")
        box = Gtk.ListBox(css_classes=["boxed-list"], selection_mode=Gtk.SelectionMode.NONE)
        box.append(entry)
        dialog.set_extra_child(box)
        dialog.add_response("cancel", "Cancel")
        dialog.add_response("erase", "Erase")
        dialog.set_response_appearance("erase", Adw.ResponseAppearance.DESTRUCTIVE)
        dialog.set_response_enabled("erase", False)
        dialog.set_default_response("cancel")
        entry.connect("changed", lambda e: dialog.set_response_enabled("erase", bool(name) and e.get_text().strip() == name))

        def answered(_d, response):
            if response != "erase" or entry.get_text().strip() != name:
                return
            self.background(lambda: self.session.call({"op": "action", "device_id": d["id"], "type": "erase",
                                                        "confirm": entry.get_text().strip()}),
                            lambda _r, error: (self.toast(error) if error else
                                               (self.toast(f"{name} will be erased at its next report"), self.reload())))
        dialog.connect("response", answered)
        dialog.present(self)
        return dialog

    def send_action(self, d: dict, kind: str) -> Adw.AlertDialog | None:
        def go() -> None:
            self.background(lambda: self.session.call({"op": "action", "device_id": d["id"], "type": kind}),
                            lambda _r, error: (self.toast(error) if error else
                                               (self.toast(f"Asked {d.get('hostname')} to {ACTION_LABEL[kind].lower()}"),
                                                self.reload())))
        bodies = {"restart": "Whoever is using it gets five minutes' notice before the restart.",
                  "shutdown": "Whoever is using it gets five minutes' notice, then it switches off. It reports again "
                              "when someone switches it on.",
                  "install-updates": "Updates install in the background; a restart may follow.",
                  "lost-mode-on": "At its next report nobody can sign in any more, and whoever is using it is signed "
                                  "out 20 seconds after a notice (unsaved work is lost). The sign-in screen says it's "
                                  "lost and to return it to your organisation. Release it here when it's found."}
        if kind not in bodies:
            go()
            return None
        dialog = Adw.AlertDialog(heading=f"{ACTION_LABEL[kind]} on {d.get('hostname')}?", body=bodies[kind])
        dialog.add_response("cancel", "Cancel")
        dialog.add_response("go", ACTION_LABEL[kind])
        dialog.set_response_appearance("go", Adw.ResponseAppearance.SUGGESTED if kind == "install-updates"
                                       else Adw.ResponseAppearance.DESTRUCTIVE)
        dialog.connect("response", lambda _d, r: r == "go" and go())
        dialog.present(self)
        return dialog

    # --- codes and organisations ------------------------------------------------------------------
    def make_code(self, org_id: str, hours_index: int, uses: int) -> None:
        hours = [24, 72, 168, 720][hours_index]

        def done(result, error):
            if error:
                self.toast(error)
                return
            box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
            box.append(Gtk.Label(label="Server address", xalign=0, css_classes=["dim-label"]))
            box.append(Gtk.Label(label=FLEET_SERVER, xalign=0, selectable=True, wrap=True))
            box.append(Gtk.Label(label="Join code", xalign=0, css_classes=["dim-label"], margin_top=8))
            box.append(Gtk.Label(label=result["code"], xalign=0, selectable=True, css_classes=["fleet-code"]))
            dialog = Adw.AlertDialog(heading="Join code",
                                     body=f"Works for {result['uses']} computer{'s' if result['uses'] != 1 else ''} "
                                          f"within {result['hours']} hours. It's shown only now.")
            dialog.set_extra_child(box)
            dialog.add_response("copy", "Copy code")
            dialog.add_response("close", "Done")
            dialog.set_default_response("close")
            dialog.connect("response", lambda _d, r: r == "copy" and Gdk.Display.get_default().get_clipboard().set(result["code"]))
            dialog.present(self)
        self.background(lambda: self.session.call({"op": "new-code", "organisation_id": org_id,
                                                    "hours": hours, "uses": uses}), done)

    def new_org(self) -> None:
        dialog = Adw.AlertDialog(heading="New organisation",
                                 body="The Owner is the one person who decides who the admins are. Leave it empty "
                                      "to be the Owner yourself.")
        entry = Adw.EntryRow(title="Name")
        owner = Adw.EntryRow(title="Owner's email (optional)")
        box = Gtk.ListBox(css_classes=["boxed-list"], selection_mode=Gtk.SelectionMode.NONE)
        box.append(entry)
        box.append(owner)
        dialog.set_extra_child(box)
        dialog.add_response("cancel", "Cancel")
        dialog.add_response("add", "Add")
        dialog.set_response_appearance("add", Adw.ResponseAppearance.SUGGESTED)

        def answered(_d, response):
            name = entry.get_text().strip()
            if response != "add" or not name:
                return
            body = {"op": "new-organisation", "name": name}
            if owner.get_text().strip():
                body["owner_email"] = owner.get_text().strip()

            def done(r, error):
                if error:
                    self.toast(error)
                    return
                self.org_id = r["id"]
                self.reload()
                self.show_recovery_code(name, r.get("recovery_code"))
            self.background(lambda: self.session.call(body), done)
        dialog.connect("response", answered)
        dialog.present(self)
        return dialog

    # --- People ---------------------------------------------------------------------------------
    def sample_mode(self) -> bool:
        return bool(self.data and self.data.get("sample"))

    def call(self, body: dict, done, sample_reply=None) -> None:
        """A fleet-admin call in the background; with sample data (the self-test), its stand-in reply."""
        if self.sample_mode():
            done(sample_reply() if callable(sample_reply) else (sample_reply or {}), None)
            return
        self.background(lambda: self.session.call(body), done)

    def org_computers(self, org: dict) -> list[dict]:
        return [d for d in (self.data or {}).get("devices", []) if d["organisation_id"] == org["id"] and not d.get("left_at")]

    def computer_picker(self, org: dict, all_on: bool, chosen: list[str]):
        """All the organisation's computers, or chosen ones: (rows to add to a list, a function giving
        (all_computers, [device ids]))."""
        everything = Adw.SwitchRow(title="All the organisation's computers",
                                   subtitle="Including computers that join later", active=all_on)
        checks = []
        rows = [everything]
        for d in self.org_computers(org):
            row = Adw.ActionRow(title=GLib.markup_escape_text(d.get("hostname") or "(no name)"), visible=not all_on)
            check = Gtk.CheckButton(active=d["id"] in chosen, valign=Gtk.Align.CENTER)
            row.add_prefix(check)
            row.set_activatable_widget(check)
            checks.append((d["id"], check))
            rows.append(row)
        everything.connect("notify::active", lambda sw, _p: [r.set_visible(not sw.get_active()) for r in rows[1:]])
        return rows, lambda: (everything.get_active(), [i for i, c in checks if c.get_active()])

    def open_people(self, org: dict) -> None:
        if self.nav.find_page("people") is not None:
            self.nav.pop_to_tag("org")
        page = Adw.PreferencesPage()
        view = Adw.ToolbarView()
        header = Adw.HeaderBar()
        add = Gtk.Button(icon_name="list-add-symbolic", tooltip_text="Add a person", sensitive=False)
        header.pack_start(add)
        view.add_top_bar(header)
        view.set_content(page)
        self.nav.push(Adw.NavigationPage(title="People", child=view, tag="people"))
        group = Adw.PreferencesGroup(title=f"People in {org['name']}", description="Loading…")
        page.add(group)
        self.people_page = page

        def done(result, error):
            if error:
                group.set_description(error)
                return
            people = (result or {}).get("people") or []
            is_owner = bool((result or {}).get("is_owner"))
            add.set_sensitive(True)
            add.connect("clicked", lambda _b: self.add_person(org, is_owner))
            group.set_description(f"{len(people)} {'person' if len(people) == 1 else 'people'}. Computers get "
                                  "changes at their next report (within the hour)." if people else
                                  "Nobody yet. Add someone with the + button: they get a setup code to sign in "
                                  "with, then choose their own password.")
            for person in people:
                n = len(person.get("on") or [])
                where = "all computers" if person.get("all_computers") else f"{n} computer{'s' if n != 1 else ''}"
                row = Adw.ActionRow(title=GLib.markup_escape_text(person.get("full_name") or person["username"]),
                                    subtitle=GLib.markup_escape_text(f"{person['username']} · {where}"), activatable=True)
                row.add_prefix(Gtk.Image(icon_name="avatar-default-symbolic"))
                if person.get("role") != "employee":
                    row.add_suffix(tag(ROLE_LABEL.get(person.get("role"), person.get("role")), "dim"))
                if not person.get("enabled"):
                    row.add_suffix(tag("disabled", "bad"))
                elif person.get("must_change"):
                    row.add_suffix(tag("setup code not used yet", "warn"))
                row.add_suffix(Gtk.Image(icon_name="go-next-symbolic"))
                row.connect("activated", lambda _r, pe=person: self.open_person(org, pe, is_owner))
                group.add(row)
        self.call({"op": "people", "organisation_id": org["id"]}, done,
                  lambda: {"people": (self.data or {}).get("sample_people", []), "is_owner": True})

    def open_person(self, org: dict, person: dict, is_owner: bool) -> None:
        page = Adw.PreferencesPage()
        view = Adw.ToolbarView()
        view.add_top_bar(Adw.HeaderBar())
        view.set_content(page)
        name = person.get("full_name") or person["username"]
        self.nav.push(Adw.NavigationPage(title=name, child=view))
        info = Adw.PreferencesGroup(title=name)
        page.add(info)
        state = ("Disabled: can't sign in" if not person.get("enabled") else
                 "Hasn't used the setup code yet" if person.get("must_change") else "Signs in with their own password")
        for title, value in (("Username", person["username"]), ("Email", person.get("email") or "–"),
                             ("Role", ROLE_LABEL.get(person.get("role"), person.get("role"))), ("Sign-in", state),
                             ("Added", f"{ago(person.get('created_at'))} by {person.get('created_by') or '–'}")):
            row = Adw.ActionRow(title=title, subtitle=GLib.markup_escape_text(str(value)), subtitle_selectable=True)
            row.add_css_class("property")
            info.add(row)

        where = Adw.PreferencesGroup(title="On these computers",
                                     description="All the organisation's computers" if person.get("all_computers")
                                     else "Only the computers chosen for them")
        page.add(where)
        for c in person.get("on") or []:
            status = c.get("status") or "not yet"
            row = Adw.ActionRow(title=GLib.markup_escape_text(c.get("hostname") or "(no name)"))
            row.add_prefix(Gtk.Image(icon_name="computer-symbolic"))
            kind = "bad" if status.startswith(("conflict", "couldn")) else "dim" if status == "not yet" else "good"
            row.add_suffix(tag("waiting for its next report" if status == "not yet" else status, kind))
            where.add(row)
        if not person.get("on"):
            where.add(Adw.ActionRow(title="No computers yet"))

        change = Adw.PreferencesGroup(title="Change")
        page.add(change)
        row = Adw.ActionRow(title="Name and email", activatable=True)
        row.add_prefix(Gtk.Image(icon_name="document-edit-symbolic"))
        row.connect("activated", lambda _r: self.edit_person_details(org, person))
        change.add(row)
        roles = ["employee", "admin", "owner"]
        role = Adw.ComboRow(title="Role", model=Gtk.StringList.new([ROLE_LABEL[r] for r in roles]),
                            subtitle=ROLE_HELP.get(person.get("role"), "") if is_owner else
                            "Only the Owner gives or takes the admin role",
                            selected=roles.index(person.get("role")) if person.get("role") in roles else 0,
                            sensitive=is_owner)
        role.connect("notify::selected", lambda r, _p: self.change_role(org, person, roles[r.get_selected()], r))
        change.add(role)
        row = Adw.ActionRow(title="Computers", subtitle="All" if person.get("all_computers") else
                            f"{len(person.get('computers') or [])} chosen", activatable=True)
        row.add_prefix(Gtk.Image(icon_name="computer-symbolic"))
        row.connect("activated", lambda _r: self.edit_person_computers(org, person))
        change.add(row)

        sign_in = Adw.PreferencesGroup(title="Signing in")
        page.add(sign_in)
        manages = is_owner or person.get("role") == "employee"
        row = Adw.ActionRow(title="Give a new setup code", subtitle="If they forgot their password. The old one stops "
                            "working at each computer's next report", activatable=manages, sensitive=manages)
        row.add_prefix(Gtk.Image(icon_name="dialog-password-symbolic"))
        row.connect("activated", lambda _r: self.new_setup_code(org, person))
        sign_in.add(row)
        enabled = person.get("enabled")
        row = Adw.ActionRow(title="Disable" if enabled else "Enable again",
                            subtitle="Locked on every computer at its next report; their files stay" if enabled else
                            "They can sign in again at each computer's next report", activatable=manages,
                            sensitive=manages)
        row.add_prefix(Gtk.Image(icon_name="action-unavailable-symbolic" if enabled else "object-select-symbolic"))
        row.connect("activated", lambda _r: self.set_person_enabled(org, person, not enabled))
        sign_in.add(row)
        leave = Adw.PreferencesGroup()
        page.add(leave)
        row = Adw.ActionRow(title=f"Remove {person['username']}", subtitle="Their account is removed from every "
                            "computer; you choose whether their files are kept", activatable=manages, sensitive=manages)
        row.add_prefix(Gtk.Image(icon_name="user-trash-symbolic"))
        row.add_css_class("error")
        row.connect("activated", lambda _r: self.remove_person(org, person))
        leave.add(row)
        if not manages:
            leave.set_description("Only the Owner changes an admin's or the Owner's sign-in.")

    def after_people_change(self, org: dict, message: str) -> None:
        self.toast(message)
        self.open_people(org)

    def add_person(self, org: dict, is_owner: bool) -> Adw.AlertDialog:
        dialog = Adw.AlertDialog(heading="Add a person", body="They get a setup code to sign in with, then choose "
                                 "their own password. Computers get their account at their next report.")
        box = Gtk.ListBox(css_classes=["boxed-list"], selection_mode=Gtk.SelectionMode.NONE)
        full = Adw.EntryRow(title="Full name")
        user = Adw.EntryRow(title="Username (how they sign in)")
        email = Adw.EntryRow(title="Work email (optional)")
        roles = ["employee"] + (["admin", "owner"] if is_owner else [])
        role = Adw.ComboRow(title="Role", model=Gtk.StringList.new([ROLE_LABEL[r] for r in roles]),
                            subtitle=ROLE_HELP["employee"] if is_owner else "Only the Owner can add admins")
        role.connect("notify::selected", lambda r, _p: r.set_subtitle(ROLE_HELP[roles[r.get_selected()]]))
        for w in (full, user, email, role):
            box.append(w)
        rows, picked = self.computer_picker(org, True, [])
        for r in rows:
            box.append(r)
        note = Gtk.Label(wrap=True, xalign=0, css_classes=["dim-label"], margin_top=6)
        outer = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        outer.append(box)
        outer.append(note)
        dialog.set_extra_child(outer)
        dialog.add_response("cancel", "Cancel")
        dialog.add_response("add", "Add")
        dialog.set_response_appearance("add", Adw.ResponseAppearance.SUGGESTED)
        dialog.set_response_enabled("add", False)
        suggested = {"last": ""}

        def name_changed(_e):
            if user.get_text() in ("", suggested["last"]):
                suggested["last"] = suggest_username(full.get_text())
                user.set_text(suggested["last"])

        def user_changed(_e):
            problem = username_problem(user.get_text())
            note.set_label(problem or "")
            dialog.set_response_enabled("add", problem is None)
        full.connect("changed", name_changed)
        user.connect("changed", user_changed)

        def answered(_d, response):
            if response != "add" or username_problem(user.get_text()):
                return
            all_computers, computers = picked()
            display = full.get_text().strip() or user.get_text()
            code = setup_code()
            body = {"op": "add-person", "organisation_id": org["id"], "username": user.get_text(),
                    "full_name": full.get_text().strip(), "role": roles[role.get_selected()],
                    "all_computers": all_computers, "computers": computers}
            if email.get_text().strip():
                body["email"] = email.get_text().strip()

            def work():
                body["password_hash"] = hash_password(code)
                return {} if self.sample_mode() else self.session.call(body)

            def done(_r, error):
                if error:
                    self.toast(error)
                    return
                self.show_setup_code(display, code, first=True)
                self.after_people_change(org, f"Added {user.get_text()}")
            self.background(work, done)
        dialog.connect("response", answered)
        dialog.present(self)
        return dialog

    def show_setup_code(self, display: str, code: str, first: bool) -> Adw.AlertDialog:
        dialog = Adw.AlertDialog(
            heading=f"Setup code for {display}",
            body=(f"Give this to {display} in person or over a call, not by email. At the sign-in screen of "
                  f"{'any of the computers they may use' if first else 'their computer'}, they choose their name, "
                  "type this code exactly (capital letters and dashes), and then choose their own password. "
                  "Computers get it at their next report (within the hour). It's shown only now."))
        label = Gtk.Label(label=code, selectable=True, css_classes=["fleet-code"], margin_top=6)
        dialog.set_extra_child(label)
        dialog.add_response("copy", "Copy code")
        dialog.add_response("close", "Done")
        dialog.set_default_response("close")
        dialog.connect("response", lambda _d, r: r == "copy" and Gdk.Display.get_default().get_clipboard().set(code))
        dialog.present(self)
        return dialog

    def edit_person_details(self, org: dict, person: dict) -> Adw.AlertDialog:
        dialog = Adw.AlertDialog(heading=f"{person['username']}: name and email")
        box = Gtk.ListBox(css_classes=["boxed-list"], selection_mode=Gtk.SelectionMode.NONE)
        full = Adw.EntryRow(title="Full name", text=person.get("full_name") or "")
        email = Adw.EntryRow(title="Work email", text=person.get("email") or "")
        box.append(full)
        box.append(email)
        dialog.set_extra_child(box)
        dialog.add_response("cancel", "Cancel")
        dialog.add_response("save", "Save")
        dialog.set_response_appearance("save", Adw.ResponseAppearance.SUGGESTED)

        def answered(_d, response):
            if response != "save":
                return
            self.call({"op": "edit-person", "person_id": person["id"], "full_name": full.get_text().strip(),
                       "email": email.get_text().strip()},
                      lambda _r, error: self.toast(error) if error else self.after_people_change(org, "Saved"))
        dialog.connect("response", answered)
        dialog.present(self)
        return dialog

    def change_role(self, org: dict, person: dict, role: str, combo: Adw.ComboRow) -> None:
        if role == person.get("role"):
            return

        def done(_r, error):
            if error:
                self.toast(error)
                roles = ["employee", "admin", "owner"]
                combo.set_selected(roles.index(person.get("role")) if person.get("role") in roles else 0)
                return
            person["role"] = role
            self.toast(f"{person['username']} is now {'the Owner' if role == 'owner' else 'an ' + ROLE_LABEL[role].lower()}"
                       ": computers change at their next report")
        self.call({"op": "edit-person", "person_id": person["id"], "role": role}, done)

    def edit_person_computers(self, org: dict, person: dict) -> Adw.AlertDialog:
        dialog = Adw.AlertDialog(heading=f"Where {person['username']} can sign in",
                                 body="Taken off a computer, their account there is removed and their files kept.")
        box = Gtk.ListBox(css_classes=["boxed-list"], selection_mode=Gtk.SelectionMode.NONE)
        rows, picked = self.computer_picker(org, bool(person.get("all_computers")), person.get("computers") or [])
        for r in rows:
            box.append(r)
        dialog.set_extra_child(box)
        dialog.add_response("cancel", "Cancel")
        dialog.add_response("save", "Save")
        dialog.set_response_appearance("save", Adw.ResponseAppearance.SUGGESTED)

        def answered(_d, response):
            if response != "save":
                return
            all_computers, computers = picked()
            self.call({"op": "edit-person", "person_id": person["id"], "all_computers": all_computers,
                       "computers": computers},
                      lambda _r, error: self.toast(error) if error else self.after_people_change(org, "Saved"))
        dialog.connect("response", answered)
        dialog.present(self)
        return dialog

    def new_setup_code(self, org: dict, person: dict) -> Adw.AlertDialog:
        name = person.get("full_name") or person["username"]
        dialog = Adw.AlertDialog(heading=f"A new setup code for {name}?",
                                 body="Their password stops working on each computer at its next report; they sign "
                                      "in with the new code and choose a new password.")
        dialog.add_response("cancel", "Cancel")
        dialog.add_response("go", "Make a code")
        dialog.set_response_appearance("go", Adw.ResponseAppearance.SUGGESTED)

        def answered(_d, response):
            if response != "go":
                return
            code = setup_code()

            def work():
                body = {"op": "new-setup-code", "person_id": person["id"], "password_hash": hash_password(code)}
                return {} if self.sample_mode() else self.session.call(body)

            def done(_r, error):
                if error:
                    self.toast(error)
                    return
                self.show_setup_code(name, code, first=False)
                self.after_people_change(org, f"New setup code for {person['username']}")
            self.background(work, done)
        dialog.connect("response", answered)
        dialog.present(self)
        return dialog

    def set_person_enabled(self, org: dict, person: dict, enabled: bool) -> Adw.AlertDialog | None:
        def go():
            self.call({"op": "set-person-enabled", "person_id": person["id"], "enabled": enabled},
                      lambda _r, error: self.toast(error) if error else self.after_people_change(
                          org, f"{person['username']} {'enabled' if enabled else 'disabled'}: computers change at "
                               "their next report"))
        if enabled:
            go()
            return None
        dialog = Adw.AlertDialog(heading=f"Disable {person['username']}?",
                                 body="At each computer's next report (within the hour) their account is locked and "
                                      "they're signed out. Their files stay, and you can enable them again.")
        dialog.add_response("cancel", "Cancel")
        dialog.add_response("go", "Disable")
        dialog.set_response_appearance("go", Adw.ResponseAppearance.DESTRUCTIVE)
        dialog.connect("response", lambda _d, r: r == "go" and go())
        dialog.present(self)
        return dialog

    def remove_person(self, org: dict, person: dict) -> Adw.AlertDialog:
        user = person["username"]
        dialog = Adw.AlertDialog(heading=f"Remove {user}?",
                                 body="Their account is removed from every computer at its next report. To confirm, "
                                      "type their username.")
        box = Gtk.ListBox(css_classes=["boxed-list"], selection_mode=Gtk.SelectionMode.NONE)
        files = Adw.SwitchRow(title="Delete their files too",
                              subtitle="Off: each computer keeps their files for an administrator to hand over "
                                       "(in /home/.kulan-left)")
        entry = Adw.EntryRow(title=f"Type {user}")
        box.append(files)
        box.append(entry)
        dialog.set_extra_child(box)
        dialog.add_response("cancel", "Cancel")
        dialog.add_response("remove", "Remove")
        dialog.set_response_appearance("remove", Adw.ResponseAppearance.DESTRUCTIVE)
        dialog.set_response_enabled("remove", False)
        dialog.set_default_response("cancel")
        entry.connect("changed", lambda e: dialog.set_response_enabled("remove", e.get_text().strip() == user))

        def answered(_d, response):
            if response != "remove" or entry.get_text().strip() != user:
                return
            self.call({"op": "remove-person", "person_id": person["id"], "remove_files": files.get_active(),
                       "confirm": user},
                      lambda _r, error: self.toast(error) if error else self.after_people_change(
                          org, f"{user} removed: computers remove the account at their next report"))
        dialog.connect("response", answered)
        dialog.present(self)
        return dialog

    # --- admins and the Owner ---------------------------------------------------------------------
    def open_admins(self, org: dict) -> None:
        if self.nav.find_page("admins") is not None:
            self.nav.pop_to_tag("org")
        page = Adw.PreferencesPage()
        view = Adw.ToolbarView()
        view.add_top_bar(Adw.HeaderBar())
        view.set_content(page)
        self.nav.push(Adw.NavigationPage(title="Admins and the Owner", child=view, tag="admins"))
        group = Adw.PreferencesGroup(title="Kulan Fleet admins", description="Loading…")
        page.add(group)

        def done(result, error):
            if error:
                group.set_description(error)
                return
            result = result or {}
            owner, is_owner = result.get("owner"), bool(result.get("is_owner"))
            group.set_description("They sign in to Kulan Fleet with their email and manage computers and people. "
                                  + ("As the Owner, you choose who they are." if is_owner else
                                     "Only the Owner changes who they are."))
            row = Adw.ActionRow(title=GLib.markup_escape_text(owner or "No Owner yet"), subtitle="Owner")
            row.add_prefix(Gtk.Image(icon_name="starred-symbolic"))
            group.add(row)
            for a in result.get("admins") or []:
                if a.get("email") == owner:
                    continue
                row = Adw.ActionRow(title=GLib.markup_escape_text(a["email"]), subtitle=f"admin since {ago(a.get('created_at'))}")
                row.add_prefix(Gtk.Image(icon_name="avatar-default-symbolic"))
                if is_owner:
                    remove = Gtk.Button(icon_name="user-trash-symbolic", tooltip_text="No longer an admin",
                                        valign=Gtk.Align.CENTER, css_classes=["flat"])
                    remove.connect("clicked", lambda _b, e=a["email"]: self.change_admin(org, "remove-admin", e))
                    row.add_suffix(remove)
                group.add(row)
            if is_owner:
                add = Adw.PreferencesGroup(title="Add an admin")
                page.add(add)
                entry = Adw.EntryRow(title="Their email", show_apply_button=True)
                entry.connect("apply", lambda e: e.get_text().strip() and self.change_admin(org, "add-admin", e.get_text().strip()))
                add.add(entry)
            if (self.data or {}).get("global"):
                boss = Adw.PreferencesGroup(title="Ownership")
                page.add(boss)
                entry = Adw.EntryRow(title="Make this email the Owner", show_apply_button=True)
                entry.connect("apply", lambda e: e.get_text().strip() and self.set_owner(org, e.get_text().strip()))
                boss.add(entry)
        self.call({"op": "admins", "organisation_id": org["id"]}, done,
                  lambda: (self.data or {}).get("sample_admins", {}))

    def change_admin(self, org: dict, op: str, email: str) -> None:
        def done(_r, error):
            if error:
                self.toast(error)
                return
            self.toast(f"{email} {'is an admin' if op == 'add-admin' else 'is no longer an admin'}")
            self.open_admins(org)
        self.call({"op": op, "organisation_id": org["id"], "email": email}, done)

    def set_owner(self, org: dict, email: str) -> None:
        def done(r, error):
            if error:
                self.toast(error)
                return
            org["owner_email"] = email.lower()
            self.open_admins(org)
            self.show_recovery_code(org["name"], (r or {}).get("recovery_code"))
        self.call({"op": "set-owner", "organisation_id": org["id"], "email": email}, done,
                  lambda: {"recovery_code": "ABCDE-FGHJK-LMNPQ-RSTUV"})

    def show_recovery_code(self, name: str, code: str | None) -> Adw.AlertDialog | None:
        if not code:
            return None
        dialog = Adw.AlertDialog(
            heading=f"Recovery code for {name}",
            body="Write this down and keep it somewhere safe, away from this computer. If the Owner ever loses their "
                 "email account, signing in to Kulan Fleet with a new email and entering this code (menu › Become "
                 "the Owner with a recovery code) makes that email the Owner. It's shown only now; using it gives "
                 "a new one.")
        dialog.set_extra_child(Gtk.Label(label=code, selectable=True, css_classes=["fleet-code"], wrap=True,
                                         margin_top=6))
        dialog.add_response("copy", "Copy code")
        dialog.add_response("close", "I wrote it down")
        dialog.set_default_response("close")
        dialog.connect("response", lambda _d, r: r == "copy" and Gdk.Display.get_default().get_clipboard().set(code))
        dialog.present(self)
        return dialog

    def recover_owner(self) -> Adw.AlertDialog:
        dialog = Adw.AlertDialog(heading="Become the Owner",
                                 body="Enter the organisation's recovery code (written down when the Owner was set). "
                                      "The email you're signed in with becomes the Owner.")
        box = Gtk.ListBox(css_classes=["boxed-list"], selection_mode=Gtk.SelectionMode.NONE)
        entry = Adw.EntryRow(title="Recovery code")
        box.append(entry)
        dialog.set_extra_child(box)
        dialog.add_response("cancel", "Cancel")
        dialog.add_response("go", "Become the Owner")
        dialog.set_response_appearance("go", Adw.ResponseAppearance.SUGGESTED)

        def answered(_d, response):
            if response != "go" or not entry.get_text().strip():
                return

            def done(r, error):
                if error:
                    self.toast(error)
                    return
                self.org_id = ((r or {}).get("organisation") or {}).get("id", self.org_id)
                self.reload()
                self.show_recovery_code(((r or {}).get("organisation") or {}).get("name", "your organisation"),
                                        (r or {}).get("recovery_code"))
            self.call({"op": "recover-owner", "recovery_code": entry.get_text().strip()}, done)
        dialog.connect("response", answered)
        dialog.present(self)
        return dialog


