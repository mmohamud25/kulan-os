# --- the session ---------------------------------------------------------------------
SECRET_SCHEMA = None
if Secret is not None:
    SECRET_SCHEMA = Secret.Schema.new(APP_ID, Secret.SchemaFlags.NONE, {"kind": Secret.SchemaAttributeType.STRING})


def keyring_get() -> str | None:
    if SECRET_SCHEMA is None:
        return None
    try:
        return Secret.password_lookup_sync(SECRET_SCHEMA, {"kind": "refresh-token"}, None)
    except GLib.Error:
        return None


def keyring_set(token: str | None) -> None:
    if SECRET_SCHEMA is None:
        return
    try:
        if token:
            Secret.password_store_sync(SECRET_SCHEMA, {"kind": "refresh-token"}, Secret.COLLECTION_DEFAULT,
                                       "Kulan Fleet sign-in", token, None)
        else:
            Secret.password_clear_sync(SECRET_SCHEMA, {"kind": "refresh-token"}, None)
    except GLib.Error:
        pass


class FleetError(Exception):
    def __init__(self, message: str, two_step: str | None = None) -> None:
        super().__init__(message)
        self.two_step = two_step  # "code" or "set-up": the server wants an authenticator app code


class ErrorText(str):
    """An error message for the window, carrying what the server asked for."""
    two_step: str | None = None


class FleetOffline(FleetError):
    """The server couldn't be reached (no internet, server down): not a reason
    to forget the sign-in."""


def http(url: str, body: dict | None, headers: dict | None = None, method: str = "POST") -> dict:
    request = urllib.request.Request(url, data=None if method in ("GET", "DELETE") else json.dumps(body or {}).encode(),
                                     method=method,
                                     headers={"Content-Type": "application/json", "apikey": PUBLISHABLE_KEY,
                                              "User-Agent": "kulan-fleet-admin/1", **(headers or {})})
    try:
        with urllib.request.urlopen(request, timeout=TIMEOUT) as reply:
            text = reply.read(5_000_000).decode("utf-8", "replace")
    except urllib.error.HTTPError as e:
        two_step = None
        try:
            detail = json.loads(e.read().decode("utf-8", "replace"))
            message = detail.get("error") or detail.get("msg") or detail.get("error_description") or detail.get("message")
            two_step = detail.get("two_step") if detail.get("two_step") in ("code", "set-up") else None
        except (ValueError, AttributeError):
            message = None
        if isinstance(message, str) and message:
            message = message[0].upper() + message[1:]  # the server's messages start in lower case
        if e.code == 429 and isinstance(message, str) and re.search(r"rate limit|only request this after", message, re.I):
            message = ("Too many sign-in emails for now. Wait a few minutes (up to an hour if you asked several "
                       "times), then try again.")
        raise FleetError(message or f"Server error {e.code}", two_step) from e
    except (urllib.error.URLError, OSError) as e:
        print(f"kulan-fleet-admin: {getattr(e, 'reason', e)}", file=sys.stderr)  # the details, for whoever looks
        raise FleetOffline("Can't reach the Kulan Fleet server. Check your internet connection and try again.") from e
    try:
        return json.loads(text) if text.strip() else {}
    except ValueError as e:
        raise FleetError("The server sent an unexpected reply") from e


class Session:
    """Supabase Auth with an emailed one-time code; refresh token in the keyring."""

    def __init__(self) -> None:
        self.access_token: str | None = None
        self.expires = 0.0
        self.refresh_token: str | None = keyring_get()
        self.email = ""

    def _take(self, data: dict) -> None:
        self.access_token = data.get("access_token")
        self.refresh_token = data.get("refresh_token")
        self.expires = time.time() + float(data.get("expires_in") or 3600) - 60
        self.email = (data.get("user") or {}).get("email", self.email)
        keyring_set(self.refresh_token)

    def send_code(self, email: str) -> None:
        http(f"{SUPABASE_URL}/auth/v1/otp", {"email": email, "create_user": True})

    def verify(self, email: str, code: str) -> None:
        """Takes the code from the email, or its sign-in link.

        Supabase's built-in email has only a link (its text can be changed only with
        your own mail server), so either works: the link copied from the email, or
        the address the browser landed on after opening it.
        """
        # Phones and mail apps add line breaks or spaces, and copying from the
        # address bar can drop "http://" (or keep only the part after "#").
        code = "".join(code.split())
        if not code.isdigit() and "://" not in code and "refresh_token=" in code:
            code = "http://localhost/" + ("" if code.startswith("#") or "/" in code.split("#")[0] else "#") + \
                (code.split("/", 1)[1] if "/" in code.split("#")[0] else code)
        if code.isdigit():
            self._take(http(f"{SUPABASE_URL}/auth/v1/verify", {"type": "email", "email": email, "token": code}))
            return
        url = urllib.parse.urlsplit(code)
        if url.scheme != "https" and not code.startswith("http://localhost"):
            raise FleetError("Paste the 6-digit code, or the whole sign-in link from the email.")
        fragment = urllib.parse.parse_qs(url.fragment)
        query = urllib.parse.parse_qs(url.query)
        if "error_description" in fragment or "error_description" in query:
            reason = (fragment.get("error_description") or query["error_description"])[0]
            if re.search(r"expired|invalid", reason, re.I):
                raise FleetError("That sign-in link has expired or was already used. Each link works once, and asking "
                                 "for a new one cancels the earlier ones. Ask for a new link and use the newest email.")
            raise FleetError(reason)
        if "refresh_token" in fragment:
            # The browser already used the link: swap its refresh token for our own session.
            self._take(http(f"{SUPABASE_URL}/auth/v1/token?grant_type=refresh_token",
                            {"refresh_token": fragment["refresh_token"][0]}))
        elif "token" in query and url.netloc == urllib.parse.urlsplit(SUPABASE_URL).netloc:
            kind = (query.get("type") or ["magiclink"])[0]
            self._take(http(f"{SUPABASE_URL}/auth/v1/verify", {"type": kind, "token_hash": query["token"][0]}))
        else:
            raise FleetError("That doesn't look like the sign-in link from the email.")
        if email and self.email and self.email.lower() != email.lower():
            self.sign_out()
            raise FleetError(f"That link is for {self.email}, not {email}.")

    def token(self) -> str:
        if self.access_token and time.time() < self.expires:
            return self.access_token
        if not self.refresh_token:
            raise FleetError("Sign in to continue")
        try:
            self._take(http(f"{SUPABASE_URL}/auth/v1/token?grant_type=refresh_token",
                            {"refresh_token": self.refresh_token}))
        except FleetOffline:
            raise  # offline: keep the sign-in for when the connection is back
        except FleetError:
            self.sign_out(local_only=True)
            raise FleetError("Your sign-in has expired. Sign in again.")
        return self.access_token

    def call(self, body: dict) -> dict:
        return http(API, body, {"Authorization": f"Bearer {self.token()}"})

    def aal(self) -> str | None:
        """How strongly this sign-in is checked: "aal2" once the authenticator app's code was given."""
        try:
            part = self.token().split(".")[1]
            return json.loads(base64.urlsafe_b64decode(part + "=" * (-len(part) % 4))).get("aal")
        except (IndexError, ValueError, TypeError, AttributeError):
            return None

    # Authenticator apps (Supabase MFA, TOTP): the second step for Kulan Fleet admins.
    def _auth(self) -> dict:
        return {"Authorization": f"Bearer {self.token()}"}

    def authenticators(self) -> list[dict]:
        user = http(f"{SUPABASE_URL}/auth/v1/user", None, self._auth(), "GET")
        return [f for f in user.get("factors") or [] if f.get("factor_type") == "totp"]

    def enroll_authenticator(self) -> dict:
        """A new authenticator app: {id, totp: {uri, secret, qr_code}} (checked with verify_authenticator)."""
        for f in self.authenticators():
            if f.get("status") != "verified":  # a set-up that was never finished
                http(f"{SUPABASE_URL}/auth/v1/factors/{f['id']}", None, self._auth(), "DELETE")
        return http(f"{SUPABASE_URL}/auth/v1/factors", {"factor_type": "totp", "issuer": "Kulan Fleet",
                                                         "friendly_name": f"Kulan Fleet {time.strftime('%Y-%m-%d %H:%M')}"},
                    self._auth())

    def verify_authenticator(self, factor_id: str, code: str) -> None:
        challenge = http(f"{SUPABASE_URL}/auth/v1/factors/{factor_id}/challenge", {}, self._auth())
        self._take(http(f"{SUPABASE_URL}/auth/v1/factors/{factor_id}/verify",
                        {"challenge_id": challenge.get("id"), "code": code}, self._auth()))

    def remove_authenticator(self, factor_id: str) -> None:
        http(f"{SUPABASE_URL}/auth/v1/factors/{factor_id}", None, self._auth(), "DELETE")

    def sign_out(self, local_only: bool = False) -> None:
        if not local_only and self.access_token:
            try:
                http(f"{SUPABASE_URL}/auth/v1/logout", {}, {"Authorization": f"Bearer {self.access_token}"})
            except FleetError:
                pass
        self.access_token = self.refresh_token = None
        keyring_set(None)


# --- setup codes -----------------------------------------------------------------------
def setup_code() -> str:
    """12 random characters (60 bits) in groups of four: typed once, at the
    sign-in screen, then replaced by the person's own password."""
    chars = "".join(secrets.choice(CODE_LETTERS) for _ in range(12))
    return "-".join(chars[i:i + 4] for i in range(0, 12, 4))


def hash_password(code: str) -> str:
    """The one-way crypt(3) hash the computers put in /etc/shadow: yescrypt
    (Debian's own) when mkpasswd is here, otherwise SHA-512 crypt."""
    tries = []
    if shutil.which("mkpasswd"):
        tries.append(["mkpasswd", "--method=yescrypt", "--stdin"])
    if shutil.which("openssl"):
        tries.append(["openssl", "passwd", "-6", "-stdin"])
    for argv in tries:
        try:
            out = subprocess.run(argv, input=code + "\n", capture_output=True, text=True, timeout=30).stdout.strip()
        except (OSError, subprocess.TimeoutExpired):
            continue
        if HASH.match(out):
            return out
    raise FleetError("Can't make a setup code. Install mkpasswd or openssl.")


def suggest_username(name: str) -> str:
    """"Amina Yusuf" -> "amina"; letters only, as the computers allow."""
    plain = unicodedata.normalize("NFKD", name).encode("ascii", "ignore").decode().lower()
    first = re.sub(r"[^a-z0-9]", "", (plain.split() or [""])[0])
    first = first.lstrip("0123456789")[:32]
    return first if first and first not in RESERVED else ""


def username_problem(name: str) -> str | None:
    if not USERNAME.match(name):
        return "Username: use lower-case letters, digits, - or _, starting with a letter."
    return f"Username: {name} is used by the system. Choose another." if name in RESERVED else None


def network_problem(ssid: str, security: str, password: str) -> str | None:
    """What's wrong with a Wi-Fi network as typed, or None (the same rules as the server and the computers)."""
    size = len(ssid.encode())
    if not 1 <= size <= 32 or any(ord(c) < 32 or ord(c) == 127 for c in ssid):
        return "Network name: 1 to 32 characters"
    if security == "wpa-psk" and not (re.fullmatch(r"[\x20-\x7e]{8,63}", password) or re.fullmatch(r"[0-9a-fA-F]{64}", password)):
        return "Password: 8 to 63 characters"
    return None


def pushed_line(devices: list[dict], kind: str, item_id: str) -> str:
    """How a group's network or printer went on its computers, from their reports."""
    if not devices:
        return "No computers in the group yet"
    added = waiting = 0
    problems = []
    for d in devices:
        state = (((d.get("pushed") or {}).get(kind)) or {}).get(item_id)
        if state == "added":
            added += 1
        elif not state:
            waiting += 1
        else:
            problems.append(f"{d.get('hostname') or '(no name)'}: {state}")
    return " · ".join([f"Added on {added} of {len(devices)}"] +
                      ([f"{waiting} waiting for their next report"] if waiting else []) + problems)


