#!/usr/bin/python3
"""Kulan Setup Assistant: the first-login setup for Kulan OS.

Steps: hello, look (light, dark or automatic, and accent colour),
accessibility, privacy, bring files from another computer, backups,
passwords, apps (from Flathub, filtered to what this computer can run),
protection overview, and done. Every step can be skipped.

Runs automatically once per user at first login (--autostart), never in the
live session. Can be reopened any time from the app grid.
"""

from __future__ import annotations

import argparse
import os
import secrets
import shlex
import shutil
import subprocess
import sys
import threading
from dataclasses import dataclass
from pathlib import Path

import gi

gi.require_version("Gtk", "4.0")
gi.require_version("Adw", "1")
from gi.repository import Adw, Gdk, Gio, GLib, Gtk  # noqa: E402

APP_ID = "org.kulan.Welcome"
UPDATE_HELPER = "/usr/lib/kulan/update-run"
RESTORE_CONFIG = Path("/etc/timeshift/timeshift.json")
CONF_PATH = Path("/usr/share/kulan/kulan.conf")
STATE_DIR = Path(GLib.get_user_config_dir()) / "kulan-welcome"
DONE_FILE = STATE_DIR / "done"
WALLPAPERS = Path("/usr/share/backgrounds/kulan")
INTERFACE_SCHEMA = "org.gnome.desktop.interface"
KULAN_SCHEMA = "org.kulan.desktop"

ACCENTS = ["teal", "blue", "green", "yellow", "orange", "red", "pink", "purple", "slate"]

# Folders brought over from another computer: the names a Mac, Windows or
# Linux home folder uses, and where each goes here.
MIGRATE_FOLDERS = {
    "desktop": GLib.UserDirectory.DIRECTORY_DESKTOP,
    "documents": GLib.UserDirectory.DIRECTORY_DOCUMENTS,
    "my documents": GLib.UserDirectory.DIRECTORY_DOCUMENTS,
    "downloads": GLib.UserDirectory.DIRECTORY_DOWNLOAD,
    "music": GLib.UserDirectory.DIRECTORY_MUSIC,
    "pictures": GLib.UserDirectory.DIRECTORY_PICTURES,
    "photos": GLib.UserDirectory.DIRECTORY_PICTURES,
    "videos": GLib.UserDirectory.DIRECTORY_VIDEOS,
    "movies": GLib.UserDirectory.DIRECTORY_VIDEOS,
}
# Never copied: system and app clutter from other computers.
MIGRATE_SKIP = {".ds_store", "thumbs.db", "desktop.ini", "$recycle.bin", ".trash", ".trashes",
                ".spotlight-v100", ".fseventsd", "system volume information", ".localized"}


@dataclass(frozen=True)
class AppChoice:
    app_id: str
    name: str
    summary: str
    category: str
    symbol: str  # shown until the app is installed and its own icon exists


