    # --- 8: apps ------------------------------------------------------------------
    def build_apps(self) -> Gtk.Widget:
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=18)
        box.append(
            self.heading(
                "Add your apps",
                "Pick the apps you want and install them in one go. More are in the Software app.",
            )
        )
        self.apps_status = Gtk.Label(label="Checking which apps this computer can run…", css_classes=["dim-label"])
        box.append(self.apps_status)

        groups: dict[str, Adw.PreferencesGroup] = {}
        for choice in APPS:
            if choice.category not in groups:
                groups[choice.category] = Adw.PreferencesGroup(title=choice.category)
                box.append(groups[choice.category])
            check = Gtk.CheckButton(valign=Gtk.Align.CENTER, sensitive=False)
            check.connect("toggled", self.on_app_toggled)
            row = Adw.ActionRow(title=choice.name, subtitle=choice.summary, activatable_widget=check)
            theme = Gtk.IconTheme.get_for_display(Gdk.Display.get_default())
            if theme.has_icon(choice.app_id):
                icon = Gtk.Image(icon_name=choice.app_id, pixel_size=32)
            else:
                icon = Gtk.Image(icon_name=choice.symbol, pixel_size=24, margin_start=4, margin_end=4)
            row.add_prefix(icon)
            row.add_suffix(check)
            groups[choice.category].add(row)
            self.app_checks[choice.app_id] = check
            self.app_rows[choice.app_id] = row

        self.install_button = Gtk.Button(
            label="Install selected", css_classes=["suggested-action", "pill"], halign=Gtk.Align.CENTER, sensitive=False
        )
        self.install_button.connect("clicked", self.on_install)
        self.install_spinner = Gtk.Spinner(visible=False, halign=Gtk.Align.CENTER)
        box.append(self.install_button)
        box.append(self.install_spinner)

        addons = Adw.PreferencesGroup(title="Add-ons",
                                      description="Developer Kit, office and media apps, Phone Link, Nearby "
                                                  "Share and more, one click each.")
        addons.add(self.link_row("Kulan add-ons", "Open Add-ons in Kulan Settings",
                                 lambda: self.open_settings("add-ons")))
        box.append(addons)
        box.append(Gtk.Box(margin_bottom=12))
        self.apps_page = self.page(box)
        return self.apps_page

    def load_app_availability(self) -> None:
        if shutil.which("flatpak") is None:
            self.apps_status.set_label("Flatpak isn't installed, so these apps can't be added here.")
            return

        code, out, _ = run(["flatpak", "--default-arch"], timeout=10)
        arch = out.strip() if code == 0 and out.strip() else None
        cmd = ["flatpak", "remote-ls", "--system", "--app", "--columns=application", "flathub"]
        if arch:
            cmd.append(f"--arch={arch}")

        def got_remote(code: int, out: str, err: str) -> bool:
            if code != 0:
                self.apps_status.set_label("Couldn't reach Flathub. Connect to the internet, then reopen this page.")
                self.apps_loaded = False
                return False
            available = {line.strip() for line in out.splitlines() if line.strip()}
            run_async(
                ["flatpak", "list", "--app", "--columns=application"],
                lambda c, o, e: self.apply_availability(available, set(o.split()) if c == 0 else set(), arch),
                timeout=30,
            )
            return False

        run_async(cmd, got_remote, timeout=120)

    def apply_availability(self, available: set[str], installed: set[str], arch: str | None) -> bool:
        unavailable = 0
        for app_id, check in self.app_checks.items():
            row = self.app_rows[app_id]
            choice = next(c for c in APPS if c.app_id == app_id)
            if app_id in installed:
                row.set_sensitive(True)
                check.set_active(True)
                check.set_sensitive(False)
                row.set_subtitle(f"{choice.summary} - installed")
            elif app_id in available:
                row.set_sensitive(True)
                check.set_sensitive(True)
                row.set_subtitle(choice.summary)
            else:
                unavailable += 1
                check.set_active(False)
                check.set_sensitive(False)
                row.set_sensitive(False)
                row.set_subtitle("Not available for this computer - use its website instead")
        machine = {"aarch64": "ARM", "x86_64": "PC"}.get(arch or "", "this")
        if unavailable:
            self.apps_status.set_label(
                f"{unavailable} of these aren't made for {machine} computers yet and are greyed out."
            )
        else:
            self.apps_status.set_label("All of these work on this computer.")
        self.on_app_toggled(None)
        return False

    def selected_apps(self) -> list[str]:
        return [app_id for app_id, check in self.app_checks.items() if check.get_active() and check.get_sensitive()]

    def on_app_toggled(self, _check: Gtk.CheckButton | None) -> None:
        count = len(self.selected_apps())
        self.install_button.set_sensitive(count > 0)
        label = f"Install {count} app{'s' if count != 1 else ''}" if count else "Install selected"
        self.install_button.set_label(label)

    def on_install(self, _button: Gtk.Button) -> None:
        apps = self.selected_apps()
        if not apps:
            return
        self.install_button.set_sensitive(False)
        self.install_button.set_label("Installing… this can take a few minutes")
        self.install_spinner.set_visible(True)
        self.install_spinner.start()
        for check in self.app_checks.values():
            check.set_sensitive(False)

        def done(code: int, _out: str, err: str) -> bool:
            self.install_spinner.stop()
            self.install_spinner.set_visible(False)
            if code == 0:
                self.toast(f"Installed {len(apps)} app{'s' if len(apps) != 1 else ''}")
            else:
                reason = (err.strip().splitlines() or ["unknown error"])[-1]
                self.toast(f"Couldn't install: {reason}")
            self.load_app_availability()
            return False

        # A system-wide install asks for your password through the normal
        # GNOME prompt; apps then appear for every user on this computer.
        run_async(["flatpak", "install", "--system", "--noninteractive", "-y", "flathub", *apps], done, timeout=3600)

    # --- 9: protection ---------------------------------------------------------------
    def build_security(self) -> Gtk.Widget:
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=18)
        box.append(self.heading("How you're protected", f"{self.name} turns on these protections for you.",
                                "security-high-symbolic"))
        group = Adw.PreferencesGroup()
        live = self.live

        group.add(self.status_row("Firewall", "Blocks connections coming in from the network",
                                  self.firewall_enabled()))
        group.add(self.status_row("Automatic security updates", "Fixes for security problems install every day",
                                  self.auto_updates_enabled()))
        if live:
            group.add(self.info_row("Disk encryption", "Choose it when you install - it's on by default"))
        else:
            encrypted = self.disk_encrypted()
            group.add(
                self.status_row(
                    "Disk encryption",
                    "Your files are locked if this computer is lost"
                    if encrypted
                    else "Reinstall with encryption turned on to protect your files if this computer is lost",
                    encrypted,
                )
            )
        group.add(self.status_row("Screen lock", "Locks after 5 minutes away, or when the lid closes", True))
        group.add(self.status_row("Private browsing defaults",
                                  "Firefox blocks ads, trackers and cookie banners, and sends no usage data",
                                  Path("/etc/firefox/policies/policies.json").exists()))
        box.append(group)
        more = Adw.PreferencesGroup()
        more.add(self.link_row("Security in Kulan Settings", "Run a security checkup and see every protection",
                               lambda: self.open_settings("security")))
        box.append(more)
        return self.page(box)

    @staticmethod
    def status_row(title: str, subtitle: str, state: bool | None) -> Adw.ActionRow:
        row = Adw.ActionRow(title=title, subtitle=subtitle)
        if state is True:
            row.add_prefix(Gtk.Image(icon_name="object-select-symbolic", css_classes=["success"]))
            row.add_suffix(Gtk.Label(label="On", css_classes=["success"]))
        elif state is False:
            row.add_prefix(Gtk.Image(icon_name="dialog-warning-symbolic", css_classes=["warning"]))
            row.add_suffix(Gtk.Label(label="Off", css_classes=["warning"]))
        else:
            row.add_prefix(Gtk.Image(icon_name="dialog-information-symbolic"))
        return row

    @staticmethod
    def info_row(title: str, subtitle: str) -> Adw.ActionRow:
        row = Adw.ActionRow(title=title, subtitle=subtitle)
        row.add_prefix(Gtk.Image(icon_name="dialog-information-symbolic"))
        return row

    @staticmethod
    def firewall_enabled() -> bool:
        try:
            return "ENABLED=yes" in Path("/etc/ufw/ufw.conf").read_text().split()
        except OSError:
            return False

    @staticmethod
    def auto_updates_enabled() -> bool:
        code, out, _ = run(["apt-config", "dump", "APT::Periodic::Unattended-Upgrade"], timeout=10)
        return code == 0 and '"1"' in out

    @staticmethod
    def disk_encrypted() -> bool:
        code, out, _ = run(["lsblk", "--noheadings", "--output", "TYPE"], timeout=10)
        return code == 0 and "crypt" in out.split()

    # --- 10: done -------------------------------------------------------------------
    def build_done(self) -> Gtk.Widget:
        status = Adw.StatusPage(
            icon_name="object-select-symbolic",
            title="You're all set",
            description="Open Setup Assistant again any time from your apps. Kulan Settings has everything else.",
            vexpand=True,
        )
        inner = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=18)
        group = Adw.PreferencesGroup()
        self.startup_switch = Adw.SwitchRow(title="Show this at startup", active=not DONE_FILE.exists())
        group.add(self.startup_switch)
        inner.append(group)
        url = self.conf.get("KULAN_HOME_URL", "")
        if url:
            publisher = self.conf.get("KULAN_PUBLISHER", "").removesuffix(" Ltd").strip() or "our website"
            visit = Gtk.Button(label=f"Visit {publisher}", css_classes=["pill"], halign=Gtk.Align.CENTER)
            visit.connect("clicked", lambda _b: Gtk.UriLauncher.new(url).launch(self, None, None, None))
            inner.append(visit)
        status.set_child(Adw.Clamp(maximum_size=420, child=inner))
        return status


class WelcomeApp(Adw.Application):
    def __init__(self, start_page: int, self_test: bool = False) -> None:
        super().__init__(application_id=APP_ID, flags=Gio.ApplicationFlags.NON_UNIQUE if self_test
                         else Gio.ApplicationFlags.DEFAULT_FLAGS)
        self.start_page = start_page
        self.self_test = self_test
        self.result = 0
        self.conf = read_conf()

    def do_startup(self) -> None:
        Adw.Application.do_startup(self)
        provider = Gtk.CssProvider()
        if hasattr(provider, "load_from_string"):  # GTK 4.12+
            provider.load_from_string(CSS)
        else:
            provider.load_from_data(CSS.encode())
        Gtk.StyleContext.add_provider_for_display(
            Gdk.Display.get_default(), provider, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION
        )

    def do_activate(self) -> None:
        if self.self_test:
            # Build every step, as CI does on Debian's real GTK and libadwaita.
            try:
                window = WelcomeWindow(self, self.conf, 0)
                pages = window.carousel.get_n_pages()
                for index in range(pages):
                    window.jump_to(index)
                print(f"{pages}/{len(window.builders)} steps built")
                self.result = 0 if pages == len(window.builders) else 1
                window.migrating = False
                window.destroy()
            except Exception as exc:  # noqa: BLE001 - report, then fail
                print(f"FAIL {exc!r}", file=sys.stderr)
                self.result = 1
            self.quit()
            return
        window = self.props.active_window or WelcomeWindow(self, self.conf, self.start_page)
        window.present()


def main(argv: list[str]) -> int:
    parser = argparse.ArgumentParser(description="Kulan OS Setup Assistant")
    parser.add_argument("--autostart", action="store_true", help="run only if this is the first login")
    parser.add_argument("--self-test", action="store_true", help="build every step, print a summary and quit")
    parser.add_argument("--page", type=int, default=0, help=argparse.SUPPRESS)
    args = parser.parse_args(argv[1:])

    if args.autostart and (DONE_FILE.exists() or is_live_session()):
        return 0
    if args.autostart:
        # Shown once: even if the session ends with the window still open.
        try:
            STATE_DIR.mkdir(parents=True, exist_ok=True)
            DONE_FILE.write_text("1\n")
        except OSError:
            pass
    app = WelcomeApp(args.page, args.self_test)
    code = app.run([argv[0]])
    return app.result or code


if __name__ == "__main__":
    sys.exit(main(sys.argv))
