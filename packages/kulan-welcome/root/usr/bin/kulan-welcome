def read_conf() -> dict[str, str]:
    conf = {"KULAN_NAME": "Kulan OS", "KULAN_HOME_URL": ""}
    try:
        for line in CONF_PATH.read_text().splitlines():
            line = line.strip()
            if not line or line.startswith("#") or "=" not in line:
                continue
            key, value = line.split("=", 1)
            parts = shlex.split(value)
            conf[key.strip()] = parts[0] if parts else ""
    except (OSError, ValueError):
        pass
    return conf


def is_live_session() -> bool:
    try:
        return "boot=live" in Path("/proc/cmdline").read_text().split()
    except OSError:
        return False


def settings(schema_id: str) -> Gio.Settings | None:
    source = Gio.SettingsSchemaSource.get_default()
    if source is None or source.lookup(schema_id, True) is None:
        return None
    return Gio.Settings.new(schema_id)


def interface_settings() -> Gio.Settings | None:
    return settings(INTERFACE_SCHEMA)


def has_key(gsettings: Gio.Settings | None, key: str) -> bool:
    return gsettings is not None and gsettings.props.settings_schema.has_key(key)


def run(cmd: list[str], timeout: int = 120) -> tuple[int, str, str]:
    try:
        proc = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout, check=False)
        return proc.returncode, proc.stdout, proc.stderr
    except (OSError, subprocess.TimeoutExpired) as exc:
        return 1, "", str(exc)


def run_async(cmd: list[str], done, timeout: int = 120) -> None:
    """Run cmd in a worker thread; call done(code, out, err) on the main loop."""

    def worker() -> None:
        result = run(cmd, timeout)
        # Default priority, not idle: an idle callback can wait indefinitely
        # behind a running animation such as the install spinner.
        GLib.idle_add(lambda: done(*result) and False, priority=GLib.PRIORITY_DEFAULT)

    threading.Thread(target=worker, daemon=True).start()


def desktop_app(desktop_id: str) -> Gio.DesktopAppInfo | None:
    try:
        return Gio.DesktopAppInfo.new(desktop_id)
    except TypeError:
        return None


# --- bringing files over -----------------------------------------------------------

def migration_plan(source: Path) -> list[tuple[Path, Path]]:
    """(from, to) pairs for a folder chosen on another drive.

    A home folder from a Mac, Windows or Linux computer is matched by its
    folder names (Documents, Pictures, Movies...); everything else in it
    (loose files, Projects, OneDrive...) goes to Documents/From <name>, so
    nothing is left behind. Any other folder is copied there as a whole."""
    documents = Path(GLib.get_user_special_dir(GLib.UserDirectory.DIRECTORY_DOCUMENTS) or Path.home())
    extra = documents / f"From {source.name or 'another computer'}"
    try:
        children = sorted(source.iterdir())
    except OSError:
        children = []
    pairs: list[tuple[Path, Path]] = []
    leftovers: list[Path] = []
    for child in children:
        if child.name.lower() in MIGRATE_SKIP or child.name.startswith(".") or child.is_symlink():
            continue
        special = MIGRATE_FOLDERS.get(child.name.lower()) if child.is_dir() else None
        target = GLib.get_user_special_dir(special) if special is not None else None
        if target:
            pairs.append((child, Path(target)))
        else:
            leftovers.append(child)
    if not pairs:
        return [(source, extra)]
    pairs += [(child, extra / child.name) for child in leftovers]
    return pairs


def migration_files(pairs: list[tuple[Path, Path]]) -> tuple[list[tuple[Path, Path, int]], int]:
    """Every (file, destination, size) to copy, and how many folders or files
    couldn't be read. Files already there are left alone."""
    files: list[tuple[Path, Path, int]] = []
    unreadable = 0

    def note_error(_error: OSError) -> None:
        nonlocal unreadable
        unreadable += 1

    def add(src: Path, dst: Path) -> None:
        nonlocal unreadable
        try:
            if src.is_symlink() or not src.is_file() or dst.exists():
                return
            files.append((src, dst, src.stat().st_size))
        except OSError:
            unreadable += 1

    for source, target in pairs:
        if source.is_file():
            add(source, target)
            continue
        for root, dirs, names in os.walk(source, onerror=note_error, followlinks=False):
            dirs[:] = [d for d in dirs if d.lower() not in MIGRATE_SKIP and not d.startswith(".")]
            for name in names:
                if name.lower() in MIGRATE_SKIP or name.startswith("._"):
                    continue
                src = Path(root) / name
                add(src, target / src.relative_to(source))
    return files, unreadable


def copy_file(src: Path, dst: Path) -> None:
    """Copy one file safely: into a temporary name first (so a full disk or a
    pulled drive never leaves a half file that looks complete), with normal
    file permissions (drives from Windows mark everything executable), and
    the original modification time."""
    dst.parent.mkdir(parents=True, exist_ok=True)
    part = dst.with_name(f".{dst.name}.kulan-part")
    try:
        shutil.copyfile(src, part)
        umask = os.umask(0)
        os.umask(umask)
        os.chmod(part, 0o666 & ~umask)
        stat = src.stat()
        os.utime(part, ns=(stat.st_atime_ns, stat.st_mtime_ns))
        os.replace(part, dst)
    except BaseException:
        part.unlink(missing_ok=True)
        raise


class WelcomeWindow(Adw.ApplicationWindow):
    def __init__(self, app: Adw.Application, conf: dict[str, str], start_page: int) -> None:
        super().__init__(application=app, title=f"Set up {conf['KULAN_NAME']}")
        self.conf = conf
        self.name = conf["KULAN_NAME"]
        self.settings = interface_settings()
        self.kulan = settings(KULAN_SCHEMA)
        self.live = is_live_session()
        self.app_checks: dict[str, Gtk.CheckButton] = {}
        self.app_rows: dict[str, Adw.ActionRow] = {}
        self.apps_loaded = False
        self.migrating = False
        self.set_default_size(800, 640)

        self.toasts = Adw.ToastOverlay()
        self.carousel = Adw.Carousel(hexpand=True, vexpand=True, allow_scroll_wheel=False, allow_mouse_drag=False)
        self.carousel.connect("page-changed", self.on_page_changed)
        self.builders = (
            self.build_welcome,
            self.build_appearance,
            self.build_accessibility,
            self.build_privacy,
            self.build_migration,
            self.build_backups,
            self.build_passwords,
            self.build_apps,
            self.build_security,
            self.build_done,
        )
        for builder in self.builders:
            self.carousel.append(builder())

        self.back = Gtk.Button(label="Back")
        self.back.connect("clicked", lambda _b: self.go(-1))
        self.next = Gtk.Button(label="Continue", css_classes=["suggested-action", "pill"])
        self.next.connect("clicked", self.on_next)
        dots = Adw.CarouselIndicatorDots(carousel=self.carousel, hexpand=True)

        footer = Gtk.CenterBox(margin_start=18, margin_end=18, margin_top=6, margin_bottom=14)
        footer.set_start_widget(self.back)
        footer.set_center_widget(dots)
        footer.set_end_widget(self.next)

        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        box.append(self.carousel)
        box.append(footer)
        self.toasts.set_child(box)

        view = Adw.ToolbarView()
        view.add_top_bar(Adw.HeaderBar(show_title=False))
        view.set_content(self.toasts)
        self.set_content(view)
        self.connect("close-request", self.on_close)

        if start_page:
            GLib.idle_add(self.jump_to, start_page)
        self.on_page_changed(self.carousel, 0)

    # --- navigation -----------------------------------------------------------
    def jump_to(self, index: int) -> bool:
        index = max(0, min(index, self.carousel.get_n_pages() - 1))
        self.carousel.scroll_to(self.carousel.get_nth_page(index), False)
        self.on_page_changed(self.carousel, index)
        return False

    def go(self, step: int) -> None:
        index = round(self.carousel.get_position()) + step
        if 0 <= index < self.carousel.get_n_pages():
            self.carousel.scroll_to(self.carousel.get_nth_page(index), True)

    def on_next(self, _button: Gtk.Button) -> None:
        if round(self.carousel.get_position()) >= self.carousel.get_n_pages() - 1:
            self.close()
        else:
            self.go(1)

    def on_page_changed(self, carousel: Adw.Carousel, index: int) -> None:
        last = index >= carousel.get_n_pages() - 1
        self.back.set_visible(index > 0)
        self.next.set_label("Start using " + self.name if last else ("Get Started" if index == 0 else "Continue"))
        if carousel.get_nth_page(index) is self.apps_page and not self.apps_loaded:
            self.apps_loaded = True
            self.load_app_availability()

    def on_close(self, _window: Gtk.Window) -> bool:
        if self.migrating:
            self.toast("Your files are still being copied. Wait until it finishes.")
            return True
        try:
            if self.startup_switch.get_active():
                DONE_FILE.unlink(missing_ok=True)
            else:
                STATE_DIR.mkdir(parents=True, exist_ok=True)
                DONE_FILE.write_text("1\n")
        except OSError:
            pass
        return False

    def toast(self, text: str) -> None:
        self.toasts.add_toast(Adw.Toast(title=GLib.markup_escape_text(text), timeout=4))

    @staticmethod
    def page(child: Gtk.Widget, width: int = 620) -> Gtk.Widget:
        clamp = Adw.Clamp(maximum_size=width, child=child, margin_start=24, margin_end=24)
        scroller = Gtk.ScrolledWindow(hscrollbar_policy=Gtk.PolicyType.NEVER, vexpand=True, hexpand=True)
        scroller.set_child(clamp)
        return scroller

    @staticmethod
    def heading(title: str, subtitle: str, icon: str | None = None) -> Gtk.Widget:
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6, margin_top=12, margin_bottom=18)
        if icon:
            box.append(Gtk.Image(icon_name=icon, pixel_size=48, css_classes=["step-icon"], margin_bottom=6))
        box.append(Gtk.Label(label=title, css_classes=["title-1"], wrap=True, justify=Gtk.Justification.CENTER))
        box.append(Gtk.Label(label=subtitle, css_classes=["dim-label"], wrap=True, justify=Gtk.Justification.CENTER))
        return box

    @staticmethod
    def link_row(title: str, subtitle: str, action) -> Adw.ActionRow:
        row = Adw.ActionRow(title=title, subtitle=subtitle, activatable=True)
        row.add_suffix(Gtk.Image(icon_name="go-next-symbolic"))
        row.connect("activated", lambda _r: action())
        return row

    def open_app(self, desktop_id: str, missing: str) -> None:
        info = desktop_app(desktop_id)
        if info is None:
            self.toast(missing)
            return
        try:
            info.launch([], None)
        except GLib.Error as exc:
            self.toast(f"Couldn't open it: {exc.message}")

    def open_settings(self, page: str) -> None:
        try:
            Gio.Subprocess.new(["kulan-settings", page], Gio.SubprocessFlags.NONE)
        except GLib.Error:
            self.toast("Kulan Settings isn't installed")

    # --- 1: hello -------------------------------------------------------------
    def build_welcome(self) -> Gtk.Widget:
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=14, valign=Gtk.Align.CENTER, vexpand=True)
        box.append(Gtk.Image(icon_name="kulan-logo", pixel_size=112))
        box.append(Gtk.Label(label="hello", css_classes=["kulan-hello"]))
        box.append(Gtk.Label(label=f"Welcome to {self.name}. Let's set things up the way you like.",
                             css_classes=["dim-label"], wrap=True, justify=Gtk.Justification.CENTER))
        box.append(Gtk.Label(label="Every step can be skipped and changed later in Kulan Settings.",
                             css_classes=["dim-label", "caption"], wrap=True, justify=Gtk.Justification.CENTER))
        return box

    # --- 2: look --------------------------------------------------------------
    def build_appearance(self) -> Gtk.Widget:
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=18)
        box.append(self.heading("Choose your look", "Change it any time in Kulan Settings > Appearance."))

        cards = Gtk.Box(spacing=14, halign=Gtk.Align.CENTER, homogeneous=True)
        current = self.current_style()
        light = self.theme_card("Light", [WALLPAPERS / "kulan-light.png"], "light", current == "light")
        dark = self.theme_card("Dark", [WALLPAPERS / "kulan-dark.png"], "dark", current == "dark")
        dark.set_group(light)
        cards.append(light)
        cards.append(dark)
        if has_key(self.kulan, "automatic-style"):
            auto = self.theme_card("Automatic", [WALLPAPERS / "kulan-light.png", WALLPAPERS / "kulan-dark.png"],
                                   "auto", current == "auto")
            auto.set_group(light)
            auto.set_tooltip_text("Light by day, dark after sunset")
            cards.append(auto)
        box.append(cards)

        if has_key(self.settings, "accent-color"):
            box.append(Gtk.Label(label="Accent colour", css_classes=["heading"], margin_top=6))
            swatches = Gtk.Box(spacing=10, halign=Gtk.Align.CENTER)
            current_accent = self.settings.get_string("accent-color")
            group: Gtk.ToggleButton | None = None
            for accent in ACCENTS:
                mark = Gtk.Image(icon_name="object-select-symbolic", visible=accent == current_accent)
                button = Gtk.ToggleButton(
                    child=mark,
                    active=accent == current_accent,
                    tooltip_text=accent.capitalize(),
                    css_classes=["accent-swatch", f"accent-{accent}"],
                )
                button.update_property([Gtk.AccessibleProperty.LABEL], [f"{accent.capitalize()} accent"])
                if group is None:
                    group = button
                else:
                    button.set_group(group)
                button.connect("toggled", self.on_accent, accent, mark)
                swatches.append(button)
            box.append(swatches)
        return self.page(box)

    def current_style(self) -> str:
        if self.kulan is not None and has_key(self.kulan, "automatic-style") and self.kulan.get_boolean(
                "automatic-style"):
            return "auto"
        if self.settings is not None and self.settings.get_string("color-scheme") == "default":
            return "light"
        return "dark"

    def theme_card(self, label: str, images: list[Path], style: str, active: bool) -> Gtk.ToggleButton:
        inner = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        pictures = Gtk.Box(homogeneous=True)
        for image in images:
            if image.exists():
                picture = Gtk.Picture.new_for_filename(str(image))
                picture.set_content_fit(Gtk.ContentFit.COVER)
                picture.set_size_request(180 // len(images), 112)
                pictures.append(picture)
        pictures.set_size_request(180, 112)
        pictures.set_overflow(Gtk.Overflow.HIDDEN)
        pictures.add_css_class("auto-card")
        inner.append(pictures)
        inner.append(Gtk.Label(label=label, css_classes=["heading"]))
        button = Gtk.ToggleButton(child=inner, active=active, css_classes=["theme-card"])
        button.connect("toggled", self.on_theme, style)
        return button

    def on_theme(self, button: Gtk.ToggleButton, style: str) -> None:
        if not button.get_active():
            return
        if self.kulan is not None and has_key(self.kulan, "automatic-style"):
            self.kulan.set_boolean("automatic-style", style == "auto")
        if style != "auto" and self.settings is not None:
            self.settings.set_string("color-scheme", "prefer-dark" if style == "dark" else "default")

    def on_accent(self, button: Gtk.ToggleButton, accent: str, mark: Gtk.Image) -> None:
        mark.set_visible(button.get_active())
        if button.get_active() and self.settings is not None:
            self.settings.set_string("accent-color", accent)

    # --- 3: accessibility -----------------------------------------------------
    def build_accessibility(self) -> Gtk.Widget:
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=18)
        box.append(self.heading("Accessibility", "Make the screen easier to see, hear and use.",
                                "preferences-desktop-accessibility-symbolic"))
        group = Adw.PreferencesGroup()
        a11y = settings("org.gnome.desktop.a11y.interface")
        apps = settings("org.gnome.desktop.a11y.applications")
        rows = []
        if has_key(self.settings, "text-scaling-factor"):
            larger = Adw.SwitchRow(title="Larger text", subtitle="Text in every app is a quarter bigger",
                                   active=self.settings.get_double("text-scaling-factor") > 1.0)
            larger.connect("notify::active", lambda r, _p: self.settings.set_double(
                "text-scaling-factor", 1.25 if r.get_active() else 1.0))
            rows.append(larger)
        if has_key(a11y, "high-contrast"):
            contrast = Adw.SwitchRow(title="High contrast", subtitle="Stronger outlines and colours")
            a11y.bind("high-contrast", contrast, "active", Gio.SettingsBindFlags.DEFAULT)
            rows.append(contrast)
        if has_key(self.settings, "enable-animations"):
            motion = Adw.SwitchRow(title="Reduce motion", subtitle="Windows and menus appear without animation")
            self.settings.bind("enable-animations", motion, "active",
                               Gio.SettingsBindFlags.DEFAULT | Gio.SettingsBindFlags.INVERT_BOOLEAN)
            rows.append(motion)
        if has_key(apps, "screen-reader-enabled"):
            reader = Adw.SwitchRow(title="Screen reader", subtitle="Reads the screen aloud (Super+Alt+S)")
            apps.bind("screen-reader-enabled", reader, "active", Gio.SettingsBindFlags.DEFAULT)
            rows.append(reader)
        if has_key(apps, "screen-magnifier-enabled"):
            zoom = Adw.SwitchRow(title="Zoom", subtitle="Magnify part of the screen (Super+Alt+8)")
            apps.bind("screen-magnifier-enabled", zoom, "active", Gio.SettingsBindFlags.DEFAULT)
            rows.append(zoom)
        for row in rows:
            group.add(row)
        group.add(self.link_row("More accessibility options", "Typing, pointing, sound and more",
                                lambda: self.open_gnome("universal-access")))
        box.append(group)
        return self.page(box)

    def open_gnome(self, panel: str) -> None:
        try:
            Gio.Subprocess.new(["gnome-control-center", panel], Gio.SubprocessFlags.NONE)
        except GLib.Error:
            self.toast("Settings isn't installed")

    # --- 4: privacy -------------------------------------------------------------
    def build_privacy(self) -> Gtk.Widget:
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=18)
        box.append(self.heading("Your privacy", f"{self.name} sends no usage data, crash reports or "
                                "advertising IDs. These choices keep more of you private.",
                                "preferences-system-privacy-symbolic"))
        group = Adw.PreferencesGroup()
        location = settings("org.gnome.system.location")
        if has_key(location, "enabled"):
            loc = Adw.SwitchRow(title="Location services", subtitle="Lets apps such as Maps and Weather find "
                                "where you are. Off by default")
            location.bind("enabled", loc, "active", Gio.SettingsBindFlags.DEFAULT)
            group.add(loc)

        self.name_row = Adw.ActionRow(title="Computer name",
                                      subtitle=GLib.markup_escape_text(
                                          f"“{GLib.get_host_name()}”: other devices on your network can see it"))
        private = Gtk.Button(label="Make private", valign=Gtk.Align.CENTER)
        private.connect("clicked", self.on_private_name)
        private.set_sensitive(not self.live and Path(UPDATE_HELPER).exists())
        self.name_row.add_suffix(private)
        group.add(self.name_row)

        self.dns_row = Adw.ActionRow(title="Block ads and trackers everywhere",
                                     subtitle="Name lookups that block ads in every app and browser, encrypted "
                                              "whenever the network allows (Mullvad's free DNS)")
        dns = Gtk.Button(label="Turn on", valign=Gtk.Align.CENTER)
        dns.connect("clicked", self.on_adblock_dns)
        dns.set_sensitive(not self.live and Path(UPDATE_HELPER).exists())
        self.dns_row.add_suffix(dns)
        group.add(self.dns_row)
        box.append(group)

        more = Adw.PreferencesGroup()
        more.add(self.link_row("All privacy settings", "Camera, microphone, history and what Kulan OS connects to",
                               lambda: self.open_settings("privacy")))
        box.append(more)
        return self.page(box)

    def helper(self, args: list[str], done) -> None:
        run_async(["pkexec", UPDATE_HELPER, *args], done, timeout=600)

    def on_private_name(self, button: Gtk.Button) -> None:
        name = f"kulan-{secrets.token_hex(3)}"
        button.set_sensitive(False)

        def done(code: int, _out: str, err: str) -> bool:
            if code == 0:
                button.set_label("Done")
                self.name_row.set_subtitle(GLib.markup_escape_text(f"Now “{name}”"))
            else:
                button.set_sensitive(True)
                self.toast("Cancelled" if code in (126, 127) else
                           f"Couldn't rename: {(err.strip().splitlines() or ['unknown error'])[-1][:120]}")
            return False

        self.helper(["set-hostname", name], done)

    def on_adblock_dns(self, button: Gtk.Button) -> None:
        button.set_sensitive(False)
        button.set_label("Turning on…")

        def done(code: int, _out: str, err: str) -> bool:
            if code == 0:
                button.set_label("On")
            else:
                button.set_sensitive(True)
                button.set_label("Turn on")
                self.toast("Cancelled" if code in (126, 127) else
                           f"Couldn't turn it on: {(err.strip().splitlines() or ['unknown error'])[-1][:120]}")
            return False

        self.helper(["dns", "adblock"], done)

    # --- 5: bring your files ------------------------------------------------------
    def build_migration(self) -> Gtk.Widget:
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=18)
        box.append(self.heading("Bring your files", "Copy documents, photos, music and videos from another "
                                "computer: plug in a drive with them, or a backup, then choose the folder.",
                                "folder-download-symbolic"))
        group = Adw.PreferencesGroup(description="Mac, Windows and Linux folders are recognised: Documents go to "
                                     "Documents, Movies to Videos, and so on; anything else goes to a folder in "
                                     "Documents. Nothing on the drive is changed, and files you already have here "
                                     "are kept.")
        self.migrate_row = Adw.ActionRow(title="Choose a folder", subtitle="Your old home folder, or any folder")
        self.migrate_button = Gtk.Button(label="Choose…", valign=Gtk.Align.CENTER, css_classes=["suggested-action"])
        self.migrate_button.connect("clicked", self.on_choose_migration)
        self.migrate_button.set_sensitive(not self.live)
        self.migrate_row.add_suffix(self.migrate_button)
        group.add(self.migrate_row)
        box.append(group)
        self.migrate_progress = Gtk.ProgressBar(show_text=True, visible=False)
        box.append(self.migrate_progress)
        if self.live:
            box.append(Gtk.Label(label=f"Available after you install {self.name}.", css_classes=["dim-label"]))
        return self.page(box)

    def on_choose_migration(self, _button: Gtk.Button) -> None:
        dialog = Gtk.FileDialog(title="Choose the folder to bring over")
        media = Path("/media") / GLib.get_user_name()
        if media.is_dir():
            dialog.set_initial_folder(Gio.File.new_for_path(str(media)))

        def chosen(d, result) -> None:
            try:
                folder = d.select_folder_finish(result)
            except GLib.Error:
                return  # cancelled
            if folder is not None and folder.get_path():
                self.start_migration(Path(folder.get_path()))

        dialog.select_folder(self, None, chosen)

    def start_migration(self, source: Path) -> None:
        home = Path.home().resolve()
        chosen = source.resolve()
        # Never this computer's own files: home itself, a folder inside it,
        # or a folder that contains it (such as /home or /).
        if chosen == home or home in chosen.parents or chosen in home.parents:
            self.toast("That folder holds this computer's own files. Choose a folder on the drive or backup.")
            return
        if chosen == Path("/media") / GLib.get_user_name() or chosen.parent == Path("/media"):
            self.toast("Open the drive first, then choose the folder on it.")
            return
        self.migrating = True
        self.migrate_button.set_sensitive(False)
        self.migrate_row.set_subtitle(GLib.markup_escape_text(f"Looking through “{source.name or source}”…"))
        self.migrate_progress.set_visible(True)
        self.migrate_progress.set_fraction(0)
        self.migrate_progress.set_text("Counting files…")
        threading.Thread(target=self.migrate_worker, args=(source,), daemon=True).start()

    def migrate_worker(self, source: Path) -> None:
        copied = failed = 0
        targets: list[str] = []
        problem = ""
        try:
            pairs = migration_plan(source)
            home = Path.home()
            targets = sorted({t.relative_to(home).parts[0] for _, t in pairs if t.is_relative_to(home)})
            files, failed = migration_files(pairs)
            total = sum(size for _, _, size in files)
            free = shutil.disk_usage(Path.home()).free
            if total > free - 512 * 1024 ** 2:  # keep half a gigabyte spare
                problem = (f"There isn't enough space: it needs {GLib.format_size(total)}, "
                           f"and {GLib.format_size(max(free, 0))} is free here.")
                return
            done_bytes = 0
            last = 0.0
            for src, dst, size in files:
                try:
                    copy_file(src, dst)
                    copied += 1
                except OSError:
                    failed += 1
                done_bytes += size
                now = GLib.get_monotonic_time() / 1e6
                if now - last > 0.2:
                    last = now
                    GLib.idle_add(self.migrate_tick, done_bytes / (total or 1), copied, len(files))
        except Exception as exc:  # noqa: BLE001 - report it, never leave the window stuck
            problem = f"Copying stopped: {exc}"
        finally:
            GLib.idle_add(self.migrate_done, copied, failed, targets, problem)

    def migrate_tick(self, fraction: float, copied: int, count: int) -> bool:
        self.migrate_progress.set_fraction(min(fraction, 1.0))
        self.migrate_progress.set_text(f"Copied {copied} of {count} files")
        return False

    def migrate_done(self, copied: int, failed: int, targets: list[str], problem: str) -> bool:
        self.migrating = False
        self.migrate_button.set_sensitive(True)
        self.migrate_button.set_label("Choose another…")
        if problem:
            self.migrate_progress.set_visible(False)
            self.migrate_row.set_subtitle(GLib.markup_escape_text(problem))
            return False
        self.migrate_progress.set_fraction(1.0)
        where = ", ".join(targets) or "your folders"
        note = f"; {failed} couldn't be read" if failed else ""
        if copied == 0:
            self.migrate_progress.set_text("Nothing new to copy")
            self.migrate_row.set_subtitle(GLib.markup_escape_text(
                f"Everything there is already on this computer{note}"))
        else:
            self.migrate_progress.set_text(f"Copied {copied} file{'s' if copied != 1 else ''}")
            self.migrate_row.set_subtitle(GLib.markup_escape_text(f"Copied into {where}{note}"))
        return False

    # --- 6: backups ---------------------------------------------------------------
    def build_backups(self) -> Gtk.Widget:
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=18)
        box.append(self.heading("Back up your files", "Keep a copy of your files on a drive or in Google Drive "
                                "or OneDrive, so nothing is lost if this computer is.",
                                "drive-harddisk-symbolic"))
        group = Adw.PreferencesGroup()
        backups = Adw.ActionRow(title="File backups",
                                subtitle="Backups (Déjà Dup): automatic, encrypted, and easy to restore")
        button = Gtk.Button(label="Set up", valign=Gtk.Align.CENTER, css_classes=["suggested-action"])
        button.connect("clicked", lambda _b: self.open_app("org.gnome.DejaDup.desktop",
                                                           "Backups isn't installed. Get Déjà Dup in Software."))
        button.set_sensitive(not self.live)
        backups.add_suffix(button)
        group.add(backups)
        if self.live:
            restore = Adw.ActionRow(title="Restore points", subtitle="Set up automatically after you install")
        elif RESTORE_CONFIG.exists():
