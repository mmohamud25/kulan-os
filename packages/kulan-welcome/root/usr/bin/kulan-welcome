def read_conf() -> dict[str, str]:
    conf = {"KULAN_NAME": "Kulan OS", "KULAN_HOME_URL": ""}
    try:
        for line in CONF_PATH.read_text().splitlines():
            line = line.strip()
            if not line or line.startswith("#") or "=" not in line:
                continue
            key, value = line.split("=", 1)
            parts = shlex.split(value)
            conf[key.strip()] = parts[0] if parts else ""
    except (OSError, ValueError):
        pass
    return conf


def is_live_session() -> bool:
    try:
        return "boot=live" in Path("/proc/cmdline").read_text().split()
    except OSError:
        return False


def settings(schema_id: str) -> Gio.Settings | None:
    source = Gio.SettingsSchemaSource.get_default()
    if source is None or source.lookup(schema_id, True) is None:
        return None
    return Gio.Settings.new(schema_id)


def interface_settings() -> Gio.Settings | None:
    return settings(INTERFACE_SCHEMA)


def has_key(gsettings: Gio.Settings | None, key: str) -> bool:
    return gsettings is not None and gsettings.props.settings_schema.has_key(key)


def run(cmd: list[str], timeout: int = 120) -> tuple[int, str, str]:
    try:
        proc = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout, check=False)
        return proc.returncode, proc.stdout, proc.stderr
    except (OSError, subprocess.TimeoutExpired) as exc:
        return 1, "", str(exc)


def run_async(cmd: list[str], done, timeout: int = 120) -> None:
    """Run cmd in a worker thread; call done(code, out, err) on the main loop."""

    def worker() -> None:
        result = run(cmd, timeout)
        # Default priority, not idle: an idle callback can wait indefinitely
        # behind a running animation such as the install spinner.
        GLib.idle_add(lambda: done(*result) and False, priority=GLib.PRIORITY_DEFAULT)

    threading.Thread(target=worker, daemon=True).start()


def helper_failure(code: int, out: str, err: str, fallback: str) -> str:
    """What to say when a change didn't work: Cancelled, update-run's own words
    for people (its "say:" lines), or a plain fallback. Never a program's output."""
    if code in (126, 127):
        return "Cancelled"
    said = [line[4:].strip() for line in out.splitlines() if line.startswith("say:") and line[4:].strip()]
    if said:
        return said[-1].rstrip(".")
    if err.strip():
        print(f"kulan-welcome: {err.strip().splitlines()[-1]}", file=sys.stderr)
    return fallback


def is_administrator() -> bool:
    """Whether this account can approve changes to the whole computer itself."""
    try:
        admin_gid = grp.getgrnam("sudo").gr_gid
    except KeyError:
        return True  # can't tell: don't hide anything
    return admin_gid in os.getgroups() or os.getgid() == admin_gid


def online(monitor: Gio.NetworkMonitor | None = None) -> bool:
    """Connected to the internet (a network that reaches it, not only a captive Wi-Fi sign-in page)."""
    monitor = monitor or Gio.NetworkMonitor.get_default()
    return monitor.get_network_available() and monitor.get_connectivity() == Gio.NetworkConnectivity.FULL


def unavailable_text(count: int) -> str:
    return (f"{count} of these isn’t available for this computer yet." if count == 1 else
            f"{count} of these aren’t available for this computer yet.")


def desktop_app(desktop_id: str) -> Gio.DesktopAppInfo | None:
    try:
        return Gio.DesktopAppInfo.new(desktop_id)
    except TypeError:
        return None


# --- bringing files over -----------------------------------------------------------

def migration_plan(source: Path) -> list[tuple[Path, Path]]:
    """(from, to) pairs for a folder chosen on another drive.

    A home folder from a Mac, Windows or Linux computer is matched by its
    folder names (Documents, Pictures, Movies...); everything else in it
    (loose files, Projects, OneDrive...) goes to Documents/From <name>, so
    nothing is left behind. Any other folder is copied there as a whole."""
    documents = Path(GLib.get_user_special_dir(GLib.UserDirectory.DIRECTORY_DOCUMENTS) or Path.home())
    extra = documents / f"From {source.name or 'another computer'}"
    try:
        children = sorted(source.iterdir())
    except OSError:
        children = []
    pairs: list[tuple[Path, Path]] = []
    leftovers: list[Path] = []
    for child in children:
        if child.name.lower() in MIGRATE_SKIP or child.name.startswith(".") or child.is_symlink():
            continue
        special = MIGRATE_FOLDERS.get(child.name.lower()) if child.is_dir() else None
        target = GLib.get_user_special_dir(special) if special is not None else None
        if target:
            pairs.append((child, Path(target)))
        else:
            leftovers.append(child)
    if not pairs:
        return [(source, extra)]
    pairs += [(child, extra / child.name) for child in leftovers]
    return pairs


def migration_files(pairs: list[tuple[Path, Path]]) -> tuple[list[tuple[Path, Path, int]], int]:
    """Every (file, destination, size) to copy, and how many folders or files
    couldn't be read. Files already there are left alone."""
    files: list[tuple[Path, Path, int]] = []
    unreadable = 0

    def note_error(_error: OSError) -> None:
        nonlocal unreadable
        unreadable += 1

    def add(src: Path, dst: Path) -> None:
        nonlocal unreadable
        try:
            if src.is_symlink() or not src.is_file() or dst.exists():
                return
            files.append((src, dst, src.stat().st_size))
        except OSError:
            unreadable += 1

    for source, target in pairs:
        if source.is_file():
            add(source, target)
            continue
        for root, dirs, names in os.walk(source, onerror=note_error, followlinks=False):
            dirs[:] = [d for d in dirs if d.lower() not in MIGRATE_SKIP and not d.startswith(".")]
            for name in names:
                if name.lower() in MIGRATE_SKIP or name.startswith("._"):
                    continue
                src = Path(root) / name
                add(src, target / src.relative_to(source))
    return files, unreadable


def copy_file(src: Path, dst: Path) -> None:
    """Copy one file safely: into a temporary name first (so a full disk or a
    pulled drive never leaves a half file that looks complete), with normal
    file permissions (drives from Windows mark everything executable), and
    the original modification time."""
    dst.parent.mkdir(parents=True, exist_ok=True)
    part = dst.with_name(f".{dst.name}.kulan-part")
    try:
        shutil.copyfile(src, part)
        umask = os.umask(0)
        os.umask(umask)
        os.chmod(part, 0o666 & ~umask)
        stat = src.stat()
        os.utime(part, ns=(stat.st_atime_ns, stat.st_mtime_ns))
        os.replace(part, dst)
    except BaseException:
        part.unlink(missing_ok=True)
        raise


class WelcomeWindow(Adw.ApplicationWindow):
    def __init__(self, app: Adw.Application, conf: dict[str, str], start_page: int, autostart: bool = False,
                 every_step: bool = False) -> None:
        """every_step: build the steps that only some computers need too (the self-test)."""
        super().__init__(application=app, title=f"Set up {conf['KULAN_NAME']}")
        self.conf = conf
        self.name = conf["KULAN_NAME"]
        self.settings = interface_settings()
        self.kulan = settings(KULAN_SCHEMA)
        self.live = is_live_session()
        self.autostart = autostart
        self.admin = is_administrator()
        self.app_checks: dict[str, Gtk.CheckButton] = {}
        self.app_rows: dict[str, Adw.ActionRow] = {}
        self.apps_loaded = False
        self.apps_waiting_online = False  # the app list couldn't load offline: load it once online
        self.migrating = False
        self.installing = False
        self.downloading = False
        self.finished = False
        self.network_page: Gtk.Widget | None = None
        self.monitor = Gio.NetworkMonitor.get_default()
        self.set_default_size(800, 640)

        self.toasts = Adw.ToastOverlay()
        self.carousel = Adw.Carousel(hexpand=True, vexpand=True, allow_scroll_wheel=False, allow_mouse_drag=False)
        self.carousel.connect("page-changed", self.on_page_changed)
        builders = [self.build_welcome]
        if every_step or (not online(self.monitor) and not self.live):
            builders.append(self.build_network)
        builders += [self.build_appearance, self.build_accessibility, self.build_privacy, self.build_migration,
                     self.build_backups, self.build_passwords, self.build_apps]
        if every_step or (not self.live and self.assistant_needs_model()):
            builders.append(self.build_assistant)
        builders += [self.build_security, self.build_done]
        self.builders = tuple(builders)
        for builder in self.builders:
            self.carousel.append(builder())
        # Online or not, as it changes: the Wi-Fi step, the apps list and the model download follow it.
        self.monitor_handler = self.monitor.connect("network-changed", lambda *_a: self.on_network_changed())

        self.back = Gtk.Button(label="Back")
        self.back.connect("clicked", lambda _b: self.go(-1))
        self.next = Gtk.Button(label="Continue", css_classes=["suggested-action", "pill"])
        self.next.connect("clicked", self.on_next)
        dots = Adw.CarouselIndicatorDots(carousel=self.carousel, hexpand=True)

        footer = Gtk.CenterBox(margin_start=18, margin_end=18, margin_top=6, margin_bottom=14)
        footer.set_start_widget(self.back)
        footer.set_center_widget(dots)
        footer.set_end_widget(self.next)

        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        box.append(self.carousel)
        box.append(footer)
        self.toasts.set_child(box)

        view = Adw.ToolbarView()
        view.add_top_bar(Adw.HeaderBar(show_title=False))
        view.set_content(self.toasts)
        self.set_content(view)
        self.connect("close-request", self.on_close)
        self.connect("destroy", lambda _w: self.monitor.disconnect(self.monitor_handler)
                     if self.monitor.handler_is_connected(self.monitor_handler) else None)

        if start_page:
            GLib.idle_add(self.jump_to, start_page)
        self.on_page_changed(self.carousel, 0)

    # --- navigation -----------------------------------------------------------
    def jump_to(self, index: int) -> bool:
        index = max(0, min(index, self.carousel.get_n_pages() - 1))
        self.carousel.scroll_to(self.carousel.get_nth_page(index), False)
        self.on_page_changed(self.carousel, index)
        return False

    def go(self, step: int) -> None:
        index = round(self.carousel.get_position()) + step
        if 0 <= index < self.carousel.get_n_pages():
            self.carousel.scroll_to(self.carousel.get_nth_page(index), True)

    def on_next(self, _button: Gtk.Button) -> None:
        if round(self.carousel.get_position()) >= self.carousel.get_n_pages() - 1:
            self.finished = True
            self.close()
        else:
            self.go(1)

    def on_page_changed(self, carousel: Adw.Carousel, index: int) -> None:
        last = index >= carousel.get_n_pages() - 1
        self.back.set_visible(index > 0)
        self.next.set_label("Start using " + self.name if last else ("Get Started" if index == 0 else "Continue"))
        if carousel.get_nth_page(index) is self.apps_page and not self.apps_loaded:
            self.apps_loaded = True
            self.load_app_availability()

    def on_close(self, _window: Gtk.Window) -> bool:
        if self.migrating:
            self.toast("Your files are still being copied.")
            return True
        if self.installing:
            self.jump_to(self.page_index(self.apps_page))
            self.toast("Your apps are still being installed. Setup can close when they’re done.")
            return True
        if self.downloading:
            self.jump_to(self.page_index(getattr(self, "assistant_page", None)))
            self.toast("Ask Kulan’s model is still downloading. Setup can close when it’s done.")
            return True
        if self.finished or self.startup_switch.get_active() != self.startup_initial:
            # Finished (or the switch was changed): done, unless it should show at every start.
            self.mark_done(not self.startup_switch.get_active())
        # Closed early: not done. It opens once more at the next sign-in (main()).
        return False

    @staticmethod
    def mark_done(done: bool) -> None:
        try:
            STATE_DIR.mkdir(parents=True, exist_ok=True)
            if done:
                DONE_FILE.write_text("1\n")
            else:
                DONE_FILE.unlink(missing_ok=True)
            REMINDED_FILE.unlink(missing_ok=True)
        except OSError:
            pass

    def page_index(self, page: Gtk.Widget | None) -> int:
        for index in range(self.carousel.get_n_pages()):
            if self.carousel.get_nth_page(index) is page:
                return index
        return round(self.carousel.get_position())

    def toast(self, text: str) -> None:
        self.toasts.add_toast(Adw.Toast(title=GLib.markup_escape_text(text), timeout=4))

    @staticmethod
    def page(child: Gtk.Widget, width: int = 620) -> Gtk.Widget:
        clamp = Adw.Clamp(maximum_size=width, child=child, margin_start=24, margin_end=24)
        scroller = Gtk.ScrolledWindow(hscrollbar_policy=Gtk.PolicyType.NEVER, vexpand=True, hexpand=True)
        scroller.set_child(clamp)
        return scroller

    @staticmethod
    def heading(title: str, subtitle: str, icon: str | None = None) -> Gtk.Widget:
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6, margin_top=12, margin_bottom=18)
        if icon:
            box.append(Gtk.Image(icon_name=icon, pixel_size=48, css_classes=["step-icon"], margin_bottom=6))
        box.append(Gtk.Label(label=title, css_classes=["title-1"], wrap=True, justify=Gtk.Justification.CENTER))
        box.append(Gtk.Label(label=subtitle, css_classes=["dim-label"], wrap=True, justify=Gtk.Justification.CENTER))
        return box

    @staticmethod
    def link_row(title: str, subtitle: str, action) -> Adw.ActionRow:
        row = Adw.ActionRow(title=title, subtitle=subtitle, activatable=True)
        row.add_suffix(Gtk.Image(icon_name="go-next-symbolic"))
        row.connect("activated", lambda _r: action())
        return row

    def open_app(self, desktop_id: str, missing: str) -> None:
        info = desktop_app(desktop_id)
        if info is None:
            self.toast(missing)
            return
        try:
            info.launch([], None)
        except GLib.Error as exc:
            print(f"kulan-welcome: {desktop_id}: {exc.message}", file=sys.stderr)
            self.toast("Couldn’t open it. Try again")

    def open_settings(self, page: str) -> None:
        try:
            Gio.Subprocess.new(["kulan-settings", page], Gio.SubprocessFlags.NONE)
        except GLib.Error:
            self.toast("Kulan Settings isn't installed")

    # --- 1: hello -------------------------------------------------------------
    def build_welcome(self) -> Gtk.Widget:
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=14, valign=Gtk.Align.CENTER, vexpand=True)
        box.append(Gtk.Image(icon_name="kulan-logo", pixel_size=112))
        box.append(Gtk.Label(label="hello", css_classes=["kulan-hello"]))
        box.append(Gtk.Label(label=f"Welcome to {self.name}. Let's get you set up.",
                             css_classes=["dim-label"], wrap=True, justify=Gtk.Justification.CENTER))
        box.append(Gtk.Label(label="You can skip any step and change it later in Kulan Settings.",
                             css_classes=["dim-label", "caption"], wrap=True, justify=Gtk.Justification.CENTER))
        return box

    # --- 2: get online (only when not connected) -----------------------------------------
    def build_network(self) -> Gtk.Widget:
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=18)
        box.append(self.heading("Get online", "Connect to Wi-Fi to add apps and get updates. You can skip this "
                                "and connect later from the top bar.", "network-wireless-symbolic"))
        status = Adw.PreferencesGroup()
        self.net_status = Adw.ActionRow(title="Not connected", subtitle_lines=0)
        self.net_status_icon = Gtk.Image(icon_name="network-wireless-offline-symbolic")
        self.net_status.add_prefix(self.net_status_icon)
        self.net_turn_on = Gtk.Button(label="Turn on Wi-Fi", valign=Gtk.Align.CENTER, visible=False,
                                      css_classes=["suggested-action"])
        self.net_turn_on.connect("clicked", lambda _b: self.wifi_on())
        self.net_status.add_suffix(self.net_turn_on)
        status.add(self.net_status)
        box.append(status)

        self.wifi_group = Adw.PreferencesGroup(title="Wi-Fi networks", visible=False)
        scan = Gtk.Button(icon_name="view-refresh-symbolic", valign=Gtk.Align.CENTER, css_classes=["flat"],
                          tooltip_text="Look for networks")
        scan.update_property([Gtk.AccessibleProperty.LABEL], ["Look for networks"])
        scan.connect("clicked", lambda _b: self.wifi_scan())
        self.wifi_group.set_header_suffix(scan)
        box.append(self.wifi_group)
        self.wifi_rows: list[Gtk.Widget] = []

        more = Adw.PreferencesGroup()
        more.add(self.link_row("More ways to connect", "Work or school Wi-Fi, a hidden network, a cable or a VPN, "
                               "in Kulan Settings › Wi-Fi and network", lambda: self.open_settings("wifi")))
        box.append(more)
        box.append(Gtk.Box(margin_bottom=12))

        self.nm = None
        self.nm_refresh = 0
        self.nm_watches: list[tuple] = []
        self.joining: dict | None = None  # {"uuid", "new", "ssid"}: a network being joined from here
        if NM is not None and ks_wifi is not None and not self.live:
            NM.Client.new_async(None, self.got_nm)
        self.network_page = self.page(box)
        self.show_online()
        return self.network_page

    def got_nm(self, _source, result) -> None:
        try:
            client = NM.Client.new_finish(result)
        except GLib.Error as exc:
            print(f"kulan-welcome: NetworkManager: {exc.message}", file=sys.stderr)
            return
        if not client.get_nm_running():
            return
        self.nm = client
        for signal in ("notify::wireless-enabled", "notify::primary-connection", "active-connection-added",
                       "active-connection-removed", "connection-added", "connection-removed"):
            client.connect(signal, lambda *_a: self.queue_wifi())
        client.connect("device-added", lambda *_a: self.watch_wifi_device())
        self.watch_wifi_device()
        self.wifi_scan()

    def wifi_device(self):
        for device in self.nm.get_devices() if self.nm is not None else []:
            if isinstance(device, NM.DeviceWifi) and device.get_managed():
                return device
        return None

    def watch_wifi_device(self) -> None:
        for obj, handler in self.nm_watches:
            if obj.handler_is_connected(handler):
                obj.disconnect(handler)
        self.nm_watches = []
        device = self.wifi_device()
        if device is not None:
            for signal in ("access-point-added", "access-point-removed", "notify::active-access-point"):
                self.nm_watches.append((device, device.connect(signal, lambda *_a: self.queue_wifi())))
            self.nm_watches.append((device, device.connect("state-changed", self.on_wifi_state)))
        self.queue_wifi()

    def wifi_scan(self) -> None:
        device = self.wifi_device()
        if device is not None and self.nm.wireless_get_enabled():
            device.request_scan_async(None, lambda d, r: self.quietly(d.request_scan_finish, r))

    @staticmethod
    def quietly(finish, result) -> None:
        try:
            finish(result)
        except GLib.Error:
            pass  # scanning too often, or Wi-Fi off: the list still updates

    def wifi_on(self) -> None:
        if self.nm is not None:
            self.nm.dbus_set_property("/org/freedesktop/NetworkManager", "org.freedesktop.NetworkManager",
                                      "WirelessEnabled", GLib.Variant("b", True), -1, None,
                                      lambda c, r, _d: self.quietly(c.dbus_set_property_finish, r), None)

    def queue_wifi(self) -> None:
        if not self.nm_refresh:
            self.nm_refresh = GLib.timeout_add(300, self.fill_wifi)

    def fill_wifi(self) -> bool:
        self.nm_refresh = 0
        for row in self.wifi_rows:
            self.wifi_group.remove(row)
        self.wifi_rows = []
        device = self.wifi_device()
        enabled = self.nm is not None and self.nm.wireless_get_enabled()
        self.net_turn_on.set_visible(device is not None and not enabled
                                     and self.nm.wireless_hardware_get_enabled())
        self.wifi_group.set_visible(device is not None and enabled)
        if device is not None and enabled:
            active = device.get_active_access_point()
            points = [{"ap": ap, "ssid": ks_wifi.ssid_text(ap.get_ssid()), "strength": ap.get_strength(),
                       "security": ks_wifi.security_kind(ap.get_flags(), ap.get_wpa_flags(), ap.get_rsn_flags()),
                       "active": active is not None and ap.get_path() == active.get_path()}
                      for ap in device.get_access_points()]
            nets = ks_wifi.strongest_per_network(points)[:12]
            if not nets:
                row = Adw.ActionRow(title="Looking for networks…")
                self.wifi_group.add(row)
                self.wifi_rows.append(row)
            for net in nets:
                row = self.wifi_row(device, net)
                self.wifi_group.add(row)
                self.wifi_rows.append(row)
        self.show_online()
        return GLib.SOURCE_REMOVE

    def saved_wifi(self, device, ssid: str):
        # Kulan Settings' own check (not NMDevice.filter_connections, which crashed, 2.11).
        find = getattr(ks_wifi, "saved_for", None)  # (an older Kulan Settings: none found, nothing crashes)
        return find(device, self.nm.get_connections(), ssid) if find else None

    def wifi_row(self, device, net: dict) -> Adw.ActionRow:
        saved = self.saved_wifi(device, net["ssid"])
        row = Adw.ActionRow(title=GLib.markup_escape_text(net["ssid"]), activatable=not net["active"],
                            subtitle="Connected" if net["active"] else "Saved" if saved is not None else "")
        row.add_prefix(Gtk.Image(icon_name=ks_wifi.signal_icon(net["strength"])))
        if net["security"] != "open":
            row.add_suffix(Gtk.Image(icon_name="channel-secure-symbolic", tooltip_text="Needs a password"))
        if net["active"]:
            row.add_suffix(Gtk.Image(icon_name="object-select-symbolic", css_classes=["success"]))
        else:
            row.connect("activated", lambda _r: self.join_wifi(device, net))
        return row

    def join_wifi(self, device, net: dict) -> None:
        saved = self.saved_wifi(device, net["ssid"])
        if saved is not None:
            self.joining = {"uuid": saved.get_uuid(), "new": False, "ssid": net["ssid"]}
            self.nm.activate_connection_async(saved, device, net["ap"].get_path(), None, self.joined)
        elif net["security"] in ("enterprise", "wep"):
            self.toast("This network needs more than a password. Join it in Kulan Settings › Wi-Fi and network")
            self.open_settings("wifi")
        elif net["security"] == "open":
            self.add_wifi(device, net, None)
        else:
            self.ask_wifi_password(net["ssid"], lambda password: self.add_wifi(device, net, password))

    def ask_wifi_password(self, ssid: str, then, why: str = "") -> None:
        dialog = Adw.AlertDialog(heading=f"Join “{ssid}”", body=(why + " " if why else "")
                                 + "Enter the network’s password.")
        entry = Gtk.PasswordEntry(show_peek_icon=True, activates_default=True)
        entry.update_property([Gtk.AccessibleProperty.LABEL], ["Wi-Fi password"])
        dialog.set_extra_child(entry)
        dialog.add_response("cancel", "Cancel")
        dialog.add_response("join", "Join")
        dialog.set_response_appearance("join", Adw.ResponseAppearance.SUGGESTED)
        dialog.set_default_response("join")
        dialog.set_close_response("cancel")
        dialog.set_response_enabled("join", False)
        entry.connect("changed", lambda e: dialog.set_response_enabled("join", 8 <= len(e.get_text()) <= 63))
        dialog.connect("response", lambda _d, answer: then(entry.get_text()) if answer == "join" else None)
        dialog.present(self)
        entry.grab_focus()

    def add_wifi(self, device, net: dict, password: str | None) -> None:
        connection = NM.SimpleConnection.new()
        wireless = NM.SettingWireless.new()
        wireless.set_property(NM.SETTING_WIRELESS_SSID, GLib.Bytes.new(net["ssid"].encode("utf-8")))
        connection.add_setting(wireless)
        if password is not None:
            security = NM.SettingWirelessSecurity.new()
            security.set_property(NM.SETTING_WIRELESS_SECURITY_KEY_MGMT,
                                  "sae" if net["security"] == "sae" else "wpa-psk")
            security.set_property(NM.SETTING_WIRELESS_SECURITY_PSK, password)
            connection.add_setting(security)
        self.joining = {"uuid": "", "new": True, "ssid": net["ssid"], "device": device, "net": net}
        self.nm.add_and_activate_connection_async(connection, device, net["ap"].get_path(), None, self.joined)
        self.toast(f"Joining {net['ssid']}…")

    def joined(self, client, result) -> None:
        try:
            if self.joining and self.joining.get("new"):
                active = client.add_and_activate_connection_finish(result)
                conn = active.get_connection() if active is not None else None
                self.joining["uuid"] = conn.get_uuid() if conn is not None else ""
            else:
                client.activate_connection_finish(result)
        except GLib.Error as exc:
            print(f"kulan-welcome: joining: {exc.message}", file=sys.stderr)
            if not exc.matches(Gio.io_error_quark(), Gio.IOErrorEnum.CANCELLED):
                self.toast("Couldn’t join that network. Try again, or choose another")
            self.joining = None
        self.queue_wifi()

    def on_wifi_state(self, _device, new_state: int, _old: int, reason: int) -> None:
        """A wrong password: never keep it. A network added here is forgotten again, and
        a saved one asks for its new password."""
        joining = self.joining
        if joining is None:
            return
        if new_state == NM.DeviceState.ACTIVATED:
            self.joining = None
            return
        if new_state != NM.DeviceState.FAILED:
            return
        self.joining = None
        if reason not in (NM.DeviceStateReason.NO_SECRETS, NM.DeviceStateReason.SUPPLICANT_DISCONNECT,
                          NM.DeviceStateReason.SUPPLICANT_FAILED, NM.DeviceStateReason.SUPPLICANT_TIMEOUT):
            self.toast("Couldn’t join that network. Try again, or choose another")
            return
        conn = self.nm.get_connection_by_uuid(joining["uuid"]) if joining.get("uuid") else None
        if joining.get("new"):
            if conn is not None:
                conn.delete_async(None, lambda c, r: self.quietly(c.delete_finish, r))
            self.toast("That password didn’t work. Choose the network to try again")
        elif conn is not None and conn.get_setting_wireless_security() is not None:
            GLib.idle_add(lambda: (self.ask_wifi_password(
                joining["ssid"], lambda password: self.update_wifi_password(conn, password),
                "The saved password didn’t work."), False)[1])

    def update_wifi_password(self, conn, password: str) -> None:
        updated = NM.SimpleConnection.new_clone(conn)
        updated.get_setting_wireless_security().set_property(NM.SETTING_WIRELESS_SECURITY_PSK, password)

        def saved(c, result) -> None:
            try:
                c.update2_finish(result)
            except GLib.Error as exc:
                print(f"kulan-welcome: saving the password: {exc.message}", file=sys.stderr)
                self.toast("Couldn’t save the password. Try again")
                return
            device = self.wifi_device()
            if device is not None:
                self.joining = {"uuid": c.get_uuid(), "new": False, "ssid": ks_wifi.ssid_text(
                    c.get_setting_wireless().get_ssid())}
                self.nm.activate_connection_async(c, device, None, None, self.joined)
        conn.update2(updated.to_dbus(NM.ConnectionSerializationFlags.ALL), NM.SettingsUpdate2Flags.TO_DISK, None,
                     None, saved)

    def connect_wifi(self) -> None:
        """Connect: the Get online step when there is one, else Kulan Settings' Wi-Fi page."""
        if self.network_page is not None:
            self.jump_to(self.page_index(self.network_page))
        else:
            self.open_settings("wifi")

    def show_online(self) -> None:
        if self.network_page is None:
            return
        if online(self.monitor):
            primary = self.nm.get_primary_connection() if self.nm is not None else None
            self.net_status.set_title(GLib.markup_escape_text(
                f"Connected to {primary.get_id()}" if primary is not None else "Connected to the internet"))
            self.net_status.set_subtitle("You’re online. Continue when you’re ready")
            self.net_status_icon.set_from_icon_name("object-select-symbolic")
            self.net_status_icon.set_css_classes(["success"])
        else:
            limited = self.monitor.get_network_available() and \
                self.monitor.get_connectivity() in (Gio.NetworkConnectivity.PORTAL, Gio.NetworkConnectivity.LIMITED)
            self.net_status.set_title("Almost online" if limited else "Not connected")
            self.net_status.set_subtitle(
                "This network needs you to sign in on its own page first. Open Firefox to see it" if limited else
                "Choose your Wi-Fi network below" if self.nm is not None and self.wifi_device() is not None else
                "Plug in a network cable, or use More ways to connect")
            self.net_status_icon.set_from_icon_name("network-wireless-offline-symbolic")
            self.net_status_icon.set_css_classes([])

    def on_network_changed(self) -> None:
        self.show_online()
        if online(self.monitor):
            if self.apps_waiting_online:
                self.apps_waiting_online = False
                self.reload_apps()
            self.show_model_state()

    # --- 2: look --------------------------------------------------------------
    def build_appearance(self) -> Gtk.Widget:
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=18)
        box.append(self.heading("Choose your look", "You can change this later in Kulan Settings."))

        cards = Gtk.Box(spacing=14, halign=Gtk.Align.CENTER, homogeneous=True)
        current = self.current_style()
        light = self.theme_card("Light", [WALLPAPERS / "kulan-light.png"], "light", current == "light")
        dark = self.theme_card("Dark", [WALLPAPERS / "kulan-dark.png"], "dark", current == "dark")
        dark.set_group(light)
        cards.append(light)
        cards.append(dark)
        if has_key(self.kulan, "automatic-style"):
            auto = self.theme_card("Automatic", [WALLPAPERS / "kulan-light.png", WALLPAPERS / "kulan-dark.png"],
                                   "auto", current == "auto")
            auto.set_group(light)
            auto.set_tooltip_text("Light by day, dark after sunset")
            cards.append(auto)
        box.append(cards)

        if has_key(self.settings, "accent-color"):
            box.append(Gtk.Label(label="Accent colour", css_classes=["heading"], margin_top=6))
            swatches = Gtk.Box(spacing=10, halign=Gtk.Align.CENTER)
            current_accent = self.settings.get_string("accent-color")
            group: Gtk.ToggleButton | None = None
            for accent in ACCENTS:
                mark = Gtk.Image(icon_name="object-select-symbolic", visible=accent == current_accent)
                button = Gtk.ToggleButton(
                    child=mark,
                    active=accent == current_accent,
                    tooltip_text=accent.capitalize(),
                    css_classes=["accent-swatch", f"accent-{accent}"],
                )
                button.update_property([Gtk.AccessibleProperty.LABEL], [f"{accent.capitalize()} accent"])
                if group is None:
                    group = button
                else:
                    button.set_group(group)
                button.connect("toggled", self.on_accent, accent, mark)
                swatches.append(button)
            box.append(swatches)
        return self.page(box)

    def current_style(self) -> str:
        if self.kulan is not None and has_key(self.kulan, "automatic-style") and self.kulan.get_boolean(
                "automatic-style"):
            return "auto"
        if self.settings is not None and self.settings.get_string("color-scheme") == "default":
            return "light"
        return "dark"

    def theme_card(self, label: str, images: list[Path], style: str, active: bool) -> Gtk.ToggleButton:
        inner = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        pictures = Gtk.Box(homogeneous=True)
        for image in images:
            if image.exists():
                picture = Gtk.Picture.new_for_filename(str(image))
                picture.set_content_fit(Gtk.ContentFit.COVER)
                picture.set_size_request(180 // len(images), 112)
                pictures.append(picture)
        pictures.set_size_request(180, 112)
        pictures.set_overflow(Gtk.Overflow.HIDDEN)
        pictures.add_css_class("auto-card")
        inner.append(pictures)
        inner.append(Gtk.Label(label=label, css_classes=["heading"]))
        button = Gtk.ToggleButton(child=inner, active=active, css_classes=["theme-card"])
        button.connect("toggled", self.on_theme, style)
        return button

    def on_theme(self, button: Gtk.ToggleButton, style: str) -> None:
        if not button.get_active():
            return
        if self.kulan is not None and has_key(self.kulan, "automatic-style"):
            self.kulan.set_boolean("automatic-style", style == "auto")
        if style != "auto" and self.settings is not None:
            self.settings.set_string("color-scheme", "prefer-dark" if style == "dark" else "default")

    def on_accent(self, button: Gtk.ToggleButton, accent: str, mark: Gtk.Image) -> None:
        mark.set_visible(button.get_active())
        if button.get_active() and self.settings is not None:
            self.settings.set_string("accent-color", accent)

    # --- 3: accessibility -----------------------------------------------------
    def build_accessibility(self) -> Gtk.Widget:
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=18)
        box.append(self.heading("Accessibility", "Make the screen easier to see, hear and use.",
                                "preferences-desktop-accessibility-symbolic"))
        group = Adw.PreferencesGroup()
        a11y = settings("org.gnome.desktop.a11y.interface")
        apps = settings("org.gnome.desktop.a11y.applications")
        rows = []
        if has_key(self.settings, "text-scaling-factor"):
            larger = Adw.SwitchRow(title="Larger text", subtitle="Makes text bigger in every app",
                                   active=self.settings.get_double("text-scaling-factor") > 1.0)
            larger.connect("notify::active", lambda r, _p: self.settings.set_double(
                "text-scaling-factor", 1.25 if r.get_active() else 1.0))
            rows.append(larger)
        if has_key(a11y, "high-contrast"):
            contrast = Adw.SwitchRow(title="High contrast", subtitle="Stronger outlines and colours")
            a11y.bind("high-contrast", contrast, "active", Gio.SettingsBindFlags.DEFAULT)
            rows.append(contrast)
        if has_key(self.settings, "enable-animations"):
            motion = Adw.SwitchRow(title="Reduce motion", subtitle="Turns off animations")
            self.settings.bind("enable-animations", motion, "active",
                               Gio.SettingsBindFlags.DEFAULT | Gio.SettingsBindFlags.INVERT_BOOLEAN)
            rows.append(motion)
        if has_key(apps, "screen-reader-enabled"):
            reader = Adw.SwitchRow(title="Screen reader", subtitle="Reads the screen aloud (Super+Alt+S)")
            apps.bind("screen-reader-enabled", reader, "active", Gio.SettingsBindFlags.DEFAULT)
            rows.append(reader)
        if has_key(apps, "screen-magnifier-enabled"):
            zoom = Adw.SwitchRow(title="Zoom", subtitle="Magnify part of the screen (Super+Alt+8)")
            apps.bind("screen-magnifier-enabled", zoom, "active", Gio.SettingsBindFlags.DEFAULT)
            rows.append(zoom)
        for row in rows:
            group.add(row)
        group.add(self.link_row("More accessibility options", "Typing, pointing, sound and more",
                                lambda: self.open_settings("accessibility")))
        box.append(group)
        return self.page(box)

    def open_gnome(self, panel: str) -> None:
        try:
            Gio.Subprocess.new(["gnome-control-center", panel], Gio.SubprocessFlags.NONE)
        except GLib.Error:
            self.toast("Settings isn't installed")

    # --- 4: privacy -------------------------------------------------------------
    def build_privacy(self) -> Gtk.Widget:
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=18)
        box.append(self.heading("Your privacy", f"{self.name} sends no personal data, crash reports or "
                                "advertising IDs.",
                                "preferences-system-privacy-symbolic"))
        # A standard account can still ask an administrator to type their password.
        group = Adw.PreferencesGroup(description="" if self.admin or self.live else
                                     "Changing the computer name, ad blocking and the anonymous count needs an "
                                     "administrator’s password: ask one to type it when it’s asked for.")
        location = settings("org.gnome.system.location")
        if has_key(location, "enabled"):
            loc = Adw.SwitchRow(title="Location services", subtitle="Lets apps like Maps and Weather use your location")
            location.bind("enabled", loc, "active", Gio.SettingsBindFlags.DEFAULT)
            group.add(loc)

        self.name_row = Adw.ActionRow(title="Computer name",
                                      subtitle=GLib.markup_escape_text(
                                          f"“{GLib.get_host_name()}” is visible to other devices on your network"))
        private = Gtk.Button(label="Make private", valign=Gtk.Align.CENTER)
        private.connect("clicked", self.on_private_name)
        private.set_sensitive(not self.live and Path(UPDATE_HELPER).exists())
        self.name_row.add_suffix(private)
        group.add(self.name_row)

        self.dns_row = Adw.ActionRow(title="Block ads and trackers",
                                     subtitle="In every app and browser, using Mullvad’s free DNS. Encrypted "
                                              "when the network allows")
        dns = Gtk.Button(label="Turn on", valign=Gtk.Align.CENTER)
        dns.connect("clicked", self.on_adblock_dns)
        dns.set_sensitive(not self.live and Path(UPDATE_HELPER).exists())
        try:  # already on (set in Kulan Settings › Privacy, or earlier here)
            if "adblock.dns.mullvad.net" in Path("/etc/systemd/resolved.conf.d/60-kulan-dns.conf").read_text():
                dns.set_label("On")
                dns.set_sensitive(False)
        except OSError:
            pass
        self.dns_row.add_suffix(dns)
        group.add(self.dns_row)

        # The anonymous weekly count: said plainly, with the off switch here.
        if Path("/usr/lib/kulan/countme").exists():
            self.count_row = Adw.SwitchRow(
                title="Count this computer, anonymously",
                subtitle=f"Once a week, {self.name} sends its version, PC or Mac, and roughly how long it’s "
                         "been installed. No ID and nothing about you.",
                subtitle_lines=0, active=not Path(COUNTME_OFF).exists())
            self.count_row.set_sensitive(not self.live and Path(UPDATE_HELPER).exists())
            self.count_row.connect("notify::active", self.on_count)
            group.add(self.count_row)
        box.append(group)

        more = Adw.PreferencesGroup()
        more.add(self.link_row("All privacy settings", "Camera, microphone, history and what Kulan OS connects to",
                               lambda: self.open_settings("privacy")))
        box.append(more)
        return self.page(box)

    def helper(self, args: list[str], done) -> None:
        run_async(["pkexec", UPDATE_HELPER, *args], done, timeout=600)

    def on_count(self, row: Adw.SwitchRow, _pspec) -> None:
        on = row.get_active()
        if on == (not Path(COUNTME_OFF).exists()):
            return
        row.set_sensitive(False)

        def done(code: int, _out: str, err: str) -> bool:
            row.set_sensitive(True)
            if code != 0:
                row.handler_block_by_func(self.on_count)
                row.set_active(not Path(COUNTME_OFF).exists())
                row.handler_unblock_by_func(self.on_count)
                self.toast(helper_failure(code, _out, err, "Couldn’t change it. Try again in Kulan Settings › "
                                                             "Privacy"))
            return False

        self.helper(["countme-on" if on else "countme-off"], done)

    def on_private_name(self, button: Gtk.Button) -> None:
        name = f"kulan-{secrets.token_hex(3)}"
        button.set_sensitive(False)

        def done(code: int, _out: str, err: str) -> bool:
            if code == 0:
                button.set_label("Done")
                self.name_row.set_subtitle(GLib.markup_escape_text(f"Now “{name}”"))
            else:
                button.set_sensitive(True)
                self.toast(helper_failure(code, _out, err, "Couldn’t rename it. Try again in Kulan Settings › "
                                                             "Privacy"))
            return False

        self.helper(["set-hostname", name], done)

    def on_adblock_dns(self, button: Gtk.Button) -> None:
        button.set_sensitive(False)
        button.set_label("Turning on…")

        def done(code: int, _out: str, err: str) -> bool:
            if code == 0:
                button.set_label("On")
            else:
                button.set_sensitive(True)
                button.set_label("Turn on")
                self.toast(helper_failure(code, _out, err, "Couldn’t turn it on. Connect to the internet, then "
                                                             "try again"))
            return False

        self.helper(["dns", "adblock"], done)

    # --- 5: bring your files ------------------------------------------------------
    def build_migration(self) -> Gtk.Widget:
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=18)
        box.append(self.heading("Bring your files", "Copy documents, photos, music and videos from another "
                                "computer’s drive or backup.",
                                "folder-download-symbolic"))
        group = Adw.PreferencesGroup(description="Folders from a Mac, Windows or Linux computer go to the matching "
                                     "folders here. Anything else goes to a folder in Documents. Nothing on the "
                                     "drive is changed, and files you already have are kept.")
        self.migrate_row = Adw.ActionRow(title="Choose a folder", subtitle="Your old home folder, or any folder")
        self.migrate_button = Gtk.Button(label="Choose…", valign=Gtk.Align.CENTER, css_classes=["suggested-action"])
        self.migrate_button.connect("clicked", self.on_choose_migration)
        self.migrate_button.set_sensitive(not self.live)
        self.migrate_row.add_suffix(self.migrate_button)
        group.add(self.migrate_row)
        box.append(group)
        self.migrate_progress = Gtk.ProgressBar(show_text=True, visible=False)
        box.append(self.migrate_progress)
        if self.live:
            box.append(Gtk.Label(label=f"Available after you install {self.name}.", css_classes=["dim-label"]))
        return self.page(box)

    def on_choose_migration(self, _button: Gtk.Button) -> None:
        dialog = Gtk.FileDialog(title="Choose the folder to bring over")
        media = Path("/media") / GLib.get_user_name()
        if media.is_dir():
            dialog.set_initial_folder(Gio.File.new_for_path(str(media)))

        def chosen(d, result) -> None:
            try:
                folder = d.select_folder_finish(result)
            except GLib.Error:
                return  # cancelled
            if folder is not None and folder.get_path():
                self.start_migration(Path(folder.get_path()))

        dialog.select_folder(self, None, chosen)

    def start_migration(self, source: Path) -> None:
        home = Path.home().resolve()
        chosen = source.resolve()
        # Never this computer's own files: home itself, a folder inside it,
        # or a folder that contains it (such as /home or /).
        if chosen == home or home in chosen.parents or chosen in home.parents:
            self.toast("That folder holds this computer's own files. Choose a folder on the drive or backup.")
            return
        if chosen == Path("/media") / GLib.get_user_name() or chosen.parent == Path("/media"):
            self.toast("Open the drive first, then choose the folder on it.")
            return
        self.migrating = True
        self.migrate_button.set_sensitive(False)
        self.migrate_row.set_subtitle(GLib.markup_escape_text(f"Looking through “{source.name or source}”…"))
        self.migrate_progress.set_visible(True)
        self.migrate_progress.set_fraction(0)
        self.migrate_progress.set_text("Counting files…")
        threading.Thread(target=self.migrate_worker, args=(source,), daemon=True).start()

    def migrate_worker(self, source: Path) -> None:
        copied = failed = 0
        targets: list[str] = []
        problem = ""
        try:
            pairs = migration_plan(source)
            home = Path.home()
            targets = sorted({t.relative_to(home).parts[0] for _, t in pairs if t.is_relative_to(home)})
            files, failed = migration_files(pairs)
            total = sum(size for _, _, size in files)
            free = shutil.disk_usage(Path.home()).free
            if total > free - 512 * 1024 ** 2:  # keep half a gigabyte spare
                problem = (f"Not enough space. This needs {GLib.format_size(total)}, "
                           f"and {GLib.format_size(max(free, 0))} is free.")
                return
            done_bytes = 0
            last = 0.0
            for src, dst, size in files:
                try:
                    copy_file(src, dst)
                    copied += 1
                except OSError:
                    failed += 1
                done_bytes += size
                now = GLib.get_monotonic_time() / 1e6
                if now - last > 0.2:
                    last = now
                    GLib.idle_add(self.migrate_tick, done_bytes / (total or 1), copied, len(files))
        except Exception as exc:  # noqa: BLE001 - report it, never leave the window stuck
            print(f"kulan-welcome: copying stopped: {exc!r}", file=sys.stderr)
            problem = ("Copying stopped. Check the drive is still plugged in, then choose the folder again: "
                       "files already copied are kept")
        finally:
            GLib.idle_add(self.migrate_done, copied, failed, targets, problem)

    def migrate_tick(self, fraction: float, copied: int, count: int) -> bool:
        self.migrate_progress.set_fraction(min(fraction, 1.0))
        self.migrate_progress.set_text(f"Copied {copied} of {count} files")
        return False

    def migrate_done(self, copied: int, failed: int, targets: list[str], problem: str) -> bool:
        self.migrating = False
        self.migrate_button.set_sensitive(True)
        self.migrate_button.set_label("Choose another…")
        if problem:
            self.migrate_progress.set_visible(False)
            self.migrate_row.set_subtitle(GLib.markup_escape_text(problem))
            return False
        self.migrate_progress.set_fraction(1.0)
        where = ", ".join(targets) or "your folders"
        note = f"; {failed} couldn't be read" if failed else ""
        if copied == 0:
            self.migrate_progress.set_text("Nothing new to copy")
            self.migrate_row.set_subtitle(GLib.markup_escape_text(
                f"Everything there is already on this computer{note}"))
        else:
            self.migrate_progress.set_text(f"Copied {copied} file{'s' if copied != 1 else ''}")
            self.migrate_row.set_subtitle(GLib.markup_escape_text(f"Copied into {where}{note}"))
        return False

    # --- 6: backups ---------------------------------------------------------------
