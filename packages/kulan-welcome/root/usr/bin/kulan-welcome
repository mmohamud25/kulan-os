# Setup and Kulan Settings always agree (what's recommended, what's secure).
sys.path.insert(0, os.environ.get("KULAN_SETTINGS_LIB", "/usr/share/kulan-settings"))
try:
    from kulan_settings import assistant as ks_assistant
except Exception:  # noqa: BLE001 - not installed, or too old: those steps are left out
    ks_assistant = None
try:
    from kulan_settings import wifi as ks_wifi
except Exception:  # noqa: BLE001
    ks_wifi = None

