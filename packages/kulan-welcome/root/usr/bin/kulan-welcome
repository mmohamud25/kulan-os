    # --- 8: apps ------------------------------------------------------------------
    def build_apps(self) -> Gtk.Widget:
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=18)
        box.append(
            self.heading(
                "Add your apps",
                "Choose apps to install. Find more in Software.",
            )
        )
        self.apps_status = Gtk.Label(label="Checking which apps this computer can run…", css_classes=["dim-label"],
                                     wrap=True, justify=Gtk.Justification.CENTER)
        box.append(self.apps_status)
        # Offline: connect, and the list fills in by itself once online.
        self.apps_connect = Gtk.Button(label="Connect to Wi-Fi", halign=Gtk.Align.CENTER, visible=False,
                                       css_classes=["pill"])
        self.apps_connect.connect("clicked", lambda _b: self.connect_wifi())
        box.append(self.apps_connect)
        self.apps_retry = Gtk.Button(label="Try again", halign=Gtk.Align.CENTER, visible=False, css_classes=["pill"])
        self.apps_retry.connect("clicked", lambda _b: self.reload_apps())
        box.append(self.apps_retry)

        groups: dict[str, Adw.PreferencesGroup] = {}
        for choice in APPS:
            if choice.category not in groups:
                groups[choice.category] = Adw.PreferencesGroup(title=choice.category)
                box.append(groups[choice.category])
            check = Gtk.CheckButton(valign=Gtk.Align.CENTER, sensitive=False)
            check.connect("toggled", self.on_app_toggled)
            row = Adw.ActionRow(title=choice.name, subtitle=choice.summary, activatable_widget=check)
            theme = Gtk.IconTheme.get_for_display(Gdk.Display.get_default())
            if theme.has_icon(choice.app_id):
                icon = Gtk.Image(icon_name=choice.app_id, pixel_size=32)
            else:
                icon = Gtk.Image(icon_name=choice.symbol, pixel_size=24, margin_start=4, margin_end=4)
            row.add_prefix(icon)
            row.add_suffix(check)
            groups[choice.category].add(row)
            self.app_checks[choice.app_id] = check
            self.app_rows[choice.app_id] = row

        self.install_button = Gtk.Button(
            label="Install selected", css_classes=["suggested-action", "pill"], halign=Gtk.Align.CENTER, sensitive=False
        )
        self.install_button.connect("clicked", self.on_install)
        self.install_progress = Gtk.ProgressBar(show_text=True, visible=False)
        self.install_progress.update_property([Gtk.AccessibleProperty.LABEL], ["Installing apps"])
        box.append(self.install_button)
        box.append(self.install_progress)

        addons = Adw.PreferencesGroup(title="Add-ons",
                                      description="Developer Kit, office and media apps, Phone link and more.")
        addons.add(self.link_row("Kulan add-ons", "Open Add-ons in Kulan Settings",
                                 lambda: self.open_settings("add-ons")))
        box.append(addons)
        box.append(Gtk.Box(margin_bottom=12))
        self.apps_page = self.page(box)
        return self.apps_page

    def reload_apps(self) -> None:
        self.apps_retry.set_visible(False)
        self.apps_connect.set_visible(False)
        self.apps_status.set_label("Checking which apps this computer can run…")
        self.apps_loaded = True
        self.load_app_availability()

    def load_app_availability(self) -> None:
        if shutil.which("flatpak") is None:
            self.apps_status.set_label("These apps can’t be added here. Add apps later in Software.")
            self.bitwarden_row.set_subtitle(self.bitwarden_text(False))
            return

        code, out, _ = run(["flatpak", "--default-arch"], timeout=10)
        arch = out.strip() if code == 0 and out.strip() else None
        cmd = ["flatpak", "remote-ls", "--system", "--app", "--columns=application", "flathub"]
        if arch:
            cmd.append(f"--arch={arch}")

        def got_remote(code: int, out: str, err: str) -> bool:
            if code != 0:
                self.apps_loaded = False
                if not online(self.monitor):
                    self.apps_waiting_online = True
                    self.apps_status.set_label("Not connected to the internet. Connect to Wi-Fi, and this list "
                                               "fills in by itself.")
                    self.apps_connect.set_visible(True)
                else:
                    print(f"kulan-welcome: flathub: {err.strip()[-300:]}", file=sys.stderr)
                    self.apps_status.set_label("Couldn’t reach the app store right now. Try again in a minute.")
                    self.apps_retry.set_visible(True)
                return False
            self.apps_connect.set_visible(False)
            self.apps_retry.set_visible(False)
            available = {line.strip() for line in out.splitlines() if line.strip()}
            run_async(
                ["flatpak", "list", "--app", "--columns=application"],
                lambda c, o, e: self.apply_availability(available, set(o.split()) if c == 0 else set(), arch),
                timeout=30,
            )
            return False

        run_async(cmd, got_remote, timeout=120)

    def apply_availability(self, available: set[str], installed: set[str], arch: str | None) -> bool:
        unavailable = 0
        for app_id, check in self.app_checks.items():
            row = self.app_rows[app_id]
            choice = next(c for c in APPS if c.app_id == app_id)
            if app_id in installed:
                row.set_sensitive(True)
                check.set_active(True)
                check.set_sensitive(False)
                row.set_subtitle(f"{choice.summary} · Installed")
            elif app_id in available:
                row.set_sensitive(True)
                check.set_sensitive(True)
                row.set_subtitle(choice.summary)
            else:
                unavailable += 1
                check.set_active(False)
                check.set_sensitive(False)
                row.set_sensitive(False)
                row.set_subtitle("Not available for this computer")
        if unavailable:
            self.apps_status.set_label(unavailable_text(unavailable))
        else:
            self.apps_status.set_label("All of these work on this computer.")
        self.bitwarden_row.set_subtitle(self.bitwarden_text("com.bitwarden.desktop" in available | installed))
        self.on_app_toggled(None)
        return False

    def selected_apps(self) -> list[str]:
        return [app_id for app_id, check in self.app_checks.items() if check.get_active() and check.get_sensitive()]

    def on_app_toggled(self, _check: Gtk.CheckButton | None) -> None:
        count = len(self.selected_apps())
        self.install_button.set_sensitive(count > 0)
        label = f"Install {count} app{'s' if count != 1 else ''}" if count else "Install selected"
        self.install_button.set_label(label)

    def on_install(self, _button: Gtk.Button) -> None:
        apps = self.selected_apps()
        if not apps:
            return
        self.installing = True
        self.install_button.set_sensitive(False)
        self.install_button.set_label("Installing…")
        self.install_progress.set_visible(True)
        for check in self.app_checks.values():
            check.set_sensitive(False)
        # One app at a time, so the bar says which one; the password is asked once (kept for a few minutes).
        self.install_queue = list(apps)
        self.install_total = len(apps)
        self.install_done: list[str] = []
        self.install_failed: list[tuple[str, str]] = []
        self.install_next()

    def install_next(self) -> None:
        if not self.install_queue:
            self.install_finished()
            return
        app_id = self.install_queue.pop(0)
        number = self.install_total - len(self.install_queue)
        name = next(c.name for c in APPS if c.app_id == app_id)
        self.install_progress.set_fraction((number - 1) / self.install_total)
        self.install_progress.set_text(f"Installing {name} ({number} of {self.install_total})…")

        def done(code: int, _out: str, err: str) -> bool:
            if code == 0:
                self.install_done.append(app_id)
            elif re.search(r"not allowed for user|Not authorized|dismissed|cancel", err, re.I):
                self.install_failed.append((app_id, "cancelled"))
                self.install_queue.clear()  # the password wasn't given: don't ask again for each app
            else:
                print(f"kulan-welcome: installing {app_id}: {err.strip()[-300:]}", file=sys.stderr)
                self.install_failed.append((app_id, err))
            self.install_next()
            return False

        # A system-wide install asks for your password through the normal
        # GNOME prompt; apps then appear for every user on this computer.
        run_async(["flatpak", "install", "--system", "--noninteractive", "-y", "flathub", app_id], done,
                  timeout=3600)

    def install_finished(self) -> None:
        self.installing = False
        self.install_progress.set_fraction(1.0)
        self.install_progress.set_visible(False)
        count = len(self.install_done)
        reasons = [err for _a, err in self.install_failed]
        if not self.install_failed:
            self.toast(f"Installed {count} app{'s' if count != 1 else ''}")
        elif all(r == "cancelled" for r in reasons) and not count:
            self.toast("Cancelled")
        else:
            text = "\n".join(reasons)
            if re.search(r"Can't load uri|Could not resolve|Temporary failure|Network|Unable to connect", text, re.I):
                why = "Not connected to the internet. Connect, then try again"
            elif re.search(r"No space left|Not enough disk space", text, re.I):
                why = "Not enough free space. Free some in Kulan Settings › Storage"
            else:
                why = "Try again in a few minutes"
            missing = len(self.install_failed)
            self.toast(f"Installed {count}, but {missing} app{'s' if missing != 1 else ''} couldn’t be installed. {why}"
                       if count else f"Couldn’t install the apps. {why}")
        self.load_app_availability()

    # --- Ask Kulan's model (only when the assistant has none) ----------------------------------
    @staticmethod
    def assistant_needs_model() -> bool:
        if ks_assistant is None or not ks_assistant.ENGINE.exists() or settings(ks_assistant.SCHEMA) is None:
            return False
        writing = ks_assistant.models("writing")
        return bool(writing) and not any(ks_assistant.downloaded(m) for m in writing)

    def build_assistant(self) -> Gtk.Widget:
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=18)
        box.append(self.heading("Ask Kulan", "Private help with writing, summaries and questions, on this "
                                "computer. Nothing you ask leaves it. It needs a model, downloaded once.",
                                "kulan-assistant-symbolic"))
        group = Adw.PreferencesGroup()
        self.model_row = Adw.ActionRow(title="", subtitle_lines=0)
        self.model_button = Gtk.Button(label="Download", valign=Gtk.Align.CENTER, css_classes=["suggested-action"])
        self.model_button.connect("clicked", lambda _b: self.download_model())
        self.model_row.add_suffix(self.model_button)
        group.add(self.model_row)
        group.add(self.link_row("Other models and Ask Kulan’s settings", "In Kulan Settings › Assistant",
                                lambda: self.open_settings("assistant")))
        box.append(group)
        self.model_progress = Gtk.ProgressBar(show_text=True, visible=False)
        self.model_progress.update_property([Gtk.AccessibleProperty.LABEL], ["Model download"])
        box.append(self.model_progress)
        self.model = None
        self.model_done = False
        if ks_assistant is not None:
            self.memory = round(ks_assistant.memory_gb())
            writing = ks_assistant.models("writing")
            best = ks_assistant.recommended(writing, self.memory)
            self.model = next((m for m in writing if m["id"] == best), None)
            if self.model is None and writing:
                need = min(m.get("memory_gb", 99) for m in writing)
                self.model_row.set_title("This computer doesn’t have enough memory for Ask Kulan")
                self.model_row.set_subtitle(f"It needs at least {need} GB of memory, and this computer has "
                                            f"{self.memory} GB.")
                self.model_row.add_prefix(Gtk.Image(icon_name="dialog-warning-symbolic"))
        self.assistant_page = self.page(box)
        self.show_model_state()
        return self.assistant_page

    def show_model_state(self) -> None:
        if getattr(self, "model_row", None) is None:
            return
        if self.model is None:
            self.model_button.set_visible(False)
            if not self.model_row.get_title():
                self.model_row.set_title("Ask Kulan isn’t set up")
            return
        size = ks_assistant.size_text(self.model.get("size", 0))
        self.model_row.set_title(GLib.markup_escape_text(f"{self.model.get('title', 'The')} model, recommended "
                                                         "for this computer"))
        if self.model_done:
            self.model_row.set_subtitle("Downloaded. Ask Kulan is ready: find it in your apps")
            self.model_button.set_visible(False)
        elif self.downloading:
            self.model_button.set_sensitive(False)
        elif not online(self.monitor):
            self.model_row.set_subtitle(f"A {size} download. Connect to the internet first, then download it here")
            self.model_button.set_sensitive(False)
        else:
            self.model_row.set_subtitle(f"A {size} download, for everyone on this computer. It continues where "
                                        "it stopped if it’s cut off")
            self.model_button.set_sensitive(True)

    def download_model(self) -> None:
        if self.model is None or self.downloading:
            return
        try:
            proc = Gio.Subprocess.new(["pkexec", UPDATE_HELPER, "assistant-model", self.model["id"]],
                                      Gio.SubprocessFlags.STDOUT_PIPE | Gio.SubprocessFlags.STDERR_PIPE)
        except GLib.Error as exc:
            print(f"kulan-welcome: {exc.message}", file=sys.stderr)
            self.toast("Couldn’t start the download. Try again in Kulan Settings › Assistant")
            return
        self.downloading = True
        self.show_model_state()
        self.model_progress.set_fraction(0)
        self.model_progress.set_text("Starting the download…")
        self.model_progress.set_visible(True)
        out: list[str] = []
        err: list[str] = []

        def read(stream: Gio.DataInputStream, lines: list[str], progress: bool) -> None:
            def got(src, result) -> None:
                try:
                    line, _n = src.read_line_finish_utf8(result)
                except GLib.Error:
                    line = None
                if line is None:
                    return
                lines.append(line)
                del lines[:-40]
                parts = line.split(":", 3)
                if progress and len(parts) == 4 and parts[0] == "pmstatus":
                    try:
                        self.model_progress.set_fraction(max(0.0, min(1.0, float(parts[2]) / 100)))
                        self.model_progress.set_text(parts[3][:80])
                    except ValueError:
                        pass
                src.read_line_async(GLib.PRIORITY_DEFAULT, None, got)
            stream.read_line_async(GLib.PRIORITY_DEFAULT, None, got)
        read(Gio.DataInputStream.new(proc.get_stdout_pipe()), out, True)
        read(Gio.DataInputStream.new(proc.get_stderr_pipe()), err, False)

        def finished(p, result) -> None:
            try:
                p.wait_finish(result)
                code = p.get_exit_status() if p.get_if_exited() else 1
            except GLib.Error:
                code = 1
            self.downloading = False
            self.model_progress.set_visible(False)
            if code == 0:
                self.model_done = True
                assistant = settings(ks_assistant.SCHEMA)
                key = ks_assistant.KINDS["writing"][0]
                if has_key(assistant, key):
                    assistant.set_string(key, self.model["id"])
                self.toast("Ask Kulan is ready")
            else:
                # model-download's own reasons are written for people ("Not enough free space…").
                own = [line.strip() for line in err if re.match(r"^[A-Z][^/:]*[.]?$", line.strip())]
                self.toast(helper_failure(code, "\n".join(out), "\n".join(err),
                                          own[-1].rstrip(".") if own else
                                          "The download didn’t finish. Try again here or in Kulan Settings › "
                                          "Assistant"))
            self.show_model_state()
        proc.wait_async(None, finished)

    # --- 9: protection ---------------------------------------------------------------
    def build_security(self) -> Gtk.Widget:
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=18)
        box.append(self.heading("How you're protected", f"{self.name} turns on these protections for you.",
                                "security-high-symbolic"))
        group = Adw.PreferencesGroup()
        live = self.live

        group.add(self.status_row("Firewall", "Blocks connections coming in from the network",
                                  self.firewall_enabled()))
        group.add(self.status_row("Automatic security updates", "Security fixes install every day",
                                  self.auto_updates_enabled()))
        if live:
            group.add(self.info_row("Disk encryption", "On by default when you install"))
        else:
            encrypted = self.disk_encrypted()
            group.add(
                self.status_row(
                    "Disk encryption",
                    "Your files are locked if this computer is lost"
                    if encrypted
                    else "Reinstall with encryption to protect your files if this computer is lost",
                    encrypted,
                )
            )
        group.add(self.screen_lock_row())
        if not live and self.automatic_sign_in():
            group.add(self.automatic_sign_in_row())
        group.add(self.status_row("Private browsing defaults",
                                  "Firefox blocks ads, trackers and cookie banners, and sends no usage data",
                                  Path("/etc/firefox/policies/policies.json").exists()))
        box.append(group)
        more = Adw.PreferencesGroup()
        more.add(self.link_row("Security in Kulan Settings", "Run a checkup and see all protections",
                               lambda: self.open_settings("security")))
        box.append(more)
        return self.page(box)

    @staticmethod
    def automatic_sign_in(conf: Path = Path("/etc/gdm3/daemon.conf"), user: str | None = None) -> bool:
        """Whether this person is signed in automatically at start-up."""
        user = user or GLib.get_user_name()
        try:
            lines = conf.read_text(errors="replace").splitlines()
        except OSError:
            return False
        section, values = "", {}
        for line in lines:
            line = line.strip()
            if line.startswith("[") and line.endswith("]"):
                section = line[1:-1].strip().lower()
            elif section == "daemon" and "=" in line and not line.startswith("#"):
                key, _s, value = line.partition("=")
                values[key.strip()] = value.strip()
        return values.get("AutomaticLoginEnable", "").lower() in ("true", "1", "yes") and \
            values.get("AutomaticLogin", "") == user

    def automatic_sign_in_row(self) -> Adw.ActionRow:
        """Automatic sign-in: why saved passwords ask to be unlocked, and the fix."""
        row = Adw.ActionRow(title="Sign in automatically",
                            subtitle="Saved passwords stay locked, so Wi-Fi, browsers and online accounts "
                                     "ask you to unlock them after you sign in")
        row.add_prefix(Gtk.Image(icon_name="dialog-warning-symbolic", css_classes=["warning"]))
        fix = Gtk.Button(label="Fix…", valign=Gtk.Align.CENTER)
        fix.connect("clicked", lambda _b: self.open_settings("users"))
        row.add_suffix(fix)
        return row

    def screen_lock_row(self) -> Adw.ActionRow:
        """The screen lock as it's actually set."""
        saver, session = settings("org.gnome.desktop.screensaver"), settings("org.gnome.desktop.session")
        locks = saver.get_boolean("lock-enabled") if has_key(saver, "lock-enabled") else None
        delay = session.get_uint("idle-delay") if has_key(session, "idle-delay") else 0
        if locks is None:
            return self.status_row("Screen lock", "Set it in Kulan Settings › Security", None)
        if not locks or not delay:
            return self.status_row("Screen lock", "Anyone can use this computer while you’re away", False)
        minutes = max(1, delay // 60)
        return self.status_row("Screen lock", f"Locks after {minutes} minute{'s' if minutes != 1 else ''} away, "
                               "or when the lid closes", True)

    @staticmethod
    def status_row(title: str, subtitle: str, state: bool | None) -> Adw.ActionRow:
        row = Adw.ActionRow(title=title, subtitle=subtitle)
        if state is True:
            row.add_prefix(Gtk.Image(icon_name="object-select-symbolic", css_classes=["success"]))
            row.add_suffix(Gtk.Label(label="On", css_classes=["success"]))
        elif state is False:
            row.add_prefix(Gtk.Image(icon_name="dialog-warning-symbolic", css_classes=["warning"]))
            row.add_suffix(Gtk.Label(label="Off", css_classes=["warning"]))
        else:
            row.add_prefix(Gtk.Image(icon_name="dialog-information-symbolic"))
        return row

    @staticmethod
    def info_row(title: str, subtitle: str) -> Adw.ActionRow:
        row = Adw.ActionRow(title=title, subtitle=subtitle)
        row.add_prefix(Gtk.Image(icon_name="dialog-information-symbolic"))
        return row

    @staticmethod
    def firewall_enabled() -> bool:
        try:
            return "ENABLED=yes" in Path("/etc/ufw/ufw.conf").read_text().split()
        except OSError:
            return False

    @staticmethod
    def auto_updates_enabled() -> bool:
        code, out, _ = run(["apt-config", "dump", "APT::Periodic::Unattended-Upgrade"], timeout=10)
        return code == 0 and '"1"' in out

    @staticmethod
    def disk_encrypted() -> bool:
        code, out, _ = run(["lsblk", "--noheadings", "--output", "TYPE"], timeout=10)
        return code == 0 and "crypt" in out.split()

    # --- 10: done -------------------------------------------------------------------
    def build_done(self) -> Gtk.Widget:
        status = Adw.StatusPage(
            icon_name="object-select-symbolic",
            title="You're all set",
            description="You can open Setup Assistant again from your apps.",
            vexpand=True,
        )
        inner = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=18)
        group = Adw.PreferencesGroup()
        # On only if it would show at the next sign-in anyway (opened from the apps, not finished yet).
        self.startup_initial = not DONE_FILE.exists() and not self.autostart
        self.startup_switch = Adw.SwitchRow(title="Show this at startup", active=self.startup_initial)
        group.add(self.startup_switch)
        inner.append(group)
        url = self.conf.get("KULAN_HOME_URL", "")
        if url:
            # "Visit Kulan Group", without the company's legal suffix.
            publisher = self.conf.get("KULAN_PUBLISHER", "")
            for suffix in (" LLC", " Ltd", " Inc."):
                publisher = publisher.removesuffix(suffix)
            publisher = publisher.strip() or "our website"
            visit = Gtk.Button(label=f"Visit {publisher}", css_classes=["pill"], halign=Gtk.Align.CENTER)
            visit.connect("clicked", lambda _b: Gtk.UriLauncher.new(url).launch(self, None, None, None))
            inner.append(visit)
        status.set_child(Adw.Clamp(maximum_size=420, child=inner))
        return status


class WelcomeApp(Adw.Application):
    def __init__(self, start_page: int, self_test: bool = False, autostart: bool = False) -> None:
        super().__init__(application_id=APP_ID, flags=Gio.ApplicationFlags.NON_UNIQUE if self_test
                         else Gio.ApplicationFlags.DEFAULT_FLAGS)
        self.start_page = start_page
        self.self_test = self_test
        self.autostart = autostart
        self.result = 0
        self.conf = read_conf()

    def do_startup(self) -> None:
        Adw.Application.do_startup(self)
        provider = Gtk.CssProvider()
        if hasattr(provider, "load_from_string"):  # GTK 4.12+
            provider.load_from_string(CSS)
        else:
            provider.load_from_data(CSS.encode())
        Gtk.StyleContext.add_provider_for_display(
            Gdk.Display.get_default(), provider, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION
        )

    def do_activate(self) -> None:
        if self.self_test:
            # Build every step, as CI does on Debian's real GTK and libadwaita.
            try:
                window = WelcomeWindow(self, self.conf, 0, every_step=True)
                pages = window.carousel.get_n_pages()
                for index in range(pages):
                    window.jump_to(index)
                print(f"{pages}/{len(window.builders)} steps built")
                self.result = 0 if pages == len(window.builders) else 1
                for problem in self_checks(window):
                    print(f"FAIL {problem}", file=sys.stderr)
                    self.result = 1
                window.migrating = window.installing = window.downloading = False
                window.destroy()
            except Exception as exc:  # noqa: BLE001 - report, then fail
                print(f"FAIL {exc!r}", file=sys.stderr)
                self.result = 1
            self.quit()
            return
        window = self.props.active_window or WelcomeWindow(self, self.conf, self.start_page, self.autostart)
        window.present()


def self_checks(window: WelcomeWindow) -> list[str]:
    """What the steps say and do in each case (run by --self-test, on Debian's GTK in CI)."""
    problems = []

    def check(what: str, ok: bool) -> None:
        if not ok:
            problems.append(what)
    check("unavailable apps, one", unavailable_text(1) == "1 of these isn’t available for this computer yet.")
    check("unavailable apps, several", unavailable_text(3) == "3 of these aren’t available for this computer yet.")
    check("helper: cancelled", helper_failure(126, "", "", "x") == "Cancelled")
    check("helper: its own words", helper_failure(1, "pmstatus:x:1:y\nsay: Use letters only.\n", "E: raw", "x")
          == "Use letters only")
    check("helper: never raw output", helper_failure(1, "", "E: Sub-process /usr/bin/dpkg returned an error code (1)", "Plain") == "Plain")
    check("Bitwarden only when offered", "next page" not in window.bitwarden_text(False))
    # Offline, the apps list says so, offers to connect, and fills in by itself once online.
    window.apps_waiting_online = False
    window.apps_status.set_label("")
    check("network step built", window.network_page is not None and window.page_index(window.network_page) == 1)
    check("assistant step built", getattr(window, "assistant_page", None) is not None)
    # Closing while apps install is refused, and shows where they are.
    window.installing = True
    check("closing while installing is refused", window.on_close(window) is True)
    window.installing = False
    window.downloading = True
    check("closing while the model downloads is refused", window.on_close(window) is True)
    window.downloading = False
    return problems


def main(argv: list[str]) -> int:
    parser = argparse.ArgumentParser(description="Kulan OS Setup Assistant")
    parser.add_argument("--autostart", action="store_true", help="run only if this is the first login")
    parser.add_argument("--self-test", action="store_true", help="build every step, print a summary and quit")
    parser.add_argument("--page", type=int, default=0, help=argparse.SUPPRESS)
    args = parser.parse_args(argv[1:])

    if args.autostart and (DONE_FILE.exists() or is_live_session()):
        return 0
    if args.autostart:
        # Not done until it's finished. Closed early, or cut off when the
        # session ended, it's shown once more at the next sign-in, then not again.
        try:
            STATE_DIR.mkdir(parents=True, exist_ok=True)
            if REMINDED_FILE.exists():
                DONE_FILE.write_text("1\n")
            else:
                REMINDED_FILE.write_text("1\n")
        except OSError:
            pass
    app = WelcomeApp(args.page, args.self_test, args.autostart)
    code = app.run([argv[0]])
    return app.result or code


if __name__ == "__main__":
    sys.exit(main(sys.argv))
