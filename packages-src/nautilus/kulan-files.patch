diff --git a/src/resources/style.css b/src/resources/style.css
index d695d08..e4b4921 100644
--- a/src/resources/style.css
+++ b/src/resources/style.css
@@ -358,3 +358,46 @@ rubberband {
 .toolbar.no-bottom-padding {
   padding-bottom: 0px;
 }
+
+/* Kulan Files ------------------------------------------------------------- */
+
+/* Status bar: where you are on the left, item count and free space right. */
+.kulan-status-bar {
+  min-height: 26px;
+  padding: 0 12px;
+  font-size: 0.86em;
+  border-top: 1px solid alpha(currentColor, 0.08);
+  background-color: alpha(currentColor, 0.025);
+}
+.kulan-status-bar label { color: alpha(currentColor, 0.72); }
+.kulan-status-bar .kulan-status-path { font-weight: 500; }
+
+/* Sidebar headings: Favourites, Locations, Tags. */
+.kulan-sidebar-heading {
+  margin: 14px 12px 4px 12px;
+  font-size: 0.78em;
+  font-weight: 700;
+}
+
+/* Preview pane. */
+kulan-preview {
+  border-left: 1px solid alpha(currentColor, 0.08);
+  background-color: alpha(currentColor, 0.02);
+}
+kulan-preview .kulan-preview-picture { border-radius: 12px; }
+kulan-preview .kulan-preview-details { font-size: 0.9em; }
+
+/* Tag chips, in the colours of Kulan's tag dots. */
+.kulan-tag {
+  padding: 2px 10px;
+  border-radius: 999px;
+  font-size: 0.85em;
+  font-weight: 600;
+}
+.kulan-tag-red { background-color: alpha(#ef4444, 0.16); color: #dc2626; }
+.kulan-tag-orange { background-color: alpha(#f97316, 0.16); color: #ea580c; }
+.kulan-tag-yellow { background-color: alpha(#eab308, 0.20); color: #a16207; }
+.kulan-tag-green { background-color: alpha(#22c55e, 0.16); color: #15803d; }
+.kulan-tag-blue { background-color: alpha(#3b82f6, 0.16); color: #2563eb; }
+.kulan-tag-purple { background-color: alpha(#a855f7, 0.16); color: #9333ea; }
+.kulan-tag-grey { background-color: alpha(#94a3b8, 0.22); color: #475569; }
