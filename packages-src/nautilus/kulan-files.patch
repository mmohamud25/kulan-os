+/* Kulan Files: the sidebar in three parts, as in the Finder:
+ *   Favourites - Home, Recent, Starred, Desktop and your folders (bookmarks)
+ *   Locations  - cloud accounts, disks and drives, Network and Trash
+ *   Tags       - one row for each colour tag in use
+ * kulan_rank() gives the order; rows of one rank keep GNOME's own order. */
+static int
+kulan_rank (GtkListBoxRow *row)
+{
+  NautilusGtkPlacesSectionType section_type;
+  g_autofree char *uri = NULL;
+
+  g_object_get (row, "section-type", &section_type, "uri", &uri, NULL);
+  switch (section_type)
+    {
+    case NAUTILUS_GTK_PLACES_SECTION_DEFAULT_LOCATIONS:
+      if (uri != NULL &&
+          (g_str_has_prefix (uri, SCHEME_TRASH ":") || g_str_has_prefix (uri, SCHEME_NETWORK_VIEW ":")))
+        return 4;
+      return 0;
+    case NAUTILUS_GTK_PLACES_SECTION_BOOKMARKS:
+      return 1;
+    case NAUTILUS_GTK_PLACES_SECTION_CLOUD:
+      return 2;
+    case NAUTILUS_GTK_PLACES_SECTION_MOUNTS:
+      return 3;
+    case NAUTILUS_GTK_PLACES_SECTION_KULAN_TAGS:
+      return 5;
+    case NAUTILUS_GTK_PLACES_SECTION_INVALID:
+    case NAUTILUS_GTK_PLACES_N_SECTIONS:
+    default:
+      return 6;
+    }
+}
+
+static const char *
+kulan_group_title (int rank)
+{
+  if (rank <= 1)
+    return _("Favourites");
+  if (rank <= 4)
+    return _("Locations");
+  if (rank == 5)
+    return _("Tags");
+  return NULL;
+}
