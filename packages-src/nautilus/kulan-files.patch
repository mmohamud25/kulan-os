+/* Kulan Files: the preview pane, showing the selected item like the Finder's
+ * preview column: a large thumbnail or icon, its name and kind, its tags,
+ * and size, dates and location, with Open and Share buttons.
+ *
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+
+#include "nautilus-kulan-preview.h"
+
+#include <glib/gi18n.h>
+
+#include "nautilus-file.h"
+#include "nautilus-file-utilities.h"
+#include "nautilus-mime-actions.h"
+#include "nautilus-window.h"
+
+#define PREVIEW_SIZE 256
+#define TAGS_XATTR "xattr::xdg.tags"
+#define TAGS_METADATA "metadata::kulan-tags"
+
+struct _NautilusKulanPreview
+{
+    AdwBin parent_instance;
+
+    NautilusFile *file;
+    gulong changed_id;
+
+    GtkWidget *stack;
+    GtkWidget *picture;
+    GtkWidget *name;
+    GtkWidget *kind;
+    GtkWidget *tags;
+    GtkWidget *details;
+    GtkWidget *open_button;
+    GCancellable *tags_cancellable;
+};
+
+G_DEFINE_FINAL_TYPE (NautilusKulanPreview, nautilus_kulan_preview, ADW_TYPE_BIN)
+
+static const struct
+{
+    const char *id;
+    const char *name;
+} kulan_tags[] =
+{
+    { "red", N_("Red") }, { "orange", N_("Orange") }, { "yellow", N_("Yellow") },
+    { "green", N_("Green") }, { "blue", N_("Blue") }, { "purple", N_("Purple") },
+    { "grey", N_("Grey") },
+};
+
+static void
+clear_box (GtkWidget *box)
+{
+    GtkWidget *child;
+
+    while ((child = gtk_widget_get_first_child (box)) != NULL)
+    {
+        gtk_widget_unparent (child);
+    }
+}
+
+static void
+add_detail (NautilusKulanPreview *self,
+            const char           *label,
+            const char           *value)
+{
+    GtkWidget *row;
+    GtkWidget *key;
+    GtkWidget *text;
+
+    if (value == NULL || *value == '\0')
+    {
+        return;
+    }
+
+    row = gtk_box_new (GTK_ORIENTATION_HORIZONTAL, 12);
+    key = gtk_label_new (label);
+    gtk_widget_add_css_class (key, "dim-label");
+    gtk_label_set_xalign (GTK_LABEL (key), 0);
+    text = gtk_label_new (value);
+    gtk_label_set_xalign (GTK_LABEL (text), 1);
+    gtk_label_set_ellipsize (GTK_LABEL (text), PANGO_ELLIPSIZE_MIDDLE);
+    gtk_label_set_selectable (GTK_LABEL (text), TRUE);
+    gtk_widget_set_hexpand (text, TRUE);
+    gtk_widget_set_tooltip_text (text, value);
+    gtk_box_append (GTK_BOX (row), key);
+    gtk_box_append (GTK_BOX (row), text);
+    gtk_box_append (GTK_BOX (self->details), row);
+}
+
+/* Tags are read the way Kulan's tags code writes them: the "user.xdg.tags"
+ * extended attribute, or GIO metadata where a disk can't store those. */
+static void
+show_tags (NautilusKulanPreview *self,
+           const char           *raw)
+{
+    g_auto (GStrv) parts = NULL;
+
+    clear_box (self->tags);
+    gtk_widget_set_visible (self->tags, FALSE);
+    if (raw == NULL || *raw == '\0')
+    {
+        return;
+    }
+
+    parts = g_strsplit (raw, ",", -1);
+    for (guint i = 0; i < G_N_ELEMENTS (kulan_tags); i++)
+    {
+        for (guint j = 0; parts[j] != NULL; j++)
+        {
+            g_autofree char *word = g_ascii_strdown (g_strstrip (parts[j]), -1);
+
+            if (g_str_equal (word, kulan_tags[i].id) ||
+                (g_str_equal (word, "gray") && g_str_equal (kulan_tags[i].id, "grey")))
+            {
+                GtkWidget *chip = gtk_label_new (_(kulan_tags[i].name));
+                g_autofree char *css_class = g_strconcat ("kulan-tag-", kulan_tags[i].id, NULL);
+
+                gtk_widget_add_css_class (chip, "kulan-tag");
+                gtk_widget_add_css_class (chip, css_class);
+                gtk_box_append (GTK_BOX (self->tags), chip);
+                gtk_widget_set_visible (self->tags, TRUE);
+                break;
+            }
+        }
+    }
+}
+
+static void
+on_tags_queried (GObject      *source,
+                 GAsyncResult *result,
+                 gpointer      user_data)
+{
+    NautilusKulanPreview *self;
+    g_autoptr (GFileInfo) info = NULL;
+    g_autoptr (GError) error = NULL;
+    const char *raw;
+
+    info = g_file_query_info_finish (G_FILE (source), result, &error);
+    if (g_error_matches (error, G_IO_ERROR, G_IO_ERROR_CANCELLED))
+    {
+        return;
+    }
+    self = NAUTILUS_KULAN_PREVIEW (user_data);
+    if (info == NULL)
+    {
+        show_tags (self, NULL);
+        return;
+    }
+    raw = g_file_info_get_attribute_string (info, TAGS_XATTR);
+    if (raw == NULL || *raw == '\0')
+    {
+        raw = g_file_info_get_attribute_string (info, TAGS_METADATA);
+    }
+    show_tags (self, raw);
+}
+
+static void
+refresh (NautilusKulanPreview *self)
+{
+    g_autoptr (GdkPaintable) paintable = NULL;
+    g_autofree char *kind = NULL;
+    g_autofree char *size = NULL;
+    g_autofree char *created = NULL;
+    g_autofree char *modified = NULL;
+    g_autofree char *where = NULL;
+    g_autofree char *contents = NULL;
+    g_autoptr (GFile) location = NULL;
+    int scale;
+
+    if (self->file == NULL)
+    {
+        gtk_stack_set_visible_child_name (GTK_STACK (self->stack), "empty");
+        return;
+    }
+    gtk_stack_set_visible_child_name (GTK_STACK (self->stack), "file");
+
+    scale = gtk_widget_get_scale_factor (GTK_WIDGET (self));
+    paintable = nautilus_file_get_icon_paintable (self->file, PREVIEW_SIZE, scale,
+                                                  NAUTILUS_FILE_ICON_FLAGS_USE_THUMBNAILS);
+    gtk_picture_set_paintable (GTK_PICTURE (self->picture), paintable);
+
+    gtk_label_set_text (GTK_LABEL (self->name), nautilus_file_get_display_name (self->file));
+    kind = nautilus_file_get_string_attribute (self->file, "detailed_type");
+    gtk_label_set_text (GTK_LABEL (self->kind), kind != NULL ? kind : "");
+
+    clear_box (self->details);
+    if (nautilus_file_is_directory (self->file))
+    {
+        guint count;
+        gboolean unreadable;
+
+        if (nautilus_file_get_directory_item_count (self->file, &count, &unreadable) && !unreadable)
+        {
+            contents = g_strdup_printf (ngettext ("%'u item", "%'u items", count), count);
+        }
+        add_detail (self, _("Contents"), contents);
+    }
+    else
+    {
+        size = nautilus_file_get_string_attribute (self->file, "size");
+        add_detail (self, _("Size"), size);
+    }
+    created = nautilus_file_get_string_attribute (self->file, "date_created");
+    modified = nautilus_file_get_string_attribute (self->file, "date_modified");
+    where = nautilus_file_get_string_attribute (self->file, "where");
+    add_detail (self, _("Created"), created);
+    add_detail (self, _("Modified"), modified);
+    add_detail (self, _("Where"), where);
+
+    g_cancellable_cancel (self->tags_cancellable);
+    g_clear_object (&self->tags_cancellable);
+    self->tags_cancellable = g_cancellable_new ();
+    location = nautilus_file_get_location (self->file);
+    show_tags (self, NULL);
+    if (location != NULL)
+    {
+        g_file_query_info_async (location, TAGS_XATTR "," TAGS_METADATA, G_FILE_QUERY_INFO_NONE,
+                                 G_PRIORITY_DEFAULT, self->tags_cancellable, on_tags_queried, self);
+    }
+}
+
+static void
+on_file_ready (NautilusFile *file,
+               gpointer      user_data)
+{
+    NautilusKulanPreview *self = NAUTILUS_KULAN_PREVIEW (user_data);
+
+    if (file == self->file)
+    {
+        refresh (self);
+    }
+}
+
+static void
+on_file_changed (NautilusFile         *file,
+                 NautilusKulanPreview *self)
+{
+    refresh (self);
+}
+
+static void
+drop_file (NautilusKulanPreview *self)
+{
+    if (self->file == NULL)
+    {
+        return;
+    }
+    nautilus_file_cancel_call_when_ready (self->file, on_file_ready, self);
+    g_clear_signal_handler (&self->changed_id, self->file);
+    nautilus_file_monitor_remove (self->file, self);
+    g_clear_pointer (&self->file, nautilus_file_unref);
+}
+
+void
+nautilus_kulan_preview_set_file (NautilusKulanPreview *self,
+                                 NautilusFile         *file)
+{
+    NautilusFileAttributes attributes;
+
+    g_return_if_fail (NAUTILUS_IS_KULAN_PREVIEW (self));
+
+    if (file == self->file)
+    {
+        return;
+    }
+    drop_file (self);
+    if (file != NULL)
+    {
+        self->file = nautilus_file_ref (file);
+        attributes = NAUTILUS_FILE_ATTRIBUTES_FOR_ICON |
+                     NAUTILUS_FILE_ATTRIBUTE_INFO |
+                     NAUTILUS_FILE_ATTRIBUTE_DIRECTORY_ITEM_COUNT;
+        /* Monitoring asks for thumbnails and item counts and keeps them
+         * current; "changed" redraws when they arrive. */
+        nautilus_file_monitor_add (self->file, self, attributes);
+        self->changed_id = g_signal_connect (self->file, "changed",
+                                             G_CALLBACK (on_file_changed), self);
+        nautilus_file_call_when_ready (self->file, attributes, on_file_ready, self);
+    }
+    refresh (self);
+}
+
+static void
+on_open_clicked (GtkButton            *button,
+                 NautilusKulanPreview *self)
+{
+    GtkRoot *root;
+    NautilusWindowSlot *slot = NULL;
+    g_autoptr (GFile) location = NULL;
+    g_autoptr (GFile) parent = NULL;
+    g_autofree char *parent_uri = NULL;
+
+    if (self->file == NULL)
+    {
+        return;
+    }
+    root = gtk_widget_get_root (GTK_WIDGET (self));
+    if (NAUTILUS_IS_WINDOW (root))
+    {
+        slot = nautilus_window_get_active_slot (NAUTILUS_WINDOW (root));
+    }
+    location = nautilus_file_get_location (self->file);
+    parent = g_file_get_parent (location);
+    parent_uri = parent != NULL ? g_file_get_uri (parent) : NULL;
+    nautilus_mime_activate_file (GTK_WINDOW (root), slot, self->file, parent_uri, 0);
+}
+
+static void
+nautilus_kulan_preview_dispose (GObject *object)
+{
+    NautilusKulanPreview *self = NAUTILUS_KULAN_PREVIEW (object);
+
+    drop_file (self);
+    g_cancellable_cancel (self->tags_cancellable);
+    g_clear_object (&self->tags_cancellable);
+
+    G_OBJECT_CLASS (nautilus_kulan_preview_parent_class)->dispose (object);
+}
+
+static void
+nautilus_kulan_preview_init (NautilusKulanPreview *self)
+{
+    GtkWidget *scrolled;
+    GtkWidget *box;
+    GtkWidget *empty;
+    GtkWidget *buttons;
+    GtkWidget *open;
+
+    gtk_widget_add_css_class (GTK_WIDGET (self), "kulan-preview");
+    gtk_widget_set_size_request (GTK_WIDGET (self), 220, -1);
+
+    self->stack = gtk_stack_new ();
+    adw_bin_set_child (ADW_BIN (self), self->stack);
+
+    empty = adw_status_page_new ();
+    adw_status_page_set_icon_name (ADW_STATUS_PAGE (empty), "view-reveal-symbolic");
+    adw_status_page_set_title (ADW_STATUS_PAGE (empty), _("No Preview"));
+    gtk_widget_add_css_class (empty, "compact");
+    gtk_stack_add_named (GTK_STACK (self->stack), empty, "empty");
+
+    box = gtk_box_new (GTK_ORIENTATION_VERTICAL, 12);
+    gtk_widget_set_margin_top (box, 18);
+    gtk_widget_set_margin_bottom (box, 18);
+    gtk_widget_set_margin_start (box, 18);
+    gtk_widget_set_margin_end (box, 18);
+
+    self->picture = gtk_picture_new ();
+    gtk_picture_set_content_fit (GTK_PICTURE (self->picture), GTK_CONTENT_FIT_CONTAIN);
+    gtk_picture_set_can_shrink (GTK_PICTURE (self->picture), TRUE);
+    gtk_widget_set_size_request (self->picture, -1, 180);
+    gtk_widget_add_css_class (self->picture, "kulan-preview-picture");
+    gtk_box_append (GTK_BOX (box), self->picture);
+
+    self->name = gtk_label_new (NULL);
+    gtk_label_set_wrap (GTK_LABEL (self->name), TRUE);
+    gtk_label_set_wrap_mode (GTK_LABEL (self->name), PANGO_WRAP_WORD_CHAR);
+    gtk_label_set_justify (GTK_LABEL (self->name), GTK_JUSTIFY_CENTER);
+    gtk_label_set_selectable (GTK_LABEL (self->name), TRUE);
+    gtk_widget_add_css_class (self->name, "title-3");
+    gtk_box_append (GTK_BOX (box), self->name);
+
+    self->kind = gtk_label_new (NULL);
+    gtk_label_set_wrap (GTK_LABEL (self->kind), TRUE);
+    gtk_label_set_justify (GTK_LABEL (self->kind), GTK_JUSTIFY_CENTER);
+    gtk_widget_add_css_class (self->kind, "dim-label");
+    gtk_box_append (GTK_BOX (box), self->kind);
+
+    self->tags = gtk_box_new (GTK_ORIENTATION_HORIZONTAL, 6);
+    gtk_widget_set_halign (self->tags, GTK_ALIGN_CENTER);
+    gtk_widget_set_visible (self->tags, FALSE);
+    gtk_box_append (GTK_BOX (box), self->tags);
+
+    self->details = gtk_box_new (GTK_ORIENTATION_VERTICAL, 6);
+    gtk_widget_add_css_class (self->details, "kulan-preview-details");
+    gtk_widget_set_margin_top (self->details, 6);
+    gtk_box_append (GTK_BOX (box), self->details);
+
+    buttons = gtk_box_new (GTK_ORIENTATION_HORIZONTAL, 8);
+    gtk_box_set_homogeneous (GTK_BOX (buttons), TRUE);
+    gtk_widget_set_margin_top (buttons, 6);
+    open = gtk_button_new_with_mnemonic (_("_Open"));
+    gtk_widget_add_css_class (open, "suggested-action");
+    gtk_widget_add_css_class (open, "pill");
+    g_signal_connect (open, "clicked", G_CALLBACK (on_open_clicked), self);
+    self->open_button = open;
+    gtk_box_append (GTK_BOX (buttons), open);
+    gtk_box_append (GTK_BOX (box), buttons);
+
+    scrolled = gtk_scrolled_window_new ();
+    gtk_scrolled_window_set_policy (GTK_SCROLLED_WINDOW (scrolled), GTK_POLICY_NEVER, GTK_POLICY_AUTOMATIC);
+    gtk_scrolled_window_set_child (GTK_SCROLLED_WINDOW (scrolled), box);
+    gtk_stack_add_named (GTK_STACK (self->stack), scrolled, "file");
+
+    gtk_stack_set_visible_child_name (GTK_STACK (self->stack), "empty");
+}
+
+static void
+nautilus_kulan_preview_class_init (NautilusKulanPreviewClass *klass)
+{
+    GObjectClass *object_class = G_OBJECT_CLASS (klass);
+    GtkWidgetClass *widget_class = GTK_WIDGET_CLASS (klass);
+
+    object_class->dispose = nautilus_kulan_preview_dispose;
+    gtk_widget_class_set_css_name (widget_class, "kulan-preview");
+    gtk_widget_class_set_accessible_role (widget_class, GTK_ACCESSIBLE_ROLE_GROUP);
+}
