+/* Kulan Files: free space of the open folder's disk, for the status bar.
+ * Asked again when the folder changes, or when files change after a few
+ * seconds; the answer redraws the status bar. */
+#define KULAN_FREE_SPACE_MAX_AGE (5 * G_USEC_PER_SEC)
+
+static void
+kulan_free_space_ready (GObject      *source,
+                        GAsyncResult *result,
+                        gpointer      user_data)
+{
+    NautilusFilesView *view;
+    NautilusFilesViewPrivate *priv;
+    g_autoptr (GFileInfo) info = NULL;
+    g_autoptr (GError) error = NULL;
+
+    info = g_file_query_filesystem_info_finish (G_FILE (source), result, &error);
+    if (g_error_matches (error, G_IO_ERROR, G_IO_ERROR_CANCELLED))
+    {
+        return;
+    }
+    view = NAUTILUS_FILES_VIEW (user_data);
+    priv = nautilus_files_view_get_instance_private (view);
+    priv->kulan_free_known = info != NULL &&
+                             g_file_info_has_attribute (info, G_FILE_ATTRIBUTE_FILESYSTEM_FREE);
+    priv->kulan_free_bytes = priv->kulan_free_known ?
+                             g_file_info_get_attribute_uint64 (info, G_FILE_ATTRIBUTE_FILESYSTEM_FREE) : 0;
+    priv->kulan_free_checked = g_get_monotonic_time ();
+    schedule_update_status (view);
+}
+
+static void
+kulan_check_free_space (NautilusFilesView *view)
+{
+    NautilusFilesViewPrivate *priv = nautilus_files_view_get_instance_private (view);
+    GFile *location = nautilus_view_get_location (NAUTILUS_VIEW (view));
+    gboolean same = location != NULL && priv->kulan_free_location != NULL &&
+                    g_file_equal (location, priv->kulan_free_location);
+
+    if (location == NULL)
+    {
+        return;
+    }
+    if (same && g_get_monotonic_time () - priv->kulan_free_checked < KULAN_FREE_SPACE_MAX_AGE)
+    {
+        return;
+    }
+    if (!same)
+    {
+        priv->kulan_free_known = FALSE;
+        g_set_object (&priv->kulan_free_location, location);
+    }
+    /* Don't ask again while an answer is on its way. */
+    priv->kulan_free_checked = g_get_monotonic_time ();
+    g_cancellable_cancel (priv->kulan_free_cancellable);
+    g_clear_object (&priv->kulan_free_cancellable);
+    priv->kulan_free_cancellable = g_cancellable_new ();
+    g_file_query_filesystem_info_async (location, G_FILE_ATTRIBUTE_FILESYSTEM_FREE, G_PRIORITY_LOW,
+                                        priv->kulan_free_cancellable, kulan_free_space_ready, view);
+}
+
+static void
+kulan_show_status (NautilusFilesView *view,
+                   guint              selected,
+                   gboolean           size_known,
+                   goffset            size)
+{
+    NautilusFilesViewPrivate *priv = nautilus_files_view_get_instance_private (view);
+    GtkWidget *window = gtk_widget_get_ancestor (GTK_WIDGET (view), NAUTILUS_TYPE_WINDOW);
+    guint total = priv->model != NULL ? g_list_model_get_n_items (G_LIST_MODEL (priv->model)) : 0;
+    g_autoptr (GString) text = g_string_new (NULL);
+
+    if (window == NULL || priv->slot == NULL)
+    {
+        return;
+    }
+    kulan_check_free_space (view);
+
+    if (selected == 0)
+    {
+        g_string_printf (text, ngettext ("%'u item", "%'u items", total), total);
+        if (priv->kulan_free_known)
+        {
+            g_autofree char *free_text = g_format_size (priv->kulan_free_bytes);
+            /* Translators: "12 items, 41.3 GB available" */
+            g_string_append_printf (text, _(", %s available"), free_text);
+        }
+    }
+    else
+    {
+        /* Translators: "3 of 12 selected" */
+        g_string_printf (text, _("%'u of %'u selected"), selected, total);
+        if (size_known && size > 0)
+        {
+            g_autofree char *size_text = g_format_size (size);
+            g_string_append_printf (text, " (%s)", size_text);
+        }
+    }
+    nautilus_window_kulan_set_status (NAUTILUS_WINDOW (window), priv->slot, text->str);
+}
