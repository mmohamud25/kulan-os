+#define KULAN_PREVIEW_KEY "files-preview-pane"
+#define KULAN_STATUS_KEY "kulan-status-text"
+
+/* "Home › Documents › Projects": where the open folder is, for the status bar. */
+static char *
+kulan_path_text (GFile *location)
+{
+    g_autoptr (GFile) home = g_file_new_for_path (g_get_home_dir ());
+    g_autoptr (GPtrArray) parts = g_ptr_array_new_with_free_func (g_free);
+    g_autoptr (GString) text = g_string_new (NULL);
+    g_autoptr (GFile) current = NULL;
+
+    if (location == NULL)
+    {
+        return g_strdup ("");
+    }
+    if (!g_file_is_native (location))
+    {
+        g_autoptr (NautilusFile) file = nautilus_file_get (location);
+        return g_strdup (nautilus_file_get_display_name (file));
+    }
+
+    current = g_object_ref (location);
+    while (current != NULL)
+    {
+        g_autoptr (GFile) parent = NULL;
+
+        if (g_file_equal (current, home))
+        {
+            g_ptr_array_add (parts, g_strdup (_("Home")));
+            break;
+        }
+        parent = g_file_get_parent (current);
+        if (parent == NULL)
+        {
+            g_ptr_array_add (parts, g_strdup (_("Computer")));
+            break;
+        }
+        g_ptr_array_add (parts, g_file_get_basename (current));
+        g_set_object (&current, parent);
+    }
+
+    for (gint i = (gint) parts->len - 1; i >= 0; i--)
+    {
+        g_string_append (text, g_ptr_array_index (parts, i));
+        if (i > 0)
+        {
+            g_string_append (text, "  ›  ");
+        }
+    }
+    return g_string_free (g_steal_pointer (&text), FALSE);
+}
+
+static void
+kulan_update_preview (NautilusWindow *window)
+{
+    NautilusWindowSlot *slot = nautilus_window_get_active_slot (window);
+    GList *selection;
+    NautilusFile *file = NULL;
+    g_autoptr (NautilusFile) folder = NULL;
+
+    if (window->kulan_preview == NULL)
+    {
+        return;
+    }
+    if (slot == NULL ||
+        !adw_overlay_split_view_get_show_sidebar (ADW_OVERLAY_SPLIT_VIEW (window->preview_split)))
+    {
+        nautilus_kulan_preview_set_file (NAUTILUS_KULAN_PREVIEW (window->kulan_preview), NULL);
+        return;
+    }
+    selection = nautilus_window_slot_get_selection (slot);
+    if (selection != NULL)
+    {
+        file = selection->data;
+    }
+    else if (nautilus_window_slot_get_location (slot) != NULL)
+    {
+        folder = nautilus_file_get (nautilus_window_slot_get_location (slot));
+        file = folder;
+    }
+    nautilus_kulan_preview_set_file (NAUTILUS_KULAN_PREVIEW (window->kulan_preview), file);
+}
+
+static void
+kulan_update_status (NautilusWindow *window)
+{
+    NautilusWindowSlot *slot = nautilus_window_get_active_slot (window);
+    g_autofree char *path = NULL;
+    const char *info = NULL;
+
+    if (window->kulan_status_path == NULL)
+    {
+        return;
+    }
+    if (slot != NULL)
+    {
+        path = kulan_path_text (nautilus_window_slot_get_location (slot));
+        info = g_object_get_data (G_OBJECT (slot), KULAN_STATUS_KEY);
+    }
+    gtk_label_set_text (GTK_LABEL (window->kulan_status_path), path != NULL ? path : "");
+    gtk_label_set_text (GTK_LABEL (window->kulan_status_info), info != NULL ? info : "");
+}
+
+void
+nautilus_window_kulan_set_status (NautilusWindow     *window,
+                                  NautilusWindowSlot *slot,
+                                  const char         *text)
+{
+    g_return_if_fail (NAUTILUS_IS_WINDOW (window));
+
+    if (slot == NULL)
+    {
+        return;
+    }
+    g_object_set_data_full (G_OBJECT (slot), KULAN_STATUS_KEY, g_strdup (text), g_free);
+    if (slot == nautilus_window_get_active_slot (window))
+    {
+        kulan_update_status (window);
+    }
+}
+
+static void
+on_slot_selection_changed (NautilusWindowSlot *slot,
+                           GParamSpec         *pspec,
+                           NautilusWindow     *window)
+{
+    if (nautilus_window_get_active_slot (window) == slot)
+    {
+        kulan_update_preview (window);
+    }
+}
+
+static void
+action_toggle_preview (GSimpleAction *action,
+                       GVariant      *state,
+                       gpointer       user_data)
+{
+    NautilusWindow *window = NAUTILUS_WINDOW (user_data);
+    gboolean show = g_variant_get_boolean (state);
+
+    g_simple_action_set_state (action, state);
+    adw_overlay_split_view_set_show_sidebar (ADW_OVERLAY_SPLIT_VIEW (window->preview_split), show);
+    if (window->kulan_settings != NULL &&
+        g_settings_get_boolean (window->kulan_settings, KULAN_PREVIEW_KEY) != show)
+    {
+        g_settings_set_boolean (window->kulan_settings, KULAN_PREVIEW_KEY, show);
+    }
+    kulan_update_preview (window);
+}
+
 static void
 on_location_changed (NautilusWindow *window)
 {
     nautilus_window_sync_location_widgets (window);
+    kulan_update_status (window);
+    kulan_update_preview (window);
 }
 
