# Kulan OS: packages kept on the USB stick (the ISO's package pool) for
# Kulan Installer and Calamares, so installing never needs the internet:
# the boot loader for this kind of computer, and disk encryption's start-up
# support. The live system itself doesn't use them.
#
# The PC boot loader for older (BIOS) computers, grub-pc, is in
# installer-bios.list.binary: it conflicts with grub-efi-amd64, and
# live-build resolves each list on its own, so they can't share a list.
#if ARCHITECTURES amd64
grub-efi-amd64
grub-efi-amd64-signed
shim-signed
shim-helpers-amd64-signed
systemd-boot-efi-amd64-signed
#endif
#if ARCHITECTURES arm64
grub-efi-arm64
grub-efi-arm64-signed
shim-signed
shim-helpers-arm64-signed
systemd-boot-efi-arm64-signed
#endif
efibootmgr
os-prober
cryptsetup
cryptsetup-initramfs
keyutils
# Signed start-up (kulan-signed-start): the computer's own key signs its
# start-up files, made with ukify (dracut is in installer-dracut.list.binary).
systemd-boot-efi
systemd-ukify
python3-pefile
python3-zstandard
sbsigntool
mokutil
openssl
