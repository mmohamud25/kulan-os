# Kulan OS desktop - GNOME on Debian 13.
# One package per line. Package names verified against Debian trixie.

# Kulan OS's own packages (built by packages/build-debs.sh)
kulan-base
kulan-desktop-settings
kulan-settings
kulan-welcome

# Desktop
gnome-core
gnome-tweaks
gnome-shell-extension-dashtodock
gnome-shell-extension-blur-my-shell
gnome-shell-extension-appindicator
gnome-shell-extension-prefs
# Window snapping into halves and quarters, like macOS
gnome-shell-extension-tiling-assistant
# Battery modes (Power Saver, Balanced, Performance) in Quick Settings
power-profiles-daemon

# Look and feel
adwaita-icon-theme
bibata-cursor-theme
fonts-inter
fonts-jetbrains-mono
plymouth
plymouth-themes

# Everyday apps
firefox-esr
gnome-text-editor
gnome-calculator
loupe
evince
file-roller
gnome-disk-utility
gnome-system-monitor
# Mac-style extras: Quick Look (select a file in Files, press Space),
# emoji and symbols, weather and world clocks in the date menu, disk usage
gnome-sushi
gnome-characters
gnome-weather
gnome-clocks
baobab
# Live Text: copy text out of anything on screen (Super+Shift+T)
tesseract-ocr
tesseract-ocr-eng

# Office and media (native builds; run on ARM and PCs)
libreoffice-writer
libreoffice-calc
libreoffice-impress
libreoffice-gnome
vlc
gimp

# Restore points (roll back if an update ever breaks something)
timeshift

# App store (Debian packages + Flathub)
gnome-software
flatpak
gnome-software-plugin-flatpak

# Graphical installer (shown in the live session)
calamares
calamares-settings-debian

# Fonts
fonts-noto-core
fonts-noto-color-emoji

# Security and privacy
ufw
gufw
unattended-upgrades
deja-dup
# Password manager (offline, encrypted vault, browser autofill)
keepassxc
# Removes hidden location and device details from photos and documents
metadata-cleaner
# VPN: OpenVPN files import in Settings (WireGuard is built into NetworkManager)
network-manager-openvpn-gnome
# Extra AppArmor profiles that fence in common apps
apparmor-profiles-extra

# Tor Browser launcher: Tor Browser is only built for PCs (x86-64).
#if ARCHITECTURES amd64
torbrowser-launcher
#endif

# Speed: swap in compressed memory (settings in kulan-base)
systemd-zram-generator

# Useful tools
sudo
curl
wget
git
nano
htop

# Virtual machine integration (clipboard, display resize in UTM/QEMU).
# Harmless on real hardware: the services only start inside a VM.
spice-vdagent
qemu-guest-agent
