# Kulan OS desktop - GNOME on Debian 13.
# One package per line. Package names verified against Debian trixie.

# Kulan OS's own packages (built by packages/build-debs.sh)
kulan-base
kulan-desktop-settings
kulan-settings
kulan-welcome
kulan-assistant
kulan-assistant-engine

# Desktop
gnome-core
# Remote desktop (Kulan Settings > Sharing), off until someone turns it on
gnome-remote-desktop
# Languages can be added in Kulan Settings > Language and region
locales
gnome-tweaks
gnome-shell-extension-dashtodock
gnome-shell-extension-blur-my-shell
gnome-shell-extension-appindicator
gnome-shell-extension-prefs
# Files and folders on the desktop, like a Mac
gnome-shell-extension-desktop-icons-ng
# App menus when right-clicking an app in the dock (Discord, Slack, Spotify...)
gir1.2-dbusmenu-glib-0.4
# Window snapping into halves and quarters, like macOS
gnome-shell-extension-tiling-assistant
# Battery modes (Power Saver, Balanced, Performance) in Quick Settings
power-profiles-daemon

# Look and feel
adwaita-icon-theme
bibata-cursor-theme
fonts-inter
fonts-jetbrains-mono
plymouth
plymouth-themes

# Everyday apps
firefox-esr
gnome-text-editor
gnome-calculator
loupe
evince
file-roller
gnome-disk-utility
gnome-system-monitor
# Mac-style extras: Quick Look (select a file in Files, press Space),
# emoji and symbols, weather and world clocks in the date menu, disk usage
gnome-sushi
gnome-characters
gnome-weather
gnome-clocks
baobab
# Live Text: copy text out of anything on screen (Super+Shift+T)
tesseract-ocr
tesseract-ocr-eng
tesseract-ocr-ara
# Firmware updates for the BIOS, docks and devices, from their makers (LVFS)
fwupd
# Sets the clock from the internet (Date and time › Set the time automatically)
systemd-timesyncd
python3-nautilus
# Terminal: Ptyxis with Kulan colours, zsh with suggestions and highlighting
ptyxis
zsh
zsh-autosuggestions
zsh-syntax-highlighting
# Terminal power tools: fuzzy history and file search, fast search, nicer
# listings and viewing, folder jumping, a live system monitor
fzf
ripgrep
fd-find
bat
eza
zoxide
btop
# Qt apps follow the GTK theme (QT_QPA_PLATFORMTHEME=gtk3)
qt5-gtk-platformtheme
qt6-gtk-platformtheme

# Office and media (native builds; run on ARM and PCs)
libreoffice-writer
libreoffice-calc
libreoffice-impress
libreoffice-gnome
vlc
gimp

# Restore points (roll back if an update ever breaks something)
timeshift

# App store (Debian packages + Flathub)
gnome-software
flatpak
gnome-software-plugin-flatpak

# Graphical installer (shown in the live session)
# Kulan Installer (the usual way to install); Calamares stays as Advanced install
kulan-installer
calamares
calamares-settings-debian

# Fonts
fonts-noto-core
fonts-noto-color-emoji

# Security and privacy
ufw
gufw
unattended-upgrades
deja-dup
# Password manager (offline, encrypted vault, browser autofill)
keepassxc
# Removes hidden location and device details from photos and documents
metadata-cleaner
# VPN: OpenVPN files import in Settings (WireGuard is built into NetworkManager)
network-manager-openvpn-gnome
# Extra AppArmor profiles that fence in common apps
apparmor-profiles-extra

# Tor Browser launcher: Tor Browser is only built for PCs (x86-64).
#if ARCHITECTURES amd64
torbrowser-launcher
#endif

# Speed: swap in compressed memory (settings in kulan-base)
systemd-zram-generator
systemd-oomd
# Restart that works in ARM VMs (UTM): see kulan-base fast-restart
kexec-tools

# Useful tools
sudo
curl
wget
# (git comes with the Developer tools add-on, kulan-devkit)
nano
htop

# Virtual machine integration (clipboard, display resize in UTM/QEMU).
# Harmless on real hardware: the services only start inside a VM.
spice-vdagent
qemu-guest-agent
# VMware Fusion / Workstation: shared clipboard, drag and drop, automatic
# screen size and time sync (its services only start inside VMware).
open-vm-tools-desktop
