#!/bin/sh
# Kulan OS installer branding: rebrands Debian's Calamares setup in place.
set -eu

# shellcheck source=../../../kulan.conf
. /usr/share/kulan/kulan.conf

CAL=/etc/calamares
DEBIAN_BRANDING="${CAL}/branding/debian"
KULAN_BRANDING="${CAL}/branding/kulan"
ASSETS=/usr/share/kulan/calamares
LAUNCHER=/usr/share/applications/calamares-install-debian.desktop

[ -d "${DEBIAN_BRANDING}" ] || { echo "E: ${DEBIAN_BRANDING} not found - is calamares-settings-debian installed?" >&2; exit 1; }
[ -f "${CAL}/settings.conf" ] || { echo "E: ${CAL}/settings.conf not found" >&2; exit 1; }

rm -rf "${KULAN_BRANDING}"
cp -a "${DEBIAN_BRANDING}" "${KULAN_BRANDING}"
install -m 0644 "${ASSETS}/logo.png" "${KULAN_BRANDING}/kulan-logo.png"
install -m 0644 "${ASSETS}/welcome.png" "${KULAN_BRANDING}/welcome.png"
for SLIDE in "${ASSETS}"/slide*.png; do
	install -m 0644 "${SLIDE}" "${KULAN_BRANDING}/$(basename "${SLIDE}")"
done
install -m 0644 "${ASSETS}/show.qml" "${KULAN_BRANDING}/show.qml"
install -m 0644 "${ASSETS}/stylesheet.qss" "${KULAN_BRANDING}/stylesheet.qss"
rm -f "${KULAN_BRANDING}/debian-logo.png"

# Rewrite the strings. bootloaderEntryName stays "Debian" on purpose: Debian's
# Secure Boot-signed GRUB only looks for its config under EFI/debian, so
# renaming it would stop installed systems booting with Secure Boot on.
DESC="${KULAN_BRANDING}/branding.desc"
sed -i -E \
	-e "s|^componentName:.*|componentName:   kulan|" \
	-e "s|^([[:space:]]+productName:[[:space:]]+).*|\1${KULAN_NAME}|" \
	-e "s|^([[:space:]]+shortProductName:[[:space:]]+).*|\1${KULAN_SHORT_NAME}|" \
	-e "s|^([[:space:]]+version:[[:space:]]+).*|\1${KULAN_VERSION}|" \
	-e "s|^([[:space:]]+shortVersion:[[:space:]]+).*|\1${KULAN_VERSION}|" \
	-e "s|^([[:space:]]+versionedName:[[:space:]]+).*|\1${KULAN_NAME} ${KULAN_VERSION}|" \
	-e "s|^([[:space:]]+shortVersionedName:[[:space:]]+).*|\1${KULAN_SHORT_NAME} ${KULAN_VERSION}|" \
	-e "s|^([[:space:]]+productUrl:[[:space:]]+).*|\1${KULAN_HOME_URL}|" \
	-e "s|^([[:space:]]+supportUrl:[[:space:]]+).*|\1${KULAN_SUPPORT_URL}|" \
	-e "s|^([[:space:]]+productLogo:[[:space:]]+).*|\1\"kulan-logo.png\"|" \
	-e "s|^([[:space:]]+productIcon:[[:space:]]+).*|\1\"kulan-logo.png\"|" \
	-e "s|^([[:space:]]+SidebarBackground:[[:space:]]+).*|\1\"#0A2240\"|" \
	-e "s|^([[:space:]]+SidebarBackgroundCurrent:[[:space:]]+).*|\1\"#0D9488\"|" \
	-e "s|^([[:space:]]+SidebarText:[[:space:]]+).*|\1\"#DCE7F0\"|" \
	-e "s|^([[:space:]]+SidebarTextCurrent:[[:space:]]+).*|\1\"#FFFFFF\"|" \
	"${DESC}"

grep -q "^componentName:   kulan" "${DESC}" || { echo "E: failed to rebrand ${DESC}" >&2; exit 1; }

sed -i -E 's|^branding:.*|branding: kulan|' "${CAL}/settings.conf"
grep -q '^branding: kulan$' "${CAL}/settings.conf" || { echo "E: failed to switch Calamares branding" >&2; exit 1; }

# "Log in automatically" starts unticked: with it on, the password store
# (keyring) stays locked, so apps keep asking for a password, and it adds
# a wait at every start. People can still tick it in the installer.
USERS="${CAL}/modules/users.conf"
if [ -f "${USERS}" ]; then
	if grep -qE '^doAutologin:' "${USERS}"; then
		sed -i -E 's|^doAutologin:.*|doAutologin:     false|' "${USERS}"
	else
		printf '\ndoAutologin:     false\n' >> "${USERS}"
	fi
	grep -qE '^doAutologin:[[:space:]]+false$' "${USERS}" || { echo "E: failed to set doAutologin" >&2; exit 1; }

	# New accounts use zsh, as on a Mac (Kulan's prompt and suggestions come
	# from /etc/skel/.zshrc). Calamares 3.3 reads user: shell:, older
	# settings used userShell:.
	if [ -x /bin/zsh ] || [ -x /usr/bin/zsh ]; then
		if grep -qE '^[[:space:]]+shell:' "${USERS}"; then
			sed -i -E 's|^([[:space:]]+shell:).*|\1 /bin/zsh|' "${USERS}"
		elif grep -qE '^userShell:' "${USERS}"; then
			sed -i -E 's|^userShell:.*|userShell:       /bin/zsh|' "${USERS}"
		elif grep -qE '^user:[[:space:]]*$' "${USERS}"; then
			sed -i -E 's|^user:[[:space:]]*$|user:\n  shell: /bin/zsh|' "${USERS}"
		else
			printf '\nuser:\n  shell: /bin/zsh\n' >> "${USERS}"
		fi
		grep -qE '(^[[:space:]]+shell:|^userShell:)[[:space:]]+/bin/zsh$' "${USERS}" ||
			{ echo "E: failed to set the installer's shell" >&2; exit 1; }
	fi
fi

# Disk encryption: a mistyped password at start-up asks again, as often as
# needed (tries=0), instead of giving up after three and leaving a text
# console. Calamares copies these options into /etc/crypttab.
FSTAB="${CAL}/modules/fstab.conf"
if [ -f "${FSTAB}" ]; then
	if grep -qE '^crypttabOptions:' "${FSTAB}"; then
		if grep -qE '^crypttabOptions:.*tries=' "${FSTAB}"; then
			sed -i -E '/^crypttabOptions:/ s|tries=[0-9]+|tries=0|' "${FSTAB}"
		else
			sed -i -E 's|^(crypttabOptions:[[:space:]]*)([^#[:space:]]+)|\1\2,tries=0|' "${FSTAB}"
		fi
	else
		printf '\ncrypttabOptions: luks,tries=0\n' >> "${FSTAB}"
	fi
	grep -qE '^crypttabOptions:[[:space:]]*[^#[:space:]]*tries=0' "${FSTAB}" ||
		{ echo "E: failed to set the disk password retries" >&2; exit 1; }
fi

# The live session's account (made by adduser) and any made later with
# adduser or useradd on the installed system use zsh too.
if [ -x /bin/zsh ] || [ -x /usr/bin/zsh ]; then
	[ -f /etc/adduser.conf ] && sed -i -E 's|^#?DSHELL=.*|DSHELL=/bin/zsh|' /etc/adduser.conf
	[ -f /etc/default/useradd ] && sed -i -E 's|^#?[[:space:]]*SHELL=.*|SHELL=/bin/zsh|' /etc/default/useradd
fi

# Launcher in the app grid / dock.
if [ -f "${LAUNCHER}" ]; then
	sed -i -E \
		-e "s|^Name=.*|Name=Install ${KULAN_NAME}|" \
		-e "s|^Comment=.*|Comment=Install ${KULAN_NAME} on this computer|" \
		-e "s|^Icon=.*|Icon=kulan-logo|" \
		"${LAUNCHER}"
fi
# The desktop-icon helper hardcodes "Install Debian" for LXDE only; rebrand it too.
if [ -f /usr/bin/add-calamares-desktop-icon ]; then
	sed -i "s|Install Debian|Install ${KULAN_NAME}|g; s|Icon=install-debian|Icon=kulan-logo|g" \
		/usr/bin/add-calamares-desktop-icon
fi

# No installer icon on the live desktop: Debian's script copies the launcher
# there and marks it trusted, but GNOME's desktop icons still showed it as
# "calamares-install-debian.desktop" with a "not allowed to launch" badge.
# "Install Kulan OS" is the first icon in the dock and in the Welcome app.
ICON_AUTOSTART=/etc/xdg/autostart/calamares-desktop-icon.desktop
if [ -f "${ICON_AUTOSTART}" ]; then
	grep -qx 'Hidden=true' "${ICON_AUTOSTART}" || printf 'Hidden=true\n' >> "${ICON_AUTOSTART}"
fi

echo "I: Kulan OS installer branding installed"
