#!/bin/sh
# Kulan OS boot menu: replaces Debian's wording and background in the GRUB
# (UEFI) and ISOLINUX (BIOS) menus on the ISO.
#
# Edits the generated files rather than copying live-build's templates, so it
# keeps working when live-build changes its templates between versions.
set -eu

# Binary hooks run from the binary/ directory; also accept the build root.
if [ -d binary ]; then
	BUILD_ROOT=.
	MEDIUM=binary
else
	BUILD_ROOT=..
	MEDIUM=.
fi

CONF="${BUILD_ROOT}/chroot/usr/share/kulan/kulan.conf"
SPLASH="${BUILD_ROOT}/chroot/usr/share/kulan/boot-splash.png"
[ -r "${CONF}" ] || { echo "E: ${CONF} missing" >&2; exit 1; }
[ -r "${SPLASH}" ] || { echo "E: ${SPLASH} missing" >&2; exit 1; }
# shellcheck source=../../../kulan.conf
. "${CONF}"

CHANGED=0
for DIR in "${MEDIUM}/boot/grub" "${MEDIUM}/isolinux"; do
	[ -d "${DIR}" ] || continue

	for CFG in "${DIR}"/*.cfg "${DIR}"/*/*.cfg "${DIR}"/*/theme.txt; do
		[ -f "${CFG}" ] || continue
		sed -i \
			-e "s|Debian GNU/Linux Live|${KULAN_NAME} Live|g" \
			-e "s|Live system|${KULAN_NAME} Live|g" \
			-e "s|Debian GNU/Linux|${KULAN_NAME}|g" \
			"${CFG}"
		CHANGED=$((CHANGED + 1))
	done

	for IMG in "${DIR}"/splash.png "${DIR}"/*/splash.png; do
		[ -f "${IMG}" ] || continue
		cp "${SPLASH}" "${IMG}"
		CHANGED=$((CHANGED + 1))
	done
	# Some ISOLINUX themes use an SVG splash; drop it so the PNG is used.
	rm -f "${DIR}/splash.svg"
done

# The UEFI start menu (GRUB): the computer's own screen size rather than
# Debian's 800x600, which some laptops can't show (on a ThinkPad T490 the
# entries couldn't be seen), and Kulan's layout: the entries, then the
# countdown and keys below them, all clear of the Kulan OS logo at the bottom
# right. Unifont only: in a Secure Boot test, Debian's signed GRUB used its
# built-in Unifont and ignored a loaded Inter font.
GRUB_DIR="${MEDIUM}/boot/grub"
if [ -f "${GRUB_DIR}/config.cfg" ] && [ -f "${GRUB_DIR}/live-theme/theme.txt" ]; then
	sed -i 's|^\([[:space:]]*\)set gfxmode=800x600$|\1set gfxmode=1920x1080,1600x900,1366x768,1280x800,1024x768,800x600,auto|' \
		"${GRUB_DIR}/config.cfg"
	grep -q 'gfxmode=1920x1080' "${GRUB_DIR}/config.cfg" || { echo "E: GRUB's screen size not set in config.cfg" >&2; exit 1; }
	cat > "${GRUB_DIR}/live-theme/theme.txt" <<'THEME'
# Kulan OS start menu (written by Kulan's boot menu hook).
desktop-image: "../splash.png"
title-text: ""
message-font: "Unifont Regular 16"
terminal-font: "Unifont Regular 16"

+ boot_menu {
	left = 12%
	width = 60%
	top = 36%
	height = 36%
	item_font = "Unifont Regular 16"
	selected_item_font = "Unifont Regular 16"
	item_color = "#c9d6e3"
	selected_item_color = "#ffb547"
	item_height = 24
	item_padding = 0
	item_spacing = 12
	icon_width = 0
	icon_height = 0
	item_icon_space = 0
}

+ progress_bar {
	id = "__timeout__"
	left = 12%
	top = 75%
	width = 60%
	height = 32
	font = "Unifont Regular 16"
	text_color = "#ffffff"
	fg_color = "#1f7a8c"
	bg_color = "#0e2a44"
	border_color = "#3c6e91"
	text = "@TIMEOUT_NOTIFICATION_LONG@"
}

+ label {
	left = 12%
	top = 75%+44
	width = 60%
	height = 24
	align = "left"
	color = "#b8c7d6"
	font = "Unifont Regular 16"
	text = "@KEYMAP_SHORT@"
}
THEME
	CHANGED=$((CHANGED + 1))
fi

# Start the first entry (Kulan OS Live) automatically after 5 seconds, so
# booting from the ISO needs no key press. Any key stops the countdown.
GRUB_CFG="${MEDIUM}/boot/grub/grub.cfg"
if [ -f "${GRUB_CFG}" ]; then
	# Appended at the end: GRUB reads the value once the whole file (including
	# files it sources, such as config.cfg) has run, so the last setting wins.
	sed -i -e '/^[[:space:]]*set[[:space:]]\+timeout=/d' -e '/^[[:space:]]*set[[:space:]]\+default=/d' -e '/^# Kulan OS: start the first entry/d' "${GRUB_CFG}"
	printf '# Kulan OS: start the first entry after 5 seconds.\nset default=0\nset timeout=5\n' >> "${GRUB_CFG}"
	CHANGED=$((CHANGED + 1))
fi
ISOLINUX_CFG="${MEDIUM}/isolinux/isolinux.cfg"
if [ -f "${ISOLINUX_CFG}" ]; then
	sed -i '/^[[:space:]]*timeout[[:space:]]/Id' "${ISOLINUX_CFG}"
	echo "timeout 50" >> "${ISOLINUX_CFG}"
	CHANGED=$((CHANGED + 1))
fi

if [ "${CHANGED}" -eq 0 ]; then
	echo "E: no boot menu files found to brand under ${MEDIUM}" >&2
	exit 1
fi

echo "I: Kulan OS boot menu branded (${CHANGED} files)"
