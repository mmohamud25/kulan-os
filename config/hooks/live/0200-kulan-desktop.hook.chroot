#!/bin/sh
# Kulan OS desktop: extensions, dock apps, GNOME defaults, icons, login screen.
set -eu

SCHEMAS=/usr/share/glib-2.0/schemas
EXT_DIR=/usr/share/gnome-shell/extensions
GENERATED="${SCHEMAS}/98_kulan-os-generated.gschema.override"
INSTALLER_DESKTOP=calamares-install-debian.desktop

# --- Extensions ---------------------------------------------------------------
# Look up each extension's real ID from what the packages installed, so a
# renamed ID in a future Debian release can't silently leave it switched off.
# Format: "<label>:<glob matching the extension folder>:<required?>"
EXTENSIONS=""
for SPEC in \
	"dock:dash-to-dock@*:required" \
	"blur:blur-my-shell@*:required" \
	"tray:*appindicator*@*:optional"; do
	LABEL="${SPEC%%:*}"
	REST="${SPEC#*:}"
	PATTERN="${REST%%:*}"
	NEED="${REST#*:}"
	FOUND=""
	for DIR in "${EXT_DIR}"/${PATTERN}; do
		[ -f "${DIR}/metadata.json" ] || continue
		FOUND="$(basename "${DIR}")"
		break
	done
	if [ -z "${FOUND}" ]; then
		if [ "${NEED}" = required ]; then
			echo "E: GNOME extension for '${LABEL}' not found in ${EXT_DIR}" >&2
			exit 1
		fi
		echo "W: optional GNOME extension for '${LABEL}' not found; skipping" >&2
		continue
	fi
	EXTENSIONS="${EXTENSIONS:+${EXTENSIONS}, }'${FOUND}'"

	# If an extension ships its own compiled settings, it reads those instead
	# of the system ones and would ignore our defaults. Recompile its copy
	# with our overrides included.
	if [ -d "${EXT_DIR}/${FOUND}/schemas" ]; then
		cp "${SCHEMAS}/90_kulan-os.gschema.override" "${EXT_DIR}/${FOUND}/schemas/"
		glib-compile-schemas "${EXT_DIR}/${FOUND}/schemas"
	fi
done

# --- Dock (favourite apps) ----------------------------------------------------
# calamares-settings-debian ships its own list at priority 96 (with a launcher
# id that does not exist), so ours must sort after it. The installer is only
# added while its launcher exists; on the installed system it's gone because
# Calamares removes itself after installing.
FAVORITES="'firefox-esr.desktop', 'org.gnome.Nautilus.desktop', 'org.gnome.Console.desktop', 'org.gnome.TextEditor.desktop', 'org.gnome.Software.desktop', 'org.gnome.Settings.desktop'"
if [ -f "/usr/share/applications/${INSTALLER_DESKTOP}" ]; then
	FAVORITES="'${INSTALLER_DESKTOP}', ${FAVORITES}"
fi

rm -f "${SCHEMAS}/98_kulan-os-favorites.gschema.override"
cat > "${GENERATED}" <<EOF
# Generated by the Kulan OS build (config/hooks/live/0200-kulan-desktop.hook.chroot).
[org.gnome.shell]
enabled-extensions=[${EXTENSIONS}]
favorite-apps=[${FAVORITES}]
EOF

# Unknown keys only warn (they can differ between GNOME releases); syntax
# errors fail the build.
glib-compile-schemas "${SCHEMAS}"

# --- Icons --------------------------------------------------------------------
if command -v gtk-update-icon-cache >/dev/null 2>&1; then
	gtk-update-icon-cache --force --quiet /usr/share/icons/hicolor
fi

# --- Login screen (GDM) -------------------------------------------------------
# GDM reads the "gdm" dconf profile; make sure it includes our system db.
PROFILE=/etc/dconf/profile/gdm
if [ ! -f "${PROFILE}" ] || ! grep -qx 'system-db:gdm' "${PROFILE}"; then
	mkdir -p /etc/dconf/profile
	{
		echo 'user-db:user'
		echo 'system-db:gdm'
		if [ -f /usr/share/gdm/greeter-dconf-defaults ]; then
			echo 'file-db:/usr/share/gdm/greeter-dconf-defaults'
		fi
	} > "${PROFILE}"
fi
dconf update

echo "I: Kulan OS desktop defaults installed (extensions: ${EXTENSIONS})"
