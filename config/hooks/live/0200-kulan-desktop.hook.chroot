#!/bin/sh
# Re-apply the Kulan desktop setup once every package is installed, in strict
# mode: the ISO build fails if a required GNOME extension is missing.
# (kulan-desktop-settings also runs this on install and on every update.)
set -eu

[ -x /usr/lib/kulan/desktop-setup ] || { echo "E: kulan-desktop-settings is not installed" >&2; exit 1; }
KULAN_STRICT=1 /usr/lib/kulan/desktop-setup
