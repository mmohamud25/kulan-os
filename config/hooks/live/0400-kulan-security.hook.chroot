#!/bin/sh
# Kulan OS security defaults:
#  - firewall on at boot: block incoming connections, allow outgoing
#  - automatic security updates (config in /etc/apt/apt.conf.d/20auto-upgrades)
set -eu

UFW_CONF=/etc/ufw/ufw.conf
UFW_DEFAULTS=/etc/default/ufw

[ -f "${UFW_CONF}" ] || { echo "E: ${UFW_CONF} missing - is ufw installed?" >&2; exit 1; }

sed -i -E 's/^ENABLED=.*/ENABLED=yes/' "${UFW_CONF}"
sed -i -E \
	-e 's/^DEFAULT_INPUT_POLICY=.*/DEFAULT_INPUT_POLICY="DROP"/' \
	-e 's/^DEFAULT_OUTPUT_POLICY=.*/DEFAULT_OUTPUT_POLICY="ACCEPT"/' \
	-e 's/^DEFAULT_FORWARD_POLICY=.*/DEFAULT_FORWARD_POLICY="DROP"/' \
	"${UFW_DEFAULTS}"

grep -qx 'ENABLED=yes' "${UFW_CONF}" || { echo "E: could not enable ufw" >&2; exit 1; }

# ufw.service starts the firewall at boot when ENABLED=yes.
systemctl enable ufw.service >/dev/null 2>&1 || true
systemctl is-enabled ufw.service >/dev/null 2>&1 || {
	echo "E: ufw.service is not enabled" >&2
	exit 1
}

echo "I: Kulan OS security defaults installed"
