#!/bin/sh
# Make sure the Kulan boot splash is really inside the initramfs, so the ISO
# never silently ships a text-only boot.
set -eu

[ -x /usr/lib/kulan/boot-splash-setup ] || { echo "E: kulan-desktop-settings is not installed" >&2; exit 1; }
/usr/lib/kulan/boot-splash-setup

INITRDS="$(ls /boot/initrd.img-* 2>/dev/null || true)"
if [ -z "${INITRDS}" ]; then
	echo "E: no initramfs in /boot - the kernel should be installed before hooks run" >&2
	exit 1
fi

update-initramfs -u -k all
for INITRD in ${INITRDS}; do
	if ! lsinitramfs "${INITRD}" | grep -q 'plymouth/themes/kulan/kulan.plymouth'; then
		echo "E: Kulan OS splash theme is missing from ${INITRD}" >&2
		exit 1
	fi
done

echo "I: Kulan OS boot splash verified in the initramfs"
