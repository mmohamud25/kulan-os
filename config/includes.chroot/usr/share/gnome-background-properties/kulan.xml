<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE wallpapers SYSTEM "gnome-wp-list.dtd">
<!-- Adds the Kulan wallpaper to Settings > Appearance. -->
<wallpapers>
  <wallpaper deleted="false">
    <name>Kulan</name>
    <filename>/usr/share/backgrounds/kulan/kulan-light.png</filename>
    <filename-dark>/usr/share/backgrounds/kulan/kulan-dark.png</filename-dark>
    <options>zoom</options>
    <shade_type>solid</shade_type>
    <pcolor>#0A2240</pcolor>
    <scolor>#0A2240</scolor>
  </wallpaper>
</wallpapers>
